{{ 'milaura-destination-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_product = section.settings.featured_product
  assign featured_heading = section.settings.star_title | default: featured_product.title
  assign selected_count = 0
  assign seasonal_title_id = 'MilauraSeasonalTitle-' | append: section.id
  assign star_title_id = 'MilauraSeasonalStarTitle-' | append: section.id
  assign catalogue_title_id = 'MilauraSeasonalCatalogueTitle-' | append: section.id
  assign media_description_id = 'MilauraSeasonalMediaDescription-' | append: section.id
  assign campaign_video_desktop = section.settings.campaign_video
  assign campaign_video_mobile = section.settings.campaign_video_mobile | default: campaign_video_desktop
  assign campaign_poster_desktop = section.settings.campaign_poster
  assign campaign_poster_mobile = section.settings.campaign_poster_mobile | default: campaign_poster_desktop
  assign campaign_art_composite = section.settings.campaign_art_composite
  assign campaign_art_composite_mobile = section.settings.campaign_art_composite_mobile | default: campaign_art_composite
  assign star_image_media = featured_product.media | where: 'media_type', 'image'
  assign star_primary_media = star_image_media[0] | default: featured_product.featured_media
  assign star_secondary_media = star_image_media[1]
  assign star_tertiary_media = star_image_media[3] | default: star_image_media[2]

  for block in section.blocks
    assign block_product = block.settings.product
    if block_product != blank
      if featured_product == blank or block_product.handle != featured_product.handle
        assign selected_count = selected_count | plus: 1
      endif
    endif
  endfor

  assign total_count = selected_count
  if featured_product != blank
    assign total_count = total_count | plus: 1
  endif
-%}

{%- if campaign_video_desktop != blank -%}
  <script src="{{ 'milaura-sodalite-landing-media.js' | asset_url }}" defer="defer"></script>
{%- endif -%}


<div
  id="MilauraSeasonalCollection-{{ section.id }}"
  class="milaura-sodalite-landing milaura-destination-landing"
  {% if section.settings.star_material_asset != blank %}
    style="--milaura-destination-star-material: url('{{ section.settings.star_material_asset | asset_url }}');"
  {% endif %}
>
  <section class="milaura-sodalite-intro" aria-labelledby="{{ seasonal_title_id }}">
    <div class="milaura-sodalite-intro__shell">
      <header class="milaura-sodalite-intro__head">
        {%- if section.settings.campaign_eyebrow != blank -%}
          <p class="milaura-sodalite-intro__eyebrow">{{ section.settings.campaign_eyebrow | escape }}</p>
        {%- endif -%}

        <h1 id="{{ seasonal_title_id }}" class="milaura-sodalite-intro__title">
          <span class="milaura-sodalite-intro__title-main">{{ section.settings.campaign_title | escape }}<span aria-hidden="true">,</span></span>
          {%- if section.settings.campaign_title_secondary != blank -%}
            <span class="milaura-sodalite-intro__title-secondary">{{ section.settings.campaign_title_secondary | escape }}</span>
          {%- endif -%}
        </h1>
      </header>

      <figure class="milaura-sodalite-intro__media">
        <div class="milaura-sodalite-intro__media-frame"{% if campaign_video_desktop != blank %} data-milaura-sodalite-landing-media{% endif %}>
          {%- if campaign_video_desktop != blank -%}
            <video
              class="milaura-sodalite-intro__video"
              poster="{{ campaign_poster_desktop | asset_url }}"
              preload="none"
              muted
              loop
              playsinline
              disablepictureinpicture
              aria-describedby="{{ media_description_id }}"
              data-milaura-sodalite-landing-video
              data-src-desktop="{{ campaign_video_desktop | asset_url }}"
              data-src-mobile="{{ campaign_video_mobile | asset_url }}"
              data-poster-desktop="{{ campaign_poster_desktop | asset_url }}"
              data-poster-mobile="{{ campaign_poster_mobile | asset_url }}"
            ></video>
            <button
              class="milaura-sodalite-intro__media-toggle"
              type="button"
              aria-label="Lire la vidéo"
              aria-pressed="false"
              data-milaura-sodalite-landing-toggle
            >
              <span data-milaura-sodalite-landing-toggle-label>Lire</span>
            </button>
          {%- else -%}
            <picture class="milaura-sodalite-intro__picture">
              <source media="(max-width: 749px)" srcset="{{ campaign_poster_mobile | asset_url }}">
              <img
                class="milaura-sodalite-intro__image"
                src="{{ campaign_poster_desktop | asset_url }}"
                width="1280"
                height="720"
                alt="{{ section.settings.campaign_media_alt | escape }}"
                loading="eager"
                fetchpriority="high"
              >
            </picture>
          {%- endif -%}
          {%- if campaign_art_composite != blank -%}
            <picture class="milaura-sodalite-intro__product-art" aria-hidden="true">
              {%- if campaign_art_composite_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ campaign_art_composite_mobile | asset_url }}">
              {%- endif -%}
              <img
                class="milaura-sodalite-intro__product-art-image"
                src="{{ campaign_art_composite | asset_url }}"
                width="1536"
                height="1024"
                alt=""
                loading="eager"
                fetchpriority="high"
              >
            </picture>
          {%- endif -%}
        </div>
        {%- if campaign_video_desktop != blank -%}
          <figcaption id="{{ media_description_id }}" class="milaura-sodalite-intro__media-caption">
            {{ section.settings.campaign_media_alt | escape }}
          </figcaption>
        {%- endif -%}
      </figure>

      <div class="milaura-sodalite-intro__support">
        {%- if section.settings.campaign_text != blank -%}
          <div class="milaura-sodalite-intro__text">{{ section.settings.campaign_text }}</div>
        {%- endif -%}

        <div class="milaura-sodalite-intro__meta" aria-label="Repères de la sélection">
          {%- if section.settings.edition_label != blank -%}
            <span>{{ section.settings.edition_label | escape }}</span>
          {%- endif -%}
          {%- if section.settings.meta_label_1 != blank -%}
            <span>{{ section.settings.meta_label_1 | escape }}</span>
          {%- endif -%}
          {%- if section.settings.meta_label_2 != blank -%}
            <span>{{ section.settings.meta_label_2 | escape }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- if featured_product != blank -%}
    <section class="milaura-sodalite-star" aria-labelledby="{{ star_title_id }}">
      <header class="milaura-sodalite-star__heading">
        {%- if section.settings.star_label != blank -%}
          <p class="milaura-sodalite-star__eyebrow">{{ section.settings.star_label | escape }}</p>
        {%- endif -%}

        <h2 id="{{ star_title_id }}" class="milaura-sodalite-star__title">
          {{ featured_heading | escape }}
        </h2>
      </header>

      <div class="milaura-sodalite-star__shell">
        <a
          class="milaura-sodalite-star__media{% if star_secondary_media == blank and star_tertiary_media == blank %} milaura-sodalite-star__media--single{% endif %}"
          href="{{ featured_product.url }}"
          aria-label="Voir {{ featured_product.title | escape }}"
        >
          {%- if star_primary_media != blank -%}
            <span class="milaura-sodalite-star__tile milaura-sodalite-star__tile--primary">
              {{
                star_primary_media.preview_image
                | image_url: width: 1200
                | image_tag:
                  class: 'milaura-sodalite-star__image',
                  widths: '480, 720, 960, 1200',
                  sizes: '(max-width: 749px) 78vw, 36vw',
                  loading: 'eager',
                  alt: star_primary_media.alt
              }}
            </span>
          {%- endif -%}

          {%- if star_secondary_media != blank -%}
            <span class="milaura-sodalite-star__tile milaura-sodalite-star__tile--secondary">
              {{
                star_secondary_media.preview_image
                | image_url: width: 720
                | image_tag:
                  class: 'milaura-sodalite-star__image',
                  widths: '240, 360, 480, 720',
                  sizes: '(max-width: 749px) 38vw, 18vw',
                  loading: 'lazy',
                  alt: star_secondary_media.alt
              }}
            </span>
          {%- endif -%}

          {%- if star_tertiary_media != blank -%}
            <span class="milaura-sodalite-star__tile milaura-sodalite-star__tile--tertiary">
              {{
                star_tertiary_media.preview_image
                | image_url: width: 720
                | image_tag:
                  class: 'milaura-sodalite-star__image',
                  widths: '240, 360, 480, 720',
                  sizes: '(max-width: 749px) 42vw, 20vw',
                  loading: 'lazy',
                  alt: star_tertiary_media.alt
              }}
            </span>
          {%- endif -%}
        </a>

        <div class="milaura-sodalite-star__copy">
          {%- if section.settings.star_text != blank -%}
            <div class="milaura-sodalite-star__text">{{ section.settings.star_text }}</div>
          {%- endif -%}

          <span class="milaura-sodalite-star__price">{{ featured_product.price | money }}</span>

          <a class="milaura-sodalite-star__cta" href="{{ featured_product.url }}">
            <span>{{ section.settings.star_cta_label | escape }}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  {%- endif -%}

  <section class="milaura-sodalite-catalogue" aria-labelledby="{{ catalogue_title_id }}">
    <div class="milaura-sodalite-catalogue__shell">
      <header class="milaura-sodalite-catalogue__head">
        <div>
          <p class="milaura-sodalite-catalogue__eyebrow">{{ section.settings.catalogue_eyebrow | escape }}</p>
          <h2 id="{{ catalogue_title_id }}" class="milaura-sodalite-catalogue__title">{{ section.settings.catalogue_title | escape }}</h2>
        </div>
        {%- if total_count > 0 -%}
          <p class="milaura-sodalite-catalogue__count">{{ total_count }} produits</p>
        {%- endif -%}
      </header>

      {%- if selected_count > 0 -%}
        <div class="milaura-sodalite-catalogue__grid milaura-cards milaura-cards--editorial" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              {%- if featured_product == blank or product.handle != featured_product.handle -%}
                <div class="milaura-sodalite-catalogue__card" role="listitem" {{ block.shopify_attributes }}>
                  {% render 'milaura-card-product',
                    card_product: product,
                    img_loading: 'lazy',
                    show_vendor: false,
                    show_badges: section.settings.show_badges,
                    show_secondary_image: true,
                    force_bestseller_badge: false
                  %}
                  {% render 'milaura-editorial-purchase', product: product %}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="milaura-sodalite-catalogue__empty">{{ section.settings.empty_message | escape }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Landing de sélection",
  "tag": "section",
  "class": "section-milaura-sodalite-landing",
  "max_blocks": 48,
  "settings": [
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Fond minéral dans les assets"
    },
    {
      "type": "text",
      "id": "star_material_asset",
      "label": "Fond matière du produit star dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_poster",
      "label": "Rappel visuel desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_poster_mobile",
      "label": "Rappel visuel mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_video",
      "label": "Vidéo desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_video_mobile",
      "label": "Vidéo mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_composite",
      "label": "Composition produit desktop"
    },
    {
      "type": "text",
      "id": "campaign_art_composite_mobile",
      "label": "Composition produit mobile"
    },
    {
      "type": "text",
      "id": "campaign_media_alt",
      "label": "Description du rappel visuel"
    },
    {
      "type": "text",
      "id": "campaign_eyebrow",
      "label": "Sur-titre",
      "default": "Rentrée 2026"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre H1",
      "default": "La rentrée en sodalite"
    },
    {
      "type": "text",
      "id": "campaign_title_secondary",
      "label": "Sous-titre du H1",
      "default": "la pierre de votre rentrée"
    },
    {
      "type": "richtext",
      "id": "campaign_text",
      "label": "Introduction",
      "default": "<p>Découvrez les produits en sodalite sélectionnés pour la rentrée.</p>"
    },
    {
      "type": "text",
      "id": "edition_label",
      "label": "Édition",
      "default": "Rentrée 2026"
    },
    {
      "type": "text",
      "id": "meta_label_1",
      "label": "Repère 1",
      "default": "Expression"
    },
    {
      "type": "text",
      "id": "meta_label_2",
      "label": "Repère 2",
      "default": "Confiance"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produit star"
    },
    {
      "type": "text",
      "id": "star_title",
      "label": "Titre éditorial du produit star"
    },
    {
      "type": "text",
      "id": "star_label",
      "label": "Libellé du produit star",
      "default": "Le produit star"
    },
    {
      "type": "richtext",
      "id": "star_text",
      "label": "Texte du produit star"
    },
    {
      "type": "text",
      "id": "star_cta_label",
      "label": "CTA du produit star",
      "default": "Découvrir le bracelet"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    },
    {
      "type": "text",
      "id": "catalogue_eyebrow",
      "label": "Sur-titre du catalogue",
      "default": "La sélection complète"
    },
    {
      "type": "text",
      "id": "catalogue_title",
      "label": "Titre du catalogue",
      "default": "Tous les produits en sodalite"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Message si la sélection est vide",
      "default": "La sélection Sodalite arrive bientôt."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing de sélection"
    }
  ]
}
{% endschema %}
