{{ 'milaura-product-pdp-v2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign faq_data = product.metafields.milaura.faq_json.value
  assign contact_url = section.settings.contact_url | default: '/pages/contact-milaura'
-%}

<section
  id="MilauraProductServicesV2-{{ section.id }}"
  class="milaura-pdp-services-v2"
  aria-labelledby="MilauraProductServicesV2Title-{{ section.id }}"
>
  <div class="milaura-pdp-services-v2__inner">
    <header class="milaura-pdp-services-v2__header">
      <h2 id="MilauraProductServicesV2Title-{{ section.id }}">Services & réponses</h2>
    </header>

    <div class="milaura-pdp-services-v2__layout">
      <div class="milaura-pdp-services-v2__facts" aria-label="Services MilAura">
        <div class="milaura-pdp-services-v2__fact">
          <h3>{{ section.settings.shipping_title | escape }}</h3>
          <p>{{ section.settings.shipping_text | escape }}</p>
        </div>
        <div class="milaura-pdp-services-v2__fact">
          <h3>{{ section.settings.returns_title | escape }}</h3>
          <p>{{ section.settings.returns_text | escape }}</p>
        </div>
        <div class="milaura-pdp-services-v2__fact">
          <h3>{{ section.settings.payment_title | escape }}</h3>
          <p>{{ section.settings.payment_text | escape }}</p>
        </div>

        <a class="milaura-pdp-services-v2__contact" href="{{ contact_url }}">
          Demander un conseil <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="milaura-pdp-services-v2__faq">
        <h3>Questions fréquentes</h3>
        {%- if faq_data != blank and faq_data.size > 0 -%}
          {%- for item in faq_data limit: 6 -%}
            <details class="milaura-pdp-services-v2__question">
              <summary>{{ item.question | escape }}</summary>
              <div class="milaura-pdp-services-v2__answer rte">{{ item.answer }}</div>
            </details>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <details class="milaura-pdp-services-v2__question" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}</summary>
              <div class="milaura-pdp-services-v2__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_faq_schema -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- if faq_data != blank and faq_data.size > 0 -%}
        {%- for item in faq_data limit: 6 -%}
          {
            "@type": "Question",
            "name": {{ item.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "MilAura services V2",
  "tag": "section",
  "class": "section-milaura-product-services-v2",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "shipping_title",
      "label": "Titre livraison",
      "default": "Expédition & livraison"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Texte livraison",
      "default": "Expédition sous 24 h du lundi au vendredi. Livraison en France sous 3 à 5 jours."
    },
    {
      "type": "text",
      "id": "returns_title",
      "label": "Titre retours",
      "default": "Retours"
    },
    {
      "type": "textarea",
      "id": "returns_text",
      "label": "Texte retours",
      "default": "Retour possible sous 14 jours après réception pour les articles éligibles."
    },
    {
      "type": "text",
      "id": "payment_title",
      "label": "Titre paiement",
      "default": "Paiements"
    },
    {
      "type": "textarea",
      "id": "payment_text",
      "label": "Texte paiement",
      "default": "Cartes, Apple Pay et Shop Pay. Paiement Klarna en 3 fois sans frais sous réserve d’éligibilité."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Page de contact"
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Activer le balisage FAQ",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Quand ma commande sera-t-elle expédiée ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Les commandes sont préparées et expédiées depuis notre atelier à Metz sous 24 h du lundi au vendredi.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MilAura services V2",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
