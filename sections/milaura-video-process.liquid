{% style %}
  #MilauraVideoProcess-{{ section.id }} {
    width: 100%;
    padding: var(--milaura-spacing-lg) var(--milaura-spacing-sm) var(--milaura-spacing-xl);
    background: transparent;
  }

  #MilauraVideoProcess-{{ section.id }} .video-process-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--milaura-spacing-md);
    align-items: start;
  }

  /* Colonne gauche : Vidéo - centré verticalement */
  #MilauraVideoProcess-{{ section.id }} .video-column {
    display: flex;
    flex-direction: column;
    gap: var(--milaura-spacing-sm);
    justify-content: center;
    min-height: 100%;
  }

  #MilauraVideoProcess-{{ section.id }} .video-title {
    font-family: var(--milaura-font-signature);
    font-size: {{ section.settings.title_size }}rem;
    color: {{ section.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
    text-transform: none;
    text-align: center;
  }

  #MilauraVideoProcess-{{ section.id }} .video-subtitle {
    font-size: {{ section.settings.subtitle_size }}rem;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.6;
    margin-bottom: var(--milaura-spacing-sm);
    text-align: center;
  }

  #MilauraVideoProcess-{{ section.id }} .video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--milaura-border-radius);
    overflow: hidden;
    background: #f9f9f9;
  }

  #MilauraVideoProcess-{{ section.id }} .video-wrapper video,
  #MilauraVideoProcess-{{ section.id }} .video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  #MilauraVideoProcess-{{ section.id }} .video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--milaura-beige-mid);
    color: var(--milaura-text-light);
    font-family: var(--milaura-font-body);
  }

  /* Colonne droite : Produits */
  #MilauraVideoProcess-{{ section.id }} .products-column {
    display: flex;
    flex-direction: column;
    gap: var(--milaura-spacing-sm);
  }

  #MilauraVideoProcess-{{ section.id }} .products-list {
    display: flex;
    flex-direction: column;
    gap: var(--milaura-spacing-sm);
  }

  #MilauraVideoProcess-{{ section.id }} .product-item {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  #MilauraVideoProcess-{{ section.id }} .product-item:hover {
    text-decoration: none;
  }

  #MilauraVideoProcess-{{ section.id }} .milaura-product-card {
    width: min(100%, 360px);
    margin: 0 auto;
  }

  #MilauraVideoProcess-{{ section.id }} .collection-button {
    margin-top: var(--milaura-spacing-sm);
    margin-bottom: 50px;
    text-align: center;
  }

  /* Desktop/Tablette : CTA sous la vidéo visible, CTA sous produits caché */
  #MilauraVideoProcess-{{ section.id }} .collection-button.desktop-only {
    display: block;
  }

  #MilauraVideoProcess-{{ section.id }} .collection-button.mobile-only {
    display: none;
  }

  /* Dots cachés sur desktop */
  #MilauraVideoProcess-{{ section.id }} .carousel-dots {
    display: none;
  }

  /* ============================================
     MOBILE / TABLETTE (≤ 768px) - CARROUSEL SINGLE
     ============================================ */
  @media screen and (max-width: 768px) {
    #MilauraVideoProcess-{{ section.id }} {
      padding: var(--milaura-spacing-md) var(--milaura-spacing-sm);
    }

    #MilauraVideoProcess-{{ section.id }} .video-process-container {
      display: flex;
      flex-direction: column;
      gap: var(--milaura-spacing-md);
      align-items: center;
    }

    #MilauraVideoProcess-{{ section.id }} .video-column {
      width: 100%;
      text-align: center;
    }

    #MilauraVideoProcess-{{ section.id }} .video-title {
      font-size: 2rem;
      margin-bottom: 10px;
      text-align: center;
    }

    #MilauraVideoProcess-{{ section.id }} .video-subtitle {
      font-size: 1rem;
      margin-bottom: 16px;
      text-align: center;
      max-width: 90%;
      margin-left: auto;
      margin-right: auto;
    }

    #MilauraVideoProcess-{{ section.id }} .video-wrapper {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      border-radius: 16px;
      aspect-ratio: 16 / 9;
    }

    /* Produits en carrousel single card */
    #MilauraVideoProcess-{{ section.id }} .products-column {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }

    #MilauraVideoProcess-{{ section.id }} .products-list {
      position: relative;
      min-height: 0;
    }

    #MilauraVideoProcess-{{ section.id }} .product-item {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0.5s ease;
    }

    #MilauraVideoProcess-{{ section.id }} .product-item.is-active {
      opacity: 1;
      visibility: visible;
      position: relative;
    }

    /* Navigation du carrousel : cible tactile, repere visuel minimal. */
    #MilauraVideoProcess-{{ section.id }} .carousel-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--milaura-esp-3xs);
      margin-top: var(--milaura-esp-sm);
    }

    #MilauraVideoProcess-{{ section.id }} .carousel-dot {
      position: relative;
      width: var(--milaura-cible-tactile);
      height: var(--milaura-cible-tactile);
      border: 0;
      background: transparent;
      cursor: pointer;
      padding: 0;
    }

    #MilauraVideoProcess-{{ section.id }} .carousel-dot::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: var(--milaura-esp-md);
      height: 1px;
      background: var(--milaura-aigue-pierre);
      transform: translate(-50%, -50%);
      transition: width var(--milaura-transition-rapide), background-color var(--milaura-transition-rapide);
    }

    #MilauraVideoProcess-{{ section.id }} .carousel-dot:hover::after,
    #MilauraVideoProcess-{{ section.id }} .carousel-dot.is-active::after {
      width: var(--milaura-esp-lg);
      background: var(--milaura-aigue-profonde);
    }

    #MilauraVideoProcess-{{ section.id }} .carousel-dot:focus-visible {
      outline: var(--milaura-focus);
      outline-offset: var(--milaura-focus-offset);
    }

    /* Mobile : CTA sous la vidéo caché, CTA sous produits visible */
    #MilauraVideoProcess-{{ section.id }} .collection-button.desktop-only {
      display: none;
    }

    #MilauraVideoProcess-{{ section.id }} .collection-button.mobile-only {
      display: block;
      margin-top: 24px;
      text-align: center;
    }

    /* CTA lisible - Police sans-serif */
    #MilauraVideoProcess-{{ section.id }} .collection-button.mobile-only .milaura-btn {
      font-family: var(--milaura-font-texte) !important;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 16px 32px;
    }
  }

  /* Très petit mobile */
  @media screen and (max-width: 380px) {
    #MilauraVideoProcess-{{ section.id }} .video-title {
      font-size: 1.7rem;
    }

    #MilauraVideoProcess-{{ section.id }} .products-column {
      max-width: 290px;
    }

    #MilauraVideoProcess-{{ section.id }} .collection-button.mobile-only .milaura-btn {
      font-size: 0.9rem;
      padding: 14px 24px;
    }
  }
{% endstyle %}

<div id="MilauraVideoProcess-{{ section.id }}">
  <div class="video-process-container">
    <!-- Colonne gauche : Vidéo -->
    <div class="video-column">
      {% if section.settings.title != blank %}
        <h2 class="video-title milaura-heading">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="video-subtitle milaura-text">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="video-wrapper">
        {% if section.settings.video_url != blank %}
          {% assign video_url = section.settings.video_url %}
          
          {% comment %} Détecter si c'est une URL YouTube {% endcomment %}
          {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
            {% assign video_id = '' %}
            {% if video_url contains 'youtube.com/watch?v=' %}
              {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
            {% elsif video_url contains 'youtu.be/' %}
              {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}
            {% endif %}
            
            {% if video_id != blank %}
              <iframe 
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen
                loading="lazy">
              </iframe>
            {% else %}
              <div class="video-placeholder">URL YouTube invalide</div>
            {% endif %}
          {% elsif video_url contains '.mp4' or video_url contains '.webm' or video_url contains '.ogg' %}
            {% comment %} Vidéo directe (MP4, WebM, OGG) {% endcomment %}
            <video controls preload="metadata" loading="lazy">
              <source src="{{ video_url }}" type="video/mp4">
              Votre navigateur ne supporte pas la lecture de vidéos.
            </video>
          {% else %}
            {% comment %} Autre type d'URL, on essaie de l'afficher comme iframe {% endcomment %}
            <iframe 
              src="{{ video_url }}" 
              frameborder="0" 
              allowfullscreen
              loading="lazy">
            </iframe>
          {% endif %}
        {% else %}
          <div class="video-placeholder">
            <p>Aucune vidéo configurée</p>
          </div>
        {% endif %}
      </div>

      <!-- CTA sous la vidéo (desktop/tablette) -->
      {% assign selected_collection_for_btn = collections[section.settings.collection] %}
      {% if section.settings.button_label != blank and selected_collection_for_btn != blank %}
        <div class="collection-button desktop-only">
          <a href="{{ selected_collection_for_btn.url }}" class="milaura-btn milaura-btn-primary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}
    </div>

    <!-- Colonne droite : Produits -->
    <div class="products-column">
      {% assign selected_collection = collections[section.settings.collection] %}
      {% assign products_count = 0 %}

      {% if selected_collection != blank and selected_collection.products.size > 0 %}
        <div class="products-list milaura-cards" id="products-carousel-{{ section.id }}" role="list">
          {% for product in selected_collection.products limit: 4 %}
            {% assign products_count = products_count | plus: 1 %}
            <div class="product-item {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {% render 'milaura-product-card',
                product: product,
                img_loading: 'lazy',
                show_vendor: false,
                show_badges: true,
                show_secondary_image: true,
                force_bestseller_badge: false,
                nested_list_item: false
              %}
            </div>
          {% endfor %}
        </div>

        <!-- Dots navigation (mobile) -->
        <div class="carousel-dots" id="carousel-dots-{{ section.id }}">
          {% for product in selected_collection.products limit: 4 %}
            <button
              type="button"
              class="carousel-dot {% if forloop.first %}is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Voir {{ product.title }}"
            ></button>
          {% endfor %}
        </div>

        <!-- CTA mobile uniquement (caché sur desktop/tablette) -->
        {% if section.settings.button_label != blank %}
          <div class="collection-button mobile-only">
            <a href="{{ selected_collection.url }}" class="milaura-btn milaura-btn-primary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      {% else %}
        <div class="products-list milaura-cards" role="list">
          {% comment %} Placeholders si aucune collection n'est sélectionnée {% endcomment %}
          {% for i in (1..3) %}
            <div class="milaura-product-card" role="listitem">
              <div class="grid__card">
                <div class="grid__card-img grid__card-img--placeholder">
                  {{ 'product-' | append: i | placeholder_svg_tag }}
                </div>
                <div class="grid__card-info">
                  <h3 class="grid__card-title">Produit Exemple {{ i }}</h3>
                  <div class="grid__card-price">29,90 €</div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';

  var sectionId = '{{ section.id }}';
  var carousel = document.getElementById('products-carousel-' + sectionId);
  var dotsContainer = document.getElementById('carousel-dots-' + sectionId);

  if (!carousel || !dotsContainer) return;

  var items = Array.prototype.slice.call(carousel.querySelectorAll('.product-item'));
  var dots = Array.prototype.slice.call(dotsContainer.querySelectorAll('.carousel-dot'));
  var currentIndex = 0;
  var autoPlayInterval = null;

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function showSlide(index) {
    if (index < 0) index = items.length - 1;
    if (index >= items.length) index = 0;

    currentIndex = index;

    items.forEach(function(item, i) {
      item.classList.toggle('is-active', i === index);
    });

    dots.forEach(function(dot, i) {
      dot.classList.toggle('is-active', i === index);
    });
  }

  function startAutoPlay() {
    if (!isMobile()) return;
    stopAutoPlay();
    autoPlayInterval = setInterval(function() {
      showSlide(currentIndex + 1);
    }, 4000);
  }

  function stopAutoPlay() {
    if (autoPlayInterval) {
      clearInterval(autoPlayInterval);
      autoPlayInterval = null;
    }
  }

  // Click on dots
  dots.forEach(function(dot, i) {
    dot.addEventListener('click', function() {
      showSlide(i);
      stopAutoPlay();
      startAutoPlay();
    });
  });

  // Touch swipe support (mobile)
  var touchStartX = 0;
  var touchStartY = 0;
  var touchMoved = false;
  var isSwiping = false;

  carousel.addEventListener('touchstart', function(e) {
    if (!isMobile()) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
    touchMoved = false;
    isSwiping = false;
    stopAutoPlay();
  }, { passive: true });

  carousel.addEventListener('touchmove', function(e) {
    if (!isMobile() || !touchStartX) return;

    var touchCurrentX = e.touches[0].clientX;
    var touchCurrentY = e.touches[0].clientY;
    var diffX = touchStartX - touchCurrentX;
    var diffY = touchStartY - touchCurrentY;

    // Si le mouvement horizontal est plus grand que vertical, c'est un swipe
    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 10) {
      isSwiping = true;
      touchMoved = true;
    }
  }, { passive: true });

  carousel.addEventListener('touchend', function(e) {
    if (!isMobile()) return;

    var touchEndX = e.changedTouches[0].clientX;
    var diff = touchStartX - touchEndX;

    // Seuil réduit à 30px pour meilleure réactivité
    if (isSwiping && Math.abs(diff) > 30) {
      if (diff > 0) {
        // Swipe gauche -> slide suivant
        showSlide(currentIndex + 1);
      } else {
        // Swipe droite -> slide précédent
        showSlide(currentIndex - 1);
      }
    }

    touchStartX = 0;
    touchStartY = 0;
    isSwiping = false;
    startAutoPlay();
  }, { passive: true });

  // Start autoplay on mobile
  if (isMobile()) {
    startAutoPlay();
  }

  // Handle resize
  window.addEventListener('resize', function() {
    if (isMobile()) {
      showSlide(currentIndex);
      startAutoPlay();
    } else {
      stopAutoPlay();
      // Show all items on desktop
      items.forEach(function(item) {
        item.classList.remove('is-active');
      });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Milaura Process Vidéo",
  "settings": [
    {
      "type": "header",
      "content": "📝 Contenu"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section",
      "default": "Notre Artisanat"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Découvrez comment nous créons chaque pièce avec passion et attention aux détails."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL de la vidéo",
      "info": "URL YouTube (youtube.com ou youtu.be) ou URL directe d'une vidéo (MP4, WebM, OGG)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection de produits"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label du bouton",
      "default": "Voir tous les produits du rituel"
    },
    {
      "type": "header",
      "content": "✏️ Style Titre"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre",
      "min": 1.5,
      "max": 4,
      "step": 0.1,
      "unit": "rem",
      "default": 2.8
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur du titre",
      "default": "#B9975B"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Taille sous-titre",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.1
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Couleur sous-titre",
      "default": "#1b1b1b"
    },
    {
      "type": "header",
      "content": "✏️ Style Produits"
    },
    {
      "type": "range",
      "id": "product_name_size",
      "label": "Taille nom produit",
      "min": 0.8,
      "max": 1.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.1
    },
    {
      "type": "color",
      "id": "product_name_color",
      "label": "Couleur nom produit",
      "default": "#1b1b1b"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Taille prix",
      "min": 0.9,
      "max": 1.5,
      "step": 0.1,
      "unit": "rem",
      "default": 1.1
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Couleur prix",
      "default": "#B9975B"
    }
  ],
  "presets": [
    {
      "name": "Milaura Process Vidéo"
    }
  ]
}
{% endschema %}
