{%- liquid
  assign footer_form_id = 'MilauraFooterNewsletter-' | append: section.id
  assign withdrawal_page = pages['retractation']
-%}

<footer id="MilauraFooter-{{ section.id }}" class="milaura-footer" aria-label="Pied de page">
  <div class="milaura-footer__inner">
    <div class="milaura-footer__top">
      <div class="milaura-footer__brand">
        <a class="milaura-footer__logo-link" href="{{ routes.root_url }}" aria-label="MilAura, accueil">
          {%- if section.settings.logo != blank -%}
            {{- section.settings.logo
              | image_url: width: 360
              | image_tag:
                class: 'milaura-footer__logo',
                widths: '160, 240, 360',
                sizes: '180px',
                loading: 'lazy',
                alt: shop.name
            -}}
          {%- else -%}
            <span class="milaura-footer__wordmark">MilAura</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="milaura-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <nav class="milaura-footer__social" aria-label="Réseaux sociaux">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>
            {%- endif -%}
            {%- if settings.social_pinterest_link != blank -%}
              <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="milaura-footer__newsletter">
          <p class="milaura-footer__newsletter-title">{{ section.settings.newsletter_title | escape }}</p>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="milaura-footer__newsletter-text">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
          {% form 'customer', id: footer_form_id, class: 'milaura-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="MilauraFooterEmail-{{ section.id }}">Adresse email</label>
            <input
              id="MilauraFooterEmail-{{ section.id }}"
              class="milaura-footer__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.newsletter_placeholder | escape }}"
              required
            >
            <button class="milaura-footer__submit" type="submit">
              <span>{{ section.settings.newsletter_button | escape }}</span>
              <span aria-hidden="true">↗</span>
            </button>
            {%- if form.posted_successfully? -%}
              <p class="milaura-footer__form-message" tabindex="-1">{{ section.settings.newsletter_success | escape }}</p>
            {%- elsif form.errors -%}
              <p class="milaura-footer__form-message milaura-footer__form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}
    </div>

    <div class="milaura-footer__navigation">
      <nav class="milaura-footer__column" aria-labelledby="MilauraFooterExplore-{{ section.id }}">
        <h2 id="MilauraFooterExplore-{{ section.id }}" class="milaura-footer__column-title">Explorer</h2>
        <ul role="list">
          <li><a href="{{ routes.collections_url }}/nouveautes">Nouveautés</a></li>
          <li><a href="{{ routes.collections_url }}/bijoux-pierres-naturelles">Bijoux</a></li>
          <li><a href="/pages/bijoux-par-pierre">Bijoux par pierre</a></li>
          <li><a href="/pages/guide-des-pierres">Pierres et minéraux</a></li>
          <li><a href="{{ routes.collections_url }}/bougies-senteurs">Bougies et senteurs</a></li>
        </ul>
      </nav>

      <nav class="milaura-footer__column" aria-labelledby="MilauraFooterChoose-{{ section.id }}">
        <h2 id="MilauraFooterChoose-{{ section.id }}" class="milaura-footer__column-title">Choisir</h2>
        <ul role="list">
          <li><a href="/pages/choisir-sa-pierre">Selon mon ressenti</a></li>
          <li><a href="/pages/diagnostic-emotionnel">Faire le diagnostic</a></li>
          <li><a href="/pages/guide-des-pierres">Pierres de A à Z</a></li>
          <li><a href="/pages/guide-des-senteurs">Senteurs de A à Z</a></li>
          <li><a href="/pages/pierres-de-naissance">Pierre de naissance</a></li>
          <li><a href="/pages/cadeaux-anniversaire-de-mariage">Anniversaire de mariage</a></li>
        </ul>
      </nav>

      <nav class="milaura-footer__column" aria-labelledby="MilauraFooterHouse-{{ section.id }}">
        <h2 id="MilauraFooterHouse-{{ section.id }}" class="milaura-footer__column-title">MilAura</h2>
        <ul role="list">
          <li><a href="{{ settings.milaura_c1_mon_ecrin_url | default: routes.account_url }}">Mon compte</a></li>
          <li><a href="/pages/notre-histoire">Notre histoire</a></li>
          <li><a href="/blogs/journal">Le Journal</a></li>
          <li><a href="/pages/contact-milaura">Contact</a></li>
        </ul>
      </nav>

      <nav class="milaura-footer__column" aria-labelledby="MilauraFooterHelp-{{ section.id }}">
        <h2 id="MilauraFooterHelp-{{ section.id }}" class="milaura-footer__column-title">Aide</h2>
        <ul role="list">
          {%- if section.settings.help_menu != blank -%}
            {%- for link in section.settings.help_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- endif -%}
          {%- if withdrawal_page != blank -%}
            <li><a href="{{ withdrawal_page.url }}">Rétractation</a></li>
          {%- endif -%}
          <li><a href="/pages/mentions-legales">Mentions légales</a></li>
          <li><button type="button" class="milaura-footer__privacy-control" data-milaura-cookie-manage>Gérer mes cookies</button></li>
        </ul>
      </nav>
    </div>

    <div class="milaura-footer__bottom">
      <div>
        <p class="milaura-footer__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}. Tous droits réservés.</p>
        <p class="milaura-footer__disclaimer">La lithothérapie présente des traditions et des usages de bien-être. Elle ne remplace pas un avis médical.</p>
      </div>

      <div class="milaura-footer__bottom-meta">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
          <ul class="milaura-footer__payments" role="list" aria-label="Moyens de paiement acceptés">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.show_studio_credit -%}
          <a class="milaura-footer__credit" href="{{ section.settings.studio_credit_url }}" target="_blank" rel="noopener">
            {{ section.settings.studio_credit_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{%- style -%}
  #MilauraFooter-{{ section.id }},
  #MilauraFooter-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraFooter-{{ section.id }} {
    padding: var(--milaura-esp-3xl) 0 var(--milaura-esp-lg);
    color: var(--milaura-encre);
    background: var(--milaura-surface-mineral);
    border-top: var(--milaura-filet-mineral);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__inner {
    width: min(1320px, calc(100% - clamp(32px, 7vw, 112px)));
    margin: 0 auto;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(360px, 0.72fr);
    gap: var(--milaura-esp-2xl);
    padding-bottom: var(--milaura-esp-xl);
    border-bottom: var(--milaura-filet-or);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__logo-link,
  #MilauraFooter-{{ section.id }} .milaura-footer__wordmark {
    display: inline-block;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__logo {
    display: block;
    width: min(180px, 100%);
    height: auto;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__wordmark {
    color: var(--milaura-amethyste-profonde);
    font-family: var(--milaura-font-signature);
    font-size: var(--milaura-t-signature);
    font-weight: 600;
    line-height: var(--milaura-lh-signature);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__tagline {
    max-width: 520px;
    margin: var(--milaura-esp-md) 0 0;
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--milaura-esp-md);
    margin-top: var(--milaura-esp-lg);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__social a,
  #MilauraFooter-{{ section.id }} .milaura-footer__credit {
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
    text-decoration-color: var(--milaura-or);
    text-underline-offset: 4px;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__newsletter-title {
    margin: 0;
    color: var(--milaura-encre);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-h3);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__newsletter-text {
    max-width: 520px;
    margin: var(--milaura-esp-sm) 0 0;
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--milaura-esp-xs);
    margin-top: var(--milaura-esp-md);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__input,
  #MilauraFooter-{{ section.id }} .milaura-footer__submit {
    min-height: var(--milaura-cible-conversion);
    border: 0;
    border-bottom: var(--milaura-filet-or);
    border-radius: 0;
    font-size: var(--milaura-t-bouton);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__input {
    min-width: 0;
    padding: 0 var(--milaura-esp-xs);
    color: var(--milaura-encre);
    background: transparent;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__submit {
    display: inline-flex;
    align-items: center;
    gap: var(--milaura-esp-2xs);
    padding: 0 var(--milaura-esp-xs);
    color: var(--milaura-encre);
    background: transparent;
    cursor: pointer;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__submit span:last-child {
    color: var(--milaura-or-profond);
    font-size: var(--milaura-t-corps-large);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__input:focus-visible,
  #MilauraFooter-{{ section.id }} .milaura-footer__submit:focus-visible,
  #MilauraFooter-{{ section.id }} .milaura-footer__privacy-control:focus-visible,
  #MilauraFooter-{{ section.id }} a:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: var(--milaura-focus-offset);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__form-message {
    grid-column: 1 / -1;
    margin: var(--milaura-esp-xs) 0 0;
    color: var(--milaura-aigue-profonde);
    font-size: var(--milaura-t-petit);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__form-message--error {
    color: var(--milaura-amethyste-profonde);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__navigation {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--milaura-esp-xl);
    padding: var(--milaura-esp-xl) 0;
    border-bottom: var(--milaura-filet);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__column-title {
    margin: 0 0 var(--milaura-esp-md);
    color: var(--milaura-encre);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 700;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-transform: uppercase;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__column ul {
    display: grid;
    gap: var(--milaura-esp-xs);
    margin: 0;
    padding: 0;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__column a,
  #MilauraFooter-{{ section.id }} .milaura-footer__privacy-control {
    color: var(--milaura-encre-secondaire);
    background: transparent;
    border: 0;
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
    text-decoration: none;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__privacy-control {
    min-height: var(--milaura-cible-tactile);
    margin: calc((var(--milaura-cible-tactile) - 1em) / -2) 0;
    padding: calc((var(--milaura-cible-tactile) - 1em) / 2) 0;
    font-family: var(--milaura-font-texte);
    text-align: left;
    cursor: pointer;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__column a:hover,
  #MilauraFooter-{{ section.id }} .milaura-footer__privacy-control:hover {
    color: var(--milaura-encre);
    text-decoration: underline;
    text-decoration-color: var(--milaura-or);
    text-underline-offset: 4px;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--milaura-esp-xl);
    align-items: end;
    padding-top: var(--milaura-esp-lg);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__copyright,
  #MilauraFooter-{{ section.id }} .milaura-footer__disclaimer {
    margin: 0;
    color: var(--milaura-encre-tertiaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__disclaimer {
    max-width: 760px;
    margin-top: var(--milaura-esp-xs);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__bottom-meta {
    display: grid;
    justify-items: end;
    gap: var(--milaura-esp-sm);
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--milaura-esp-2xs);
    margin: 0;
    padding: 0;
  }

  #MilauraFooter-{{ section.id }} .milaura-footer__payments svg {
    display: block;
    width: 36px;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    #MilauraFooter-{{ section.id }} .milaura-footer__top,
    #MilauraFooter-{{ section.id }} .milaura-footer__bottom {
      grid-template-columns: 1fr;
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__navigation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__bottom-meta {
      justify-items: start;
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__payments {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraFooter-{{ section.id }} {
      padding-top: var(--milaura-esp-2xl);
      padding-bottom: calc(var(--milaura-esp-xl) + 96px);
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__inner {
      width: min(100% - 32px, 680px);
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__top {
      gap: var(--milaura-esp-xl);
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__tagline {
      font-size: var(--milaura-t-petit);
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__form,
    #MilauraFooter-{{ section.id }} .milaura-footer__navigation {
      grid-template-columns: 1fr;
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__submit {
      width: fit-content;
    }

    #MilauraFooter-{{ section.id }} .milaura-footer__navigation {
      gap: var(--milaura-esp-lg);
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Pied de page MilAura",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "tagline", "label": "Présentation", "default": "Bijoux en pierres naturelles, minéraux et bougies sélectionnés par Karine à Metz." },
    { "type": "checkbox", "id": "show_social", "label": "Afficher les réseaux sociaux", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher l inscription email", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Titre inscription", "default": "Les nouvelles MilAura" },
    { "type": "textarea", "id": "newsletter_text", "label": "Texte inscription", "default": "Nouvelles créations, guides et rendez-vous de la maison. Aucun avantage inventé." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Placeholder email", "default": "Votre adresse email" },
    { "type": "text", "id": "newsletter_button", "label": "Bouton email", "default": "S’inscrire" },
    { "type": "text", "id": "newsletter_success", "label": "Confirmation", "default": "Votre inscription est enregistrée." },
    { "type": "link_list", "id": "help_menu", "label": "Menu Aide", "default": "footer" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "checkbox", "id": "show_studio_credit", "label": "Afficher le crédit studio", "default": true },
    { "type": "text", "id": "studio_credit_label", "label": "Crédit studio", "default": "Conçu par ONORA Studio" },
    { "type": "url", "id": "studio_credit_url", "label": "Lien studio" }
  ],
  "presets": [
    { "name": "Pied de page MilAura" }
  ]
}
{% endschema %}
