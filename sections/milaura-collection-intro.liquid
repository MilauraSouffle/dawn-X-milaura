{%- comment -%}
  Introduction factuelle pour les collections de type produit.
  Ne rend rien si la description de collection est vide.
{%- endcomment -%}

{%- if collection.description != blank -%}
  <section
    id="MilauraCollectionIntro-{{ section.id }}"
    class="milaura-collection-intro milaura-section"
    aria-label="A propos de {{ collection.title | escape }}"
  >
    <div class="page-width">
      <div class="milaura-collection-intro__body rte">
        {{ collection.description }}
      </div>
    </div>
  </section>

  {%- style -%}
    #MilauraCollectionIntro-{{ section.id }} {
      padding: var(--milaura-spacing-sm, 20px) var(--milaura-spacing-sm, 16px);
      background: {{ section.settings.background_color }};
    }

    #MilauraCollectionIntro-{{ section.id }} .milaura-collection-intro__body {
      max-width: 760px;
      margin: 0 auto;
      color: var(--milaura-text, #333333);
      font-size: 15px;
      line-height: 1.7;
    }

    @media screen and (min-width: 769px) {
      #MilauraCollectionIntro-{{ section.id }} {
        padding-top: var(--milaura-spacing-md, 32px);
        padding-bottom: var(--milaura-spacing-md, 32px);
      }

      #MilauraCollectionIntro-{{ section.id }} .milaura-collection-intro__body {
        font-size: 16px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Introduction collection",
  "tag": "section",
  "class": "milaura-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Introduction collection"
    }
  ]
}
{% endschema %}
