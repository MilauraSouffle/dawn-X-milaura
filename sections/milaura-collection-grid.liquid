{%- comment -%}
  Grille collection MilAura.
  La carte et son achat vivent dans les snippets partages ; cette section ne
  gere plus que la grille, l'etat vide et la pagination.
{%- endcomment -%}

{%- unless collection -%}
  <section id="MilauraGrid-{{ section.id }}" class="milaura-collection-grid">
    <div class="page-width milaura-collection-grid__notice">
      <p>Cette section fonctionne uniquement sur les pages de collection.</p>
    </div>
  </section>
  {%- break -%}
{%- endunless -%}

{%- style -%}
  #MilauraGrid-{{ section.id }} {
    padding: var(--milaura-esp-2xs) 0 var(--milaura-esp-xs);
    background: transparent;
  }

  #MilauraGrid-{{ section.id }} .milaura-collection-grid__notice,
  #MilauraGrid-{{ section.id }} .grid__empty {
    padding: var(--milaura-esp-lg) var(--milaura-esp-md);
    color: var(--milaura-encre-secondaire);
    text-align: center;
  }

  #MilauraGrid-{{ section.id }} .grid__products {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: var(--milaura-esp-md);
    align-items: stretch;
  }

  #MilauraGrid-{{ section.id }} .grid__empty {
    grid-column: 1 / -1;
  }

  #MilauraGrid-{{ section.id }} .grid__empty-title {
    margin: 0 0 var(--milaura-esp-2xs);
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-h3);
  }

  #MilauraGrid-{{ section.id }} .grid__empty-text {
    margin: 0 0 var(--milaura-esp-sm);
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
  }

  #MilauraGrid-{{ section.id }} .grid__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--milaura-esp-2xs);
    margin-top: var(--milaura-esp-lg);
    flex-wrap: wrap;
  }

  #MilauraGrid-{{ section.id }} .grid__page {
    min-width: var(--milaura-cible-tactile);
    min-height: var(--milaura-cible-tactile);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--milaura-esp-xs);
    border: 0;
    border-bottom: var(--milaura-filet);
    border-radius: var(--milaura-rayon-net);
    color: var(--milaura-prune);
    background: transparent;
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--milaura-transition-rapide),
      border-color var(--milaura-transition-rapide);
  }

  #MilauraGrid-{{ section.id }} .grid__page:hover,
  #MilauraGrid-{{ section.id }} .grid__page.is-current {
    border-color: var(--milaura-aigue-profonde);
    color: var(--milaura-aigue-profonde);
  }

  #MilauraGrid-{{ section.id }} .grid__page.is-current {
    font-weight: 700;
  }

  #MilauraGrid-{{ section.id }} .grid__page:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: var(--milaura-focus-offset);
  }

  #MilauraGrid-{{ section.id }} .grid__page svg {
    width: var(--milaura-t-petit);
    height: var(--milaura-t-petit);
  }

  #MilauraGrid-{{ section.id }} .grid__page--dots {
    min-width: auto;
    border-bottom-color: transparent;
    pointer-events: none;
  }

  @media screen and (max-width: 1024px) {
    #MilauraGrid-{{ section.id }} .grid__products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--milaura-esp-sm);
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraGrid-{{ section.id }} .grid__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--milaura-esp-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraGrid-{{ section.id }} .grid__page {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraGrid-{{ section.id }}"
  class="milaura-collection-grid"
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="grid__products milaura-cards" role="list">
        {%- if collection.products.size == 0 -%}
          <div class="grid__empty">
            <h2 class="grid__empty-title">Aucune création trouvée</h2>
            <p class="grid__empty-text">Modifiez vos filtres ou explorez nos autres univers.</p>
            <a href="{{ routes.collections_url }}" class="milaura-action milaura-action--editorial">Voir les collections</a>
          </div>
        {%- else -%}
          {%- for product in collection.products -%}
            {%- if forloop.index <= 4 -%}
              {%- assign card_img_loading = 'eager' -%}
            {%- else -%}
              {%- assign card_img_loading = 'lazy' -%}
            {%- endif -%}

            {% render 'milaura-product-card',
              product: product,
              img_loading: card_img_loading,
              show_vendor: section.settings.show_vendor,
              show_badges: section.settings.show_badges,
              show_secondary_image: true,
              force_bestseller_badge: false
            %}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="grid__pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="grid__page" aria-label="Page précédente">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="grid__page">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="grid__page is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="grid__page grid__page--dots">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="grid__page" aria-label="Page suivante">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Grille Collection",
  "tag": "section",
  "class": "milaura-section",
  "settings": [
    {
      "type": "header",
      "content": "Affichage"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colonnes (desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le vendeur",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges",
      "default": true,
      "info": "Nouveau, Promo, Épuisé"
    }
  ],
  "presets": [
    {
      "name": "Grille Collection"
    }
  ]
}
{% endschema %}
