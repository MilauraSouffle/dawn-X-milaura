{{ 'milaura-owned-stone-guides.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign title_id = 'MilauraOwnedStudyTitle-' | append: section.id
  assign protocol_id = 'MilauraOwnedStudyProtocol-' | append: section.id
  capture study_status
    echo 'Édition '
    echo section.settings.edition
    echo ' en préparation'
  endcapture
-%}

<div class="milaura-owned">
  {% render 'milaura-owned-hero',
    variant: 'study',
    title_id: title_id,
    heading: section.settings.heading,
    introduction: section.settings.introduction,
    status_text: study_status,
    cta_label: 'Lire le protocole',
    cta_target: protocol_id
  %}

  {%- if section.settings.results_ready -%}
    <section class="milaura-owned__section milaura-owned__shell">
      <div class="milaura-owned__section-heading">
        <h2>Les principaux résultats</h2>
        <p>{{ section.settings.results_method_note | escape }}</p>
      </div>
      <div class="milaura-owned-study__results">
        {%- if section.settings.metric_1_value != blank and section.settings.metric_1_label != blank -%}<p class="milaura-owned-study__metric"><strong>{{ section.settings.metric_1_value | escape }}</strong><span>{{ section.settings.metric_1_label | escape }}</span></p>{%- endif -%}
        {%- if section.settings.metric_2_value != blank and section.settings.metric_2_label != blank -%}<p class="milaura-owned-study__metric"><strong>{{ section.settings.metric_2_value | escape }}</strong><span>{{ section.settings.metric_2_label | escape }}</span></p>{%- endif -%}
        {%- if section.settings.metric_3_value != blank and section.settings.metric_3_label != blank -%}<p class="milaura-owned-study__metric"><strong>{{ section.settings.metric_3_value | escape }}</strong><span>{{ section.settings.metric_3_label | escape }}</span></p>{%- endif -%}
      </div>
    </section>
  {%- else -%}
    <section class="milaura-owned__section milaura-owned__shell">
      <div class="milaura-owned__section-heading">
        <h2>Aucun résultat n'est publié à ce stade</h2>
        <p>Le protocole est prêt. Les chiffres apparaîtront ici seulement après la collecte, le contrôle des réponses, la pondération et la documentation des limites.</p>
      </div>
    </section>
  {%- endif -%}

  <section id="{{ protocol_id }}" class="milaura-owned__section milaura-owned__shell">
    <div class="milaura-owned__section-heading">
      <h2>Le protocole annoncé avant la collecte</h2>
      <p>Cette méthode pourra encore être auditée avant le terrain. Toute modification sera datée dans la restitution finale.</p>
    </div>
    <dl class="milaura-owned-study__method">
      <div><dt>Population étudiée</dt><dd>Adultes de 18 ans et plus résidant en France métropolitaine.</dd></div>
      <div><dt>Échantillon visé</dt><dd>1 000 réponses complètes issues d'un panel en ligne. Cette cible décrit le terrain prévu, pas un résultat acquis.</dd></div>
      <div><dt>Quotas et pondération</dt><dd>Sexe, âge, catégorie socioprofessionnelle, région et taille d'agglomération. Les pondérations, les bases et les non-réponses seront publiées.</dd></div>
      <div><dt>Protection des réponses</dt><dd>Aucun nom, e-mail, téléphone, adresse précise ou date de naissance complète dans le questionnaire. Toute inscription marketing reste séparée.</dd></div>
      <div><dt>Transparence</dt><dd>Questionnaire exact, ordre des questions, dates de terrain, commanditaire, prestataire, exclusions et limites publiés avec les résultats.</dd></div>
    </dl>
  </section>

  <section class="milaura-owned__section milaura-owned__shell">
    <div class="milaura-owned__section-heading">
      <h2>Ce que l'étude cherchera à comprendre</h2>
    </div>
    <ul class="milaura-owned-study__questions">
      <li>Dans quelles situations un bijou est choisi pour sa symbolique plutôt que pour son seul style ?</li>
      <li>Quelles intentions sont associées à un achat pour soi et à un cadeau ?</li>
      <li>Quelle place occupent la pierre de naissance, la couleur et la lithothérapie dans le choix ?</li>
      <li>Quelles informations sur la matière, l'entretien et les traitements renforcent la confiance ?</li>
      <li>Comment les réponses varient selon l'âge, la situation d'achat et le rapport habituel aux bijoux ?</li>
    </ul>
  </section>

  <section class="milaura-owned__sources milaura-owned__shell">
    <h2>Références méthodologiques</h2>
    <ul>
      <li><a href="https://www.cnil.fr/fr/minimiser-les-donnees-collectees">CNIL, minimiser les données collectées</a></li>
      <li><a href="https://www.cnil.fr/fr/technologies/lanonymisation-de-donnees-personnelles">CNIL, anonymisation des données</a></li>
      <li><a href="https://www.insee.fr/fr/information/7722109?sommaire=7722116">Insee, limites et usages des enquêtes par quotas</a></li>
      <li><a href="https://ana.esomar.org/documents/icc-esomar-international-code">ICC et ESOMAR, code international des études de marché et d’opinion</a></li>
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "Étude bijoux symboliques",
  "tag": "section",
  "class": "section-milaura-owned-study",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Bijoux symboliques et intentions en France" },
    { "type": "textarea", "id": "introduction", "label": "Introduction", "default": "MilAura prépare une étude annuelle pour comprendre ce qui donne du sens au choix d’un bijou. La méthode est publiée avant les résultats afin que chacun puisse en vérifier le périmètre et les limites." },
    { "type": "text", "id": "edition", "label": "Édition", "default": "2027" },
    { "type": "checkbox", "id": "results_ready", "label": "Afficher les résultats contrôlés", "default": false },
    { "type": "textarea", "id": "results_method_note", "label": "Note de méthode des résultats" },
    { "type": "text", "id": "metric_1_value", "label": "Valeur 1" },
    { "type": "text", "id": "metric_1_label", "label": "Libellé 1" },
    { "type": "text", "id": "metric_2_value", "label": "Valeur 2" },
    { "type": "text", "id": "metric_2_label", "label": "Libellé 2" },
    { "type": "text", "id": "metric_3_value", "label": "Valeur 3" },
    { "type": "text", "id": "metric_3_label", "label": "Libellé 3" }
  ],
  "presets": [{ "name": "Étude bijoux symboliques" }]
}
{% endschema %}
