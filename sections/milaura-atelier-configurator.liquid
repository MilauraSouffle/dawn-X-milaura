{{ 'milaura-atelier.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-atelier.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign title_id = 'MilauraAtelierTitle-' | append: section.id
  assign status_id = 'MilauraAtelierStatus-' | append: section.id
  assign pilot_product = section.settings.pilot_product
  assign selected_variant = nil
  assign available_variant_count = 0
  assign palette_count = 0
  assign letter_finish_count = 0
  assign charm_count = 0

  if pilot_product != blank
    assign selected_variant = pilot_product.selected_or_first_available_variant
    for variant in pilot_product.variants
      if variant.available
        assign available_variant_count = available_variant_count | plus: 1
      endif
    endfor
  endif

  for block in section.blocks
    if block.settings.available and block.settings.pilot_compatible and block.settings.component_id != blank and block.settings.label != blank
      case block.type
        when 'palette'
          assign palette_count = palette_count | plus: 1
        when 'letter_finish'
          assign letter_finish_count = letter_finish_count | plus: 1
        when 'charm'
          assign charm_count = charm_count | plus: 1
      endcase
    endif
  endfor

  assign configuration_ready = true
  if pilot_product == blank or selected_variant == nil or available_variant_count == 0
    assign configuration_ready = false
  endif
  if section.settings.max_characters < 1 or palette_count == 0 or letter_finish_count == 0
    assign configuration_ready = false
  endif
-%}

<section
  id="MilauraAtelier-{{ section.id }}"
  class="milaura-atelier"
  aria-labelledby="{{ title_id }}"
  data-milaura-atelier
  data-enhanced="false"
  data-ready="{{ configuration_ready }}"
  data-allowed-characters="{{ section.settings.allowed_characters | escape }}"
  data-current-step="1"
>
  <div class="milaura-atelier__page page-width">
    <header class="milaura-atelier__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="milaura-atelier__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="{{ title_id }}" class="milaura-atelier__title">{{ section.settings.heading | escape }}</h1>
      {%- if configuration_ready and section.settings.introduction != blank -%}
        <div class="milaura-atelier__introduction rte">{{ section.settings.introduction }}</div>
      {%- elsif section.settings.show_private_prototype -%}
        <div class="milaura-atelier__introduction rte">
          <p>Testez le gabarit avec les composants retenus dans les paniers fournisseurs. Après commande et réception, Karine vérifiera chaque élément avant d'ouvrir les ventes.</p>
        </div>
      {%- elsif section.settings.introduction != blank -%}
        <div class="milaura-atelier__introduction rte">{{ section.settings.introduction }}</div>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <p class="milaura-atelier__signature">{{ section.settings.signature | escape }}</p>
      {%- endif -%}
    </header>

    {%- if configuration_ready -%}
      <ol class="milaura-atelier__progress" aria-label="Étapes de composition">
        <li class="milaura-atelier__progress-item" data-step-indicator="1" aria-current="step">
          <span>1</span>
          <span>Choix</span>
        </li>
        <li class="milaura-atelier__progress-item" data-step-indicator="2">
          <span>2</span>
          <span>Message</span>
        </li>
        <li class="milaura-atelier__progress-item" data-step-indicator="3">
          <span>3</span>
          <span>Revue</span>
        </li>
      </ol>

      <div class="milaura-atelier__workspace">
        <aside class="milaura-atelier__scene" aria-label="Aperçu de la composition">
          <div class="milaura-atelier__scene-inner">
            <p class="milaura-atelier__scene-label">Votre fil de composition</p>
            <div class="milaura-atelier__strand" aria-hidden="true">
              <span class="milaura-atelier__strand-line"></span>
              <figure class="milaura-atelier__component-preview" data-preview-group="palette">
                <img alt="" width="96" height="96" hidden data-preview-image>
                <figcaption data-preview-label>Palette a choisir</figcaption>
              </figure>
              <div class="milaura-atelier__word-preview" data-word-preview>VOTRE MOT</div>
              <figure class="milaura-atelier__component-preview" data-preview-group="letter_finish">
                <img alt="" width="96" height="96" hidden data-preview-image>
                <figcaption data-preview-label>Lettres a choisir</figcaption>
              </figure>
              <figure class="milaura-atelier__component-preview milaura-atelier__component-preview--charm" data-preview-group="charm">
                <img alt="" width="96" height="96" hidden data-preview-image>
                <figcaption data-preview-label>Sans charm</figcaption>
              </figure>
            </div>
            <p class="milaura-atelier__preview-note">Aperçu indicatif. Les photos montrent les composants réels, pas le bracelet monté.</p>
          </div>
        </aside>

        <form
          class="milaura-atelier__form"
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          data-atelier-form
        >
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Atelier - Modèle]" value="{{ pilot_product.title | escape }}">
          <input type="hidden" name="properties[Atelier - Taille]" value="{{ selected_variant.title | escape }}" data-size-property>
          <input type="hidden" name="properties[_atelier_config_id]" value="" data-config-id>
          <input type="hidden" name="properties[_atelier_config_version]" value="2026-08-17.v1">
          <input type="hidden" name="properties[_atelier_palette_id]" value="" data-component-property="palette">
          <input type="hidden" name="properties[_atelier_letter_finish_id]" value="" data-component-property="letter_finish">
          <input type="hidden" name="properties[_atelier_charm_id]" value="" data-component-property="charm">
          <input type="hidden" name="properties[_atelier_config_json]" value="" data-config-json>

          <div id="{{ status_id }}" class="milaura-atelier__live" role="status" aria-live="polite" aria-atomic="true" data-atelier-status></div>

          <fieldset class="milaura-atelier__step" data-step="1" data-active="true">
            <legend class="milaura-atelier__step-title" tabindex="-1">
              <span>Étape 1 sur 3</span>
              Choisissez la base
            </legend>
            <p class="milaura-atelier__step-intro">Sélectionnez uniquement parmi les composants disponibles pour ce modèle pilote.</p>

            <div class="milaura-atelier__field">
              <label for="AtelierVariant-{{ section.id }}">Taille</label>
              <div class="milaura-atelier__select-wrap">
                <select id="AtelierVariant-{{ section.id }}" name="id" required data-variant-select>
                  {%- for variant in pilot_product.variants -%}
                    {%- if variant.available -%}
                      <option
                        value="{{ variant.id }}"
                        data-variant-title="{{ variant.title | escape }}"
                        data-variant-price="{{ variant.price | money_with_currency | escape }}"
                        {% if variant.id == selected_variant.id %}selected{% endif %}
                      >
                        {{ variant.title | escape }} - {{ variant.price | money_with_currency }}
                      </option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>

            <div class="milaura-atelier__field">
              <p class="milaura-atelier__field-label" id="AtelierPaletteLabel-{{ section.id }}">Palette de perles</p>
              <div class="milaura-atelier__options" role="radiogroup" aria-labelledby="AtelierPaletteLabel-{{ section.id }}">
                {%- assign first_palette = true -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'palette' -%}
                    {%- assign option_valid = false -%}
                    {%- if block.settings.available and block.settings.pilot_compatible and block.settings.component_id != blank and block.settings.label != blank -%}
                      {%- assign option_valid = true -%}
                    {%- endif -%}
                    {%- if option_valid or section.settings.show_unavailable_options -%}
                      <label class="milaura-atelier__option{% unless option_valid %} is-unavailable{% endunless %}" {{ block.shopify_attributes }}>
                        <input
                          type="radio"
                          name="properties[Atelier - Palette]"
                          value="{{ block.settings.label | escape }}"
                          data-option-group="palette"
                          data-component-id="{{ block.settings.component_id | escape }}"
                          data-preview-label="{{ block.settings.label | escape }}"
                          {% if block.settings.image != blank %}data-preview-image="{{ block.settings.image | image_url: width: 240 }}"{% endif %}
                          {% if first_palette and option_valid %}checked required{% endif %}
                          {% unless option_valid %}disabled{% endunless %}
                        >
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '72px', alt: block.settings.label }}
                        {%- endif -%}
                        <span>{{ block.settings.label | escape }}</span>
                        {%- unless option_valid -%}<small>Indisponible</small>{%- endunless -%}
                      </label>
                      {%- if option_valid -%}{%- assign first_palette = false -%}{%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="milaura-atelier__field">
              <p class="milaura-atelier__field-label" id="AtelierLettersLabel-{{ section.id }}">Finition des lettres</p>
              <div class="milaura-atelier__options" role="radiogroup" aria-labelledby="AtelierLettersLabel-{{ section.id }}">
                {%- assign first_letter_finish = true -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'letter_finish' -%}
                    {%- assign option_valid = false -%}
                    {%- if block.settings.available and block.settings.pilot_compatible and block.settings.component_id != blank and block.settings.label != blank -%}
                      {%- assign option_valid = true -%}
                    {%- endif -%}
                    {%- if option_valid or section.settings.show_unavailable_options -%}
                      <label class="milaura-atelier__option{% unless option_valid %} is-unavailable{% endunless %}" {{ block.shopify_attributes }}>
                        <input
                          type="radio"
                          name="properties[Atelier - Lettres]"
                          value="{{ block.settings.label | escape }}"
                          data-option-group="letter_finish"
                          data-component-id="{{ block.settings.component_id | escape }}"
                          data-preview-label="{{ block.settings.label | escape }}"
                          {% if block.settings.image != blank %}data-preview-image="{{ block.settings.image | image_url: width: 240 }}"{% endif %}
                          {% if first_letter_finish and option_valid %}checked required{% endif %}
                          {% unless option_valid %}disabled{% endunless %}
                        >
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '72px', alt: block.settings.label }}
                        {%- endif -%}
                        <span>{{ block.settings.label | escape }}</span>
                        {%- unless option_valid -%}<small>Indisponible</small>{%- endunless -%}
                      </label>
                      {%- if option_valid -%}{%- assign first_letter_finish = false -%}{%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="milaura-atelier__step-actions" data-step-actions>
              <button class="milaura-atelier__next" type="button" data-step-next>Continuer</button>
            </div>
          </fieldset>

          <fieldset class="milaura-atelier__step" data-step="2" data-active="false">
            <legend class="milaura-atelier__step-title" tabindex="-1">
              <span>Étape 2 sur 3</span>
              Écrivez votre message
            </legend>
            <p class="milaura-atelier__step-intro">Relisez chaque lettre. Karine montera exactement le mot confirmé à l'étape suivante.</p>

            <div class="milaura-atelier__field">
              <label for="AtelierWord-{{ section.id }}">Mot ou message</label>
              <input
                id="AtelierWord-{{ section.id }}"
                class="milaura-atelier__text-input"
                type="text"
                name="properties[Atelier - Mot]"
                maxlength="{{ section.settings.max_characters }}"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                aria-describedby="AtelierWordHelp-{{ section.id }} AtelierWordError-{{ section.id }}"
                required
                data-word-input
              >
              <div class="milaura-atelier__field-meta">
                <p id="AtelierWordHelp-{{ section.id }}">
                  {{ section.settings.allowed_characters_help | escape }}
                </p>
                <p><span data-character-count>0</span>/{{ section.settings.max_characters }}</p>
              </div>
              <p id="AtelierWordError-{{ section.id }}" class="milaura-atelier__field-error" data-word-error></p>
            </div>

            <div class="milaura-atelier__field">
              <p class="milaura-atelier__field-label" id="AtelierCharmLabel-{{ section.id }}">Charm</p>
              <div class="milaura-atelier__options" role="radiogroup" aria-labelledby="AtelierCharmLabel-{{ section.id }}">
                <label class="milaura-atelier__option">
                  <input
                    type="radio"
                    name="properties[Atelier - Charm]"
                    value="Aucun"
                    data-option-group="charm"
                    data-component-id=""
                    data-preview-label="Sans charm"
                    checked
                  >
                  <span>Aucun</span>
                </label>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'charm' -%}
                    {%- assign option_valid = false -%}
                    {%- if block.settings.available and block.settings.pilot_compatible and block.settings.component_id != blank and block.settings.label != blank -%}
                      {%- assign option_valid = true -%}
                    {%- endif -%}
                    {%- if option_valid or section.settings.show_unavailable_options -%}
                      <label class="milaura-atelier__option{% unless option_valid %} is-unavailable{% endunless %}" {{ block.shopify_attributes }}>
                        <input
                          type="radio"
                          name="properties[Atelier - Charm]"
                          value="{{ block.settings.label | escape }}"
                          data-option-group="charm"
                          data-component-id="{{ block.settings.component_id | escape }}"
                          data-preview-label="{{ block.settings.label | escape }}"
                          {% if block.settings.image != blank %}data-preview-image="{{ block.settings.image | image_url: width: 240 }}"{% endif %}
                          {% unless option_valid %}disabled{% endunless %}
                        >
                        {%- if block.settings.image != blank -%}
                          {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '72px', alt: block.settings.label }}
                        {%- endif -%}
                        <span>{{ block.settings.label | escape }}</span>
                        {%- unless option_valid -%}<small>Indisponible</small>{%- endunless -%}
                      </label>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="milaura-atelier__field">
              <label for="AtelierNote-{{ section.id }}">Note pour Karine <span>(facultatif)</span></label>
              <textarea
                id="AtelierNote-{{ section.id }}"
                class="milaura-atelier__text-input"
                name="properties[Atelier - Note]"
                maxlength="{{ section.settings.note_max_characters }}"
                rows="3"
                aria-describedby="AtelierNoteHelp-{{ section.id }}"
                data-note-input
              ></textarea>
              <p id="AtelierNoteHelp-{{ section.id }}" class="milaura-atelier__help">Pas de nom, téléphone ou autre information personnelle dans ce champ.</p>
            </div>

            <div class="milaura-atelier__step-actions" data-step-actions>
              <button class="milaura-atelier__back" type="button" data-step-back>Retour</button>
              <button class="milaura-atelier__next" type="button" data-step-next>Verifier ma composition</button>
            </div>
          </fieldset>

          <fieldset class="milaura-atelier__step" data-step="3" data-active="false">
            <legend class="milaura-atelier__step-title" tabindex="-1">
              <span>Étape 3 sur 3</span>
              Vérifiez chaque choix
            </legend>
            <p class="milaura-atelier__step-intro">Cette synthèse sera transmise à Karine avec votre commande.</p>

            <dl class="milaura-atelier__review">
              <div><dt>Taille</dt><dd data-review="size">{{ selected_variant.title | escape }}</dd></div>
              <div><dt>Palette</dt><dd data-review="palette"></dd></div>
              <div><dt>Lettres</dt><dd data-review="letter_finish"></dd></div>
              <div><dt>Mot</dt><dd data-review="word"></dd></div>
              <div><dt>Charm</dt><dd data-review="charm">Aucun</dd></div>
              <div><dt>Note</dt><dd data-review="note">Aucune</dd></div>
            </dl>

            <label class="milaura-atelier__confirmation">
              <input type="checkbox" name="properties[Atelier - Orthographe confirmée]" value="Oui" required data-spelling-confirmation>
              <span>Je confirme l'orthographe exacte du mot ci-dessus.</span>
            </label>

            <div class="milaura-atelier__submit-bar">
              <div>
                <span>Bracelet personnalisé</span>
                <strong data-summary-price>{{ selected_variant.price | money_with_currency }}</strong>
              </div>
              <button type="submit" class="milaura-atelier__submit">Ajouter au panier</button>
            </div>

            <div class="milaura-atelier__step-actions" data-step-actions>
              <button class="milaura-atelier__back" type="button" data-step-back>Modifier mes choix</button>
            </div>
          </fieldset>
        </form>
      </div>
    {%- else -%}
      {%- if section.settings.show_private_prototype -%}
        <div
          class="milaura-atelier__prototype"
          data-atelier-prototype
          data-prototype-wrist="woman"
          data-prototype-stone="06"
          data-prototype-catalog-url="{{ 'milaura-atelier-catalog.json' | asset_url }}"
          data-prototype-config-version="2026-08-17.v1"
          aria-labelledby="MilauraAtelierPrototypeTitle-{{ section.id }}"
        >
          <div class="milaura-atelier__prototype-stage">
            <div class="milaura-atelier__prototype-topline">
              <p>Sélection panier réelle</p>
              <span data-prototype-catalog-status>Chargement du catalogue</span>
            </div>

            <div class="milaura-atelier__prototype-sizing" aria-label="Gabarit du bracelet">
              <fieldset class="milaura-atelier__prototype-gauge">
                <legend>Taille du bracelet</legend>
                <div class="milaura-atelier__prototype-gauge-options">
                  <label>
                    <input
                      type="radio"
                      name="prototype-wrist-{{ section.id }}"
                      value="child"
                      data-prototype-wrist-input
                      data-prototype-label="Enfant"
                      data-prototype-measure="14 à 16 cm"
                      data-prototype-midpoint="150"
                    >
                    <span><strong>Enfant</strong><small>14 à 16 cm</small></span>
                  </label>
                  <label>
                    <input
                      type="radio"
                      name="prototype-wrist-{{ section.id }}"
                      value="woman"
                      data-prototype-wrist-input
                      data-prototype-label="Femme"
                      data-prototype-measure="16 à 18 cm"
                      data-prototype-midpoint="170"
                      checked
                    >
                    <span><strong>Femme</strong><small>16 à 18 cm</small></span>
                  </label>
                  <label>
                    <input
                      type="radio"
                      name="prototype-wrist-{{ section.id }}"
                      value="man"
                      data-prototype-wrist-input
                      data-prototype-label="Homme"
                      data-prototype-measure="18 à 20 cm"
                      data-prototype-midpoint="190"
                    >
                    <span><strong>Homme</strong><small>18 à 20 cm</small></span>
                  </label>
                </div>
              </fieldset>

              <fieldset class="milaura-atelier__prototype-gauge milaura-atelier__prototype-gauge--stone">
                <legend>Taille des pierres</legend>
                <div class="milaura-atelier__prototype-gauge-options">
                  <label>
                    <input type="radio" name="prototype-stone-{{ section.id }}" value="04" data-prototype-stone-input>
                    <span><strong>04</strong><small>mm</small></span>
                  </label>
                  <label>
                    <input type="radio" name="prototype-stone-{{ section.id }}" value="06" data-prototype-stone-input checked>
                    <span><strong>06</strong><small>mm</small></span>
                  </label>
                  <label>
                    <input type="radio" name="prototype-stone-{{ section.id }}" value="08" data-prototype-stone-input>
                    <span><strong>08</strong><small>mm</small></span>
                  </label>
                </div>
              </fieldset>
            </div>

            <div class="milaura-atelier__bracelet-board">
              <div class="milaura-atelier__bracelet-orbit" aria-hidden="true" data-prototype-orbit>
                {%- for slot_index in (1..48) -%}
                  <span class="milaura-atelier__prototype-slot" data-prototype-slot></span>
                {%- endfor -%}
              </div>
              <div class="milaura-atelier__prototype-center">
                <span>Repère de montage</span>
                <strong data-prototype-center-word>MILAURA</strong>
                <small data-prototype-spec>Femme · 16 à 18 cm · pierres 06 mm</small>
                <small data-prototype-capacity>Calcul théorique en préparation</small>
              </div>
            </div>

            <figure class="milaura-atelier__maker">
              <img
                src="{{ 'milaura-hero-proof-karine-v2.webp' | asset_url }}"
                width="160"
                height="200"
                loading="lazy"
                alt="Karine, créatrice de MilAura"
              >
              <figcaption>
                <strong>Karine</strong>
                <span>Validera le montage réel après réception.</span>
              </figcaption>
            </figure>
          </div>

          <div class="milaura-atelier__prototype-controls">
            <p class="milaura-atelier__eyebrow">Lot 4 · moteur privé</p>
            <h2 id="MilauraAtelierPrototypeTitle-{{ section.id }}">Composez avec la sélection réellement retenue.</h2>

            <div class="milaura-atelier__prototype-tabs" role="tablist" aria-label="Choix de composition à explorer">
              <button
                id="MilauraAtelierTabMessage-{{ section.id }}"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="MilauraAtelierPanelMessage-{{ section.id }}"
                data-prototype-tab="message"
              >Message</button>
              <button
                id="MilauraAtelierTabLetters-{{ section.id }}"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="MilauraAtelierPanelLetters-{{ section.id }}"
                tabindex="-1"
                data-prototype-tab="letters"
              >Lettres</button>
              <button
                id="MilauraAtelierTabPalette-{{ section.id }}"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="MilauraAtelierPanelPalette-{{ section.id }}"
                tabindex="-1"
                data-prototype-tab="palette"
              >Pierres</button>
              <button
                id="MilauraAtelierTabDetail-{{ section.id }}"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="MilauraAtelierPanelDetail-{{ section.id }}"
                tabindex="-1"
                data-prototype-tab="detail"
              >Charms</button>
            </div>

            <div
              id="MilauraAtelierPanelMessage-{{ section.id }}"
              class="milaura-atelier__prototype-panel"
              role="tabpanel"
              aria-labelledby="MilauraAtelierTabMessage-{{ section.id }}"
              data-prototype-panel="message"
            >
              <label for="MilauraAtelierPrototypeWord-{{ section.id }}">Votre mot</label>
              <input
                id="MilauraAtelierPrototypeWord-{{ section.id }}"
                type="text"
                value="MILAURA"
                maxlength="10"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                data-prototype-word-input
              >
              <div class="milaura-atelier__prototype-meta">
                <p>La présence de chaque lettre sera comptée après commande et réception. Aucun caractère n'est encore garanti.</p>
                <span data-prototype-count>7/10</span>
              </div>
              <p class="milaura-atelier__prototype-field-note" data-prototype-word-status>Mot enregistré dans cette session uniquement.</p>
            </div>

            <div
              id="MilauraAtelierPanelLetters-{{ section.id }}"
              class="milaura-atelier__prototype-panel"
              role="tabpanel"
              aria-labelledby="MilauraAtelierTabLetters-{{ section.id }}"
              data-prototype-panel="letters"
              hidden
            >
              <div class="milaura-atelier__prototype-panel-heading">
                <p class="milaura-atelier__prototype-panel-title">Choisissez une famille retenue pour tester le rythme du mot.</p>
                <span data-prototype-option-count="letter_finish">0 option</span>
              </div>
              <div class="milaura-atelier__component-tray" data-prototype-component-options="letter_finish">
                <p class="milaura-atelier__catalog-loading">Lecture de la sélection réelle…</p>
              </div>
            </div>

            <div
              id="MilauraAtelierPanelPalette-{{ section.id }}"
              class="milaura-atelier__prototype-panel"
              role="tabpanel"
              aria-labelledby="MilauraAtelierTabPalette-{{ section.id }}"
              data-prototype-panel="palette"
              hidden
            >
              <div class="milaura-atelier__prototype-panel-heading">
                <p class="milaura-atelier__prototype-panel-title">Le diamètre règle déjà la géométrie. Les pierres exactes restent à inventorier.</p>
                <span data-prototype-option-count="stone">0 option</span>
              </div>
              <div class="milaura-atelier__component-tray" data-prototype-component-options="stone"></div>
              <div class="milaura-atelier__mounting-ledger">
                <p>Montages retenus, à commander et tester</p>
                <ul data-prototype-technical-options="cord"></ul>
              </div>
            </div>

            <div
              id="MilauraAtelierPanelDetail-{{ section.id }}"
              class="milaura-atelier__prototype-panel"
              role="tabpanel"
              aria-labelledby="MilauraAtelierTabDetail-{{ section.id }}"
              data-prototype-panel="detail"
              hidden
            >
              <div class="milaura-atelier__prototype-panel-heading">
                <p class="milaura-atelier__prototype-panel-title">Explorez les détails retenus. Leur poids, leur trou et leur tenue restent à valider.</p>
                <span data-prototype-option-count="charm">0 option</span>
              </div>
              <div class="milaura-atelier__component-tray" data-prototype-component-options="charm"></div>
            </div>

            <section class="milaura-atelier__composition-summary" aria-labelledby="MilauraAtelierSummary-{{ section.id }}">
              <div class="milaura-atelier__composition-summary-heading">
                <div>
                  <p>Fiche préparée pour Karine</p>
                  <h3 id="MilauraAtelierSummary-{{ section.id }}">Composition en cours</h3>
                </div>
                <button type="button" data-prototype-reset>Recommencer</button>
              </div>
              <dl>
                <div><dt>Taille</dt><dd data-prototype-review="wrist">Femme · 16 à 18 cm</dd></div>
                <div><dt>Diamètre</dt><dd data-prototype-review="stone">06 mm</dd></div>
                <div><dt>Repère théorique</dt><dd data-prototype-review="capacity">À calculer</dd></div>
                <div><dt>Message</dt><dd data-prototype-review="word">MILAURA</dd></div>
                <div><dt>Lettres</dt><dd data-prototype-review="letter_finish">À choisir</dd></div>
                <div><dt>Charm</dt><dd data-prototype-review="charm">Aucun</dd></div>
              </dl>
              <p data-prototype-fit-note>Ce calcul sert à préparer les essais. Karine confirmera le nombre réel de composants.</p>
            </section>

            <p class="milaura-atelier__prototype-lock" role="status">
              <span aria-hidden="true"></span>
              Sélection fournisseur réelle, commande et réception à confirmer. Stock MilAura, compatibilité, prix public et ajout au panier restent verrouillés.
            </p>
            <p class="visually-hidden" aria-live="polite" data-prototype-live></p>
          </div>
        </div>
      {%- else -%}
        <div class="milaura-atelier__locked" role="status">
          <p class="milaura-atelier__locked-label">Composition en ligne en préparation</p>
          <h2>Chaque option doit d'abord être vérifiée dans l'atelier.</h2>
          <p>Le configurateur ouvrira lorsque les composants, les tailles et les règles de montage du bracelet pilote seront confirmés. Aucun choix provisoire ne vous est présenté comme disponible.</p>
        </div>
      {%- endif -%}

      <div class="milaura-atelier__setup{% unless request.design_mode %} visually-hidden{% endunless %}">
        {%- if request.design_mode -%}
          <h3>Configuration requise dans l'éditeur</h3>
          <ul>
            {%- if pilot_product == blank -%}<li>Sélectionner le produit Shopify pilote.</li>{%- endif -%}
            {%- if available_variant_count == 0 -%}<li>Vérifier qu'une variante du produit est disponible.</li>{%- endif -%}
            {%- if section.settings.max_characters < 1 -%}<li>Définir une limite de caractères validée par Karine.</li>{%- endif -%}
            {%- if palette_count == 0 -%}<li>Ajouter une palette disponible, identifiée et compatible.</li>{%- endif -%}
            {%- if letter_finish_count == 0 -%}<li>Ajouter une finition de lettres disponible, identifiée et compatible.</li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="milaura-atelier__services" aria-labelledby="MilauraAtelierServices-{{ section.id }}">
      <div class="milaura-atelier__services-heading">
        <p class="milaura-atelier__eyebrow">Trois façons d'avancer</p>
        <h2 id="MilauraAtelierServices-{{ section.id }}">Le bon niveau d'accompagnement</h2>
      </div>
      <div class="milaura-atelier__service-list">
        <article class="milaura-atelier__service is-primary">
          <p>01</p>
          <h3>Composer mon bracelet</h3>
          <p>Un modèle pilote, des choix bornés et une configuration transmise avec la commande.</p>
          <span>{% if configuration_ready %}Disponible en ligne{% else %}Ouverture après validation atelier{% endif %}</span>
        </article>
        <article class="milaura-atelier__service">
          <p>02</p>
          <h3>Être guidée par Karine</h3>
          <p>Vous décrivez votre intention. Karine vérifie ensuite ce qui est réalisable avec les composants présents.</p>
          {%- if section.settings.guided_request_link != blank -%}
            <a href="{{ section.settings.guided_request_link }}">Décrire mon projet</a>
          {%- else -%}
            <span>Demande guidée bientôt disponible</span>
          {%- endif -%}
        </article>
        <article class="milaura-atelier__service">
          <p>03</p>
          <h3>Imaginer une pièce singulière</h3>
          <p>Une demande particulière est étudiée avant tout accord de prix, de matière ou de délai.</p>
          {%- if section.settings.bespoke_request_link != blank -%}
            <a href="{{ section.settings.bespoke_request_link }}">Presenter ma demande</a>
          {%- else -%}
            <span>Étude sur demande</span>
          {%- endif -%}
        </article>
      </div>
    </div>
  </div>
</section>

