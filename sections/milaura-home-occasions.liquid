{{ 'milaura-home-occasions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign occasion_count = 0
  for block in section.blocks
    if block.type == 'occasion'
      assign occasion_count = occasion_count | plus: 1
    endif
  endfor
-%}

{%- if occasion_count > 0 -%}
  {% render 'milaura-home-transition', tone: 'nacre' %}
  <section
    id="MilauraHomeOccasions-{{ section.id }}"
    class="milaura-home-occasions"
    aria-labelledby="MilauraHomeOccasionsTitle-{{ section.id }}"
  >
    <div class="milaura-home-occasions__inner">
      <header class="milaura-home-occasions__header milaura-section-intro">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="milaura-home-occasions__eyebrow milaura-section-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="MilauraHomeOccasionsTitle-{{ section.id }}" class="milaura-home-occasions__title milaura-section-title">
            {{ section.settings.title | escape }}
          </h2>
        </div>
        {%- if section.settings.lead != blank -%}
          <p class="milaura-home-occasions__lead">{{ section.settings.lead | escape }}</p>
        {%- endif -%}
      </header>

      <div
        class="milaura-home-occasions__cards"
        role="list"
        aria-label="Guides cadeaux MilAura"
      >
        {%- assign card_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'occasion' -%}
            {%- liquid
              assign card_index = card_index | plus: 1
              assign card_number = card_index | prepend: '0' | slice: -2, 2
              assign loading_mode = 'lazy'
              if card_index == 1
                assign loading_mode = 'eager'
              endif
            -%}
            <article
              class="milaura-home-occasions__card"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <a class="milaura-home-occasions__card-link" href="{{ block.settings.link }}">
                <span class="milaura-home-occasions__card-heading">
                  <span class="milaura-home-occasions__card-number" aria-hidden="true">{{ card_number }}</span>
                  <h3 class="milaura-home-occasions__card-title">{{ block.settings.title | escape }}</h3>
                </span>
                <span class="milaura-home-occasions__card-media">
                  {%- if block.settings.image != blank -%}
                    {{- block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'milaura-home-occasions__card-image',
                        widths: '420, 640, 840, 1100, 1400, 1600',
                        sizes: '(max-width: 749px) calc(100vw - 74px), (max-width: 989px) 46vw, 42vw',
                        loading: loading_mode,
                        alt: block.settings.image_alt
                    -}}
                  {%- elsif block.settings.desktop_asset != blank -%}
                    <picture>
                      {%- if block.settings.mobile_asset != blank -%}
                        <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_asset | asset_url }}">
                      {%- endif -%}
                      <img
                        class="milaura-home-occasions__card-image"
                        src="{{ block.settings.desktop_asset | asset_url }}"
                        alt="{{ block.settings.image_alt | escape }}"
                        width="1254"
                        height="1254"
                        loading="{{ loading_mode }}"
                        decoding="async"
                      >
                    </picture>
                  {%- endif -%}
                </span>
                <span class="milaura-home-occasions__card-footer">
                  <span class="milaura-home-occasions__action milaura-action milaura-action--editorial">
                    <span>{{ block.settings.action | escape }}</span>
                    {% render 'milaura-action-icon' %}
                  </span>
                </span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MilAura occasions",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Offrir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Un bijou pour marquer une date."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Deux guides pour relier une pierre à un mois de naissance ou à un anniversaire de mariage."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Choisir selon le mois"
        },
        {
          "type": "text",
          "id": "action",
          "label": "Action",
          "default": "Voir le guide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photographie"
        },
        {
          "type": "text",
          "id": "desktop_asset",
          "label": "Asset desktop de repli"
        },
        {
          "type": "text",
          "id": "mobile_asset",
          "label": "Asset mobile de repli"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texte alternatif"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MilAura occasions",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
