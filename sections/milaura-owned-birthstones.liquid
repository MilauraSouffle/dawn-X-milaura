{{ 'milaura-owned-stone-guides.css' | asset_url | stylesheet_tag }}

{%- assign title_id = 'MilauraOwnedBirthstonesTitle-' | append: section.id -%}

<div class="milaura-owned">
  <header class="milaura-owned__header milaura-owned__shell" aria-labelledby="{{ title_id }}">
    <h1 id="{{ title_id }}">{{ section.settings.heading | escape }}</h1>
    <p class="milaura-owned__intro">{{ section.settings.introduction | escape }}</p>
    <p class="milaura-owned__notice"><strong>Comment lire ce calendrier :</strong> chaque mois reprend la liste moderne publiée par le GIA. Les traditions peuvent varier selon les pays et les époques.</p>
  </header>

  <section class="milaura-owned__section milaura-owned__shell" aria-label="Les douze mois et leurs pierres">
    {% render 'milaura-owned-birth-months' %}
  </section>

  <section class="milaura-owned__sources milaura-owned__shell">
    <h2>Source</h2>
    <p>Les correspondances mois et pierres sont reprises de la liste du Gemological Institute of America, consultée le 2026-09-10. Les liens MilAura apparaissent uniquement lorsqu une sélection correspondante existe.</p>
    <ul><li><a href="https://www.gia.edu/birthstones">GIA, Birthstones for each month</a></li></ul>
  </section>
</div>

{% schema %}
{
  "name": "Pierres de naissance",
  "tag": "section",
  "class": "section-milaura-owned-birthstones",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pierres de naissance, mois par mois" },
    { "type": "textarea", "id": "introduction", "label": "Introduction", "default": "Choisissez un mois pour connaître ses pierres de naissance. Quand une pierre est présente chez MilAura, le calendrier vous conduit directement vers la sélection correspondante." }
  ],
  "presets": [{ "name": "Pierres de naissance" }]
}
{% endschema %}
