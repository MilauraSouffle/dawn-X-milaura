{%- liquid
  assign hero_eyebrow = section.settings.eyebrow | default: 'Bijoux & minéraux naturels'
  assign hero_signature = section.settings.signature | default: 'MilAura'
  assign hero_title_first = section.settings.title_first | default: 'La beauté des bijoux'
  assign hero_title_second = section.settings.title_second | default: 'rencontre la lithothérapie.'
  assign hero_body = section.settings.body | default: 'Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
  assign proof_1_label = section.settings.proof_1 | default: 'Pierres certifiées'
  assign proof_2_label = section.settings.proof_2 | default: 'Préparées par Karine'
  assign proof_3_label = section.settings.proof_3 | default: 'Expédiées depuis Metz'

  if proof_1_label == 'Pierres naturelles certifiées'
    assign proof_1_label = 'Pierres certifiées'
  endif

  if proof_3_label == 'Expédiées depuis notre atelier en France'
    assign proof_3_label = 'Expédiées depuis Metz'
  endif

  assign stone_link = section.settings.stone_link | default: '/pages/bijoux-par-pierre'
  assign jewelry_link = section.settings.jewelry_link | default: '/collections/bijoux-pierres-naturelles'
  assign guide_link = section.settings.guide_link | default: '/pages/diagnostic-emotionnel'

  if hero_body == blank or hero_body == 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
    assign hero_body = 'Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
  endif
-%}

{%- style -%}
  #MainContent > .shopify-section.milaura-hero-homepage {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    overflow: visible;
    background: var(--milaura-aigue-profonde);
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .shopify-section {
    margin-top: 0;
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .shopify-section::before {
    content: none !important;
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
    padding-top: clamp(48px, 4.2vw, 62px) !important;
  }

  #MilauraPortal-{{ section.id }} {
    position: relative;
    min-height: calc(100svh - var(--milaura-announcement-height, 48px));
    overflow: hidden;
    isolation: isolate;
    color: var(--milaura-nacre);
    background: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides,
  #MilauraPortal-{{ section.id }} .portal-hero__media,
  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    position: absolute;
    inset: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides {
    z-index: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media {
    visibility: hidden;
    opacity: 0;
    transform: scale(1.012);
    transition:
      opacity 700ms ease,
      transform 1400ms cubic-bezier(0.2, 0.75, 0.2, 1),
      visibility 0s linear 700ms;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    z-index: 1;
    background: var(--milaura-aigue-profonde);
    opacity: 0.13;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: relative;
    z-index: 2;
    width: min(620px, 46vw);
    padding-top: calc(84px + clamp(72px, 11svh, 128px));
    margin-left: clamp(48px, 7vw, 112px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity {
    display: flex;
    align-items: center;
    gap: var(--milaura-esp-xs);
    margin: 0 0 var(--milaura-esp-sm);
    white-space: nowrap;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
    margin: 0;
    color: var(--milaura-nacre);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity-rule {
    display: block;
    width: 32px;
    height: 1px;
    flex: 0 0 auto;
    background: var(--milaura-or);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__signature {
    margin: 0;
    color: var(--milaura-or-clair);
    font-family: var(--milaura-font-signature);
    font-size: clamp(27px, 2.1vw, 35px);
    font-weight: 600;
    line-height: 1;
    transform: rotate(-1.3deg);
    transform-origin: left center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 610px;
    margin: 0;
    color: var(--milaura-nacre);
    font-family: var(--milaura-font-display);
    font-size: clamp(52px, 5vw, 76px);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: -0.035em;
    line-height: 0.99;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title-line {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 530px;
    margin: var(--milaura-esp-md) 0 0;
    color: var(--milaura-nacre);
    font-size: clamp(15px, 1.25vw, 18px);
    font-weight: 400;
    letter-spacing: 0.004em;
    line-height: 1.55;
    opacity: 0.9;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__journeys {
    position: absolute;
    z-index: 3;
    bottom: 10px;
    left: clamp(48px, 7vw, 112px);
    display: grid;
    width: min(810px, 56vw);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #MilauraPortal-{{ section.id }} .portal-hero__journeys::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--milaura-nacre);
    content: '';
    opacity: 0.38;
  }

  #MilauraPortal-{{ section.id }} .portal-journey {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 74px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--milaura-esp-xs);
    padding: var(--milaura-esp-sm) 18px var(--milaura-esp-xs) 0;
    color: var(--milaura-nacre);
    text-align: left;
    text-decoration: none;
    opacity: 0.82;
    transition:
      color var(--milaura-transition-rapide),
      opacity var(--milaura-transition-rapide);
  }

  #MilauraPortal-{{ section.id }} .portal-journey + .portal-journey {
    padding-left: 22px;
  }

  #MilauraPortal-{{ section.id }} .portal-journey + .portal-journey::after {
    position: absolute;
    inset: var(--milaura-esp-sm) auto var(--milaura-esp-xs) 0;
    width: 1px;
    background: var(--milaura-nacre);
    content: '';
    opacity: 0.18;
  }

  #MilauraPortal-{{ section.id }} .portal-journey::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--milaura-or);
    content: '';
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity 220ms ease,
      transform 420ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  #MilauraPortal-{{ section.id }} .portal-journey.is-active,
  #MilauraPortal-{{ section.id }} .portal-journey:focus-visible {
    opacity: 1;
  }

  #MilauraPortal-{{ section.id }} .portal-journey:hover,
  #MilauraPortal-{{ section.id }} .portal-journey:focus-visible {
    color: var(--milaura-or-clair);
    opacity: 1;
  }

  #MilauraPortal-{{ section.id }} .portal-journey.is-active::before {
    opacity: 1;
    transform: scaleX(1);
  }

  #MilauraPortal-{{ section.id }} .portal-journey:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: var(--milaura-focus-offset);
  }

  #MilauraPortal-{{ section.id }} .portal-journey__index {
    color: var(--milaura-or);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  #MilauraPortal-{{ section.id }} .portal-journey__label {
    font-family: var(--milaura-font-display);
    font-size: clamp(17px, 1.45vw, 21px);
    letter-spacing: -0.01em;
    line-height: 1.12;
    text-shadow: 0 2px 18px var(--milaura-aigue-profonde);
  }

  #MilauraPortal-{{ section.id }} .portal-journey__label--short {
    display: none;
  }

  #MilauraPortal-{{ section.id }} .portal-journey__arrow {
    color: var(--milaura-or);
    font-size: 18px;
    line-height: 1;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--milaura-transition-rapide),
      transform var(--milaura-transition-rapide);
  }

  #MilauraPortal-{{ section.id }} .portal-journey.is-active .portal-journey__arrow,
  #MilauraPortal-{{ section.id }} .portal-journey:hover .portal-journey__arrow,
  #MilauraPortal-{{ section.id }} .portal-journey:focus-visible .portal-journey__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  #shopify-section-{{ section.id }} .portal-proof-bridge {
    position: absolute;
    bottom: 0;
    left: clamp(40px, 7vw, 112px);
    z-index: 4;
    display: grid;
    width: min(760px, 58vw);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 4vw, 58px);
    padding: 0 var(--milaura-esp-sm);
    color: var(--milaura-prune);
    pointer-events: none;
    transform: translateY(84%);
  }

  #shopify-section-{{ section.id }} .portal-proof {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: var(--milaura-esp-2xs);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .portal-proof--karine {
    transform: translateY(-10px);
  }

  #shopify-section-{{ section.id }} .portal-proof--atelier {
    transform: translateY(7px);
  }

  #shopify-section-{{ section.id }} .portal-proof__media {
    --proof-shape: 48% 52% 47% 53% / 52% 46% 54% 48%;
    position: relative;
    width: clamp(88px, 7vw, 106px);
    aspect-ratio: 1;
    isolation: isolate;
  }

  #shopify-section-{{ section.id }} .portal-proof--karine .portal-proof__media {
    --proof-shape: 52% 48% 54% 46% / 47% 53% 49% 51%;
    width: clamp(98px, 7.8vw, 116px);
  }

  #shopify-section-{{ section.id }} .portal-proof--atelier .portal-proof__media {
    --proof-shape: 46% 54% 50% 50% / 55% 45% 53% 47%;
  }

  #shopify-section-{{ section.id }} .portal-proof__outline,
  #shopify-section-{{ section.id }} .portal-proof__image-wrap {
    position: absolute;
    border-radius: var(--proof-shape);
  }

  #shopify-section-{{ section.id }} .portal-proof__outline {
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .portal-proof__outline--gold {
    inset: 6px -5px -4px 7px;
    border: var(--milaura-filet-or);
    transform: rotate(3deg);
  }

  #shopify-section-{{ section.id }} .portal-proof__outline--aqua {
    inset: -5px 7px 6px -5px;
    border: var(--milaura-filet-mineral);
    transform: rotate(-2.5deg);
  }

  #shopify-section-{{ section.id }} .portal-proof__image-wrap {
    inset: 0;
    z-index: 2;
    overflow: hidden;
    border: 1px solid var(--milaura-nacre);
    background: var(--milaura-nacre);
    box-shadow: var(--milaura-ombre-douce);
  }

  #shopify-section-{{ section.id }} .portal-proof__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .portal-proof--certificate .portal-proof__image {
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .portal-proof--karine .portal-proof__image {
    object-position: 50% 34%;
  }

  #shopify-section-{{ section.id }} .portal-proof--atelier .portal-proof__image {
    object-position: 48% 60%;
    transform: scale(1.14);
  }

  #shopify-section-{{ section.id }} .portal-proof__copy,
  #shopify-section-{{ section.id }} .portal-proof__title,
  #shopify-section-{{ section.id }} .portal-proof__detail {
    display: block;
  }

  #shopify-section-{{ section.id }} .portal-proof__title {
    color: var(--milaura-prune);
    font-size: clamp(12px, 0.95vw, 14px);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .portal-proof__detail {
    margin-top: 3px;
    color: var(--milaura-aigue-profonde);
    font-size: clamp(9px, 0.7vw, 10px);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* La navigation conserve ses liens et ses fonctions. Seule sa surface
     devient editoriale et reste aigue-marine sur la homepage. */
  [id^='MilauraNav-'].milaura-home-hero-nav {
    padding: 0 !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper {
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    animation: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper::before {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
    min-height: 84px !important;
    padding: 0 clamp(32px, 5.5vw, 88px) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-mineral) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition:
      background-color var(--milaura-transition-rapide),
      box-shadow var(--milaura-transition-rapide);
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
    height: 50px !important;
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    color: var(--milaura-nacre) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link--nouveautes::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    min-height: var(--milaura-cible-tactile) !important;
    padding: var(--milaura-esp-xs) var(--milaura-esp-sm) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-or) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::before,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
    color: inherit !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-inner {
    background: var(--milaura-aigue-ecume) !important;
    box-shadow: var(--milaura-ombre-douce) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-quiz-badge {
    color: var(--milaura-prune) !important;
  }

  @media screen and (max-width: 1100px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-tablet, 88px) * -1) !important;
    }
  }

  @media screen and (max-width: 820px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-mobile, 80px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      min-height: calc(100svh - var(--milaura-announcement-height, 52px));
    }

    #MilauraPortal-{{ section.id }} .portal-hero__veil {
      opacity: 0.12;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: auto;
      padding-top: calc(62px + clamp(25px, 4.2svh, 36px));
      margin: 0 22px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__identity {
      gap: 9px;
      margin-bottom: var(--milaura-esp-xs);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
      font-size: 9px;
      letter-spacing: 0.125em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__identity-rule {
      width: 22px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__signature {
      font-size: clamp(22px, 5.8vw, 25px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 350px;
      font-size: clamp(37px, 10vw, 39px);
      line-height: 0.98;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 310px;
      margin: 10px 0 0;
      font-size: 11.7px;
      line-height: 1.38;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__journeys {
      top: clamp(370px, 45svh, 390px);
      right: 18px;
      bottom: auto;
      left: 18px;
      width: auto;
    }

    #shopify-section-{{ section.id }} .portal-proof-bridge {
      right: 12px;
      left: 12px;
      width: auto;
      gap: 7px;
      padding: 0 3px;
      transform: translateY(61%);
    }

    #shopify-section-{{ section.id }} .portal-proof {
      gap: 5px;
    }

    #shopify-section-{{ section.id }} .portal-proof--karine {
      transform: translateY(-7px);
    }

    #shopify-section-{{ section.id }} .portal-proof--atelier {
      transform: translateY(6px);
    }

    #shopify-section-{{ section.id }} .portal-proof__media {
      width: clamp(64px, 18vw, 76px);
    }

    #shopify-section-{{ section.id }} .portal-proof--karine .portal-proof__media {
      width: clamp(72px, 20.5vw, 86px);
    }

    #shopify-section-{{ section.id }} .portal-proof__title {
      font-size: clamp(10px, 2.8vw, 12px);
    }

    #shopify-section-{{ section.id }} .portal-proof__detail {
      margin-top: 2px;
      font-size: clamp(7.5px, 2.15vw, 9px);
      letter-spacing: 0.055em;
    }

    #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
      padding-top: 42px !important;
    }

    #MilauraPortal-{{ section.id }} .portal-journey {
      min-height: 46px;
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: 0;
      justify-items: center;
      padding: var(--milaura-esp-2xs) 2px 6px;
      text-align: center;
    }

    #MilauraPortal-{{ section.id }} .portal-journey + .portal-journey {
      padding-left: 2px;
    }

    #MilauraPortal-{{ section.id }} .portal-journey + .portal-journey::after {
      inset: var(--milaura-esp-2xs) auto 6px 0;
    }

    #MilauraPortal-{{ section.id }} .portal-journey__index,
    #MilauraPortal-{{ section.id }} .portal-journey__label--long,
    #MilauraPortal-{{ section.id }} .portal-journey__arrow {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-journey__label--short {
      display: inline;
    }

    #MilauraPortal-{{ section.id }} .portal-journey__label {
      font-size: clamp(12.5px, 3.6vw, 14px);
      line-height: 1.08;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      height: 62px !important;
      min-height: 62px !important;
      padding: 0 18px !important;
      gap: var(--milaura-esp-xs);
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 64px !important;
      min-height: 62px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 48px !important;
      transform: none !important;
      filter: none !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      min-height: var(--milaura-cible-tactile) !important;
      padding: 10px var(--milaura-esp-xs) !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 10px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
      filter: none !important;
    }
  }

  @media screen and (max-width: 480px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: -74px !important;
    }
  }

  @media screen and (max-width: 360px) {
