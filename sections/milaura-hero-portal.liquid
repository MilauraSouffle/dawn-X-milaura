{%- liquid
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = '#MilauraSelectionAtelier'
  endif

  assign triptych_product_1 = section.settings.triptych_product_1
  if triptych_product_1 == blank
    assign triptych_product_1 = all_products['collier-obsidienne-noire-boho-dore']
  endif
  assign triptych_product_2 = section.settings.triptych_product_2
  if triptych_product_2 == blank
    assign triptych_product_2 = all_products['bracelet-oeil-de-tigre-cuir-brun']
  endif
  assign triptych_product_3 = section.settings.triptych_product_3
  if triptych_product_3 == blank
    assign triptych_product_3 = all_products['collier-agate-arbre']
  endif
  assign triptych_product_4 = section.settings.triptych_product_4
  if triptych_product_4 == blank
    assign triptych_product_4 = all_products['pendentif-argent-925-rhodie-modele-05-amethyste-facettee-bre']
  endif
  assign triptych_product_5 = section.settings.triptych_product_5
  if triptych_product_5 == blank
    assign triptych_product_5 = all_products['pendentif-amazonite']
  endif
  assign triptych_product_6 = section.settings.triptych_product_6
  if triptych_product_6 == blank
    assign triptych_product_6 = all_products['bougie-reconfort-neroli-calcedoine']
  endif
  assign triptych_product_7 = section.settings.triptych_product_7
  if triptych_product_7 == blank
    assign triptych_product_7 = all_products['savon-argan-1-piece']
  endif
  assign triptych_product_8 = section.settings.triptych_product_8
  if triptych_product_8 == blank
    assign triptych_product_8 = all_products['bol-chantant-120mm-1-piece']
  endif
  assign triptych_product_9 = section.settings.triptych_product_9
  if triptych_product_9 == blank
    assign triptych_product_9 = all_products['distributeur-savon-lapis-lazuli']
  endif

  assign triptych_photo_1_index = section.settings.triptych_photo_1 | default: 2 | minus: 1
  assign triptych_photo_2_index = section.settings.triptych_photo_2 | default: 2 | minus: 1
  assign triptych_photo_3_index = section.settings.triptych_photo_3 | default: 1 | minus: 1
  assign triptych_photo_4_index = section.settings.triptych_photo_4 | default: 1 | minus: 1
  assign triptych_photo_5_index = section.settings.triptych_photo_5 | default: 1 | minus: 1
  assign triptych_photo_6_index = section.settings.triptych_photo_6 | default: 1 | minus: 1
  assign triptych_photo_7_index = section.settings.triptych_photo_7 | default: 1 | minus: 1
  assign triptych_photo_8_index = section.settings.triptych_photo_8 | default: 1 | minus: 1
  assign triptych_photo_9_index = section.settings.triptych_photo_9 | default: 1 | minus: 1

  assign triptych_image_1 = triptych_product_1.images[triptych_photo_1_index] | default: triptych_product_1.featured_image
  assign triptych_image_2 = triptych_product_2.images[triptych_photo_2_index] | default: triptych_product_2.featured_image
  assign triptych_image_3 = triptych_product_3.images[triptych_photo_3_index] | default: triptych_product_3.featured_image
  assign triptych_image_4 = triptych_product_4.images[triptych_photo_4_index] | default: triptych_product_4.featured_image
  assign triptych_image_5 = triptych_product_5.images[triptych_photo_5_index] | default: triptych_product_5.featured_image
  assign triptych_image_6 = triptych_product_6.images[triptych_photo_6_index] | default: triptych_product_6.featured_image
  assign triptych_image_7 = triptych_product_7.images[triptych_photo_7_index] | default: triptych_product_7.featured_image
  assign triptych_image_8 = triptych_product_8.images[triptych_photo_8_index] | default: triptych_product_8.featured_image
  assign triptych_image_9 = triptych_product_9.images[triptych_photo_9_index] | default: triptych_product_9.featured_image

  assign triptych_interval = section.settings.triptych_interval | default: 4 | times: 1000
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Dancing';
    src: url('{{ 'milaura-dancing-script-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MilauraPortal-{{ section.id }} {
    --portal-nacre: #fbf8f3;
    --portal-paper: #fffdf9;
    --portal-ink: #2f222d;
    --portal-gold: #b9975b;
    --portal-aqua: #6fa9a6;
    --portal-aqua-deep: #3f7474;
    --portal-aqua-soft: #dce9e7;
    --portal-quartz: #d7b8b1;
    --portal-amethyst: #7a4d82;
    --portal-header-overlap: 0px;
    --portal-base-height: clamp(690px, calc(100svh - 148px), 860px);
    position: relative;
    isolation: isolate;
    min-height: calc(var(--portal-base-height) + var(--portal-header-overlap));
    overflow: hidden;
    color: var(--portal-ink);
    background: var(--portal-nacre);
    font-family: 'MilAura Instrument', sans-serif;
  }

  @media screen and (min-width: 1101px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      --portal-header-overlap: var(--header-height-desktop, 110px);
    }
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__stage {
    position: relative;
    width: min(100%, 1680px);
    min-height: inherit;
    margin: 0 auto;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: absolute;
    top: calc(50% + (var(--portal-header-overlap) / 2));
    left: clamp(42px, 6vw, 104px);
    z-index: 3;
    width: min(46%, 690px);
    transform: translateY(-50%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker {
    display: block;
    margin: 0 0 16px;
    color: var(--portal-amethyst);
    font-family: 'MilAura Dancing', cursive;
    font-size: clamp(2.125rem, 2.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
    content: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 690px;
    margin: 0;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(3.35rem, 4.15vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.94;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.2vw, 18px);
    width: max-content;
    max-width: 100%;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone {
    margin-top: 5px;
    margin-left: clamp(24px, 3vw, 50px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-text {
    display: block;
    min-width: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__equation-text {
    color: var(--portal-aqua-deep);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator {
    position: relative;
    flex: 0 0 auto;
    width: clamp(42px, 3.5vw, 52px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(185, 151, 91, 0.86);
    border-radius: 48% 52% 45% 55%;
    color: #fffaf2;
    font-family: 'MilAura Instrument', sans-serif;
    font-size: 0.38em;
    font-weight: 720;
    letter-spacing: 0;
    line-height: 1;
    text-shadow: 0 1px 5px rgba(47, 34, 45, 0.38);
    box-shadow:
      0 9px 24px rgba(72, 40, 78, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 0.72);
    transform: rotate(5deg);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: inherit;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator--plus {
    background:
      radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.92) 0 6%, transparent 18%),
      radial-gradient(circle at 38% 32%, #cfaed8 0, #8a5c91 42%, #4d2b52 100%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator--equals {
    background:
      radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.9) 0 6%, transparent 18%),
      radial-gradient(circle at 40% 34%, #b9dfda 0, #6fa9a6 44%, #376867 100%);
    transform: rotate(-5deg);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__result {
    display: flex;
    align-items: baseline;
    gap: 0.18em;
    margin-top: 10px;
    margin-left: clamp(54px, 7vw, 108px);
    color: var(--portal-amethyst);
    font-family: 'MilAura Instrument', sans-serif;
    font-size: 0.48em;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__result-brand {
    font-family: 'MilAura Dancing', cursive;
    font-size: 1.42em;
    font-weight: 650;
    letter-spacing: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 48ch;
    margin: clamp(18px, 1.6vw, 24px) 0 0;
    color: rgba(47, 34, 45, 0.84);
    font-size: clamp(1.1875rem, 1.2vw, 1.3125rem);
    font-weight: 460;
    letter-spacing: -0.012em;
    line-height: 1.5;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 24px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 10px 11px 10px 25px;
    border: 1px solid var(--portal-ink);
    border-radius: 999px;
    color: var(--portal-paper);
    background: var(--portal-ink);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 14px 30px rgba(47, 34, 45, 0.16);
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover {
    color: var(--portal-ink);
    background: transparent;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px rgba(47, 34, 45, 0.12);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary-icon {
    width: 34px;
    height: 34px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: var(--portal-ink);
    background: var(--portal-gold);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover .portal-hero__primary-icon {
    transform: translateX(3px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:focus-visible {
    outline: 2px solid var(--portal-aqua);
    outline-offset: 5px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof-card {
    display: grid;
    gap: 5px;
    max-width: 35rem;
    margin: 24px 0 0;
    padding: 13px 17px 13px 20px;
    border-left: 2px solid var(--portal-gold);
    border-radius: 0 14px 14px 0;
    color: rgba(47, 34, 45, 0.84);
    background: linear-gradient(90deg, rgba(185, 151, 91, 0.11), rgba(255, 253, 249, 0.2));
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof-label {
    color: #725927;
    font-size: 0.76rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof-text {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    line-height: 1.42;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 58%;
    display: grid;
    grid-template-columns: 0.84fr 1.04fr 0.92fr;
    gap: 6px;
    padding-left: 28px;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 1px;
    background: rgba(185, 151, 91, 0.46);
    transform: rotate(5deg) scaleY(1.08);
    transform-origin: center;
  }

  #MilauraPortal-{{ section.id }} .portal-facet {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    background: #e7e1d8;
    animation: milauraFacetSettle 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--facet-order) * 90ms);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand {
    top: 7%;
    height: 93%;
    clip-path: polygon(12% 0, 100% 4%, 91% 100%, 0 94%, 5% 46%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck {
    height: 96%;
    clip-path: polygon(14% 0, 100% 0, 93% 91%, 81% 100%, 0 96%, 7% 43%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--object {
    top: 4%;
    height: 96%;
    clip-path: polygon(9% 3%, 100% 0, 100% 100%, 0 94%, 6% 52%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.065);
    transition:
      opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1.035);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand .portal-facet__image {
    object-position: var(--image-position, var(--panel-position, 50% 50%));
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck .portal-facet__image {
    object-position: var(--image-position, var(--panel-position, 50% 50%));
  }

  #MilauraPortal-{{ section.id }} .portal-facet--object .portal-facet__image {
    object-position: var(--image-position, var(--panel-position, 50% 50%));
  }

  #MilauraPortal-{{ section.id }} .portal-facet__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 253, 249, 0.26);
  }

  @keyframes milauraFacetSettle {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 1100px) and (min-width: 768px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 760px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      left: 42px;
      width: 49%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: clamp(3.1rem, 5.8vw, 4.4rem);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      width: 55%;
      padding-left: 16px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proof-card {
      max-width: 31rem;
    }
  }

  @media screen and (max-width: 767px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 0;
      overflow: visible;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__stage {
      min-height: 0;
      padding-bottom: 28px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      position: relative;
      width: 100%;
      height: clamp(270px, 34svh, 315px);
      grid-template-columns: 0.86fr 1.05fr 0.89fr;
      gap: 4px;
      padding-left: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--hand {
      top: 0;
      height: 94%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--neck {
      top: 3%;
      height: 97%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--object {
      top: 0;
      height: 95%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      padding: 12px 20px 0;
      transform: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker {
      margin-bottom: 10px;
      font-size: clamp(1.875rem, 8.2vw, 2.25rem);
      line-height: 1.08;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: none;
      font-size: clamp(2.55rem, 10.2vw, 3.15rem);
      line-height: 0.96;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__equation-row {
      gap: 9px;
      width: 100%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone {
      margin-top: 4px;
      margin-left: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__operator {
      width: 36px;
      font-size: 0.38em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__result {
      margin-top: 8px;
      margin-left: 34px;
      font-size: 0.48em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 46ch;
      margin-top: 16px;
      font-size: 1.125rem;
      line-height: 1.5;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__actions {
      display: grid;
      gap: 13px;
      margin-top: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      width: 100%;
      min-height: 48px;
      padding: 8px 9px 8px 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proof-card {
      margin-top: 18px;
      padding: 12px 14px 12px 17px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proof-text {
      font-size: 0.94rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-facet {
      animation: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      transition: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet__image {
      transition: none;
    }
  }
{%- endstyle -%}

<div
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  data-triptych-interval="{{ triptych_interval }}"
>
  <div class="portal-hero__stage">
    <div class="portal-hero__visual" aria-hidden="true">
      <div
        class="portal-facet portal-facet--hand"
        style="--facet-order: 1; --panel-position: {{ section.settings.panel_hand_position | default: '50% 50%' }};"
        data-triptych-panel
      >
        {% render 'milaura-triptych-image', image: triptych_image_1, product: triptych_product_1, is_active: true, loading: 'eager', fetchpriority: 'high', position: section.settings.panel_hand_position, fallback_asset: 'milaura-hero-aventurine-halo-worn-v1.webp' %}
        {% render 'milaura-triptych-image', image: triptych_image_2, product: triptych_product_2, position: section.settings.panel_hand_position %}
        {% render 'milaura-triptych-image', image: triptych_image_3, product: triptych_product_3, position: section.settings.panel_hand_position %}
        <span class="portal-facet__veil"></span>
      </div>

      <div
        class="portal-facet portal-facet--neck"
        style="--facet-order: 2; --panel-position: {{ section.settings.panel_neck_position | default: '50% 50%' }};"
        data-triptych-panel
      >
        {% render 'milaura-triptych-image', image: triptych_image_4, product: triptych_product_4, is_active: true, loading: 'eager', fetchpriority: 'auto', position: section.settings.panel_neck_position, fallback_asset: 'milaura-hero-quartz-rose-boho-worn-v1.webp' %}
        {% render 'milaura-triptych-image', image: triptych_image_5, product: triptych_product_5, position: section.settings.panel_neck_position %}
        {% render 'milaura-triptych-image', image: triptych_image_6, product: triptych_product_6, position: section.settings.panel_neck_position %}
        <span class="portal-facet__veil"></span>
      </div>

      <div
        class="portal-facet portal-facet--object"
        style="--facet-order: 3; --panel-position: {{ section.settings.panel_ear_position | default: '50% 50%' }};"
        data-triptych-panel
      >
        {% render 'milaura-triptych-image', image: triptych_image_7, product: triptych_product_7, is_active: true, loading: 'eager', fetchpriority: 'auto', position: section.settings.panel_ear_position, fallback_asset: 'milaura-hero-soap-amethyst-v1.webp' %}
        {% render 'milaura-triptych-image', image: triptych_image_8, product: triptych_product_8, position: section.settings.panel_ear_position %}
        {% render 'milaura-triptych-image', image: triptych_image_9, product: triptych_product_9, position: section.settings.panel_ear_position %}
