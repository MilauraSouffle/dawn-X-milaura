{%- liquid
  assign hero_eyebrow = section.settings.eyebrow | default: 'Bijoux en pierres naturelles'
  assign hero_title_first = section.settings.title_first | default: 'Vos émotions'
  assign hero_title_second = section.settings.title_second | default: 'ont du style.'
  assign hero_body_standard = 'Choisissez votre bijou, votre pierre et ses vertus.'
  assign hero_body = section.settings.body | default: hero_body_standard
  assign hero_desktop_asset = section.settings.desktop_asset | default: 'milaura-home-hero-fashion-chloe-parure-desktop-v3b.webp'
  assign hero_mobile_asset = section.settings.mobile_asset | default: 'milaura-home-hero-fashion-chloe-parure-mobile-v4.webp'
  assign hero_image_alt = section.settings.image_alt | default: 'Chloé porte un collier en aigue-marine, un bracelet en améthyste, une bague en sodalite et des boucles en agate'
  assign hero_cta_label = section.settings.cta_label | default: 'Voir tous les bijoux'
  assign hero_default_link = routes.collections_url | append: '/bijoux-pierres-naturelles'
  assign hero_cta_link = section.settings.cta_link | default: hero_default_link

  if hero_eyebrow == 'Bijoux & émotions'
    assign hero_eyebrow = 'Bijoux en pierres naturelles'
  endif

  if hero_title_first == 'La beauté des bijoux' or hero_title_first == 'La lithothérapie' or hero_title_first == 'Vos émotions ont'
    assign hero_title_first = 'Vos émotions'
  endif

  if hero_title_second == blank or hero_title_second == 'du style.' or hero_title_second == 'se porte.' or hero_title_second == 'rencontre la lithothérapie.' or hero_title_second == 'rencontre les vertus des minéraux'
    assign hero_title_second = 'ont du style.'
  endif

  if hero_body == blank or hero_body == 'Bracelets, colliers, bagues et boucles d’oreilles : choisissez le style et la pierre que vous voulez porter.' or hero_body == 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.' or hero_body == 'Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
    assign hero_body = hero_body_standard
  endif
-%}

{%- style -%}
  #MainContent > .shopify-section.milaura-hero-homepage {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    overflow: visible;
    background: var(--milaura-aigue-profonde);
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
    padding-top: clamp(48px, 4.2vw, 62px) !important;
  }

  #MilauraPortal-{{ section.id }} {
    position: relative;
    min-height: calc(100svh - var(--milaura-announcement-height, 48px));
    overflow: hidden;
    isolation: isolate;
    color: var(--milaura-nacre);
    background: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides,
  #MilauraPortal-{{ section.id }} .portal-hero__media,
  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    position: absolute;
    inset: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides {
    z-index: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media {
    visibility: hidden;
    opacity: 0;
    transform: scale(1.012);
    transition:
      opacity 700ms ease,
      transform 1400ms cubic-bezier(0.2, 0.75, 0.2, 1),
      visibility 0s linear 700ms;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    z-index: 1;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--milaura-aigue-profonde) 48%, transparent) 0%,
      color-mix(in srgb, var(--milaura-aigue-profonde) 24%, transparent) 34%,
      transparent 58%
    );
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(590px, 42vw);
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: calc(84px + var(--milaura-esp-xl)) 0 clamp(48px, 6svh, 72px);
    margin-left: clamp(48px, 7vw, 112px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity {
    margin: 0 0 var(--milaura-esp-md);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
    margin: 0;
    color: var(--milaura-aigue-pierre);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 590px;
    margin: 0;
    color: var(--milaura-nacre);
    font-family: var(--milaura-font-display);
    font-size: clamp(58px, 5.35vw, 82px);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: -0.04em;
    line-height: 0.94;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  /* Le Hero bureau garde une seule idee, une silhouette mode et une action. */
  @media screen and (min-width: 1101px) {
    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: min(620px, 42vw);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 620px;
    }
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 470px;
    margin: var(--milaura-esp-md) 0 0;
    color: var(--milaura-nacre);
    font-family: var(--milaura-font-signature);
    font-size: clamp(34px, 2.5vw, 42px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.1;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__cta {
    margin-top: var(--milaura-esp-lg);
    border-bottom-color: var(--milaura-or) !important;
    color: var(--milaura-nacre) !important;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__cta:hover {
    border-bottom-color: var(--milaura-aigue-pierre) !important;
    color: var(--milaura-aigue-ecume) !important;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__cta:focus-visible {
    outline: 2px solid var(--milaura-nacre);
    outline-offset: 5px;
  }

  /* La navigation conserve ses liens et ses fonctions. Seule sa surface
     devient editoriale sur la homepage. */
  [id^='MilauraNav-'].milaura-home-hero-nav {
    padding: 0 !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper {
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    animation: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper::before {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
    min-height: 84px !important;
    padding: 0 clamp(32px, 5.5vw, 88px) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-mineral) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition:
      background-color var(--milaura-transition-rapide),
      box-shadow var(--milaura-transition-rapide);
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
    height: 50px !important;
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-burger,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    color: var(--milaura-nacre) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link--nouveautes::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    min-height: var(--milaura-cible-tactile) !important;
    padding: var(--milaura-esp-xs) var(--milaura-esp-sm) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-or) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::before,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
    color: inherit !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-inner {
    background: color-mix(in srgb, var(--milaura-aigue-profonde) 88%, transparent) !important;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--milaura-nacre) 18%, transparent) !important;
    backdrop-filter: blur(12px) saturate(112%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(112%) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-burger,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-quiz-badge {
    color: var(--milaura-nacre) !important;
  }

  @media screen and (max-width: 1100px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-tablet, 88px) * -1) !important;
    }
  }

  @media screen and (max-width: 820px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-mobile, 80px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      min-height: calc(100svh - var(--milaura-announcement-height, 52px));
    }

    #MilauraPortal-{{ section.id }} .portal-hero__veil {
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--milaura-aigue-profonde) 58%, transparent) 0%,
        color-mix(in srgb, var(--milaura-aigue-profonde) 32%, transparent) 38%,
        transparent 62%
      );
    }

    #MilauraPortal-{{ section.id }} .portal-hero__image {
      object-position: center 65%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: min(420px, calc(100vw - 44px));
      min-height: auto;
      justify-content: flex-start;
      padding-top: 92px;
      padding-bottom: 40px;
      margin: 0 22px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__identity {
      margin-bottom: 10px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
      font-size: 12px;
      letter-spacing: 0.01em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 330px;
      font-size: clamp(43px, 12.3vw, 50px);
      letter-spacing: -0.04em;
      line-height: 0.94;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      width: auto;
      max-width: 330px;
      margin-top: 14px;
      font-size: clamp(28px, 7.2vw, 31px);
      line-height: 1.08;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__cta {
      margin-top: var(--milaura-esp-md);
    }

    #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
      padding-top: 42px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      height: 62px !important;
      min-height: 62px !important;
      padding: 0 18px !important;
      gap: var(--milaura-esp-xs);
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 64px !important;
      min-height: 62px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 48px !important;
      transform: none !important;
      filter: none !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      min-height: var(--milaura-cible-tactile) !important;
      padding: 10px var(--milaura-esp-xs) !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 10px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
      filter: none !important;
    }
  }

  @media screen and (max-width: 480px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: -74px !important;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: 43px;
    }
  }

  @media screen and (max-width: 360px) {
    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: calc(100vw - 36px);
      padding-top: 92px;
      margin-right: 18px;
      margin-left: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 310px;
      font-size: 28px;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 58px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 44px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      padding-right: 9px !important;
      padding-left: 9px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-hero__media,
    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  aria-labelledby="MilauraPortalTitle-{{ section.id }}"
  data-milaura-home-hero
>
  <div class="portal-hero__slides">
    <picture class="portal-hero__media portal-hero__media--stone is-active">
      <source
        media="(max-width: 820px)"
        srcset="{{ hero_mobile_asset | asset_url }}"
      >
      <img
        class="portal-hero__image"
        src="{{ hero_desktop_asset | asset_url }}"
        width="1672"
        height="941"
        alt="{{ hero_image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    </picture>

  </div>

  <div class="portal-hero__veil" aria-hidden="true"></div>

  <div class="portal-hero__copy">
    <div class="portal-hero__identity">
      <p class="portal-hero__eyebrow">{{ hero_eyebrow | escape }}</p>
    </div>
    <h1 class="portal-hero__title" id="MilauraPortalTitle-{{ section.id }}">
      <span class="portal-hero__title-line">{{ hero_title_first | escape }}</span>
      <span class="portal-hero__title-line">{{ hero_title_second | escape }}</span>
    </h1>
    <p class="portal-hero__body">{{ hero_body | escape }}</p>
    {%- if hero_cta_label != blank -%}
      <a class="milaura-action milaura-action--editorial portal-hero__cta" href="{{ hero_cta_link }}">{{ hero_cta_label | escape }}</a>
    {%- endif -%}
  </div>

</section>

<script>
  (() => {
    const root = document.getElementById('MilauraPortal-{{ section.id }}');
    if (!root) return;

    const header = document.querySelector('[id^="MilauraNav-"]');
    const controller = new AbortController();
    let scrollFrame = 0;

    const updateHeader = () => {
      scrollFrame = 0;
      if (!header) return;
      header.classList.toggle('is-home-hero-scrolled', window.scrollY > 24);
    };

    const scheduleHeaderUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateHeader);
    };

    if (header) {
      header.classList.add('milaura-home-hero-nav');
      updateHeader();
      window.addEventListener('scroll', scheduleHeaderUpdate, {
        passive: true,
        signal: controller.signal,
      });
    }

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (!event.target.contains(root)) return;

        controller.abort();
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (header) {
          header.classList.remove('milaura-home-hero-nav', 'is-home-hero-scrolled');
        }
      },
      { signal: controller.signal }
    );
  })();
</script>

{% schema %}
{
  "name": "Hero de marque MilAura",
  "tag": "section",
  "class": "milaura-hero-homepage",
  "settings": [
    {
      "type": "header",
      "content": "Message de marque"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Slogan",
      "default": "Bijoux en pierres naturelles"
    },
    {
      "type": "text",
      "id": "title_first",
      "label": "Titre, première ligne",
      "default": "Vos émotions"
    },
    {
      "type": "text",
      "id": "title_second",
      "label": "Titre, seconde ligne",
      "default": "ont du style."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Choisissez votre bijou, votre pierre et ses vertus."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Action",
      "default": "Voir tous les bijoux"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien de l’action"
    },
    {
      "type": "header",
      "content": "Photographie"
    },
    {
      "type": "text",
      "id": "desktop_asset",
      "label": "Asset bureau",
      "default": "milaura-home-hero-fashion-chloe-parure-desktop-v3b.webp"
    },
    {
      "type": "text",
      "id": "mobile_asset",
      "label": "Asset mobile",
      "default": "milaura-home-hero-fashion-chloe-parure-mobile-v4.webp"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l image",
      "default": "Chloé porte un collier en aigue-marine, un bracelet en améthyste, une bague en sodalite et des boucles en agate"
    }
  ],
  "presets": [
    {
      "name": "Hero de marque MilAura"
    }
  ]
}
{% endschema %}
