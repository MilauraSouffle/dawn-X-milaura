      <p class="portal-hero__kicker">
        {{ section.settings.kicker | default: 'MilAura • Bijoux, gemmes & lithothérapie' }}
      </p>

      <h1 class="portal-hero__title">
        <span class="portal-hero__equation-row">
          <span class="portal-hero__equation-text">{{ section.settings.slogan_line_1 | default: 'La beauté d’un bijou' }}</span>
          <span class="portal-hero__operator portal-hero__operator--plus" aria-hidden="true">+</span>
        </span>
        <span class="portal-hero__equation-row portal-hero__equation-row--stone">
          <span class="portal-hero__equation-text">{{ section.settings.slogan_line_2 | default: 'la vertu des pierres' }}</span>
          <span class="portal-hero__operator portal-hero__operator--equals" aria-hidden="true">=</span>
        </span>
        <span class="portal-hero__result">
          <span>{{ section.settings.slogan_result | default: 'l’émotion' }}</span>
          <span class="portal-hero__result-brand">MilAura</span>
          <span aria-hidden="true">!</span>
        </span>
      </h1>

      <p class="portal-hero__body">
        {{ section.settings.body | default: 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.' }}
      </p>

      <div class="portal-hero__proof-card" aria-label="Les engagements MilAura">
        <span class="portal-hero__proof-label">{{ section.settings.proof_label | default: 'L’engagement MilAura' }}</span>
        <p class="portal-hero__proof-text">
          {{ section.settings.proof_text | default: 'Pierres naturelles certifiées. Chaque commande est préparée par Karine et expédiée depuis notre atelier en France.' }}
        </p>
      </div>

      <div class="portal-hero__actions">
        <a class="portal-hero__primary" href="{{ primary_url }}">
          <span>{{ section.settings.primary_label_v2 | default: 'Découvrir les créations' }}</span>
          <span class="portal-hero__primary-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('MilauraPortal-{{ section.id }}');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const visual = root.querySelector('.portal-hero__visual');
    const panels = Array.from(root.querySelectorAll('[data-triptych-panel]'));
    if (!visual || panels.length === 0) return;

    const interval = Number(root.dataset.triptychInterval) || 4000;
    const controller = new AbortController();
    let panelCursor = 0;
    let initialTimer;
    let rotationTimer;

    const advancePanel = () => {
      if (!root.isConnected) {
        stopRotation();
        controller.abort();
        return;
      }
      if (document.hidden) return;

      const panel = panels[panelCursor % panels.length];
      const images = Array.from(panel.querySelectorAll('[data-triptych-image]'));
      panelCursor += 1;
      if (images.length < 2) return;

      const activeIndex = Math.max(0, images.findIndex((image) => image.classList.contains('is-active')));
      const nextIndex = (activeIndex + 1) % images.length;
      images[activeIndex].classList.remove('is-active');
      images[nextIndex].classList.add('is-active');
    };

    const stopRotation = () => {
      window.clearTimeout(initialTimer);
      window.clearInterval(rotationTimer);
    };

    const startRotation = () => {
      stopRotation();
      initialTimer = window.setTimeout(() => {
        advancePanel();
        rotationTimer = window.setInterval(advancePanel, interval);
      }, interval * panels.length);
    };

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      visual.addEventListener('mouseenter', stopRotation, { signal: controller.signal });
      visual.addEventListener('mouseleave', startRotation, { signal: controller.signal });
    }

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (!event.target.contains(root)) return;
        stopRotation();
        controller.abort();
      },
      { signal: controller.signal }
    );

    startRotation();
  })();
</script>

