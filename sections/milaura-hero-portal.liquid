{%- liquid
  assign hero_eyebrow = section.settings.eyebrow | default: 'La beauté des minéraux et leurs vertus'
  assign hero_title = section.settings.title | default: 'L’harmonie parfaite.'
  assign hero_description = section.settings.description
  assign hero_desktop_asset = section.settings.desktop_asset | default: 'milaura-hero-bijoux-pierres-naturelles-obsidienne-sodalite-desktop.webp'
  assign hero_mobile_asset = section.settings.mobile_asset | default: 'milaura-hero-bijoux-pierres-naturelles-obsidienne-sodalite-mobile.webp'
  assign hero_image_alt = section.settings.image_alt | default: 'Collier en obsidienne noire, boucles en sodalite et bracelet en nacre MilAura sur fond aigue-marine'
  assign hero_cta_label = section.settings.cta_label | default: 'Découvrir nos bijoux'
  assign hero_default_link = routes.collections_url | append: '/bijoux-pierres-naturelles'
  assign hero_cta_link = section.settings.cta_link | default: hero_default_link
  assign hero_heading_tag = section.settings.heading_level | default: 'h1'
  assign hero_image_loading = 'eager'
  assign hero_image_priority = 'high'

  if hero_heading_tag == 'h2'
    assign hero_image_loading = 'lazy'
    assign hero_image_priority = 'auto'
  endif
-%}

{%- style -%}
  #MainContent > .shopify-section.milaura-hero-homepage {
    position: relative;
    z-index: 2;
    margin-top: 0 !important;
    overflow: visible;
    background: var(--milaura-aigue-profonde);
  }

  #MilauraPortal-{{ section.id }} {
    position: relative;
    min-height: calc(100svh - var(--milaura-announcement-height, 48px));
    overflow: hidden;
    isolation: isolate;
    color: var(--milaura-prune);
    background: var(--milaura-aigue-vive);
    font-family: var(--milaura-font-texte);
  }

  {%- if hero_heading_tag == 'h2' -%}
    #MilauraPortal-{{ section.id }} {
      min-height: clamp(560px, 72svh, 720px);
    }
  {%- endif -%}

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides,
  #MilauraPortal-{{ section.id }} .portal-hero__media,
  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    position: absolute;
    inset: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides {
    z-index: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media {
    visibility: hidden;
    opacity: 0;
    transform: scale(1.012);
    transition:
      opacity 700ms ease,
      transform 1400ms cubic-bezier(0.2, 0.75, 0.2, 1),
      visibility 0s linear 700ms;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    z-index: 1;
    display: block;
    background: transparent;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(510px, 40vw);
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: calc(84px + var(--milaura-esp-xl)) 0 clamp(48px, 6svh, 72px);
    margin-left: clamp(48px, 7vw, 112px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity {
    margin: 0 0 var(--milaura-esp-sm);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
    margin: 0;
    color: var(--milaura-prune);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 510px;
    margin: 0;
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: clamp(46px, 4vw, 64px);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title-line {
    display: block;
    white-space: normal;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__description {
    max-width: 470px;
    margin: var(--milaura-esp-md) 0 0;
    color: var(--milaura-prune);
    font-size: 17px;
    line-height: 1.55;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__cta {
    margin-top: var(--milaura-esp-lg);
  }

  /* La navigation conserve ses liens et ses fonctions. Seule sa surface
     devient editoriale sur la homepage. */
  [id^='MilauraNav-'].milaura-home-hero-nav {
    padding: 0 !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper {
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    animation: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper::before {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
    min-height: 84px !important;
    padding: 0 clamp(32px, 5.5vw, 88px) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-mineral) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition:
      background-color var(--milaura-transition-rapide),
      box-shadow var(--milaura-transition-rapide);
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
    height: 50px !important;
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-burger,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    color: var(--milaura-prune) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link--nouveautes::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    min-height: var(--milaura-cible-tactile) !important;
    padding: var(--milaura-esp-xs) var(--milaura-esp-sm) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-or) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::before,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
    color: inherit !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-inner {
    background: color-mix(in srgb, var(--milaura-aigue-ecume) 92%, transparent) !important;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--milaura-prune) 14%, transparent) !important;
    backdrop-filter: blur(12px) saturate(112%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(112%) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-burger,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-quiz-badge {
    color: var(--milaura-prune) !important;
  }

  @media screen and (max-width: 820px) {
    #MilauraPortal-{{ section.id }} {
      min-height: calc(100svh - var(--milaura-announcement-height, 52px));
      background: var(--milaura-aigue-vive);
    }

    {%- if hero_heading_tag == 'h2' -%}
      #MilauraPortal-{{ section.id }} {
        min-height: clamp(850px, calc(138vw + 350px), 890px);
      }
    {%- endif -%}

    #MilauraPortal-{{ section.id }} .portal-hero__slides {
      bottom: auto;
      height: clamp(500px, 138vw, 540px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__veil {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__image {
      object-position: center top;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      position: absolute;
      top: clamp(500px, 138vw, 540px);
      right: 0;
      left: 0;
      width: 100%;
      min-height: 350px;
      justify-content: flex-start;
      align-items: flex-start;
      padding: 28px 22px 34px;
      margin: 0;
      background: var(--milaura-aigue-vive);
      text-align: left;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__identity {
      margin-bottom: 10px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
      max-width: 100%;
      font-size: 10px;
      letter-spacing: 0.1em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 100%;
      color: var(--milaura-prune);
      font-size: clamp(34px, 9.5vw, 42px);
      letter-spacing: -0.035em;
      line-height: 1.02;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title-line {
      white-space: normal;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__description {
      max-width: 346px;
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.45;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__cta {
      align-self: flex-start;
      margin-top: 16px;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      height: 62px !important;
      min-height: 62px !important;
      padding: 0 18px !important;
      gap: var(--milaura-esp-xs);
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 64px !important;
      min-height: 62px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 48px !important;
      transform: none !important;
      filter: none !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      min-height: var(--milaura-cible-tactile) !important;
      padding: 10px var(--milaura-esp-xs) !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 10px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
      filter: none !important;
    }
  }

  @media screen and (max-width: 360px) {
    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: 100%;
      padding: 26px 18px 32px;
      margin: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 300px;
      font-size: 34px;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 58px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 44px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      padding-right: 9px !important;
      padding-left: 9px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-hero__media,
    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  aria-labelledby="MilauraPortalTitle-{{ section.id }}"
  data-milaura-home-hero
>
  <div class="portal-hero__slides">
    <picture class="portal-hero__media portal-hero__media--stone is-active">
      <source
        media="(max-width: 820px)"
        srcset="{{ hero_mobile_asset | asset_url }}"
      >
      <img
        class="portal-hero__image"
        src="{{ hero_desktop_asset | asset_url }}"
        width="1672"
        height="941"
        alt="{{ hero_image_alt | escape }}"
        loading="{{ hero_image_loading }}"
        fetchpriority="{{ hero_image_priority }}"
        decoding="async"
      >
    </picture>

  </div>

  <div class="portal-hero__veil" aria-hidden="true"></div>

  <div class="portal-hero__copy">
    <div class="portal-hero__identity">
      <p class="portal-hero__eyebrow">{{ hero_eyebrow | escape }}</p>
    </div>
    <{{ hero_heading_tag }} class="portal-hero__title" id="MilauraPortalTitle-{{ section.id }}">
      <span class="portal-hero__title-line">{{ hero_title | escape }}</span>
    </{{ hero_heading_tag }}>
    {%- if hero_description != blank -%}
      <p class="portal-hero__description">{{ hero_description | escape }}</p>
    {%- endif -%}
    {%- if hero_cta_label != blank -%}
      <a
        class="milaura-action milaura-action--editorial portal-hero__cta"
        href="{{ hero_cta_link }}"
        aria-label="{{ hero_cta_label | escape }}"
      >
        <span>{{ hero_cta_label | escape }}</span>
        {% render 'milaura-action-icon' %}
      </a>
    {%- endif -%}
  </div>

</section>

<script>
  (() => {
    const root = document.getElementById('MilauraPortal-{{ section.id }}');
    if (!root) return;

    const header = document.querySelector('[id^="MilauraNav-"]');
    const controller = new AbortController();
    let scrollFrame = 0;

    const updateHeader = () => {
      scrollFrame = 0;
      if (!header) return;
      header.classList.toggle('is-home-hero-scrolled', window.scrollY > 24);
    };

    const scheduleHeaderUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateHeader);
    };

    if (header) {
      updateHeader();
      window.addEventListener('scroll', scheduleHeaderUpdate, {
        passive: true,
        signal: controller.signal,
      });
    }

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (!event.target.contains(root)) return;

        controller.abort();
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (header) {
          header.classList.remove('is-home-hero-scrolled');
        }
      },
      { signal: controller.signal }
    );
  })();
</script>

{% schema %}
{
  "name": "Hero de marque MilAura",
  "tag": "section",
  "class": "milaura-hero-homepage",
  "settings": [
    {
      "type": "select",
      "id": "heading_level",
      "label": "Niveau du titre",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Message de marque"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Slogan",
      "default": "La beauté des minéraux et leurs vertus"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre principal",
      "default": "L’harmonie parfaite."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Action",
      "default": "Découvrir nos bijoux"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien de l’action"
    },
    {
      "type": "header",
      "content": "Photographie"
    },
    {
      "type": "text",
      "id": "desktop_asset",
      "label": "Asset bureau",
      "default": "milaura-hero-bijoux-pierres-naturelles-obsidienne-sodalite-desktop.webp"
    },
    {
      "type": "text",
      "id": "mobile_asset",
      "label": "Asset mobile",
      "default": "milaura-hero-bijoux-pierres-naturelles-obsidienne-sodalite-mobile.webp"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l image",
      "default": "Collier en obsidienne noire, boucles en sodalite et bracelet en nacre MilAura sur fond aigue-marine"
    }
  ],
  "presets": [
    {
      "name": "Hero de marque MilAura"
    }
  ]
}
{% endschema %}
