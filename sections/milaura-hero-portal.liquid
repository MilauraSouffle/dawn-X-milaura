{%- liquid
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = '#MilauraSelectionAtelier'
  endif

  assign conversion_text = section.settings.body
  if conversion_text == blank or conversion_text contains 'Bagues, bracelets, colliers et boucles d’oreilles' or conversion_text == 'Des matières de qualité. Des finitions soignées. Une sélection exigeante.'
    assign conversion_text = 'Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
  endif

  assign slogan_text = section.settings.slogan | default: 'La beauté des bijoux rencontre les vertus des pierres.'
  assign kicker_text = section.settings.kicker | default: 'MilAura • Bijoux, gemmes & lithothérapie'

  assign proof_1_label = section.settings.proof_1 | default: 'Pierres naturelles certifiées'
  if proof_1_label == 'Pierres naturelles certifiées'
    assign proof_1_label = 'Pierres certifiées'
  endif
  assign proof_2_label = section.settings.proof_2 | default: 'Préparées par Karine'
  assign proof_3_label = section.settings.proof_3 | default: 'Expédiées depuis notre atelier en France'
  if proof_3_label == 'Expédiées depuis notre atelier en France'
    assign proof_3_label = 'Expédiées depuis Metz'
  endif

  assign triptych_product_1 = section.settings.triptych_product_1
  if triptych_product_1 == blank
    assign triptych_product_1 = all_products['collier-obsidienne-noire-boho-dore']
  endif
  assign triptych_product_2 = section.settings.triptych_product_2
  if triptych_product_2 == blank
    assign triptych_product_2 = all_products['bracelet-oeil-de-tigre-cuir-brun']
  endif
  assign triptych_product_3 = section.settings.triptych_product_3
  if triptych_product_3 == blank
    assign triptych_product_3 = all_products['collier-agate-arbre']
  endif
  assign triptych_product_4 = section.settings.triptych_product_4
  if triptych_product_4 == blank
    assign triptych_product_4 = all_products['pendentif-argent-925-rhodie-modele-05-amethyste-facettee-bre']
  endif
  assign triptych_product_5 = section.settings.triptych_product_5
  if triptych_product_5 == blank
    assign triptych_product_5 = all_products['pendentif-amazonite']
  endif
  assign triptych_product_6 = section.settings.triptych_product_6
  if triptych_product_6 == blank
    assign triptych_product_6 = all_products['bougie-reconfort-neroli-calcedoine']
  endif
  assign triptych_product_7 = section.settings.triptych_product_7
  if triptych_product_7 == blank
    assign triptych_product_7 = all_products['savon-argan-1-piece']
  endif
  assign triptych_product_8 = section.settings.triptych_product_8
  if triptych_product_8 == blank
    assign triptych_product_8 = all_products['bol-chantant-120mm-1-piece']
  endif
  assign triptych_product_9 = section.settings.triptych_product_9
  if triptych_product_9 == blank
    assign triptych_product_9 = all_products['distributeur-savon-lapis-lazuli']
  endif

  assign triptych_photo_1_index = section.settings.triptych_photo_1 | default: 2 | minus: 1
  assign triptych_photo_2_index = section.settings.triptych_photo_2 | default: 2 | minus: 1
  assign triptych_photo_3_index = section.settings.triptych_photo_3 | default: 1 | minus: 1
  assign triptych_photo_4_index = section.settings.triptych_photo_4 | default: 1 | minus: 1
  assign triptych_photo_5_index = section.settings.triptych_photo_5 | default: 1 | minus: 1
  assign triptych_photo_6_index = section.settings.triptych_photo_6 | default: 1 | minus: 1
  assign triptych_photo_7_index = section.settings.triptych_photo_7 | default: 1 | minus: 1
  assign triptych_photo_8_index = section.settings.triptych_photo_8 | default: 1 | minus: 1
  assign triptych_photo_9_index = section.settings.triptych_photo_9 | default: 1 | minus: 1

  assign triptych_image_1 = triptych_product_1.images[triptych_photo_1_index] | default: triptych_product_1.featured_image
  assign triptych_image_2 = triptych_product_2.images[triptych_photo_2_index] | default: triptych_product_2.featured_image
  assign triptych_image_3 = triptych_product_3.images[triptych_photo_3_index] | default: triptych_product_3.featured_image
  assign triptych_image_4 = triptych_product_4.images[triptych_photo_4_index] | default: triptych_product_4.featured_image
  assign triptych_image_5 = triptych_product_5.images[triptych_photo_5_index] | default: triptych_product_5.featured_image
  assign triptych_image_6 = triptych_product_6.images[triptych_photo_6_index] | default: triptych_product_6.featured_image
  assign triptych_image_7 = triptych_product_7.images[triptych_photo_7_index] | default: triptych_product_7.featured_image
  assign triptych_image_8 = triptych_product_8.images[triptych_photo_8_index] | default: triptych_product_8.featured_image
  assign triptych_image_9 = triptych_product_9.images[triptych_photo_9_index] | default: triptych_product_9.featured_image

  assign triptych_interval = section.settings.triptych_interval | default: 4 | times: 1000
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Dancing';
    src: url('{{ 'milaura-dancing-script-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MainContent > .shopify-section.milaura-hero-homepage {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(92px, 8vw, 118px);
  }

  #MilauraPortal-{{ section.id }} {
    --portal-nacre: #fbf8f3;
    --portal-paper: #fffdf9;
    --portal-ink: #2f222d;
    --portal-prune-action: #493246;
    --portal-prune-action-light: #52394d;
    --portal-gold: #b9975b;
    --portal-aqua: #6fa9a6;
    --portal-aqua-deep: #3f7474;
    --portal-aqua-soft: #dce9e7;
    --portal-quartz: #d7b8b1;
    --portal-amethyst: #7a4d82;
    --portal-header-overlap: 0px;
    --portal-triptych-lift: 0px;
    --portal-base-height: clamp(690px, calc(100svh - 148px), 860px);
    position: relative;
    isolation: isolate;
    min-height: calc(var(--portal-base-height) + var(--portal-header-overlap));
    overflow: visible;
    color: var(--portal-ink);
    background: var(--portal-nacre);
    font-family: 'MilAura Instrument', sans-serif;
  }

  @media screen and (min-width: 1101px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      --portal-header-overlap: var(--header-height-desktop, 110px);
      --portal-triptych-lift: clamp(34px, 2.6vw, 40px);
    }

  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__stage {
    position: relative;
    width: min(100%, 1680px);
    min-height: inherit;
    margin: 0 auto;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: absolute;
    top: calc(50% + (var(--portal-header-overlap) / 2));
    left: clamp(42px, 6vw, 104px);
    z-index: 3;
    width: min(51%, 860px);
    transform: translateY(-50%);
  }

  @media screen and (min-width: 1101px) {
    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      top: calc(var(--portal-header-overlap) + clamp(48px, 6svh, 72px));
      transform: none;
    }
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker {
    display: block;
    margin: 0 0 18px;
    color: var(--portal-amethyst);
    font-family: 'MilAura Dancing', cursive;
    font-size: clamp(2.5rem, 2.9vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
    content: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker-lockup {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker-main {
    display: block;
    font-size: 1.14em;
    line-height: 0.94;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker-detail {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.22em;
    width: 100%;
    font-size: 0.84em;
    line-height: 1;
    white-space: nowrap;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker-separator {
    width: 0.22em;
    height: 0.22em;
    flex: 0 0 auto;
    align-self: center;
    border-radius: 50%;
    background: var(--portal-aqua);
    box-shadow: 0 0 0 1px rgba(63, 116, 116, 0.16);
    transform: translateY(0.04em);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 860px;
    margin: 0;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(4rem, 4.9vw, 5.65rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row {
    display: block;
    width: max-content;
    max-width: 100%;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-lockup {
    display: flex;
    align-items: baseline;
    gap: 0;
    width: max-content;
    max-width: 100%;
    line-height: 0.82;
    white-space: nowrap;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-fragment {
    display: inline-block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-lead {
    color: rgba(47, 34, 45, 0.78);
    font-size: 0.64em;
    margin-right: 0.13em;
    letter-spacing: -0.02em;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-focus {
    color: var(--portal-amethyst);
    font-size: 1.25em;
    letter-spacing: -0.05em;
    line-height: 0.78;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-material {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    color: transparent;
    font-size: 0.67em;
    margin-left: 0.22em;
    letter-spacing: -0.02em;
    line-height: 0.9;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0.02em 0 rgba(47, 34, 45, 0.12));
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-noun {
    display: inline-block;
    color: transparent;
    background-image: inherit;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__statement-connector {
    display: inline-block;
    color: rgba(47, 34, 45, 0.78);
    font-size: 0.56em;
    letter-spacing: -0.02em;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-material--jewel {
    background-image:
      repeating-linear-gradient(118deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 5px),
      linear-gradient(108deg, #3b2936 0%, #68463f 28%, #b28b51 47%, #6f4d40 64%, #342631 100%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__equation-lead {
    color: rgba(45, 105, 107, 0.72);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__statement-connector {
    color: rgba(45, 105, 107, 0.72);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__equation-focus {
    color: var(--portal-aqua-deep);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-material--stone {
    background-image:
      repeating-linear-gradient(122deg, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px 6px),
      linear-gradient(110deg, #285f61 0%, #427e7e 28%, #74a7a2 46%, #4f8987 63%, #225355 100%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone {
    margin-left: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-text {
    display: block;
    min-width: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__equation-text {
    color: var(--portal-aqua-deep);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__statement-bridge {
    display: block;
    width: 100%;
    margin: 10px 0 12px;
    color: rgba(47, 34, 45, 0.72);
    font-family: 'MilAura Instrument', sans-serif;
    font-size: 0.42em;
    font-weight: 680;
    letter-spacing: 0.035em;
    line-height: 1;
    text-align: center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 48ch;
    margin: clamp(26px, 2vw, 32px) 0 0;
    color: rgba(47, 34, 45, 0.84);
    font-size: clamp(1.1875rem, 1.2vw, 1.3125rem);
    font-weight: 460;
    letter-spacing: -0.012em;
    line-height: 1.5;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__conversion-text {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__conversion-text {
    max-width: 43ch;
    margin: 0 auto;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(1.3rem, 1.38vw, 1.52rem);
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.38;
    text-align: center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__conversion-emphasis {
    display: inline-block;
    margin-inline: -0.08em;
    padding-inline: 0.08em;
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(239, 224, 193, 0.64) 7%,
      rgba(224, 195, 133, 0.68) 50%,
      rgba(239, 224, 193, 0.6) 93%,
      transparent 100%
    );
    background-repeat: no-repeat;
    background-position: center calc(100% - 0.1em);
    background-size: 100% 0.62em;
    white-space: nowrap;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 24px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 10px 11px 10px 25px;
    border: 1px solid rgba(215, 184, 223, 0.42);
    border-radius: 999px;
    color: var(--portal-paper);
    background: linear-gradient(145deg, var(--portal-prune-action-light) 0%, var(--portal-prune-action) 58%, var(--portal-ink) 100%);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 14px 30px rgba(47, 34, 45, 0.2);
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover {
    color: var(--portal-prune-action);
    background: transparent;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px rgba(47, 34, 45, 0.12);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary-icon {
    width: 34px;
    height: 34px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: var(--portal-ink);
    background: var(--portal-gold);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover .portal-hero__primary-icon {
    transform: translateX(3px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:focus-visible {
    outline: 2px solid var(--portal-aqua);
    outline-offset: 5px;
  }

  #MilauraPortal-{{ section.id }} .portal-proof-bridge {
    position: absolute;
    right: clamp(22px, 4vw, 68px);
    bottom: 0;
    left: clamp(22px, 4vw, 68px);
    z-index: 8;
    width: min(1040px, calc(100% - 44px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(42px, 6vw, 96px);
    padding: 0 clamp(18px, 3vw, 42px);
    transform: translateY(50%);
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-proof {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  #MilauraPortal-{{ section.id }} .portal-proof--karine {
    transform: translateY(-18px);
  }

  #MilauraPortal-{{ section.id }} .portal-proof--certificate {
    transform: translateY(6px);
  }

  #MilauraPortal-{{ section.id }} .portal-proof--atelier {
    transform: translateY(12px);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__media {
    --proof-shape: 48% 52% 47% 53% / 52% 46% 54% 48%;
    position: relative;
    width: clamp(92px, 8vw, 118px);
    aspect-ratio: 1;
    isolation: isolate;
  }

  #MilauraPortal-{{ section.id }} .portal-proof--karine .portal-proof__media {
    --proof-shape: 52% 48% 54% 46% / 47% 53% 49% 51%;
    width: clamp(106px, 9vw, 132px);
  }

  #MilauraPortal-{{ section.id }} .portal-proof--atelier .portal-proof__media {
    --proof-shape: 46% 54% 50% 50% / 55% 45% 53% 47%;
  }

  #MilauraPortal-{{ section.id }} .portal-proof__outline,
  #MilauraPortal-{{ section.id }} .portal-proof__image-wrap {
    position: absolute;
    border-radius: var(--proof-shape);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__outline {
    z-index: 1;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-proof__outline--gold {
    inset: 7px -6px -5px 8px;
    border: 1px solid rgba(185, 151, 91, 0.9);
    transform: rotate(3deg);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__outline--aqua {
    inset: -6px 8px 7px -6px;
    border: 1px solid rgba(111, 169, 166, 0.76);
    transform: rotate(-2.5deg);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__image-wrap {
    inset: 0;
    z-index: 2;
    overflow: hidden;
    border: 1px solid rgba(255, 253, 249, 0.92);
    background: var(--portal-paper);
    box-shadow: 0 14px 28px rgba(47, 34, 45, 0.16);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #MilauraPortal-{{ section.id }} .portal-proof--certificate .portal-proof__image {
    object-fit: contain;
    object-position: 50% 50%;
    transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-proof--karine .portal-proof__image {
    object-position: 50% 34%;
  }

  #MilauraPortal-{{ section.id }} .portal-proof--atelier .portal-proof__image {
    object-position: 48% 60%;
    transform: scale(1.16);
  }

  #MilauraPortal-{{ section.id }} .portal-proof__copy {
    min-width: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-proof__title,
  #MilauraPortal-{{ section.id }} .portal-proof__detail {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-proof__title {
    color: var(--portal-ink);
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    font-weight: 720;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  #MilauraPortal-{{ section.id }} .portal-proof__detail {
    margin-top: 3px;
    color: var(--portal-aqua-deep);
    font-size: clamp(0.7rem, 0.8vw, 0.78rem);
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 58%;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 1px;
    background: rgba(185, 151, 91, 0.46);
    transform: rotate(5deg) scaleY(1.08);
    transform-origin: center;
  }

  @media screen and (min-width: 1101px) {
    #MilauraPortal-{{ section.id }} .portal-hero__kicker,
    #MilauraPortal-{{ section.id }} .portal-hero__title,
    #MilauraPortal-{{ section.id }} .portal-hero__statement-bridge,
    #MilauraPortal-{{ section.id }} .portal-hero__body,
    #MilauraPortal-{{ section.id }} .portal-hero__actions {
      width: min(100%, 740px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker,
    #MilauraPortal-{{ section.id }} .portal-hero__title,
    #MilauraPortal-{{ section.id }} .portal-hero__body {
      transform: translate(clamp(-180px, calc(308px - 28vw), 0px), -14px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker {
      margin: 0 0 26px;
      text-align: center;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker-default {
