{%- liquid
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = '#MilauraSelectionAtelier'
  endif

  assign triptych_product_1 = section.settings.triptych_product_1
  if triptych_product_1 == blank
    assign triptych_product_1 = all_products['collier-obsidienne-noire-boho-dore']
  endif
  assign triptych_product_2 = section.settings.triptych_product_2
  if triptych_product_2 == blank
    assign triptych_product_2 = all_products['bracelet-oeil-de-tigre-cuir-brun']
  endif
  assign triptych_product_3 = section.settings.triptych_product_3
  if triptych_product_3 == blank
    assign triptych_product_3 = all_products['collier-agate-arbre']
  endif
  assign triptych_product_4 = section.settings.triptych_product_4
  if triptych_product_4 == blank
    assign triptych_product_4 = all_products['pendentif-argent-925-rhodie-modele-05-amethyste-facettee-bre']
  endif
  assign triptych_product_5 = section.settings.triptych_product_5
  if triptych_product_5 == blank
    assign triptych_product_5 = all_products['pendentif-amazonite']
  endif
  assign triptych_product_6 = section.settings.triptych_product_6
  if triptych_product_6 == blank
    assign triptych_product_6 = all_products['bougie-reconfort-neroli-calcedoine']
  endif
  assign triptych_product_7 = section.settings.triptych_product_7
  if triptych_product_7 == blank
    assign triptych_product_7 = all_products['savon-argan-1-piece']
  endif
  assign triptych_product_8 = section.settings.triptych_product_8
  if triptych_product_8 == blank
    assign triptych_product_8 = all_products['bol-chantant-120mm-1-piece']
  endif
  assign triptych_product_9 = section.settings.triptych_product_9
  if triptych_product_9 == blank
    assign triptych_product_9 = all_products['distributeur-savon-lapis-lazuli']
  endif

  assign triptych_photo_1_index = section.settings.triptych_photo_1 | default: 2 | minus: 1
  assign triptych_photo_2_index = section.settings.triptych_photo_2 | default: 2 | minus: 1
  assign triptych_photo_3_index = section.settings.triptych_photo_3 | default: 1 | minus: 1
  assign triptych_photo_4_index = section.settings.triptych_photo_4 | default: 1 | minus: 1
  assign triptych_photo_5_index = section.settings.triptych_photo_5 | default: 1 | minus: 1
  assign triptych_photo_6_index = section.settings.triptych_photo_6 | default: 1 | minus: 1
  assign triptych_photo_7_index = section.settings.triptych_photo_7 | default: 1 | minus: 1
  assign triptych_photo_8_index = section.settings.triptych_photo_8 | default: 1 | minus: 1
  assign triptych_photo_9_index = section.settings.triptych_photo_9 | default: 1 | minus: 1

  assign triptych_image_1 = triptych_product_1.images[triptych_photo_1_index] | default: triptych_product_1.featured_image
  assign triptych_image_2 = triptych_product_2.images[triptych_photo_2_index] | default: triptych_product_2.featured_image
  assign triptych_image_3 = triptych_product_3.images[triptych_photo_3_index] | default: triptych_product_3.featured_image
  assign triptych_image_4 = triptych_product_4.images[triptych_photo_4_index] | default: triptych_product_4.featured_image
  assign triptych_image_5 = triptych_product_5.images[triptych_photo_5_index] | default: triptych_product_5.featured_image
  assign triptych_image_6 = triptych_product_6.images[triptych_photo_6_index] | default: triptych_product_6.featured_image
  assign triptych_image_7 = triptych_product_7.images[triptych_photo_7_index] | default: triptych_product_7.featured_image
  assign triptych_image_8 = triptych_product_8.images[triptych_photo_8_index] | default: triptych_product_8.featured_image
  assign triptych_image_9 = triptych_product_9.images[triptych_photo_9_index] | default: triptych_product_9.featured_image

  assign triptych_interval = section.settings.triptych_interval | default: 4 | times: 1000
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Dancing';
    src: url('{{ 'milaura-dancing-script-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MilauraPortal-{{ section.id }} {
    --portal-nacre: #fbf8f3;
    --portal-paper: #fffdf9;
    --portal-ink: #2f222d;
    --portal-gold: #b9975b;
    --portal-aqua: #6fa9a6;
    --portal-aqua-deep: #3f7474;
    --portal-aqua-soft: #dce9e7;
    --portal-quartz: #d7b8b1;
    --portal-amethyst: #7a4d82;
    --portal-header-overlap: 0px;
    --portal-base-height: clamp(690px, calc(100svh - 148px), 860px);
    position: relative;
    isolation: isolate;
    min-height: calc(var(--portal-base-height) + var(--portal-header-overlap));
    overflow: hidden;
    color: var(--portal-ink);
    background: var(--portal-nacre);
    font-family: 'MilAura Instrument', sans-serif;
  }

  @media screen and (min-width: 1101px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      --portal-header-overlap: var(--header-height-desktop, 110px);
    }
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__stage {
    position: relative;
    width: min(100%, 1680px);
    min-height: inherit;
    margin: 0 auto;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: absolute;
    top: calc(50% + (var(--portal-header-overlap) / 2));
    left: clamp(42px, 6vw, 104px);
    z-index: 3;
    width: min(46%, 690px);
    transform: translateY(-50%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker {
    display: block;
    margin: 0 0 16px;
    color: var(--portal-amethyst);
    font-family: 'MilAura Dancing', cursive;
    font-size: clamp(2.125rem, 2.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
    content: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 690px;
    margin: 0;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(3.35rem, 4.15vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.94;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row {
    display: block;
    width: max-content;
    max-width: 100%;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone {
    margin-left: clamp(24px, 3vw, 50px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-text {
    display: block;
    min-width: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone .portal-hero__equation-text {
    color: var(--portal-aqua-deep);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator {
    display: block;
    color: #9b783b;
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(1.95rem, 2.2vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator-line::before,
  #MilauraPortal-{{ section.id }} .portal-hero__operator-line::after {
    content: '';
    width: clamp(66px, 7vw, 112px);
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(185, 151, 91, 0.96));
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator-line::after {
    background: linear-gradient(90deg, rgba(185, 151, 91, 0.96), transparent);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__operator-line {
    width: min(100%, 590px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 17px;
    margin: 7px 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__result {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.18em;
    width: min(100%, 590px);
    margin-top: 2px;
    color: var(--portal-amethyst);
    font-family: 'MilAura Instrument', sans-serif;
    font-size: 0.48em;
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__result-brand {
    font-family: 'MilAura Dancing', cursive;
    font-size: 1.42em;
    font-weight: 650;
    letter-spacing: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 48ch;
    margin: clamp(18px, 1.6vw, 24px) 0 0;
    color: rgba(47, 34, 45, 0.84);
    font-size: clamp(1.1875rem, 1.2vw, 1.3125rem);
    font-weight: 460;
    letter-spacing: -0.012em;
    line-height: 1.5;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 24px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 10px 11px 10px 25px;
    border: 1px solid var(--portal-ink);
    border-radius: 999px;
    color: var(--portal-paper);
    background: var(--portal-ink);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 14px 30px rgba(47, 34, 45, 0.16);
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover {
    color: var(--portal-ink);
    background: transparent;
    transform: translateY(-2px);
    box-shadow: 0 18px 34px rgba(47, 34, 45, 0.12);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary-icon {
    width: 34px;
    height: 34px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: var(--portal-ink);
    background: var(--portal-gold);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover .portal-hero__primary-icon {
    transform: translateX(3px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:focus-visible {
    outline: 2px solid var(--portal-aqua);
    outline-offset: 5px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proofs {
    display: grid;
    gap: 10px;
    margin: 20px 0 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof {
    display: flex;
    align-items: center;
    gap: 11px;
    color: rgba(47, 34, 45, 0.78);
    font-size: 1rem;
    font-weight: 620;
    line-height: 1.25;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof::before {
    content: '✓';
    width: 28px;
    height: 28px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(185, 151, 91, 0.76);
    border-radius: 50%;
    color: #8b6d34;
    background: rgba(255, 253, 249, 0.76);
    font-size: 0.84rem;
    font-weight: 760;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 58%;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 1px;
    background: rgba(185, 151, 91, 0.46);
    transform: rotate(5deg) scaleY(1.08);
    transform-origin: center;
  }

  #MilauraPortal-{{ section.id }} .portal-facet-shell {
    position: absolute;
    top: calc(50% + (var(--portal-header-overlap) / 2));
    z-index: 1;
    aspect-ratio: 0.92 / 1;
    isolation: isolate;
    transform: translateY(-50%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet-shell--hand {
    --facet-shape: 48% 52% 45% 55% / 53% 44% 56% 47%;
    top: calc(68% + (var(--portal-header-overlap) / 2));
    left: 1%;
    z-index: 3;
    width: 42%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet-shell--neck {
    --facet-shape: 52% 48% 55% 45% / 47% 54% 46% 53%;
    top: calc(43% + (var(--portal-header-overlap) / 2));
    left: 24%;
    z-index: 2;
    width: 52%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet-shell--object {
    --facet-shape: 46% 54% 49% 51% / 55% 46% 54% 45%;
    top: calc(68% + (var(--portal-header-overlap) / 2));
    right: 1%;
    z-index: 3;
    width: 42%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet,
  #MilauraPortal-{{ section.id }} .portal-facet-outline {
    position: absolute;
    border-radius: var(--facet-shape);
  }

  #MilauraPortal-{{ section.id }} .portal-facet-outline {
    z-index: 1;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-facet-outline--gold {
    inset: 13px -9px -10px 14px;
    border: 1px solid rgba(185, 151, 91, 0.78);
    transform: rotate(2.4deg);
  }

  #MilauraPortal-{{ section.id }} .portal-facet-outline--aqua {
    inset: -10px 15px 13px -10px;
    border: 1px solid rgba(111, 169, 166, 0.58);
    transform: rotate(-1.8deg);
  }

  #MilauraPortal-{{ section.id }} .portal-facet {
    inset: 0;
    z-index: 2;
    overflow: hidden;
    border: 1px solid rgba(185, 151, 91, 0.62);
    background: var(--portal-paper);
    box-shadow: 0 28px 52px rgba(47, 34, 45, 0.16);
  }

  #MilauraPortal-{{ section.id }} .portal-facet-shell--neck .portal-facet {
    border-color: rgba(111, 169, 166, 0.72);
    box-shadow: 0 30px 58px rgba(47, 34, 45, 0.17);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 50%;
    opacity: 0;
    background: transparent;
    transform: scale(1.045);
    transition:
      opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1.015);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand .portal-facet__image {
    object-position: 50% 50%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck .portal-facet__image {
    object-position: 50% 50%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet--object .portal-facet__image {
    object-position: 50% 50%;
  }

  #MilauraPortal-{{ section.id }} .portal-facet__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 253, 249, 0.54);
  }

  @media screen and (max-width: 1100px) and (min-width: 768px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 760px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      left: 42px;
      width: 49%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: clamp(3.1rem, 5.8vw, 4.4rem);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      width: 55%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet {
      box-shadow: 0 22px 42px rgba(47, 34, 45, 0.15);
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--hand,
    #MilauraPortal-{{ section.id }} .portal-facet-shell--object {
      width: 43%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--neck {
      width: 54%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--neck .portal-facet {
      box-shadow: 0 24px 46px rgba(47, 34, 45, 0.16);
    }
  }

  @media screen and (max-width: 767px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-mobile, 80px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      min-height: 0;
      overflow: visible;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__stage {
      min-height: 0;
      padding-top: var(--header-height-mobile, 80px);
      padding-bottom: 28px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      position: relative;
      width: 100%;
      height: clamp(310px, 84vw, 365px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--hand {
      top: 70%;
      left: 0;
      width: 46%;
      margin-top: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--neck {
      top: 39%;
      left: 21%;
      width: 58%;
      margin-top: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--neck .portal-facet {
      box-shadow: 0 20px 38px rgba(47, 34, 45, 0.16);
    }

    #MilauraPortal-{{ section.id }} .portal-facet-shell--object {
      top: 70%;
      right: 0;
      left: auto;
      width: 46%;
      margin-top: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-outline--gold {
      inset: 9px -6px -7px 10px;
    }

    #MilauraPortal-{{ section.id }} .portal-facet-outline--aqua {
      inset: -7px 10px 9px -7px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      padding: 18px 18px 0;
      transform: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker {
      max-width: 19ch;
      margin: 0 auto 14px;
      font-size: clamp(1.8rem, 8vw, 2.2rem);
      line-height: 1.08;
      text-align: center;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      display: flex;
      width: 100%;
      max-width: none;
      flex-direction: column;
      align-items: center;
      font-size: clamp(1.8rem, 8.5vw, 2.55rem);
      line-height: 0.98;
      letter-spacing: -0.04em;
      text-align: center;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__equation-row {
      width: 100%;
      max-width: 100%;
      text-align: center;
      white-space: nowrap;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__equation-row--stone {
      margin-left: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__operator {
      flex: 0 0 auto;
      color: #8f6d32;
      font-size: clamp(2.35rem, 10.5vw, 2.85rem);
      line-height: 0.8;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__operator-line {
      width: 100%;
      gap: 16px;
      margin: 11px 0 10px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__operator-line::before,
    #MilauraPortal-{{ section.id }} .portal-hero__operator-line::after {
      width: clamp(64px, 21vw, 94px);
      height: 3px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__result {
      width: 100%;
      margin-top: 4px;
      font-size: clamp(1.3rem, 5.8vw, 1.6rem);
      line-height: 1.08;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 35ch;
      margin: 20px auto 0;
      font-size: 1.125rem;
      line-height: 1.5;
      text-align: center;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__actions {
      display: grid;
      gap: 13px;
      margin-top: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      width: 100%;
      min-height: 48px;
      padding: 8px 9px 8px 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proofs {
      margin-top: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proof {
      align-items: flex-start;
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      transition: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet__image {
      transition: none;
    }
  }
{%- endstyle -%}

<div
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  data-triptych-interval="{{ triptych_interval }}"
>
  <div class="portal-hero__stage">
    <div class="portal-hero__visual" aria-hidden="true">
