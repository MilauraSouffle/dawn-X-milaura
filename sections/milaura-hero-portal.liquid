<script>
  (() => {
    const root = document.getElementById('MilauraPortal-{{ section.id }}');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll('[data-milaura-hero-slide]'));
    const journeys = Array.from(root.querySelectorAll('[data-milaura-journey]'));
    const header = document.querySelector('[id^="MilauraNav-"]');
    const controller = new AbortController();
    let scrollFrame = 0;

    const activate = (index) => {
      slides.forEach((slide) => {
        slide.classList.toggle('is-active', slide.dataset.milauraHeroSlide === index);
      });

      journeys.forEach((journey) => {
        journey.classList.toggle('is-active', journey.dataset.milauraJourney === index);
      });
    };

    journeys.forEach((journey, index) => {
      const showJourney = () => activate(journey.dataset.milauraJourney);

      journey.addEventListener('pointerenter', showJourney, { signal: controller.signal });
      journey.addEventListener('focus', showJourney, { signal: controller.signal });
      journey.addEventListener('pointerdown', showJourney, { signal: controller.signal });
      journey.addEventListener(
        'keydown',
        (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

          event.preventDefault();
          const direction = event.key === 'ArrowRight' ? 1 : -1;
          const target = (index + direction + journeys.length) % journeys.length;
          journeys[target].focus();
        },
        { signal: controller.signal }
      );
    });

    const updateHeader = () => {
      scrollFrame = 0;
      if (!header) return;
      header.classList.toggle('is-home-hero-scrolled', window.scrollY > 24);
    };

    const scheduleHeaderUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateHeader);
    };

    if (header) {
      header.classList.add('milaura-home-hero-nav');
      updateHeader();
      window.addEventListener('scroll', scheduleHeaderUpdate, {
        passive: true,
        signal: controller.signal,
      });
    }

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (!event.target.contains(root)) return;

        controller.abort();
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (header) {
          header.classList.remove('milaura-home-hero-nav', 'is-home-hero-scrolled');
        }
      },
      { signal: controller.signal }
    );
  })();
</script>

