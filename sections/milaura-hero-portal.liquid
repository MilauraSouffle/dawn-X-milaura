<div
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  data-triptych-interval="{{ triptych_interval }}"
>
  <div class="portal-hero__stage">
    <div class="portal-hero__visual" aria-hidden="true">
