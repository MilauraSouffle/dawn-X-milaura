{%- liquid
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = routes.collections_url | append: '/bijoux-pierres-naturelles'
  endif

  assign secondary_url = section.settings.secondary_link
  if secondary_url == blank
    assign secondary_url = '#MilauraChoiceDoors'
  endif

  assign hero_image_width = 1536
  assign hero_image_height = 1024
  if section.settings.image != blank
    assign hero_image_width = section.settings.image.width
    assign hero_image_height = section.settings.image.height
  endif
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MilauraPortal-{{ section.id }} {
    --portal-nacre: #fbf8f3;
    --portal-paper: #fffdf9;
    --portal-ink: #2f222d;
    --portal-gold: #b9975b;
    --portal-aqua: #6fa9a6;
    --portal-aqua-soft: #dce9e7;
    --portal-quartz: #d7b8b1;
    position: relative;
    isolation: isolate;
    min-height: clamp(690px, calc(100svh - 148px), 860px);
    overflow: hidden;
    color: var(--portal-ink);
    background: var(--portal-nacre);
    font-family: 'MilAura Instrument', sans-serif;
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__stage {
    position: relative;
    width: min(100%, 1680px);
    min-height: inherit;
    margin: 0 auto;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: absolute;
    top: 50%;
    left: clamp(42px, 6vw, 104px);
    z-index: 3;
    width: min(46%, 690px);
    transform: translateY(-50%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 24px;
    color: var(--portal-aqua);
    font-size: clamp(0.68rem, 0.78vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
    content: '';
    width: 34px;
    height: 1px;
    flex: 0 0 34px;
    background: currentColor;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 10ch;
    margin: 0;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(4.15rem, 6vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title span {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title span:last-child {
    width: max-content;
    max-width: 9.6ch;
    margin-top: 2px;
    margin-left: clamp(24px, 3vw, 50px);
    color: var(--portal-aqua);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 52ch;
    margin: clamp(24px, 2.4vw, 34px) 0 0;
    color: rgba(47, 34, 45, 0.76);
    font-size: clamp(0.98rem, 1.04vw, 1.1rem);
    font-weight: 450;
    letter-spacing: -0.012em;
    line-height: 1.55;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 30px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 25px;
    border: 1px solid var(--portal-gold);
    border-radius: 999px;
    color: var(--portal-ink);
    background: var(--portal-gold);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover {
    color: var(--portal-paper);
    background: var(--portal-ink);
    transform: translateY(-2px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__secondary {
    position: relative;
    color: var(--portal-ink);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.4;
    text-decoration: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__secondary::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 1px;
    background: var(--portal-aqua);
    transform: scaleX(0.35);
    transform-origin: left;
    transition: transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__secondary:hover::after,
  #MilauraPortal-{{ section.id }} .portal-hero__secondary:focus-visible::after {
    transform: scaleX(1);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:focus-visible,
  #MilauraPortal-{{ section.id }} .portal-hero__secondary:focus-visible {
    outline: 2px solid var(--portal-aqua);
    outline-offset: 5px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proofs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 13px;
    margin-top: 28px;
    color: rgba(47, 34, 45, 0.65);
    font-size: 0.64rem;
    font-weight: 680;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof::before {
    content: '';
    width: 5px;
    height: 5px;
    flex: 0 0 5px;
    border-radius: 50%;
    background: var(--portal-gold);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 58%;
    display: grid;
    grid-template-columns: 0.84fr 1.04fr 0.92fr;
    gap: 6px;
    padding-left: 28px;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 1px;
    background: rgba(185, 151, 91, 0.46);
    transform: rotate(5deg) scaleY(1.08);
    transform-origin: center;
  }

  #MilauraPortal-{{ section.id }} .portal-facet {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    background: #e7e1d8;
    animation: milauraFacetSettle 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--facet-order) * 90ms);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand {
    top: 7%;
    height: 93%;
    clip-path: polygon(12% 0, 100% 4%, 91% 100%, 0 94%, 5% 46%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck {
    height: 96%;
    clip-path: polygon(14% 0, 100% 0, 93% 91%, 81% 100%, 0 96%, 7% 43%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--ear {
    top: 4%;
    height: 96%;
    clip-path: polygon(9% 3%, 100% 0, 100% 100%, 0 94%, 6% 52%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.035);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand .portal-facet__image {
    object-position: {{ section.settings.panel_hand_position | default: '16% 52%' }};
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck .portal-facet__image {
    object-position: {{ section.settings.panel_neck_position | default: '50% 54%' }};
  }

  #MilauraPortal-{{ section.id }} .portal-facet--ear .portal-facet__image {
    object-position: {{ section.settings.panel_ear_position | default: '84% 40%' }};
  }

  #MilauraPortal-{{ section.id }} .portal-facet__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 253, 249, 0.26);
  }

  @keyframes milauraFacetSettle {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 1100px) and (min-width: 768px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 760px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      left: 42px;
      width: 49%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: clamp(3.75rem, 6.8vw, 5.2rem);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      width: 55%;
      padding-left: 16px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proofs {
      max-width: 48ch;
    }
  }

  @media screen and (max-width: 767px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 0;
      overflow: visible;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__stage {
      min-height: 0;
      padding-bottom: 28px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      position: relative;
      width: 100%;
      height: clamp(270px, 34svh, 315px);
      grid-template-columns: 0.86fr 1.05fr 0.89fr;
      gap: 4px;
      padding-left: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--hand {
      top: 0;
      height: 94%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--neck {
      top: 3%;
      height: 97%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--ear {
      top: 0;
      height: 95%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      padding: 8px 20px 0;
      transform: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker {
      gap: 9px;
      margin-bottom: 12px;
      font-size: 0.55rem;
      letter-spacing: 0.12em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
      width: 21px;
      flex-basis: 21px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: none;
      font-size: clamp(2.65rem, 11vw, 3.2rem);
      line-height: 0.92;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title span:last-child {
      width: auto;
      max-width: none;
      margin-top: 3px;
      margin-left: 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 46ch;
      margin-top: 15px;
      font-size: 0.78rem;
      line-height: 1.42;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__actions {
      display: grid;
      gap: 13px;
      margin-top: 19px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      width: 100%;
      min-height: 48px;
      padding: 12px 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__secondary {
      width: max-content;
      max-width: 100%;
      font-size: 0.73rem;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proofs {
      gap: 5px 10px;
      margin-top: 18px;
      font-size: 0.52rem;
      letter-spacing: 0.025em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proof:last-child {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-facet {
      animation: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary,
    #MilauraPortal-{{ section.id }} .portal-hero__secondary::after {
      transition: none;
    }
  }
{%- endstyle -%}

<div id="MilauraPortal-{{ section.id }}" class="milaura-portal-hero">
  <div class="portal-hero__stage">
    <div class="portal-hero__visual" aria-hidden="true">
      <div class="portal-facet portal-facet--hand" style="--facet-order: 1;">
        <img
          class="portal-facet__image"
          {% if section.settings.image != blank %}
            src="{{ section.settings.image | image_url: width: 1800 }}"
          {% else %}
            src="{{ 'milaura-hero-triptych-prototype-v2.webp' | asset_url }}"
          {% endif %}
          width="{{ hero_image_width }}"
          height="{{ hero_image_height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
        >
        <span class="portal-facet__veil"></span>
      </div>

      <div class="portal-facet portal-facet--neck" style="--facet-order: 2;">
        <img
          class="portal-facet__image"
          {% if section.settings.image != blank %}
            src="{{ section.settings.image | image_url: width: 1800 }}"
          {% else %}
            src="{{ 'milaura-hero-triptych-prototype-v2.webp' | asset_url }}"
          {% endif %}
          width="{{ hero_image_width }}"
          height="{{ hero_image_height }}"
          alt=""
          loading="eager"
        >
        <span class="portal-facet__veil"></span>
      </div>

      <div class="portal-facet portal-facet--ear" style="--facet-order: 3;">
        <img
          class="portal-facet__image"
          {% if section.settings.image != blank %}
            src="{{ section.settings.image | image_url: width: 1800 }}"
          {% else %}
            src="{{ 'milaura-hero-triptych-prototype-v2.webp' | asset_url }}"
          {% endif %}
          width="{{ hero_image_width }}"
          height="{{ hero_image_height }}"
          alt=""
          loading="eager"
        >
        <span class="portal-facet__veil"></span>
      </div>
    </div>

    <div class="portal-hero__copy">
      <p class="portal-hero__kicker">
        {{ section.settings.kicker | default: 'MilAura • Bijoux, gemmes & lithothérapie' }}
      </p>

      <h1 class="portal-hero__title">
        <span>{{ section.settings.title_line_1 | default: 'La beauté d’un bijou.' }}</span>
        <span>{{ section.settings.title_line_2 | default: 'Les vertus d’une pierre.' }}</span>
      </h1>

      <p class="portal-hero__body">
        {{ section.settings.body | default: 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.' }}
      </p>

      <div class="portal-hero__actions">
        <a class="portal-hero__primary" href="{{ primary_url }}">
          {{ section.settings.primary_label | default: 'Découvrir les bijoux' }}
        </a>
        <a class="portal-hero__secondary" href="{{ secondary_url }}">
          {{ section.settings.secondary_label | default: 'Trouver la pierre qui me correspond' }}
        </a>
      </div>

      <div class="portal-hero__proofs" aria-label="Les engagements MilAura">
        <span class="portal-hero__proof">{{ section.settings.proof_1 | default: 'Pierres naturelles certifiées' }}</span>
        <span class="portal-hero__proof">{{ section.settings.proof_2 | default: 'Préparées par Karine' }}</span>
        <span class="portal-hero__proof">{{ section.settings.proof_3 | default: 'Expédiées depuis les Vosges' }}</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero de marque MilAura",
  "tag": "section",
  "class": "milaura-hero-homepage",
  "settings": [
    {
      "type": "header",
      "content": "Positionnement"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Surtitre",
      "default": "MilAura • Bijoux, gemmes & lithothérapie"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Titre, première ligne",
      "default": "La beauté d’un bijou."
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Titre, seconde ligne",
      "default": "Les vertus d’une pierre."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Bouton principal",
      "default": "Découvrir les bijoux"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Lien principal"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Lien secondaire",
      "default": "Trouver la pierre qui me correspond"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Destination secondaire"
    },
    {
      "type": "header",
      "content": "Preuves"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "Preuve 1",
      "default": "Pierres naturelles certifiées"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Preuve 2",
      "default": "Préparées par Karine"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Preuve 3",
      "default": "Expédiées depuis les Vosges"
    },
    {
      "type": "header",
      "content": "Triptyque taillé"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photographie générale"
    },
    {
      "type": "text",
      "id": "panel_hand_position",
      "label": "Cadrage main et bracelet",
      "default": "16% 52%"
    },
    {
      "type": "text",
      "id": "panel_neck_position",
      "label": "Cadrage collier",
      "default": "50% 54%"
    },
    {
      "type": "text",
      "id": "panel_ear_position",
      "label": "Cadrage boucles d’oreilles",
      "default": "84% 40%"
    }
  ],
  "presets": [
    {
      "name": "Hero de marque MilAura"
    }
  ]
}
{% endschema %}
