{%- liquid
  assign primary_url = section.settings.primary_link
  if primary_url == blank
    assign primary_url = '#MilauraSelectionAtelier'
  endif

  assign panel_aventurine_width = 768
  assign panel_aventurine_height = 1152
  if section.settings.panel_aventurine_image != blank
    assign panel_aventurine_width = section.settings.panel_aventurine_image.width
    assign panel_aventurine_height = section.settings.panel_aventurine_image.height
  endif

  assign panel_quartz_width = 768
  assign panel_quartz_height = 1152
  if section.settings.panel_quartz_image != blank
    assign panel_quartz_width = section.settings.panel_quartz_image.width
    assign panel_quartz_height = section.settings.panel_quartz_image.height
  endif

  assign panel_object_width = 768
  assign panel_object_height = 1152
  if section.settings.panel_object_image != blank
    assign panel_object_width = section.settings.panel_object_image.width
    assign panel_object_height = section.settings.panel_object_image.height
  endif
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Dancing';
    src: url('{{ 'milaura-dancing-script-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MilauraPortal-{{ section.id }} {
    --portal-nacre: #fbf8f3;
    --portal-paper: #fffdf9;
    --portal-ink: #2f222d;
    --portal-gold: #b9975b;
    --portal-aqua: #6fa9a6;
    --portal-aqua-deep: #3f7474;
    --portal-aqua-soft: #dce9e7;
    --portal-quartz: #d7b8b1;
    --portal-amethyst: #7a4d82;
    position: relative;
    isolation: isolate;
    min-height: clamp(690px, calc(100svh - 148px), 860px);
    overflow: hidden;
    color: var(--portal-ink);
    background: var(--portal-nacre);
    font-family: 'MilAura Instrument', sans-serif;
  }

  @media screen and (min-width: 1101px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    }
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__stage {
    position: relative;
    width: min(100%, 1680px);
    min-height: inherit;
    margin: 0 auto;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: absolute;
    top: 47%;
    left: clamp(42px, 6vw, 104px);
    z-index: 3;
    width: min(46%, 690px);
    transform: translateY(-50%);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker {
    display: block;
    margin: 0 0 16px;
    color: var(--portal-amethyst);
    font-family: 'MilAura Dancing', cursive;
    font-size: clamp(2.125rem, 2.4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__kicker::before {
    content: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 10ch;
    margin: 0;
    color: var(--portal-ink);
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(4rem, 5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.93;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title span {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title span:last-child {
    width: max-content;
    max-width: 9.6ch;
    margin-top: 2px;
    margin-left: clamp(24px, 3vw, 50px);
    color: var(--portal-aqua-deep);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 48ch;
    margin: clamp(22px, 2vw, 28px) 0 0;
    color: rgba(47, 34, 45, 0.84);
    font-size: clamp(1.1875rem, 1.2vw, 1.3125rem);
    font-weight: 460;
    letter-spacing: -0.012em;
    line-height: 1.5;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin-top: 24px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 25px;
    border: 1px solid var(--portal-gold);
    border-radius: 999px;
    color: var(--portal-ink);
    background: var(--portal-gold);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: 0.045em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:hover {
    color: var(--portal-paper);
    background: var(--portal-ink);
    transform: translateY(-2px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__primary:focus-visible {
    outline: 2px solid var(--portal-aqua);
    outline-offset: 5px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proofs {
    display: grid;
    gap: 8px;
    max-width: 34rem;
    margin: 24px 0 0;
    padding: 0;
    color: rgba(47, 34, 45, 0.84);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
    list-style: none;
    text-transform: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-height: 24px;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__proof::before {
    content: '✓';
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(185, 151, 91, 0.68);
    border-radius: 50%;
    color: #725927;
    background: rgba(255, 253, 249, 0.78);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 58%;
    display: grid;
    grid-template-columns: 0.84fr 1.04fr 0.92fr;
    gap: 6px;
    padding-left: 28px;
    overflow: hidden;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 1px;
    background: rgba(185, 151, 91, 0.46);
    transform: rotate(5deg) scaleY(1.08);
    transform-origin: center;
  }

  #MilauraPortal-{{ section.id }} .portal-facet {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    background: #e7e1d8;
    animation: milauraFacetSettle 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--facet-order) * 90ms);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand {
    top: 7%;
    height: 93%;
    clip-path: polygon(12% 0, 100% 4%, 91% 100%, 0 94%, 5% 46%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck {
    height: 96%;
    clip-path: polygon(14% 0, 100% 0, 93% 91%, 81% 100%, 0 96%, 7% 43%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--object {
    top: 4%;
    height: 96%;
    clip-path: polygon(9% 3%, 100% 0, 100% 100%, 0 94%, 6% 52%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.035);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--hand .portal-facet__image {
    object-position: var(--panel-position, 50% 50%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--neck .portal-facet__image {
    object-position: var(--panel-position, 50% 50%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet--object .portal-facet__image {
    object-position: var(--panel-position, 50% 50%);
  }

  #MilauraPortal-{{ section.id }} .portal-facet__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 253, 249, 0.26);
  }

  @keyframes milauraFacetSettle {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 1100px) and (min-width: 768px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 760px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      left: 42px;
      width: 49%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: clamp(3.75rem, 6.8vw, 5.2rem);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      width: 55%;
      padding-left: 16px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proofs {
      max-width: 31rem;
    }
  }

  @media screen and (max-width: 767px) {
    #MilauraPortal-{{ section.id }} {
      min-height: 0;
      overflow: visible;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__stage {
      min-height: 0;
      padding-bottom: 28px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual {
      position: relative;
      width: 100%;
      height: clamp(270px, 34svh, 315px);
      grid-template-columns: 0.86fr 1.05fr 0.89fr;
      gap: 4px;
      padding-left: 0;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__visual::before {
      display: none;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--hand {
      top: 0;
      height: 94%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--neck {
      top: 3%;
      height: 97%;
    }

    #MilauraPortal-{{ section.id }} .portal-facet--object {
      top: 0;
      height: 95%;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      padding: 12px 20px 0;
      transform: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__kicker {
      margin-bottom: 10px;
      font-size: clamp(1.875rem, 8.2vw, 2.25rem);
      line-height: 1.08;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: none;
      font-size: clamp(2.8rem, 11.4vw, 3.35rem);
      line-height: 0.95;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title span:last-child {
      width: auto;
      max-width: none;
      margin-top: 3px;
      margin-left: 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 46ch;
      margin-top: 16px;
      font-size: 1.125rem;
      line-height: 1.5;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__actions {
      display: grid;
      gap: 13px;
      margin-top: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      width: 100%;
      min-height: 48px;
      padding: 12px 20px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__proofs {
      gap: 7px;
      margin-top: 18px;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-facet {
      animation: none;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__primary {
      transition: none;
    }
  }
{%- endstyle -%}

<div id="MilauraPortal-{{ section.id }}" class="milaura-portal-hero">
  <div class="portal-hero__stage">
    <div class="portal-hero__visual" aria-hidden="true">
      <div
        class="portal-facet portal-facet--hand"
        style="--facet-order: 1; --panel-position: {% if section.settings.panel_aventurine_image != blank %}{{ section.settings.panel_hand_position | default: '50% 50%' }}{% else %}50% 50%{% endif %};"
      >
        <img
          class="portal-facet__image"
          {% if section.settings.panel_aventurine_image != blank %}
            src="{{ section.settings.panel_aventurine_image | image_url: width: 1200 }}"
          {% else %}
            src="{{ 'milaura-hero-aventurine-halo-worn-v1.webp' | asset_url }}"
          {% endif %}
          width="{{ panel_aventurine_width }}"
          height="{{ panel_aventurine_height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
        <span class="portal-facet__veil"></span>
      </div>

      <div
        class="portal-facet portal-facet--neck"
        style="--facet-order: 2; --panel-position: {% if section.settings.panel_quartz_image != blank %}{{ section.settings.panel_neck_position | default: '50% 50%' }}{% else %}50% 50%{% endif %};"
      >
        <img
          class="portal-facet__image"
          {% if section.settings.panel_quartz_image != blank %}
            src="{{ section.settings.panel_quartz_image | image_url: width: 1200 }}"
          {% else %}
            src="{{ 'milaura-hero-quartz-rose-boho-worn-v1.webp' | asset_url }}"
          {% endif %}
          width="{{ panel_quartz_width }}"
          height="{{ panel_quartz_height }}"
          alt=""
          loading="eager"
          decoding="async"
        >
        <span class="portal-facet__veil"></span>
      </div>

      <div
        class="portal-facet portal-facet--object"
        style="--facet-order: 3; --panel-position: {% if section.settings.panel_object_image != blank %}{{ section.settings.panel_ear_position | default: '50% 50%' }}{% else %}50% 50%{% endif %};"
      >
        <img
          class="portal-facet__image"
          {% if section.settings.panel_object_image != blank %}
            src="{{ section.settings.panel_object_image | image_url: width: 1200 }}"
          {% else %}
            src="{{ 'milaura-hero-soap-amethyst-v1.webp' | asset_url }}"
          {% endif %}
          width="{{ panel_object_width }}"
          height="{{ panel_object_height }}"
          alt=""
          loading="eager"
          decoding="async"
        >
        <span class="portal-facet__veil"></span>
      </div>
    </div>

    <div class="portal-hero__copy">
      <p class="portal-hero__kicker">
        {{ section.settings.kicker | default: 'MilAura • Bijoux, gemmes & lithothérapie' }}
      </p>

      <h1 class="portal-hero__title">
        <span>{{ section.settings.title_line_1 | default: 'La beauté d’un bijou.' }}</span>
        <span>{{ section.settings.title_line_2 | default: 'Les vertus d’une pierre.' }}</span>
      </h1>

      <p class="portal-hero__body">
        {{ section.settings.body | default: 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.' }}
      </p>

      <ul class="portal-hero__proofs" aria-label="Les engagements MilAura">
        <li class="portal-hero__proof">{{ section.settings.proof_1 | default: 'Pierres naturelles certifiées' }}</li>
        <li class="portal-hero__proof">{{ section.settings.proof_2 | default: 'Préparées par Karine' }}</li>
        <li class="portal-hero__proof">{{ section.settings.proof_3 | default: 'Expédiées depuis notre atelier en France' }}</li>
      </ul>

      <div class="portal-hero__actions">
        <a class="portal-hero__primary" href="{{ primary_url }}">
          {{ section.settings.primary_label | default: 'Voir la sélection de l’atelier' }}
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero de marque MilAura",
  "tag": "section",
  "class": "milaura-hero-homepage",
  "settings": [
    {
      "type": "header",
      "content": "Positionnement"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Surtitre",
      "default": "MilAura • Bijoux, gemmes & lithothérapie"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Titre, première ligne",
      "default": "La beauté d’un bijou."
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Titre, seconde ligne",
      "default": "Les vertus d’une pierre."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Bouton principal",
      "default": "Voir la sélection de l’atelier"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Lien principal"
    },
    {
      "type": "header",
      "content": "Preuves"
    },
    {
      "type": "text",
      "id": "proof_1",
      "label": "Preuve 1",
      "default": "Pierres naturelles certifiées"
    },
    {
      "type": "text",
      "id": "proof_2",
      "label": "Preuve 2",
      "default": "Préparées par Karine"
    },
    {
      "type": "text",
      "id": "proof_3",
      "label": "Preuve 3",
      "default": "Expédiées depuis notre atelier en France"
    },
    {
      "type": "header",
      "content": "Triptyque produits exacts"
    },
    {
      "type": "image_picker",
      "id": "panel_aventurine_image",
      "label": "Panneau bracelet aventurine"
    },
    {
      "type": "image_picker",
      "id": "panel_quartz_image",
      "label": "Panneau collier quartz rose"
    },
    {
      "type": "image_picker",
      "id": "panel_object_image",
      "label": "Panneau objet améthyste"
    },
    {
      "type": "text",
      "id": "panel_hand_position",
      "label": "Cadrage bracelet personnalisé",
      "default": "50% 50%"
    },
    {
      "type": "text",
      "id": "panel_neck_position",
      "label": "Cadrage collier personnalisé",
      "default": "50% 50%"
    },
    {
      "type": "text",
      "id": "panel_ear_position",
      "label": "Cadrage objet personnalisé",
      "default": "50% 50%"
    }
  ],
  "presets": [
    {
      "name": "Hero de marque MilAura"
    }
  ]
}
{% endschema %}
