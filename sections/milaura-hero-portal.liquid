{%- liquid
  assign hero_eyebrow = section.settings.eyebrow | default: 'Bijoux & émotions'
  assign hero_signature = section.settings.signature | default: 'MilAura'
  assign hero_title_first = section.settings.title_first | default: 'La beauté des bijoux'
  assign hero_title_second = section.settings.title_second | default: 'rencontre les vertus des minéraux'
  assign hero_body_standard = 'Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
  assign hero_body = section.settings.body | default: hero_body_standard
  if hero_title_second == blank or hero_title_second == 'rencontre la lithothérapie.'
    assign hero_title_second = 'rencontre les vertus des minéraux'
  endif

  if hero_body == blank or hero_body == 'Bagues, bracelets, colliers et boucles d’oreilles en pierres naturelles, choisis pour leur beauté, leur qualité et leur symbolique en lithothérapie.'
    assign hero_body = hero_body_standard
  endif
-%}

{%- style -%}
  #MainContent > .shopify-section.milaura-hero-homepage {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--header-height-desktop, 110px) * -1) !important;
    overflow: visible;
    background: var(--milaura-aigue-profonde);
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .shopify-section {
    margin-top: 0;
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .shopify-section::before {
    content: none !important;
  }

  #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
    padding-top: clamp(48px, 4.2vw, 62px) !important;
  }

  #MilauraPortal-{{ section.id }} {
    position: relative;
    min-height: calc(100svh - var(--milaura-announcement-height, 48px));
    overflow: hidden;
    isolation: isolate;
    color: var(--milaura-nacre);
    background: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
  }

  #MilauraPortal-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides,
  #MilauraPortal-{{ section.id }} .portal-hero__media,
  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    position: absolute;
    inset: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__slides {
    z-index: 0;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media {
    visibility: hidden;
    opacity: 0;
    transform: scale(1.012);
    transition:
      opacity 700ms ease,
      transform 1400ms cubic-bezier(0.2, 0.75, 0.2, 1),
      visibility 0s linear 700ms;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__media.is-active {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__veil {
    z-index: 1;
    background: var(--milaura-aigue-profonde);
    opacity: 0.13;
    pointer-events: none;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__copy {
    position: relative;
    z-index: 2;
    width: min(620px, 46vw);
    padding-top: calc(84px + clamp(72px, 11svh, 128px));
    margin-left: clamp(48px, 7vw, 112px);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity {
    display: flex;
    align-items: center;
    gap: var(--milaura-esp-xs);
    margin: 0 0 var(--milaura-esp-sm);
    white-space: nowrap;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
    margin: 0;
    color: var(--milaura-nacre);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__identity-dot {
    display: block;
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--milaura-or);
  }

  #MilauraPortal-{{ section.id }} .portal-hero__signature {
    margin: 0;
    color: var(--milaura-or-clair);
    font-family: var(--milaura-font-signature);
    font-size: clamp(27px, 2.1vw, 35px);
    font-weight: 600;
    line-height: 1;
    transform: rotate(-1.3deg);
    transform-origin: left center;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title {
    max-width: 610px;
    margin: 0;
    color: var(--milaura-nacre);
    font-family: var(--milaura-font-display);
    font-size: clamp(52px, 5vw, 76px);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: -0.035em;
    line-height: 0.99;
    text-wrap: balance;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__title-line {
    display: block;
  }

  #MilauraPortal-{{ section.id }} .portal-hero__body {
    max-width: 530px;
    margin: var(--milaura-esp-md) 0 0;
    color: var(--milaura-nacre);
    font-size: clamp(15px, 1.25vw, 18px);
    font-weight: 400;
    letter-spacing: 0.004em;
    line-height: 1.55;
    opacity: 0.9;
  }

  /* La navigation conserve ses liens et ses fonctions. Seule sa surface
     devient editoriale et reste aigue-marine sur la homepage. */
  [id^='MilauraNav-'].milaura-home-hero-nav {
    padding: 0 !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper {
    width: 100% !important;
    max-width: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    animation: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-snake-wrapper::before {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
    min-height: 84px !important;
    padding: 0 clamp(32px, 5.5vw, 88px) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-mineral) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    transition:
      background-color var(--milaura-transition-rapide),
      box-shadow var(--milaura-transition-rapide);
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
    height: 50px !important;
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    color: var(--milaura-nacre) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-link--nouveautes::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
    min-height: var(--milaura-cible-tactile) !important;
    padding: var(--milaura-esp-xs) var(--milaura-esp-sm) !important;
    border: 0 !important;
    border-bottom: var(--milaura-filet-or) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::before,
  [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge::after {
    content: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
    color: inherit !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-inner {
    background: color-mix(in srgb, var(--milaura-nacre) 16%, transparent) !important;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--milaura-nacre) 24%, transparent) !important;
    backdrop-filter: blur(12px) saturate(112%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(112%) !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
    filter: none !important;
  }

  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-text,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-link,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-icon,
  [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-quiz-badge {
    color: var(--milaura-prune) !important;
  }

  @media screen and (max-width: 1100px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-tablet, 88px) * -1) !important;
    }
  }

  @media screen and (max-width: 820px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: calc(var(--header-height-mobile, 80px) * -1) !important;
    }

    #MilauraPortal-{{ section.id }} {
      min-height: calc(100svh - var(--milaura-announcement-height, 52px));
    }

    #MilauraPortal-{{ section.id }} .portal-hero__veil {
      opacity: 0.12;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      width: auto;
      padding-top: calc(62px + clamp(25px, 4.2svh, 36px));
      margin: 0 22px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__identity {
      gap: 9px;
      margin-bottom: var(--milaura-esp-xs);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__eyebrow {
      font-size: 9px;
      letter-spacing: 0.125em;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__signature {
      font-size: clamp(22px, 5.8vw, 25px);
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      max-width: 350px;
      font-size: clamp(37px, 10vw, 39px);
      line-height: 0.98;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      width: calc(100vw - 36px);
      max-width: 354px;
      margin: 10px 0 0;
      font-size: clamp(10px, 2.8vw, 11.7px);
      letter-spacing: -0.004em;
      line-height: 1.38;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body-line {
      display: block;
      white-space: nowrap;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__media--stone .portal-hero__image {
      transform: translateY(-70px);
    }

    #MainContent > .shopify-section.milaura-hero-homepage + .section-milaura-selection-atelier .milaura-season__shell {
      padding-top: 42px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      height: 62px !important;
      min-height: 62px !important;
      padding: 0 18px !important;
      gap: var(--milaura-esp-xs);
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 64px !important;
      min-height: 62px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 48px !important;
      transform: none !important;
      filter: none !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      min-height: var(--milaura-cible-tactile) !important;
      padding: 10px var(--milaura-esp-xs) !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 10px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav.is-home-hero-scrolled .nav-logo-img {
      filter: none !important;
    }
  }

  @media screen and (max-width: 480px) {
    #MainContent > .shopify-section.milaura-hero-homepage {
      margin-top: -74px !important;
    }
  }

  @media screen and (max-width: 360px) {
    #MilauraPortal-{{ section.id }} .portal-hero__copy {
      padding-top: 85px;
      margin-right: 18px;
      margin-left: 18px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__title {
      font-size: 37px;
    }

    #MilauraPortal-{{ section.id }} .portal-hero__body {
      max-width: 302px;
      font-size: 11.8px;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-link {
      min-width: 58px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-logo-img {
      height: 44px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .nav-quiz-badge {
      padding-right: 9px !important;
      padding-left: 9px !important;
    }

    [id^='MilauraNav-'].milaura-home-hero-nav .badge-title {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraPortal-{{ section.id }} .portal-hero__media,
    [id^='MilauraNav-'].milaura-home-hero-nav .nav-inner {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraPortal-{{ section.id }}"
  class="milaura-portal-hero"
  aria-labelledby="MilauraPortalTitle-{{ section.id }}"
  data-milaura-home-hero
>
  <div class="portal-hero__slides" aria-hidden="true">
    <picture class="portal-hero__media portal-hero__media--stone is-active">
      <source
        media="(max-width: 820px)"
        srcset="{{ 'milaura-home-hero-v2-stone-mobile.webp' | asset_url }}"
      >
      <img
        class="portal-hero__image"
        src="{{ 'milaura-home-hero-v2-stone-desktop.webp' | asset_url }}"
        width="1672"
        height="941"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      >
    </picture>

  </div>

  <div class="portal-hero__veil" aria-hidden="true"></div>

  <div class="portal-hero__copy">
    <div class="portal-hero__identity">
      <p class="portal-hero__signature" aria-hidden="true">{{ hero_signature | escape }}</p>
      <span class="portal-hero__identity-dot" aria-hidden="true"></span>
      <p class="portal-hero__eyebrow">{{ hero_eyebrow | escape }}</p>
    </div>
    <h1 class="portal-hero__title" id="MilauraPortalTitle-{{ section.id }}">
      <span class="portal-hero__title-line">{{ hero_title_first | escape }}</span>
      <span class="portal-hero__title-line">{{ hero_title_second | escape }}</span>
    </h1>
    <p class="portal-hero__body">
      {%- if hero_body == hero_body_standard -%}
        <span class="portal-hero__body-line">Des pierres naturelles choisies avec exigence pour leur beauté,</span>
        <span class="portal-hero__body-line">leur qualité et leur symbolique en lithothérapie.</span>
      {%- else -%}
        {{- hero_body | escape -}}
      {%- endif -%}
    </p>
  </div>

</section>

<script>
  (() => {
    const root = document.getElementById('MilauraPortal-{{ section.id }}');
    if (!root) return;

    const header = document.querySelector('[id^="MilauraNav-"]');
    const controller = new AbortController();
    let scrollFrame = 0;

    const updateHeader = () => {
      scrollFrame = 0;
      if (!header) return;
      header.classList.toggle('is-home-hero-scrolled', window.scrollY > 24);
    };

    const scheduleHeaderUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateHeader);
    };

    if (header) {
      header.classList.add('milaura-home-hero-nav');
      updateHeader();
      window.addEventListener('scroll', scheduleHeaderUpdate, {
        passive: true,
        signal: controller.signal,
      });
    }

    document.addEventListener(
      'shopify:section:unload',
      (event) => {
        if (!event.target.contains(root)) return;

        controller.abort();
        if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
        if (header) {
          header.classList.remove('milaura-home-hero-nav', 'is-home-hero-scrolled');
        }
      },
      { signal: controller.signal }
    );
  })();
</script>

{% schema %}
{
  "name": "Hero de marque MilAura",
  "tag": "section",
  "class": "milaura-hero-homepage",
  "settings": [
    {
      "type": "header",
      "content": "Message de marque"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Slogan",
      "default": "Bijoux & émotions"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "MilAura"
    },
    {
      "type": "text",
      "id": "title_first",
      "label": "Titre, première ligne",
      "default": "La beauté des bijoux"
    },
    {
      "type": "text",
      "id": "title_second",
      "label": "Titre, seconde ligne",
      "default": "rencontre les vertus des minéraux"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Texte",
      "default": "Des pierres naturelles choisies avec exigence pour leur beauté, leur qualité et leur symbolique en lithothérapie."
    }
  ],
  "presets": [
    {
      "name": "Hero de marque MilAura"
    }
  ]
}
{% endschema %}
