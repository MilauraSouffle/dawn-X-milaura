{%- comment -%}
  Fragment HTML d'un produit recemment consulte.
  Le produit est resolu par Shopify depuis son URL au moment du rendu.
{%- endcomment -%}

<div data-milaura-recent-fragment>
  {%- if product != blank and product.available and product.featured_image != blank -%}
    {% render 'milaura-recommendation-card',
      recommendation_product: product,
      recommendation_intent: 'recent',
      recommendation_role: 'secondary',
      img_loading: 'lazy',
      show_purchase: false
    %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Milaura recent fragment",
  "tag": "section",
  "class": "milaura-recent-fragment-section",
  "settings": []
}
{% endschema %}
