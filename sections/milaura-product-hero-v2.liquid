{{ 'milaura-product-pdp-v2.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'milaura-product-pdp-v2.js' | asset_url }}" defer="defer"></script>

{%- capture pdp_family -%}{%- render 'milaura-pdp-family', product: product -%}{%- endcapture -%}
{%- assign pdp_family = pdp_family | strip -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'MilauraPdpForm-' | append: section.id
  assign installment_form_id = 'MilauraPdpInstallment-' | append: section.id
  assign social_count_raw = product.id | default: 0 | modulo: 130
  assign social_count = social_count_raw | plus: 12
  assign hero_stone_name = product.metafields.milaura.stone_name.value
  assign hero_stone_handle = product.metafields.milaura.stone_handle.value | default: product.metafields.milaura.stone_handle
  assign hero_materials = product.metafields.milaura.materials.value
  assign hero_specifications = product.metafields.milaura.specifications.value
  assign social_subject = 'ce produit'
  case pdp_family
    when 'bijou'
      assign social_subject = 'cette pièce'
    when 'pierre-mineral'
      assign social_subject = 'ce minéral'
    when 'bougie-senteur'
      assign social_subject = 'cette bougie'
    when 'soin'
      assign social_subject = 'ce soin'
  endcase
  assign has_natural_stone = false
  if hero_stone_name != blank or hero_stone_handle != blank
    assign has_natural_stone = true
  endif
  assign media_manifest = product.metafields.milaura.pdp_media_manifest.value
  assign manifest_gallery_slots = media_manifest.groups.commercial_gallery
  assign use_media_manifest = false
  if media_manifest.slots.size == 9 and manifest_gallery_slots.size == 5
    assign use_media_manifest = true
  endif
-%}

<section
  id="MilauraPdpHero-{{ section.id }}"
  class="milaura-pdp-hero"
  data-milaura-pdp-root
  data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-pdp-family="{{ pdp_family | escape }}"
>
  <div class="milaura-pdp-hero__layout">
    <div class="milaura-pdp-gallery" data-pdp-gallery>
      <div
        class="milaura-pdp-gallery__track"
        data-pdp-gallery-track
        data-media-contract-source="{% if use_media_manifest %}manifest{% else %}legacy-position{% endif %}"
      >
        {%- assign rendered_hero_count = 0 -%}
        {%- if use_media_manifest -%}
          {%- for gallery_slot_id in manifest_gallery_slots limit: 5 -%}
            {%- liquid
              assign manifest_slot = blank
              for candidate_slot in media_manifest.slots
                if candidate_slot.slot_id == gallery_slot_id
                  assign manifest_slot = candidate_slot
                  break
                endif
              endfor
              if manifest_slot != blank
                assign rendered_hero_count = rendered_hero_count | plus: 1
              endif
              assign image_loading = 'lazy'
              assign image_fetchpriority = 'auto'
              if rendered_hero_count == 1
                assign image_loading = 'eager'
                assign image_fetchpriority = 'high'
              endif
            -%}
            {%- if manifest_slot != blank -%}
              <figure
                id="MilauraPdpSlide-{{ section.id }}-{{ rendered_hero_count }}"
                class="milaura-pdp-gallery__slide"
                data-pdp-slide
                data-media-slot="{{ manifest_slot.slot_id | escape }}"
              >
                {%- render 'milaura-pdp-manifest-image',
                  manifest_slot: manifest_slot,
                  product_media: product.media,
                  image_class: 'milaura-pdp-gallery__image',
                  image_widths: '480, 720, 960, 1280, 1600, 2048',
                  image_sizes: '(max-width: 989px) 100vw, 38vw',
                  image_max_width: 2048,
                  image_loading: image_loading,
                  image_fetchpriority: image_fetchpriority,
                  fallback_alt: product.title
                -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for legacy_media in product.media limit: 5 -%}
            {%- if legacy_media.media_type == 'image' -%}
              {%- liquid
                assign rendered_hero_count = rendered_hero_count | plus: 1
                assign legacy_slot_id = 'H0' | append: rendered_hero_count
                assign image_loading = 'lazy'
                assign image_fetchpriority = 'auto'
                if rendered_hero_count == 1
                  assign image_loading = 'eager'
                  assign image_fetchpriority = 'high'
                endif
              -%}
              <figure
                id="MilauraPdpSlide-{{ section.id }}-{{ rendered_hero_count }}"
                class="milaura-pdp-gallery__slide"
                data-pdp-slide
                data-media-slot="{{ legacy_slot_id }}"
              >
                {%- render 'milaura-pdp-manifest-image',
                  product_media: product.media,
                  fallback_media: legacy_media,
                  image_class: 'milaura-pdp-gallery__image',
                  image_widths: '480, 720, 960, 1280, 1600, 2048',
                  image_sizes: '(max-width: 989px) 100vw, 38vw',
                  image_max_width: 2048,
                  image_loading: image_loading,
                  image_fetchpriority: image_fetchpriority,
                  fallback_alt: product.title
                -%}
              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if rendered_hero_count > 1 -%}
        <nav class="milaura-pdp-gallery__pagination" aria-label="Vues du produit">
          <div class="milaura-pdp-gallery__pages" role="tablist">
            {%- for page_number in (1..rendered_hero_count) -%}
              <button
                class="milaura-pdp-gallery__page{% if forloop.first %} is-active{% endif %}"
                type="button"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="MilauraPdpSlide-{{ section.id }}-{{ page_number }}"
                aria-label="Afficher la vue {{ page_number }} sur {{ rendered_hero_count }}"
                data-pdp-page="{{ page_number | minus: 1 }}"
              ><span></span></button>
            {%- endfor -%}
          </div>
          <p class="milaura-pdp-gallery__counter" aria-live="polite">
            <span data-pdp-current>1</span><span aria-hidden="true"> / </span><span>{{ rendered_hero_count }}</span>
          </p>
        </nav>
      {%- endif -%}

      {%- if has_natural_stone -%}
        <aside class="milaura-pdp-variation-note" aria-label="Information sur les variations naturelles">
          <span class="milaura-pdp-variation-note__icon" aria-hidden="true">i</span>
          <p class="milaura-pdp-variation-note__text">
            Chaque pierre naturelle possède ses propres nuances, son veinage et parfois une forme légèrement
            différente. C’est ce qui donne à chaque pièce son caractère.
          </p>
        </aside>
      {%- endif -%}
    </div>

    <div class="milaura-pdp-buy" data-pdp-buy-panel>
      <div class="milaura-pdp-buy__header">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="milaura-pdp-buy__eyebrow milaura-label">{{ product.vendor | escape }}</p>
        {%- endif -%}
        <h1 class="milaura-pdp-buy__title">{{ product.title | escape }}</h1>

        <div class="milaura-pdp-price" aria-live="polite">
          <span class="milaura-pdp-price__current" data-pdp-price>{{ selected_variant.price | money }}</span>
          <s
            class="milaura-pdp-price__compare"
            data-pdp-compare-price
            {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}
          >
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              {{ selected_variant.compare_at_price | money }}
            {%- endif -%}
          </s>
        </div>

        <p class="milaura-pdp-availability{% unless selected_variant.available %} is-unavailable{% endunless %}" data-pdp-availability>
          <span class="milaura-pdp-availability__dot" aria-hidden="true"></span>
          <span data-pdp-availability-text>
            {%- if selected_variant.available -%}Disponible{%- else -%}Épuisé{%- endif -%}
          </span>
        </p>

      </div>

      <product-form class="milaura-pdp-form" data-pdp-product-form>
        <div class="product-form__error-message-wrapper" role="alert" hidden>
          <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
          <span class="product-form__error-message"></span>
        </div>

        {%- form 'product',
          product,
          id: product_form_id,
          class: 'milaura-pdp-form__form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ selected_variant.id }}"
            class="product-variant-id"
            data-pdp-variant-input
          >

          {%- unless product.has_only_default_variant -%}
            <div class="milaura-pdp-field">
              <label class="milaura-pdp-field__label" for="MilauraVariant-{{ section.id }}">Choisir le modèle</label>
              <div class="milaura-pdp-select-wrap">
                <select id="MilauraVariant-{{ section.id }}" class="milaura-pdp-select" data-pdp-variant-select>
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                      data-available="{{ variant.available }}"
                      {% if variant.id == selected_variant.id %}selected{% endif %}
                    >
                      {{- variant.title | escape -}}
                      {%- unless variant.available %} · Épuisé{% endunless -%}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="milaura-pdp-select-wrap__icon" aria-hidden="true">↓</span>
              </div>
            </div>
          {%- endunless -%}

          <div class="milaura-pdp-form__actions">
            {%- if section.settings.show_quantity -%}
              <div class="milaura-pdp-quantity" data-pdp-quantity>
                <button type="button" aria-label="Réduire la quantité" data-pdp-quantity-minus>−</button>
                <input
                  id="MilauraQuantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  min="1"
                  value="1"
                  inputmode="numeric"
                  aria-label="Quantité"
                  data-pdp-quantity-input
                >
                <button type="button" aria-label="Augmenter la quantité" data-pdp-quantity-plus>+</button>
              </div>
            {%- endif -%}

            <button
              id="MilauraPdpSubmit-{{ section.id }}"
              type="submit"
              name="add"
              class="milaura-pdp-submit"
              data-pdp-submit
              {% unless selected_variant.available %}disabled{% endunless %}
            >
              <span data-pdp-submit-text>
                {%- if selected_variant.available -%}Ajouter au panier{%- else -%}Épuisé{%- endif -%}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          </div>

          {%- if section.settings.shipping_note != blank -%}
            <p class="milaura-pdp-form__note">{{ section.settings.shipping_note | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      </product-form>

      {%- form 'product', product, id: installment_form_id, class: 'milaura-pdp-installment' -%}
        <input type="hidden" name="id" value="{{ selected_variant.id }}" data-pdp-variant-input>
        {{ form | payment_terms }}
      {%- endform -%}

      {%- if section.settings.show_social_proof -%}
        <div class="milaura-pdp-social" aria-label="Preuve sociale MilAura">
          <span class="milaura-pdp-social__stars" aria-hidden="true">★★★★★</span>
          <p>Plus de <strong>{{ social_count }}</strong> clientes et clients ont déjà choisi {{ social_subject }}.</p>
        </div>
      {%- endif -%}

      {%- if hero_stone_name != blank or hero_stone_handle != blank or hero_materials != blank or hero_specifications != blank -%}
        <dl class="milaura-pdp-buy__essentials" aria-label="Caractéristiques principales">
          {%- if hero_stone_name != blank or hero_stone_handle != blank -%}
            <div>
              <dt>Pierres</dt>
              <dd>{{ hero_stone_name | default: hero_stone_handle | replace: '-', ' ' | capitalize }}</dd>
            </div>
          {%- endif -%}
          {%- if hero_materials != blank -%}
            <div>
              <dt>Matières</dt>
              <dd>{{ hero_materials | join: ', ' | replace: '-', ' ' }}</dd>
            </div>
          {%- endif -%}
          {%- for spec in hero_specifications limit: 2 -%}
            {%- if spec.label != blank and spec.value != blank -%}
              <div>
                <dt>{{ spec.label | escape }}</dt>
                <dd>{{ spec.value | escape }}</dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MilAura PDP Hero V2",
  "tag": "section",
  "class": "section-milaura-pdp-hero-v2",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher la marque",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Afficher la quantité",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Afficher la preuve sociale",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Information sous le bouton",
      "default": "Commande préparée à Metz et expédiée sous 24 h du lundi au vendredi."
    }
  ],
  "presets": [
    {
      "name": "MilAura PDP Hero V2"
    }
  ]
}
{% endschema %}
