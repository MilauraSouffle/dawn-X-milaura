{{ 'milaura-notre-histoire.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wellness_product = section.settings.wellness_product
  assign canonical_page_url = request.origin | append: page.url
  assign website_id = shop.url | append: '/#website'
  assign organization_id = shop.url | append: '/#organization'
-%}

<section class="mnh" aria-labelledby="MnhTitle-{{ section.id }}">
  <div class="mnh-hero">
    <div class="mnh-shell mnh-hero__grid">
      <div class="mnh-hero__content">
        <p class="mnh-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 id="MnhTitle-{{ section.id }}" class="mnh-hero__title">{{ section.settings.hero_title | escape }}</h1>
        <div class="mnh-hero__text rte">{{ section.settings.hero_text }}</div>
        <div class="mnh-actions">
          <a class="milaura-action milaura-action--primary" href="{{ section.settings.hero_cta_link }}">
            <span>{{ section.settings.hero_cta_label | escape }}</span>
            {% render 'milaura-action-icon' %}
          </a>
          <a class="milaura-action milaura-action--text" href="{{ section.settings.hero_secondary_link }}">
            <span>{{ section.settings.hero_secondary_label | escape }}</span>
            {% render 'milaura-action-icon' %}
          </a>
        </div>
      </div>

      <div class="mnh-hero__visual" aria-label="Karine et une sélection de bijoux MilAura">
        <div class="mnh-hero__halo" aria-hidden="true"></div>
        {%- if section.settings.hero_karine_image != blank -%}
          {{ section.settings.hero_karine_image | image_url: width: 1200 | image_tag:
            class: 'mnh-hero__karine',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '420, 640, 820, 1040, 1200',
            sizes: '(min-width: 990px) 42vw, 78vw',
            alt: 'Karine, fondatrice de MilAura'
          }}
        {%- else -%}
          <img
            class="mnh-hero__karine"
            src="{{ 'milaura-home-paths-karine-v3.webp' | asset_url }}"
            width="1254"
            height="1254"
            loading="eager"
            fetchpriority="high"
            alt="Karine, fondatrice de MilAura"
          >
        {%- endif -%}

        {%- if section.settings.hero_product_image != blank -%}
          {{ section.settings.hero_product_image | image_url: width: 1000 | image_tag:
            class: 'mnh-hero__product',
            loading: 'eager',
            widths: '360, 520, 760, 1000',
            sizes: '(min-width: 990px) 27vw, 50vw',
            alt: 'Sélection de bijoux en pierres MilAura'
          }}
        {%- else -%}
          <img
            class="mnh-hero__product"
            src="{{ 'milaura-home-paths-jewelry-v3.webp' | asset_url }}"
            width="1254"
            height="1254"
            loading="eager"
            fetchpriority="high"
            alt="Sélection de bijoux en pierres MilAura"
          >
        {%- endif -%}
        <p class="mnh-hero__caption">Sélectionnée par Karine à Metz</p>
      </div>
    </div>
  </div>

  <div class="mnh-proof" aria-label="Les repères MilAura">
    <div class="mnh-shell mnh-proof__grid">
      <p><strong>Sélection</strong><span>par Karine</span></p>
      <p><strong>Préparation</strong><span>à Metz</span></p>
      <p><strong>Conseils</strong><span>pour mieux choisir</span></p>
    </div>
  </div>

  <div class="mnh-story">
    <div class="mnh-shell mnh-story__grid">
      <figure class="mnh-story__figure">
        {%- if section.settings.story_image != blank -%}
          {{ section.settings.story_image | image_url: width: 1400 | image_tag:
            class: 'mnh-story__image',
            loading: 'lazy',
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 46vw, 100vw',
            alt: 'Karine, à l’origine de MilAura'
          }}
        {%- else -%}
          <img
            class="mnh-story__image"
            src="{{ 'milaura-hero-proof-karine-v2.webp' | asset_url }}"
            width="1043"
            height="1508"
            loading="lazy"
            alt="Karine, à l’origine de MilAura"
          >
        {%- endif -%}
      </figure>

      <div class="mnh-story__content">
        <p class="mnh-eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        <h2>{{ section.settings.story_title | escape }}</h2>
        <div class="mnh-story__text rte">{{ section.settings.story_text }}</div>
        <a class="milaura-action milaura-action--text" href="{{ section.settings.story_link }}">
          <span>{{ section.settings.story_label | escape }}</span>
          {% render 'milaura-action-icon' %}
        </a>
      </div>
    </div>
  </div>

  <div class="mnh-selection">
    <div class="mnh-shell">
      <header class="mnh-heading">
        <p class="mnh-eyebrow">{{ section.settings.selection_eyebrow | escape }}</p>
        <h2>{{ section.settings.selection_title | escape }}</h2>
        <div class="mnh-heading__intro rte">{{ section.settings.selection_intro }}</div>
      </header>

      <div class="mnh-selection__grid">
        <ol class="mnh-criteria">
          <li>
            <span class="mnh-criteria__number">01</span>
            <div>
              <h3>{{ section.settings.criterion_1_title | escape }}</h3>
              <p>{{ section.settings.criterion_1_text | escape }}</p>
            </div>
          </li>
          <li>
            <span class="mnh-criteria__number">02</span>
            <div>
              <h3>{{ section.settings.criterion_2_title | escape }}</h3>
              <p>{{ section.settings.criterion_2_text | escape }}</p>
            </div>
          </li>
          <li>
            <span class="mnh-criteria__number">03</span>
            <div>
              <h3>{{ section.settings.criterion_3_title | escape }}</h3>
              <p>{{ section.settings.criterion_3_text | escape }}</p>
            </div>
          </li>
        </ol>

        <div class="mnh-selection__visual">
          {%- if section.settings.selection_image != blank -%}
            {{ section.settings.selection_image | image_url: width: 1200 | image_tag:
              class: 'mnh-selection__image',
              loading: 'lazy',
              widths: '420, 640, 820, 1000, 1200',
              sizes: '(min-width: 990px) 38vw, 88vw',
              alt: 'Sélection de minéraux MilAura'
            }}
          {%- else -%}
            <img
              class="mnh-selection__image"
              src="{{ 'milaura-home-paths-stones-v2.webp' | asset_url }}"
              width="1254"
              height="1254"
              loading="lazy"
              alt="Sélection de minéraux MilAura"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="mnh-universes">
    <div class="mnh-shell">
      <header class="mnh-heading mnh-heading--center">
        <p class="mnh-eyebrow">{{ section.settings.universes_eyebrow | escape }}</p>
        <h2>{{ section.settings.universes_title | escape }}</h2>
        <div class="mnh-heading__intro rte">{{ section.settings.universes_intro }}</div>
      </header>

      <div class="mnh-universes__rail">
        <a class="mnh-universe-card" href="{{ section.settings.jewelry_link }}">
          <span class="mnh-universe-card__title">Les bijoux</span>
          <span class="mnh-universe-card__media">
            <img
              class="mnh-universe-card__image"
              src="{{ 'milaura-home-paths-jewelry-v3.webp' | asset_url }}"
              width="1254"
              height="1254"
              loading="lazy"
              alt="Bijoux en pierres MilAura"
            >
          </span>
          <span class="milaura-action milaura-action--text">
            <span>Voir les bijoux</span>
            {% render 'milaura-action-icon' %}
          </span>
        </a>

        <a class="mnh-universe-card" href="{{ section.settings.minerals_link }}">
          <span class="mnh-universe-card__title">Les minéraux</span>
          <span class="mnh-universe-card__media">
            <img
              class="mnh-universe-card__image"
              src="{{ 'milaura-home-paths-stones-v2.webp' | asset_url }}"
              width="1254"
              height="1254"
              loading="lazy"
              alt="Minéraux sélectionnés par MilAura"
            >
          </span>
          <span class="milaura-action milaura-action--text">
            <span>Explorer les pierres</span>
            {% render 'milaura-action-icon' %}
          </span>
        </a>

        <a class="mnh-universe-card" href="{{ section.settings.wellness_link }}">
          <span class="mnh-universe-card__title">Le bien-être</span>
          <span class="mnh-universe-card__media mnh-universe-card__media--product">
            {%- if wellness_product != blank and wellness_product.featured_image != blank -%}
              {{ wellness_product.featured_image | image_url: width: 900 | image_tag:
                class: 'mnh-universe-card__image',
                loading: 'lazy',
                widths: '360, 520, 720, 900',
                sizes: '(min-width: 990px) 28vw, 76vw',
                alt: wellness_product.featured_image.alt | default: wellness_product.title
              }}
            {%- endif -%}
          </span>
          <span class="milaura-action milaura-action--text">
            <span>Découvrir le bien-être</span>
            {% render 'milaura-action-icon' %}
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="mnh-closing">
    <div class="mnh-shell mnh-closing__inner">
      <div>
        <p class="mnh-eyebrow">{{ section.settings.cta_eyebrow | escape }}</p>
        <h2>{{ section.settings.cta_title | escape }}</h2>
        <div class="mnh-closing__text rte">{{ section.settings.cta_text }}</div>
      </div>
      <div class="mnh-actions mnh-closing__actions">
        <a class="milaura-action milaura-action--light" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          {% render 'milaura-action-icon' %}
        </a>
        <a class="milaura-action milaura-action--text-light" href="{{ section.settings.cta_secondary_link }}">
          <span>{{ section.settings.cta_secondary_label | escape }}</span>
          {% render 'milaura-action-icon' %}
        </a>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": {{ canonical_page_url | append: '#about' | json }},
  "url": {{ canonical_page_url | json }},
  "name": {{ page.title | json }},
  "description": {{ section.settings.hero_text | strip_html | json }},
  "isPartOf": { "@id": {{ website_id | json }} },
  "about": {
    "@type": "Organization",
    "@id": {{ organization_id | json }},
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "founder": {
      "@type": "Person",
      "name": "Karine Allié",
      "jobTitle": "Fondatrice de MilAura",
      "knowsAbout": ["Bijoux en pierres", "Minéraux", "Lithothérapie", "Bien-être"]
    }
  }
}
</script>

{% schema %}
{
  "name": "Notre histoire MilAura",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Surtitre", "default": "Notre histoire" },
    { "type": "text", "id": "hero_title", "label": "Titre", "default": "MilAura, c’est le regard de Karine." },
    { "type": "richtext", "id": "hero_text", "label": "Introduction", "default": "<p>À Metz, Karine sélectionne des bijoux, des minéraux et des produits bien-être pour leur beauté, leur caractère et ce qu’ils font ressentir. MilAura est née de cette envie : vous aider à trouver la pièce qui vous parle vraiment.</p>" },
    { "type": "text", "id": "hero_cta_label", "label": "CTA principal", "default": "Découvrir ses coups de cœur" },
    { "type": "url", "id": "hero_cta_link", "label": "Lien principal" },
    { "type": "text", "id": "hero_secondary_label", "label": "CTA secondaire", "default": "Explorer les bijoux" },
    { "type": "url", "id": "hero_secondary_link", "label": "Lien secondaire" },
    { "type": "image_picker", "id": "hero_karine_image", "label": "Portrait détouré de Karine" },
    { "type": "image_picker", "id": "hero_product_image", "label": "Composition de bijoux détourée" },

    { "type": "header", "content": "Origine" },
    { "type": "text", "id": "story_eyebrow", "label": "Surtitre", "default": "Comment tout a commencé" },
    { "type": "text", "id": "story_title", "label": "Titre", "default": "Une boutique née d’un regard." },
    { "type": "richtext", "id": "story_text", "label": "Texte", "default": "<p>Karine aime les pierres pour leurs couleurs, leurs nuances et les détails qui rendent chaque pièce différente.</p>" },
    { "type": "text", "id": "story_label", "label": "Libellé du lien", "default": "Voir la sélection de Karine" },
    { "type": "url", "id": "story_link", "label": "Lien" },
    { "type": "image_picker", "id": "story_image", "label": "Portrait de Karine" },

    { "type": "header", "content": "Méthode de sélection" },
    { "type": "text", "id": "selection_eyebrow", "label": "Surtitre", "default": "La sélection MilAura" },
    { "type": "text", "id": "selection_title", "label": "Titre", "default": "Comment Karine choisit chaque pièce." },
    { "type": "richtext", "id": "selection_intro", "label": "Introduction", "default": "<p>Il n’y a pas de formule automatique. Chaque sélection commence par un regard, puis par quelques critères simples.</p>" },
    { "type": "text", "id": "criterion_1_title", "label": "Critère 1", "default": "La beauté" },
    { "type": "text", "id": "criterion_1_text", "label": "Texte critère 1", "default": "Une couleur, un détail ou une pierre qui attire immédiatement le regard." },
    { "type": "text", "id": "criterion_2_title", "label": "Critère 2", "default": "La pureté des lignes" },
    { "type": "text", "id": "criterion_2_text", "label": "Texte critère 2", "default": "Une forme équilibrée, agréable à regarder et facile à porter ou à intégrer chez soi." },
    { "type": "text", "id": "criterion_3_title", "label": "Critère 3", "default": "Ce qu’elle dégage" },
    { "type": "text", "id": "criterion_3_text", "label": "Texte critère 3", "default": "Cette impression difficile à résumer, mais qui donne envie de revenir vers la pièce." },
    { "type": "image_picker", "id": "selection_image", "label": "Composition de minéraux" },

    { "type": "header", "content": "Univers" },
    { "type": "text", "id": "universes_eyebrow", "label": "Surtitre", "default": "Découvrir MilAura" },
    { "type": "text", "id": "universes_title", "label": "Titre", "default": "Bijoux, minéraux et bien-être." },
    { "type": "richtext", "id": "universes_intro", "label": "Introduction", "default": "<p>Trois portes d’entrée pour découvrir MilAura selon ce que vous recherchez aujourd’hui.</p>" },
    { "type": "url", "id": "jewelry_link", "label": "Lien bijoux" },
    { "type": "url", "id": "minerals_link", "label": "Lien minéraux" },
    { "type": "product", "id": "wellness_product", "label": "Produit bien-être mis en avant" },
    { "type": "url", "id": "wellness_link", "label": "Lien bien-être" },

    { "type": "header", "content": "Conclusion" },
    { "type": "text", "id": "cta_eyebrow", "label": "Surtitre", "default": "Besoin d’un conseil ?" },
    { "type": "text", "id": "cta_title", "label": "Titre", "default": "Vous hésitez entre plusieurs pierres ?" },
    { "type": "richtext", "id": "cta_text", "label": "Texte", "default": "<p>Le diagnostic MilAura vous aide à avancer selon votre besoin du moment.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA principal", "default": "Je trouve ma pierre" },
    { "type": "url", "id": "cta_link", "label": "Lien principal" },
    { "type": "text", "id": "cta_secondary_label", "label": "CTA secondaire", "default": "Lire le Journal" },
    { "type": "url", "id": "cta_secondary_link", "label": "Lien secondaire" }
  ],
  "presets": [
    { "name": "Notre histoire MilAura" }
  ]
}
{% endschema %}
