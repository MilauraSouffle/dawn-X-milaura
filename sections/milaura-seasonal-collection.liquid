{{ 'milaura-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  assign featured_1 = section.settings.featured_product_1
  assign featured_2 = section.settings.featured_product_2
  assign featured_3 = section.settings.featured_product_3
  assign featured_4 = section.settings.featured_product_4
-%}

{%- style -%}
  #MilauraSeasonalCollection-{{ section.id }} {
    --season-prune: #2f222d;
    --season-prune-soft: #4a3545;
    --season-gold: #bc9858;
    --season-aqua: #76bcb7;
    --season-aqua-deep: #3f8583;
    --season-nacre: #fffdf9;
    --season-sand: #f1e8d8;
    --season-ink: #322a31;
    --season-muted: #716870;
    color: var(--season-ink);
    background: var(--season-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__hero {
    min-height: min(820px, 88vh);
    display: grid;
    grid-template-columns: minmax(330px, 0.84fr) minmax(0, 1.16fr);
    background: var(--season-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 7vw, 120px);
    background:
      radial-gradient(circle at 18% 85%, rgba(118, 188, 183, 0.16), transparent 34%),
      var(--season-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__eyebrow,
  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__kicker {
    margin: 0;
    color: var(--season-aqua-deep);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title,
  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__title {
    margin: 0;
    color: var(--season-gold);
    font-family: var(--milaura-font-script, 'Dancing Script'), cursive;
    font-weight: 600;
    letter-spacing: 0;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title {
    margin-top: 16px;
    font-size: clamp(4.3rem, 7vw, 7.7rem);
    line-height: 0.84;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__name {
    margin: 28px 0 0;
    color: var(--season-prune);
    font-family: var(--milaura-font-heading, 'Playfair Display'), serif;
    font-size: clamp(1.35rem, 2vw, 2.15rem);
    font-weight: 500;
    line-height: 1.28;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__text {
    max-width: 520px;
    margin: 20px 0 0;
    color: var(--season-muted);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: clamp(0.98rem, 1.2vw, 1.12rem);
    line-height: 1.75;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 22px;
    margin-top: 28px;
    color: var(--season-prune-soft);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__photo {
    min-height: 620px;
    overflow: hidden;
    border-radius: 0 0 0 150px;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products {
    padding: clamp(64px, 8vw, 124px) 0;
    background: linear-gradient(180deg, rgba(241, 232, 216, 0.34), #fff 36%);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__header {
    max-width: 820px;
    margin: 0 auto clamp(34px, 4vw, 58px);
    padding: 0 20px;
    text-align: center;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__title {
    margin-top: 10px;
    font-size: clamp(3.2rem, 5.4vw, 5.8rem);
    line-height: 0.98;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__description {
    max-width: 680px;
    margin: 16px auto 0;
    color: var(--season-muted);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    line-height: 1.65;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
    width: min(1400px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(15px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card {
    min-width: 0;
    display: flex;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card {
    width: 100%;
    height: 100%;
    border-color: rgba(63, 133, 131, 0.42);
    box-shadow: 0 8px 22px rgba(47, 34, 45, 0.045);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card:hover {
    border-color: var(--season-aqua-deep);
    box-shadow: 0 13px 30px rgba(63, 133, 131, 0.15);
  }

  #MilauraSeasonalCollection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--season-aqua-deep);
    outline-offset: 5px;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__empty {
    margin: 0;
    padding: 60px 20px;
    color: var(--season-muted);
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__photo {
      min-height: 68vh;
      order: -1;
      border-radius: 0 0 74px 0;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__copy {
      padding: 48px 24px 66px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title {
      font-size: clamp(4.5rem, 21vw, 6.4rem);
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
      width: 100%;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      padding: 0 14px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card {
      min-width: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__title {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__description {
      font-size: 0.94rem;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card-quick {
      display: none;
    }
  }
{%- endstyle -%}

<main id="MilauraSeasonalCollection-{{ section.id }}" class="milaura-seasonal-landing">
  <section class="milaura-seasonal-landing__hero" aria-labelledby="MilauraSeasonalTitle-{{ section.id }}">
    <div class="milaura-seasonal-landing__copy">
      {%- if section.settings.campaign_label != blank -%}
        <p class="milaura-seasonal-landing__eyebrow">{{ section.settings.campaign_label | escape }}</p>
      {%- endif -%}
      <h1 id="MilauraSeasonalTitle-{{ section.id }}" class="milaura-seasonal-landing__title">
        {{ section.settings.campaign_title | escape }}
      </h1>
      {%- if section.settings.campaign_name != blank -%}
        <p class="milaura-seasonal-landing__name">{{ section.settings.campaign_name | escape }}</p>
      {%- endif -%}
      {%- if section.settings.campaign_text != blank -%}
        <p class="milaura-seasonal-landing__text">{{ section.settings.campaign_text | escape }}</p>
      {%- endif -%}
      <div class="milaura-seasonal-landing__meta" aria-label="Informations sur la sélection">
        <span>{{ collection.products_count }} créations</span>
        {%- if section.settings.edition_label != blank -%}<span>{{ section.settings.edition_label | escape }}</span>{%- endif -%}
        {%- if section.settings.availability_label != blank -%}<span>{{ section.settings.availability_label | escape }}</span>{%- endif -%}
      </div>
    </div>
    <div class="milaura-seasonal-landing__photo">
      <img
        src="{{ campaign_asset | asset_url }}"
        alt="{{ section.settings.campaign_image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1024"
        height="1536"
      >
    </div>
  </section>

  <section class="milaura-seasonal-products" aria-labelledby="MilauraSeasonalProductsTitle-{{ section.id }}">
    <header class="milaura-seasonal-products__header">
      {%- if section.settings.products_kicker != blank -%}
        <p class="milaura-seasonal-products__kicker">{{ section.settings.products_kicker | escape }}</p>
      {%- endif -%}
      <h2 id="MilauraSeasonalProductsTitle-{{ section.id }}" class="milaura-seasonal-products__title">
        {{ section.settings.products_title | escape }}
      </h2>
      {%- if section.settings.products_description != blank -%}
        <p class="milaura-seasonal-products__description">{{ section.settings.products_description | escape }}</p>
      {%- endif -%}
    </header>

    <div class="milaura-seasonal-products__shell">
      {%- paginate collection.products by 48 -%}
        {%- if collection.products_count > 0 -%}
          <div class="milaura-seasonal-products__grid milaura-cards" role="list">
            {%- if featured_1 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_1, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_2 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_2, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_3 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_3, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_4 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_4, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}

            {%- for product in collection.products -%}
              {%- unless product.handle == featured_1.handle or product.handle == featured_2.handle or product.handle == featured_3.handle or product.handle == featured_4.handle -%}
                <div class="milaura-seasonal-products__card" role="listitem">
                  {% render 'milaura-card-product',
                    card_product: product,
                    img_loading: 'lazy',
                    show_vendor: false,
                    show_badges: section.settings.show_badges,
                    show_secondary_image: true,
                    force_bestseller_badge: false
                  %}
                </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="milaura-seasonal-products__empty">La sélection arrive très bientôt.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Landing saisonnière",
  "tag": "section",
  "class": "section-milaura-seasonal-collection",
  "settings": [
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_image_alt",
      "label": "Texte alternatif du visuel",
      "default": "Eau aigue-marine sur une plage de sable nacré"
    },
    {
      "type": "text",
      "id": "campaign_label",
      "label": "Saison",
      "default": "La sélection d’août"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "Éclats des Maldives"
    },
    {
      "type": "text",
      "id": "campaign_name",
      "label": "Signature éditoriale",
      "default": "Une escale minérale imaginée par Karine"
    },
    {
      "type": "textarea",
      "id": "campaign_text",
      "label": "Introduction",
      "default": "Quand le lagon rencontre la lumière, l’amazonite, la calcédoine, la nacre et les pierres aux nuances solaires deviennent les souvenirs précieux d’un été sans fin."
    },
    {
      "type": "text",
      "id": "edition_label",
      "label": "Édition",
      "default": "Édition août 2026"
    },
    {
      "type": "text",
      "id": "availability_label",
      "label": "Disponibilité",
      "default": "Sélection en stock"
    },
    {
      "type": "text",
      "id": "products_kicker",
      "label": "Introduction de la grille",
      "default": "Choisie pour le mois d’août"
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "Titre de la grille",
      "default": "La sélection de Karine"
    },
    {
      "type": "textarea",
      "id": "products_description",
      "label": "Texte de la grille",
      "default": "Bijoux et créations choisis pour composer une collection lumineuse, fraîche et profondément MilAura."
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Produit vedette 1"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Produit vedette 2"
    },
    {
      "type": "product",
      "id": "featured_product_3",
      "label": "Produit vedette 3"
    },
    {
      "type": "product",
      "id": "featured_product_4",
      "label": "Produit vedette 4"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Landing saisonnière"
    }
  ]
}
{% endschema %}
