{{ 'milaura-card.css' | asset_url | stylesheet_tag }}
{{ 'milaura-section-heading.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  assign featured_1 = section.settings.featured_product_1
  assign featured_2 = section.settings.featured_product_2
  assign featured_3 = section.settings.featured_product_3
  assign featured_4 = section.settings.featured_product_4
  assign seasonal_title_id = 'MilauraSeasonalTitle-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  #MilauraSeasonalCollection-{{ section.id }} {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--header-height-desktop));
    overflow: hidden;
    color: var(--milaura-encre);
    background: var(--milaura-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro {
    position: relative;
    min-height: clamp(520px, 42vw, 590px);
    display: flex;
    align-items: flex-start;
    padding: calc(var(--header-height-desktop) + clamp(44px, 4vw, 64px)) 0 clamp(44px, 5vw, 64px);
    overflow: hidden;
    background: var(--milaura-nacre) url('{{ campaign_asset | asset_url }}') center 44% / cover no-repeat;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: var(--milaura-nacre);
    opacity: 0.58;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro-shell {
    position: relative;
    z-index: 1;
    width: min(1400px, calc(100% - clamp(32px, 7vw, 108px)));
    margin: 0 auto;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-section-heading {
    width: min(100%, 720px);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta {
    width: fit-content;
    max-width: 100%;
    display: flex;
    align-items: center;
    margin: clamp(22px, 2.8vw, 34px) 0 0;
    color: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-signature);
    font-size: clamp(21px, 1.8vw, 27px);
    font-weight: 600;
    letter-spacing: 0;
    line-height: var(--milaura-lh-signature);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span {
    min-height: 32px;
    display: flex;
    align-items: center;
    padding-right: var(--milaura-esp-md);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span + span {
    padding-left: var(--milaura-esp-md);
    border-left: var(--milaura-filet-or);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products {
    position: relative;
    padding: clamp(58px, 7vw, 96px) 0 clamp(76px, 9vw, 128px);
    border-top: var(--milaura-filet-mineral);
    background: var(--milaura-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
    width: min(1400px, calc(100% - clamp(32px, 7vw, 108px)));
    margin: 0 auto;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2.3vw, 36px) clamp(16px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card {
    width: 100%;
    height: auto;
  }

  #MilauraSeasonalCollection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--milaura-aigue-profonde);
    outline-offset: 5px;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__empty {
    margin: 0;
    padding: 60px 20px;
    color: var(--milaura-encre-secondaire);
    text-align: center;
  }

  @media screen and (max-width: 1100px) {
    #MilauraSeasonalCollection-{{ section.id }} {
      margin-top: calc(-1 * var(--header-height-tablet));
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro {
      padding-top: calc(var(--header-height-tablet) + 42px);
    }
  }

  @media screen and (max-width: 989px) {
    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraSeasonalCollection-{{ section.id }} {
      margin-top: calc(-1 * var(--header-height-mobile));
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro {
      min-height: 470px;
      padding: calc(var(--header-height-mobile) + 20px) 0 40px;
      background-position: 58% center;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro::before {
      opacity: 0.64;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro-shell {
      width: calc(100% - 36px);
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta {
      margin-top: 20px;
      font-size: 19px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span {
      min-height: 34px;
      justify-content: center;
      padding: 2px 12px 2px 0;
      text-align: center;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span + span {
      padding-left: 12px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products {
      padding: 38px 0 82px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
      width: 100%;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
      padding: 0 14px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-editorial-purchase__add span {
      display: none;
    }
  }
{%- endstyle -%}

<div id="MilauraSeasonalCollection-{{ section.id }}" class="milaura-seasonal-landing">
  <section class="milaura-seasonal-landing__intro" aria-labelledby="{{ seasonal_title_id }}">
    <div class="milaura-seasonal-landing__intro-shell">
      {% render 'milaura-section-heading',
        eyebrow: section.settings.campaign_date,
        title: section.settings.campaign_title,
        text: section.settings.campaign_text,
        heading_tag: 'h1',
        heading_id: seasonal_title_id,
        align: 'left',
        size: 'hero',
        eyebrow_style: 'signature'
      %}

      <div class="milaura-seasonal-landing__meta" aria-label="Informations sur la sélection">
        <span>{{ collection.products_count }} créations</span>
        {%- if section.settings.edition_label != blank -%}<span>{{ section.settings.edition_label | escape }}</span>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="milaura-seasonal-products" aria-label="Les créations de la sélection">
    <div class="milaura-seasonal-products__shell">
      {%- paginate collection.products by 48 -%}
        {%- if collection.products_count > 0 -%}
          <div class="milaura-seasonal-products__grid milaura-cards milaura-cards--editorial" role="list">
            {%- if featured_1 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_1, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
                {% render 'milaura-editorial-purchase', product: featured_1 %}
              </div>
            {%- endif -%}
            {%- if featured_2 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_2, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
                {% render 'milaura-editorial-purchase', product: featured_2 %}
              </div>
            {%- endif -%}
            {%- if featured_3 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_3, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
                {% render 'milaura-editorial-purchase', product: featured_3 %}
              </div>
            {%- endif -%}
            {%- if featured_4 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_4, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
                {% render 'milaura-editorial-purchase', product: featured_4 %}
              </div>
            {%- endif -%}

            {%- for product in collection.products -%}
              {%- unless product.handle == featured_1.handle or product.handle == featured_2.handle or product.handle == featured_3.handle or product.handle == featured_4.handle -%}
                <div class="milaura-seasonal-products__card" role="listitem">
                  {% render 'milaura-card-product',
                    card_product: product,
                    img_loading: 'lazy',
                    show_vendor: false,
                    show_badges: section.settings.show_badges,
                    show_secondary_image: true,
                    force_bestseller_badge: false
                  %}
                  {% render 'milaura-editorial-purchase', product: product %}
                </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="milaura-seasonal-products__empty">La sélection arrive très bientôt.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Landing saisonnière",
  "tag": "section",
  "class": "section-milaura-seasonal-collection",
  "settings": [
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_date",
      "label": "Date de la campagne",
      "default": "Août 2026"
    },
    {
      "type": "textarea",
      "id": "campaign_text",
      "label": "Introduction",
      "default": "Des créations choisies par Karine pour leurs reflets dorés, leurs pierres naturelles et leur lumière estivale."
    },
    {
      "type": "text",
      "id": "edition_label",
      "label": "Édition",
      "default": "Édition août 2026"
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Produit vedette 1"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Produit vedette 2"
    },
    {
      "type": "product",
      "id": "featured_product_3",
      "label": "Produit vedette 3"
    },
    {
      "type": "product",
      "id": "featured_product_4",
      "label": "Produit vedette 4"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Landing saisonnière"
    }
  ]
}
{% endschema %}
