{{ 'milaura-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  assign featured_1 = section.settings.featured_product_1
  assign featured_2 = section.settings.featured_product_2
  assign featured_3 = section.settings.featured_product_3
  assign featured_4 = section.settings.featured_product_4
-%}

{%- style -%}
  #MilauraSeasonalCollection-{{ section.id }} {
    --season-prune: #2f222d;
    --season-prune-soft: #4a3545;
    --season-gold: #bc9858;
    --season-aqua: #76bcb7;
    --season-aqua-deep: #3f8583;
    --season-nacre: #fffdf9;
    --season-sand: #f1e8d8;
    --season-ink: #322a31;
    --season-muted: #716870;
    color: var(--season-ink);
    background: var(--season-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro {
    padding: clamp(48px, 6vw, 86px) 0 clamp(44px, 5vw, 72px);
    background:
      radial-gradient(circle at 88% 12%, rgba(118, 188, 183, 0.13), transparent 25%),
      var(--season-nacre);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro-shell {
    width: min(1180px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
    text-align: center;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title-card {
    padding: clamp(24px, 3vw, 38px) clamp(22px, 4vw, 58px);
    border: 1px solid rgba(188, 152, 88, 0.5);
    border-radius: 16px;
    color: var(--season-nacre);
    background: var(--season-prune);
    box-shadow: 0 12px 32px rgba(47, 34, 45, 0.11);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title {
    margin: 0;
    color: #9dd8d4;
    font-family: var(--milaura-font-script, 'Dancing Script'), cursive;
    font-size: clamp(3.35rem, 5vw, 5.4rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__name {
    margin: 10px 0 0;
    color: #e1bd78;
    font-family: var(--milaura-font-heading, 'Playfair Display'), serif;
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    font-weight: 500;
    line-height: 1.35;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__text {
    max-width: 940px;
    margin: clamp(24px, 3vw, 38px) auto 0;
    color: var(--season-muted);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: clamp(0.98rem, 1.2vw, 1.12rem);
    line-height: 1.75;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 760px;
    margin: clamp(24px, 3vw, 34px) auto 0;
    color: var(--season-prune-soft);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span + span {
    border-left: 1px solid rgba(188, 152, 88, 0.48);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products {
    padding: clamp(58px, 7vw, 104px) 0 clamp(76px, 9vw, 132px);
    background:
      linear-gradient(180deg, rgba(255, 253, 249, 0.69), rgba(255, 253, 249, 0.84)),
      url('{{ campaign_asset | asset_url }}') center top / cover no-repeat;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
    width: min(1400px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(15px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card {
    min-width: 0;
    display: flex;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card {
    width: 100%;
    height: 100%;
    border-color: rgba(63, 133, 131, 0.42);
    background: rgba(255, 253, 249, 0.96);
    box-shadow: 0 9px 24px rgba(47, 34, 45, 0.08);
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card:hover {
    border-color: var(--season-aqua-deep);
    box-shadow: 0 13px 30px rgba(63, 133, 131, 0.15);
  }

  #MilauraSeasonalCollection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--season-aqua-deep);
    outline-offset: 5px;
  }

  #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__empty {
    margin: 0;
    padding: 60px 20px;
    color: var(--season-muted);
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__shell {
      width: 100%;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      padding: 0 14px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card {
      min-width: 0;
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro {
      padding: 34px 0 38px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__intro-shell {
      width: calc(100% - 24px);
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title-card {
      padding: 22px 16px 24px;
      border-radius: 13px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__title {
      font-size: clamp(2.8rem, 13.5vw, 4rem);
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__name {
      max-width: 290px;
      margin: 8px auto 0;
      font-size: 1rem;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__text {
      margin-top: 24px;
      padding: 0 8px;
      font-size: 0.96rem;
      line-height: 1.65;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta {
      grid-template-columns: 1fr;
      gap: 0;
      max-width: 280px;
      margin-top: 24px;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span {
      padding: 9px 0;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-landing__meta span + span {
      border-top: 1px solid rgba(188, 152, 88, 0.4);
      border-left: 0;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products {
      padding-top: 42px;
      background:
        linear-gradient(180deg, rgba(255, 253, 249, 0.72), rgba(255, 253, 249, 0.88)),
        url('{{ campaign_asset | asset_url }}') center top / auto 100% no-repeat;
    }

    #MilauraSeasonalCollection-{{ section.id }} .milaura-seasonal-products__card .grid__card-quick {
      display: none;
    }
  }
{%- endstyle -%}

<main id="MilauraSeasonalCollection-{{ section.id }}" class="milaura-seasonal-landing">
  <section class="milaura-seasonal-landing__intro" aria-labelledby="MilauraSeasonalTitle-{{ section.id }}">
    <div class="milaura-seasonal-landing__intro-shell">
      <div class="milaura-seasonal-landing__title-card">
        <h1 id="MilauraSeasonalTitle-{{ section.id }}" class="milaura-seasonal-landing__title">
          {{ section.settings.campaign_title | escape }}
        </h1>
        {%- if section.settings.campaign_name != blank -%}
          <p class="milaura-seasonal-landing__name">{{ section.settings.campaign_name | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.campaign_text != blank -%}
        <p class="milaura-seasonal-landing__text">{{ section.settings.campaign_text | escape }}</p>
      {%- endif -%}
      <div class="milaura-seasonal-landing__meta" aria-label="Informations sur la sélection">
        <span>{{ collection.products_count }} créations</span>
        {%- if section.settings.edition_label != blank -%}<span>{{ section.settings.edition_label | escape }}</span>{%- endif -%}
        {%- if section.settings.availability_label != blank -%}<span>{{ section.settings.availability_label | escape }}</span>{%- endif -%}
      </div>
    </div>
  </section>

  <section class="milaura-seasonal-products" aria-label="Les créations de la sélection d’août">
    <div class="milaura-seasonal-products__shell">
      {%- paginate collection.products by 48 -%}
        {%- if collection.products_count > 0 -%}
          <div class="milaura-seasonal-products__grid milaura-cards" role="list">
            {%- if featured_1 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_1, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_2 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_2, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_3 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_3, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}
            {%- if featured_4 != blank -%}
              <div class="milaura-seasonal-products__card" role="listitem">
                {% render 'milaura-card-product', card_product: featured_4, img_loading: 'lazy', show_vendor: false, show_badges: section.settings.show_badges, show_secondary_image: true, force_bestseller_badge: false %}
              </div>
            {%- endif -%}

            {%- for product in collection.products -%}
              {%- unless product.handle == featured_1.handle or product.handle == featured_2.handle or product.handle == featured_3.handle or product.handle == featured_4.handle -%}
                <div class="milaura-seasonal-products__card" role="listitem">
                  {% render 'milaura-card-product',
                    card_product: product,
                    img_loading: 'lazy',
                    show_vendor: false,
                    show_badges: section.settings.show_badges,
                    show_secondary_image: true,
                    force_bestseller_badge: false
                  %}
                </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="milaura-seasonal-products__empty">La sélection arrive très bientôt.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
</main>

{% schema %}
{
  "name": "Landing saisonnière",
  "tag": "section",
  "class": "section-milaura-seasonal-collection",
  "settings": [
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_name",
      "label": "Signature éditoriale",
      "default": "Une escale minérale imaginée par Karine"
    },
    {
      "type": "textarea",
      "id": "campaign_text",
      "label": "Introduction",
      "default": "Quand le lagon rencontre la lumière, l’amazonite, la calcédoine, la nacre et les pierres aux nuances solaires deviennent les souvenirs précieux d’un été sans fin."
    },
    {
      "type": "text",
      "id": "edition_label",
      "label": "Édition",
      "default": "Édition août 2026"
    },
    {
      "type": "text",
      "id": "availability_label",
      "label": "Disponibilité",
      "default": "Sélection en stock"
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Produit vedette 1"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Produit vedette 2"
    },
    {
      "type": "product",
      "id": "featured_product_3",
      "label": "Produit vedette 3"
    },
    {
      "type": "product",
      "id": "featured_product_4",
      "label": "Produit vedette 4"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Landing saisonnière"
    }
  ]
}
{% endschema %}
