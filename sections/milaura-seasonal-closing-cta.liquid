{{ 'milaura-seasonal-closing-cta.css' | asset_url | stylesheet_tag }}

{%- assign closing_title_id = 'MilauraSeasonalClosingTitle-' | append: section.id -%}
{%- assign destination_url = section.settings.button_link | default: '#MilauraSeasonalCatalogue' -%}

<section
  id="MilauraSeasonalClosing-{{ section.id }}"
  class="milaura-seasonal-closing-cta"
  aria-labelledby="{{ closing_title_id }}"
>
  <div class="milaura-seasonal-closing-cta__shell">
    <div class="milaura-seasonal-closing-cta__copy">
      {%- if section.settings.title != blank -%}
        <h2 id="{{ closing_title_id }}" class="milaura-seasonal-closing-cta__title">
          {{ section.settings.title | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="milaura-seasonal-closing-cta__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <a
        class="milaura-seasonal-closing-cta__action milaura-action milaura-action--editorial"
        href="{{ destination_url }}"
      >
        <span>{{ section.settings.button_label | escape }}</span>
        <span aria-hidden="true">↑</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Conclusion saisonnière",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Alors, quel bijou choisissez-vous ?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Grenat profond, cornaline lumineuse ou bracelet Iris : retrouvez toute la sélection et ajoutez votre préféré au panier."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Choisir mon bijou"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "Conclusion saisonnière"
    }
  ]
}
{% endschema %}
