{% comment %}
  MILAURA DOCK MOBILE
  Navigation principale mobile : Menu, Recherche, Contact, Compte et Panier.
{% endcomment %}

{%- liquid
  assign dock_contact_url = section.settings.contact_url | default: '/pages/contact-milaura'
-%}

{% style %}
  :root {
    --milaura-mobile-dock-bar: 70px;
    --milaura-mobile-dock-total: calc(
      var(--milaura-mobile-dock-bar) +
      env(safe-area-inset-bottom, 0px)
    );
  }

  .milaura-dock {
    position: fixed;
    inset: auto 0 0;
    z-index: 1000002;
    display: none;
    align-items: flex-start;
    width: 100%;
    min-height: var(--milaura-mobile-dock-total);
    padding: 0 4px;
    overflow: hidden;
    background: transparent;
    isolation: isolate;
  }

  .milaura-dock__surface {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    background:
      linear-gradient(
        180deg,
        rgba(251, 248, 243, 0.97) 0%,
        {{ section.settings.bg_color | default: '#DCE9E7' }} 42%,
        rgba(199, 223, 220, 0.99) 100%
      );
    box-shadow: 0 -16px 38px rgba(47, 34, 45, 0.16);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
    pointer-events: none;
  }

  .milaura-dock-item {
    position: relative;
    z-index: 3;
    display: flex;
    flex: 1 1 20%;
    min-width: 0;
    min-height: var(--milaura-mobile-dock-bar);
    height: var(--milaura-mobile-dock-bar);
    padding: 7px 2px 5px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: {{ section.settings.text_color | default: '#2F222D' }};
    background: transparent;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .milaura-dock-item + .milaura-dock-item::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 1px;
    background: rgba(63, 116, 116, 0.42);
  }

  .milaura-dock-item::after {
    content: '';
    position: absolute;
    top: 9px;
    left: 50%;
    z-index: 0;
    width: 64px;
    height: 50px;
    border-radius: 50%;
    background: var(--milaura-quartz-rose-poudre);
    filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) scale(0.78);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .milaura-dock-item > * {
    position: relative;
    z-index: 1;
  }

  .milaura-dock-item svg {
    width: 23px;
    height: 23px;
    color: {{ section.settings.icon_color | default: '#3F7474' }};
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 180ms ease, transform 180ms ease, filter 180ms ease;
  }

  .milaura-dock-circle-mark {
    position: relative;
    display: block;
    width: 23px;
    height: 23px;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .milaura-dock-circle-mark__ring {
    position: absolute;
    display: block;
    border: 1.35px solid;
    pointer-events: none;
  }

  .milaura-dock-circle-mark__ring--gold {
    inset: 4px 1px 3px 2px;
    border-color: rgba(73, 50, 70, 0.62);
    border-radius: 48% 52% 46% 54% / 53% 45% 55% 47%;
    transform: rotate(10deg);
  }

  .milaura-dock-circle-mark__ring--aqua {
    inset: 2px 4px 2px 3px;
    border-color: #6fa9a6;
    border-radius: 53% 47% 55% 45% / 46% 54% 48% 52%;
    transform: rotate(-13deg);
  }

  .milaura-dock-item:active {
    transform: scale(0.94);
  }

  .milaura-dock-item:hover,
  .milaura-dock-item:focus-visible,
  .milaura-dock-item.is-current {
    color: var(--milaura-prune);
    background: transparent;
  }

  .milaura-dock-item:hover::after,
  .milaura-dock-item:focus-visible::after,
  .milaura-dock-item.is-current::after {
    opacity: 0.92;
    transform: translateX(-50%) scale(1);
  }

  .milaura-dock-item:hover svg,
  .milaura-dock-item:focus-visible svg,
  .milaura-dock-item.is-current svg {
    color: #493246;
    filter: drop-shadow(0 0 7px rgba(63, 116, 116, 0.26));
    transform: translateY(-1px);
  }

  .milaura-dock-item:hover .milaura-dock-circle-mark,
  .milaura-dock-item:focus-visible .milaura-dock-circle-mark,
  .milaura-dock-item.is-current .milaura-dock-circle-mark {
    filter: drop-shadow(0 0 7px rgba(63, 116, 116, 0.24));
    transform: translateY(-1px);
  }

  .milaura-dock-item:focus-visible {
    outline: 2px solid #6fa9a6;
    outline-offset: -4px;
  }

  .milaura-dock-label {
    max-width: 100%;
    overflow: hidden;
    font-family: var(--milaura-font-texte);
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .milaura-dock-badge {
    position: absolute;
    top: 5px;
    left: calc(50% + 8px);
    display: none;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
    color: #fbf8f3;
    background: {{ section.settings.badge_color | default: '#493246' }};
    border: 1px solid rgba(251, 248, 243, 0.88);
    border-radius: 999px;
    font-family: var(--milaura-font-texte);
    font-size: 9px;
    font-weight: 800;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    body {
      padding-bottom: var(--milaura-mobile-dock-total) !important;
    }

    .milaura-dock {
      display: flex;
    }

    .milaura-sticky-bar {
      bottom: calc(var(--milaura-mobile-dock-total) + 8px) !important;
    }

    .milaura-sticky-bar:not(.is-visible) {
      transform: translateY(calc(101% + var(--milaura-mobile-dock-total) + 8px)) !important;
    }

    .milaura-sticky-bar.is-visible {
      transform: translateY(0) !important;
    }

    .milaura-bubble-trigger,
    .milaura-bubble-label {
      bottom: calc(var(--milaura-mobile-dock-total) + 12px) !important;
    }
  }

  @media screen and (max-width: 359px) {
    .milaura-dock-label {
      font-size: 9.5px;
    }

    .milaura-dock-item svg {
      width: 21px;
      height: 21px;
    }

    .milaura-dock-circle-mark {
      width: 21px;
      height: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .milaura-dock-item,
    .milaura-dock-item svg,
    .milaura-dock-circle-mark {
      transition: none !important;
    }
  }
{% endstyle %}

<nav class="milaura-dock" id="milaura-dock" aria-label="Navigation principale mobile">
  <span class="milaura-dock__surface" aria-hidden="true"></span>

  <button
    type="button"
    class="milaura-dock-item"
    data-dock-menu
    aria-label="{{ section.settings.menu_label | default: 'Menu' }}"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 7h16M4 12h11M4 17h16"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.menu_label | default: 'Menu' }}</span>
  </button>

  <button type="button" class="milaura-dock-item" data-dock-search aria-label="{{ section.settings.search_label | default: 'Rechercher' }}">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="m16.2 16.2 4 4"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.search_label | default: 'Rechercher' }}</span>
  </button>

  <a
    href="{{ dock_contact_url }}"
    class="milaura-dock-item{% if request.path contains '/pages/contact' %} is-current{% endif %}"
    aria-label="{{ section.settings.contact_label | default: 'Contact' }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 5.5h14v10H9l-4 3v-13Z"/>
      <path d="M8 9h8M8 12h5"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.contact_label | default: 'Contact' }}</span>
  </a>

  <a
    href="{{ routes.account_url }}"
    class="milaura-dock-item{% if request.path contains '/account' %} is-current{% endif %}"
    aria-label="{{ section.settings.account_label | default: 'Compte' }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="3.4"/>
      <path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.account_label | default: 'Compte' }}</span>
  </a>

  <a
    href="{{ routes.cart_url }}"
    class="milaura-dock-item{% if request.path == routes.cart_url %} is-current{% endif %}"
    aria-label="{{ section.settings.cart_label | default: 'Panier' }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 7h12l-1 13H7L6 7Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.cart_label | default: 'Panier' }}</span>
    <span class="milaura-dock-badge" id="milaura-dock-badge" aria-live="polite">0</span>
  </a>

</nav>

<script>
(function() {
  'use strict';

  var menuButton = document.querySelector('[data-dock-menu]');
  var searchButton = document.querySelector('[data-dock-search]');
  var badge = document.getElementById('milaura-dock-badge');

  if (menuButton) {
    var navbarBurger = document.querySelector('[data-nav-burger], [id^="burger-"]');
    if (navbarBurger && navbarBurger.getAttribute('aria-controls')) {
      menuButton.setAttribute('aria-controls', navbarBurger.getAttribute('aria-controls'));
    }

    menuButton.addEventListener('click', function() {
      if (navbarBurger) navbarBurger.click();
    });

    document.addEventListener('milaura:menu-state', function(event) {
      if (!event.detail) return;
      var isExpanded = Boolean(event.detail.expanded);
      menuButton.setAttribute('aria-expanded', String(isExpanded));
      menuButton.classList.toggle('is-current', isExpanded);
      if (event.detail.controls) menuButton.setAttribute('aria-controls', event.detail.controls);
    });
  }

  if (searchButton) {
    searchButton.addEventListener('click', function() {
      if (typeof window.milauraOpenSearch === 'function') {
        window.milauraOpenSearch();
      } else {
        var navbarSearch = document.querySelector('[data-milaura-search-toggle]');
        if (navbarSearch) navbarSearch.click();
      }
    });
  }

  function updateDockBadge(count) {
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count;
      badge.style.display = 'flex';
    } else {
      badge.textContent = '0';
      badge.style.display = 'none';
    }
  }

  fetch('/cart.js')
    .then(function(response) { return response.json(); })
    .then(function(cart) { updateDockBadge(cart.item_count); })
    .catch(function() {});

  if (typeof window.PUB_SUB_EVENTS !== 'undefined' && typeof subscribe === 'function') {
    subscribe(PUB_SUB_EVENTS.cartUpdate, function(event) {
      if (event && event.cart) updateDockBadge(event.cart.item_count);
    });
  }

  document.addEventListener('cart:updated', function(event) {
    if (event.detail && event.detail.cart) {
      updateDockBadge(event.detail.cart.item_count);
      return;
    }

    fetch('/cart.js')
      .then(function(response) { return response.json(); })
      .then(function(cart) { updateDockBadge(cart.item_count); })
      .catch(function() {});
  });
})();
</script>

{% schema %}
{
  "name": "Milaura Dock Mobile",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Label menu",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Label recherche",
      "default": "Rechercher"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Label contact",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "URL page contact"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Label compte",
      "default": "Compte"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Label panier",
      "default": "Panier"
    },
    {
      "type": "header",
      "content": "Apparence du dock"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Aigue-marine du dock",
      "default": "#DCE9E7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur des libelles",
      "default": "#2F222D"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Couleur des pictogrammes",
      "default": "#3F7474"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Couleur du badge panier",
      "default": "#493246"
    }
  ],
  "presets": [
    {
      "name": "Milaura Dock Mobile"
    }
  ]
}
{% endschema %}
