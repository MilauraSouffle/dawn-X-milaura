{% comment %}
  MILAURA DOCK MOBILE
  Navigation principale mobile : Menu, Recherche, Contact, Cercle et Panier.
  La ligne de gemmes est la signature visuelle du dock et emerge du bas de l'ecran.
{% endcomment %}

{%- liquid
  assign dock_contact_url = section.settings.contact_url | default: '/pages/contact-milaura'
-%}

{% style %}
  :root {
    --milaura-mobile-dock-bar: 60px;
    --milaura-mobile-dock-gems: 28px;
    --milaura-mobile-dock-total: calc(
      var(--milaura-mobile-dock-bar) +
      var(--milaura-mobile-dock-gems) +
      env(safe-area-inset-bottom, 0px)
    );
  }

  .milaura-dock {
    position: fixed;
    inset: auto 0 0;
    z-index: 1000002;
    display: none;
    align-items: flex-start;
    width: 100%;
    min-height: var(--milaura-mobile-dock-total);
    padding: 0 4px;
    background: {{ section.settings.bg_color | default: '#2F222D' }};
    border-top: 1px solid rgba(111, 169, 166, 0.72);
    box-shadow: 0 -12px 30px rgba(47, 34, 45, 0.2);
    isolation: isolate;
  }

  .milaura-dock-gem-crown {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    height: calc(var(--milaura-mobile-dock-gems) + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
    background: {{ section.settings.bg_color | default: '#2F222D' }};
    border-top: 1px solid rgba(185, 151, 91, 0.38);
    pointer-events: none;
  }

  .milaura-dock-gem-crown img {
    position: absolute;
    top: -50px;
    left: 50%;
    display: block;
    width: 100%;
    min-width: 320px;
    height: auto;
    transform: translateX(-50%);
  }

  .milaura-dock-gem-crown::after {
    content: '';
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 10px;
    background: linear-gradient(
      to bottom,
      {{ section.settings.bg_color | default: '#2F222D' }} 0%,
      rgba(47, 34, 45, 0) 100%
    );
  }

  .milaura-dock-item {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1 1 20%;
    min-width: 0;
    min-height: var(--milaura-mobile-dock-bar);
    height: var(--milaura-mobile-dock-bar);
    padding: 7px 2px 5px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: {{ section.settings.text_color | default: '#FBF8F3' }};
    background: transparent;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .milaura-dock-item + .milaura-dock-item::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 0;
    width: 1px;
    background: rgba(111, 169, 166, 0.7);
  }

  .milaura-dock-item svg {
    width: 23px;
    height: 23px;
    color: {{ section.settings.icon_color | default: '#D7B8DF' }};
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 180ms ease, transform 180ms ease, filter 180ms ease;
  }

  .milaura-dock-circle-mark {
    position: relative;
    display: block;
    width: 23px;
    height: 23px;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .milaura-dock-circle-mark__ring {
    position: absolute;
    display: block;
    border: 1.35px solid;
    pointer-events: none;
  }

  .milaura-dock-circle-mark__ring--gold {
    inset: 4px 1px 3px 2px;
    border-color: #b9975b;
    border-radius: 48% 52% 46% 54% / 53% 45% 55% 47%;
    transform: rotate(10deg);
  }

  .milaura-dock-circle-mark__ring--aqua {
    inset: 2px 4px 2px 3px;
    border-color: #6fa9a6;
    border-radius: 53% 47% 55% 45% / 46% 54% 48% 52%;
    transform: rotate(-13deg);
  }

  .milaura-dock-item:active {
    transform: scale(0.94);
  }

  .milaura-dock-item:hover,
  .milaura-dock-item:focus-visible,
  .milaura-dock-item.is-current {
    color: #ffffff;
    background: rgba(111, 169, 166, 0.12);
  }

  .milaura-dock-item:hover svg,
  .milaura-dock-item:focus-visible svg,
  .milaura-dock-item.is-current svg {
    color: #efdaf2;
    filter: drop-shadow(0 0 7px rgba(215, 184, 223, 0.42));
    transform: translateY(-1px);
  }

  .milaura-dock-item:hover .milaura-dock-circle-mark,
  .milaura-dock-item:focus-visible .milaura-dock-circle-mark,
  .milaura-dock-item.is-current .milaura-dock-circle-mark {
    filter: drop-shadow(0 0 7px rgba(215, 184, 223, 0.34));
    transform: translateY(-1px);
  }

  .milaura-dock-item:focus-visible {
    outline: 2px solid #6fa9a6;
    outline-offset: -4px;
  }

  .milaura-dock-label {
    max-width: 100%;
    overflow: hidden;
    font-family: 'Lato', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .milaura-dock-badge {
    position: absolute;
    top: 5px;
    left: calc(50% + 8px);
    display: none;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
    color: #2f222d;
    background: {{ section.settings.badge_color | default: '#B9975B' }};
    border: 1px solid rgba(251, 248, 243, 0.88);
    border-radius: 999px;
    font-family: 'Lato', sans-serif;
    font-size: 9px;
    font-weight: 800;
    line-height: 1;
  }

  @media screen and (max-width: 768px) {
    body {
      padding-bottom: var(--milaura-mobile-dock-total) !important;
    }

    .milaura-dock {
      display: flex;
    }

    .milaura-sticky-bar {
      bottom: calc(var(--milaura-mobile-dock-total) + 8px) !important;
    }

    .milaura-bubble-trigger,
    .milaura-bubble-label {
      bottom: calc(var(--milaura-mobile-dock-total) + 12px) !important;
    }
  }

  @media screen and (max-width: 359px) {
    .milaura-dock-label {
      font-size: 9.5px;
    }

    .milaura-dock-item svg {
      width: 21px;
      height: 21px;
    }

    .milaura-dock-circle-mark {
      width: 21px;
      height: 21px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .milaura-dock-item,
    .milaura-dock-item svg,
    .milaura-dock-circle-mark {
      transition: none !important;
    }
  }
{% endstyle %}

<nav class="milaura-dock" id="milaura-dock" aria-label="Navigation principale mobile">
  <div class="milaura-dock-gem-crown" aria-hidden="true">
    {%- if section.settings.gem_line_image != blank -%}
      {{ section.settings.gem_line_image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 720, 960, 1280, 1600', sizes: '100vw' }}
    {%- else -%}
      <img src="{{ 'milaura-dock-gem-line-v1.webp' | asset_url }}" width="1600" height="550" alt="" loading="eager">
    {%- endif -%}
  </div>

  <button
    type="button"
    class="milaura-dock-item"
    data-dock-menu
    aria-label="{{ section.settings.menu_label | default: 'Menu' }}"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 7h16M4 12h11M4 17h16"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.menu_label | default: 'Menu' }}</span>
  </button>

  <button type="button" class="milaura-dock-item" data-dock-search aria-label="{{ section.settings.search_label | default: 'Rechercher' }}">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="m16.2 16.2 4 4"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.search_label | default: 'Rechercher' }}</span>
  </button>

  <a
    href="{{ dock_contact_url }}"
    class="milaura-dock-item{% if request.path contains '/pages/contact' %} is-current{% endif %}"
    aria-label="{{ section.settings.contact_label | default: 'Contact' }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 5.5h14v10H9l-4 3v-13Z"/>
      <path d="M8 9h8M8 12h5"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.contact_label | default: 'Contact' }}</span>
  </a>

  <a
    href="{{ routes.account_url }}"
    class="milaura-dock-item{% if request.path contains '/account' %} is-current{% endif %}"
    aria-label="{{ section.settings.account_label | default: 'Cercle' }}"
  >
    <span class="milaura-dock-circle-mark" aria-hidden="true">
      <span class="milaura-dock-circle-mark__ring milaura-dock-circle-mark__ring--gold"></span>
      <span class="milaura-dock-circle-mark__ring milaura-dock-circle-mark__ring--aqua"></span>
    </span>
    <span class="milaura-dock-label">{{ section.settings.account_label | default: 'Cercle' }}</span>
  </a>

  <a
    href="{{ routes.cart_url }}"
    class="milaura-dock-item{% if request.path == routes.cart_url %} is-current{% endif %}"
    aria-label="{{ section.settings.cart_label | default: 'Panier' }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 7h12l-1 13H7L6 7Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    </svg>
    <span class="milaura-dock-label">{{ section.settings.cart_label | default: 'Panier' }}</span>
    <span class="milaura-dock-badge" id="milaura-dock-badge" aria-live="polite">0</span>
  </a>
</nav>

<script>
(function() {
  'use strict';

  var menuButton = document.querySelector('[data-dock-menu]');
  var searchButton = document.querySelector('[data-dock-search]');
  var badge = document.getElementById('milaura-dock-badge');

  if (menuButton) {
    var navbarBurger = document.querySelector('[id^="burger-"]');
    if (navbarBurger && navbarBurger.getAttribute('aria-controls')) {
      menuButton.setAttribute('aria-controls', navbarBurger.getAttribute('aria-controls'));
    }

    menuButton.addEventListener('click', function() {
      if (navbarBurger) navbarBurger.click();
    });

    document.addEventListener('milaura:menu-state', function(event) {
      if (!event.detail) return;
      var isExpanded = Boolean(event.detail.expanded);
      menuButton.setAttribute('aria-expanded', String(isExpanded));
      menuButton.classList.toggle('is-current', isExpanded);
      if (event.detail.controls) menuButton.setAttribute('aria-controls', event.detail.controls);
    });
  }

  if (searchButton) {
    searchButton.addEventListener('click', function() {
      if (typeof window.milauraOpenSearch === 'function') {
        window.milauraOpenSearch();
      } else {
        var navbarSearch = document.querySelector('[data-milaura-search-toggle]');
        if (navbarSearch) navbarSearch.click();
      }
    });
  }

  function updateDockBadge(count) {
    if (!badge) return;
    if (count > 0) {
      badge.textContent = count;
      badge.style.display = 'flex';
    } else {
      badge.textContent = '0';
      badge.style.display = 'none';
    }
  }

  fetch('/cart.js')
    .then(function(response) { return response.json(); })
    .then(function(cart) { updateDockBadge(cart.item_count); })
    .catch(function() {});

  if (typeof window.PUB_SUB_EVENTS !== 'undefined' && typeof subscribe === 'function') {
    subscribe(PUB_SUB_EVENTS.cartUpdate, function(event) {
      if (event && event.cart) updateDockBadge(event.cart.item_count);
    });
  }

  document.addEventListener('cart:updated', function(event) {
    if (event.detail && event.detail.cart) {
      updateDockBadge(event.detail.cart.item_count);
      return;
    }

    fetch('/cart.js')
      .then(function(response) { return response.json(); })
      .then(function(cart) { updateDockBadge(cart.item_count); })
      .catch(function() {});
  });
})();
</script>

{% schema %}
{
  "name": "Milaura Dock Mobile",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Label menu",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Label recherche",
      "default": "Rechercher"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Label contact",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "URL page contact"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Label Cercle",
      "default": "Cercle"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Label panier",
      "default": "Panier"
    },
    {
      "type": "header",
      "content": "Signature visuelle"
    },
    {
      "type": "image_picker",
      "id": "gem_line_image",
      "label": "Ligne de gemmes"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Prune du dock",
      "default": "#2F222D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur des libelles",
      "default": "#FBF8F3"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Couleur des pictogrammes",
      "default": "#D7B8DF"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Couleur du badge panier",
      "default": "#B9975B"
    }
  ],
  "presets": [
    {
      "name": "Milaura Dock Mobile"
    }
  ]
}
{% endschema %}
