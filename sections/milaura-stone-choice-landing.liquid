{%- comment -%}
  Landing de choix par pierre.
  La structure reprend la landing Tous les bijoux avec un Hero dedie et un rail mobile natif.
{%- endcomment -%}

{{ 'milaura-stone-choice-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_desktop = section.settings.hero_desktop_asset | default: 'milaura-hero-stone-choice-v3-desktop.webp'
  assign hero_mobile = section.settings.hero_mobile_asset | default: 'milaura-hero-stone-choice-v3-mobile.webp'
  assign hero_title_id = 'MilauraStoneChoiceTitle-' | append: section.id
  assign stones_id = 'MilauraStoneChoiceDirectory-' | append: section.id
  assign stones_title_id = stones_id | append: '-title'
-%}

<div class="milaura-stone-choice">
  <section class="milaura-stone-choice__hero" aria-labelledby="{{ hero_title_id }}">
    <picture class="milaura-stone-choice__hero-media">
      <source media="(max-width: 749px)" srcset="{{ hero_mobile | asset_url }}">
      <img
        class="milaura-stone-choice__hero-image"
        src="{{ hero_desktop | asset_url }}"
        alt="{{ section.settings.hero_image_alt | escape }}"
        width="1942"
        height="810"
        loading="eager"
        fetchpriority="high"
      >
    </picture>

    <div class="milaura-stone-choice__hero-inner">
      <div class="milaura-stone-choice__hero-copy">
        {%- if section.settings.signature != blank -%}
          <p class="milaura-stone-choice__signature">{{ section.settings.signature | escape }}</p>
        {%- endif -%}

        <h1 id="{{ hero_title_id }}" class="milaura-stone-choice__title">
          {{ section.settings.heading | default: page.title | escape }}
        </h1>

        {%- if section.settings.introduction != blank -%}
          <div class="milaura-stone-choice__intro rte">{{ section.settings.introduction }}</div>
        {%- endif -%}

        {%- if section.settings.hero_cta_label != blank -%}
          <a class="milaura-stone-choice__text-link" href="#{{ stones_id }}">
            {{ section.settings.hero_cta_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
    <div class="milaura-stone-choice__trust" aria-label="Les engagements MilAura">
      <div class="milaura-stone-choice__shell milaura-stone-choice__trust-inner">
        {%- if section.settings.trust_1 != blank -%}<p>{{ section.settings.trust_1 | escape }}</p>{%- endif -%}
        {%- if section.settings.trust_2 != blank -%}<p>{{ section.settings.trust_2 | escape }}</p>{%- endif -%}
        {%- if section.settings.trust_3 != blank -%}<p>{{ section.settings.trust_3 | escape }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <section id="{{ stones_id }}" class="milaura-stone-choice__directory" aria-labelledby="{{ stones_title_id }}">
    <div class="milaura-stone-choice__shell">
      <header class="milaura-stone-choice__directory-header">
        <h2 id="{{ stones_title_id }}">{{ section.settings.stones_heading | escape }}</h2>
        {%- if section.settings.stones_text != blank -%}
          <p>{{ section.settings.stones_text | escape }}</p>
        {%- endif -%}
      </header>

      <ul class="milaura-stone-choice__list" aria-label="Choisir une pierre">
        {%- for block in section.blocks -%}
          {%- liquid
            assign stone_collection = block.settings.collection
            assign stone_link = block.settings.link
            if stone_link == blank and stone_collection != blank
              assign stone_link = stone_collection.url
            endif
            if section.settings.preview_mode and block.settings.preview_link != blank
              assign stone_link = block.settings.preview_link
            endif
            assign image_connector = '?'
            if block.settings.image_url contains '?'
              assign image_connector = '&'
            endif
            assign image_base = block.settings.image_url | append: image_connector
          -%}

          {%- if stone_link != blank and block.settings.image_url != blank and block.settings.heading != blank -%}
            <li class="milaura-stone-choice__item" {{ block.shopify_attributes }}>
              <a class="milaura-stone-choice__card" href="{{ stone_link }}">
                <div class="milaura-stone-choice__card-media">
                  {% # theme-check-disable RemoteAsset %}
                  <img
                    class="milaura-stone-choice__card-image"
                    src="{{ image_base | escape }}width=760"
                    srcset="{{ image_base | escape }}width=360 360w, {{ image_base | escape }}width=560 560w, {{ image_base | escape }}width=760 760w"
                    sizes="(max-width: 749px) 78vw, (max-width: 1099px) 30vw, 23vw"
                    alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                    width="760"
                    height="760"
                    loading="lazy"
                    draggable="false"
                  >
                  {% # theme-check-enable RemoteAsset %}
                </div>
                <div class="milaura-stone-choice__card-copy">
                  <h3>{{ block.settings.heading | escape }}</h3>
                  {%- if block.settings.body != blank -%}
                    <p>{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                  <span class="milaura-stone-choice__card-link">Voir les bijoux</span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.jewelry_link != blank and section.settings.jewelry_link_label != blank -%}
        <div class="milaura-stone-choice__jewelry-path">
          <span>{{ section.settings.jewelry_link_intro | escape }}</span>
          <a class="milaura-stone-choice__text-link" href="{{ section.settings.jewelry_link }}">
            {{ section.settings.jewelry_link_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Landing Bijoux par pierre",
  "tag": "section",
  "class": "section-milaura-stone-choice-landing",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "hero_desktop_asset", "label": "Asset Hero bureau", "default": "milaura-hero-stone-choice-v3-desktop.webp" },
    { "type": "text", "id": "hero_mobile_asset", "label": "Asset Hero mobile", "default": "milaura-hero-stone-choice-v3-mobile.webp" },
    { "type": "text", "id": "hero_image_alt", "label": "Description du Hero", "default": "Pierres naturelles révélées dans une faille minérale" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "Choisir par pierre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Bijoux par pierre" },
    { "type": "richtext", "id": "introduction", "label": "Introduction", "default": "<p>Aigue-marine, améthyste, quartz rose, sodalite et bien d’autres : choisissez la pierre qui vous attire et découvrez les bijoux disponibles.</p>" },
    { "type": "text", "id": "hero_cta_label", "label": "Action du Hero", "default": "Choisir ma pierre" },
    { "type": "text", "id": "trust_1", "label": "Engagement 1", "default": "Pierres naturelles sélectionnées" },
    { "type": "text", "id": "trust_2", "label": "Engagement 2", "default": "Préparé dans notre atelier à Metz" },
    { "type": "text", "id": "trust_3", "label": "Engagement 3", "default": "Service humain 6j/7" },
    { "type": "text", "id": "stones_heading", "label": "Titre des pierres", "default": "Choisissez votre pierre" },
    { "type": "text", "id": "stones_text", "label": "Introduction des pierres", "default": "Choisissez votre bijou ou votre accessoire en commençant par la pierre que vous recherchez. À moins que ce soit elle qui vous recherche…" },
    { "type": "text", "id": "jewelry_link_intro", "label": "Introduction du lien bijoux", "default": "Vous préférez commencer par un bijou ?" },
    { "type": "text", "id": "jewelry_link_label", "label": "Lien bijoux", "default": "Choisir par bijou" },
    { "type": "url", "id": "jewelry_link", "label": "Destination bijoux" },
    { "type": "checkbox", "id": "preview_mode", "label": "Utiliser les liens de recette privée", "default": false }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Pierre",
      "settings": [
        { "type": "text", "id": "heading", "label": "Pierre" },
        { "type": "text", "id": "body", "label": "Repère de couleur" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Landing" },
        { "type": "url", "id": "preview_link", "label": "Landing de recette" },
        { "type": "url", "id": "image_url", "label": "Photographie Shopify existante" },
        { "type": "text", "id": "image_alt", "label": "Description de la photographie" },
        { "type": "number", "id": "piece_count", "label": "Nombre de pièces préparées", "default": 1 },
        { "type": "text", "id": "row_label", "label": "Ancien repère de rangée" }
      ]
    }
  ],
  "presets": [{ "name": "Landing Bijoux par pierre" }]
}
{% endschema %}
