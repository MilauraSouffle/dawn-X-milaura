{%- comment -%}
  MILAURA PRODUCT CROSSSELL
  Version 8.0 : recommandations coherentes et rail produit partage.

  Une seule famille est affichee par ordre de priorite :
  1. selection manuelle milaura.crosssell_products ;
  2. meme pierre ;
  3. meme type de produit ;
  4. collection de repli.

  Les familles ne sont jamais melangees dans le meme rail.
{%- endcomment -%}

{{ 'milaura-section-heading.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign max_products = section.settings.products_to_show | default: 4 | at_most: 4
  assign min_products = section.settings.min_products | default: 1
  assign current_product_id = product.id | default: 0
  assign scan_limit = 50

  assign current_stone = product.metafields.milaura.stone_handle.value | default: product.metafields.milaura.stone_handle
  assign stone_label = product.metafields.milaura.stone_name.value | default: product.metafields.milaura.stone_name
  if stone_label == blank and current_stone != blank
    assign stone_label = current_stone | replace: '-', ' ' | capitalize
  endif

  assign current_type = product.metafields.milaura.product_type_handle.value | default: product.metafields.milaura.product_type_handle | default: product.type | downcase | handleize
  assign metafield_products = product.metafields.milaura.crosssell_products.value
  assign fallback_collection = collections[section.settings.fallback_collection]

  assign recommendation_cards = ''
  assign recommendation_mode = ''
  assign shown_count = 0
-%}

{%- if metafield_products != blank -%}
  {%- assign candidate_count = 0 -%}
  {%- assign candidate_ids = ',' -%}
  {%- capture candidate_cards -%}
    {%- for rec_product in metafield_products -%}
      {%- if rec_product.id == current_product_id -%}{%- continue -%}{%- endif -%}
      {%- if candidate_count >= max_products -%}{%- break -%}{%- endif -%}
      {%- assign rec_key = ',' | append: rec_product.id | append: ',' -%}
      {%- if candidate_ids contains rec_key -%}{%- continue -%}{%- endif -%}
      {%- assign candidate_count = candidate_count | plus: 1 -%}
      {%- if candidate_count <= 2 -%}{%- assign image_loading = 'eager' -%}{%- else -%}{%- assign image_loading = 'lazy' -%}{%- endif -%}
      {% render 'milaura-product-card',
        product: rec_product,
        img_loading: image_loading,
        show_vendor: section.settings.show_vendor,
        show_badges: true,
        show_secondary_image: true,
        force_bestseller_badge: false
      %}
      {%- assign candidate_ids = candidate_ids | append: rec_product.id | append: ',' -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if candidate_count >= min_products -%}
    {%- assign recommendation_cards = candidate_cards -%}
    {%- assign recommendation_mode = 'curated' -%}
    {%- assign shown_count = candidate_count -%}
  {%- endif -%}
{%- endif -%}

{%- if shown_count < min_products and current_stone != blank and fallback_collection != blank -%}
  {%- assign candidate_count = 0 -%}
  {%- assign candidate_ids = ',' -%}
  {%- capture candidate_cards -%}
    {%- for rec_product in fallback_collection.products limit: scan_limit -%}
      {%- if rec_product.id == current_product_id -%}{%- continue -%}{%- endif -%}
      {%- if candidate_count >= max_products -%}{%- break -%}{%- endif -%}
      {%- assign rec_key = ',' | append: rec_product.id | append: ',' -%}
      {%- if candidate_ids contains rec_key -%}{%- continue -%}{%- endif -%}
      {%- assign rec_stone = rec_product.metafields.milaura.stone_handle.value | default: rec_product.metafields.milaura.stone_handle -%}
      {%- unless rec_stone == current_stone -%}{%- continue -%}{%- endunless -%}
      {%- assign candidate_count = candidate_count | plus: 1 -%}
      {%- if candidate_count <= 2 -%}{%- assign image_loading = 'eager' -%}{%- else -%}{%- assign image_loading = 'lazy' -%}{%- endif -%}
      {% render 'milaura-product-card',
        product: rec_product,
        img_loading: image_loading,
        show_vendor: section.settings.show_vendor,
        show_badges: true,
        show_secondary_image: true,
        force_bestseller_badge: false
      %}
      {%- assign candidate_ids = candidate_ids | append: rec_product.id | append: ',' -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if candidate_count >= min_products -%}
    {%- assign recommendation_cards = candidate_cards -%}
    {%- assign recommendation_mode = 'stone' -%}
    {%- assign shown_count = candidate_count -%}
  {%- endif -%}
{%- endif -%}

{%- if shown_count < min_products and current_type != blank and fallback_collection != blank -%}
  {%- assign candidate_count = 0 -%}
  {%- assign candidate_ids = ',' -%}
  {%- capture candidate_cards -%}
    {%- for rec_product in fallback_collection.products limit: scan_limit -%}
      {%- if rec_product.id == current_product_id -%}{%- continue -%}{%- endif -%}
      {%- if candidate_count >= max_products -%}{%- break -%}{%- endif -%}
      {%- assign rec_key = ',' | append: rec_product.id | append: ',' -%}
      {%- if candidate_ids contains rec_key -%}{%- continue -%}{%- endif -%}
      {%- assign rec_type = rec_product.metafields.milaura.product_type_handle.value | default: rec_product.metafields.milaura.product_type_handle | default: rec_product.type | downcase | handleize -%}
      {%- unless rec_type == current_type -%}{%- continue -%}{%- endunless -%}
      {%- assign candidate_count = candidate_count | plus: 1 -%}
      {%- if candidate_count <= 2 -%}{%- assign image_loading = 'eager' -%}{%- else -%}{%- assign image_loading = 'lazy' -%}{%- endif -%}
      {% render 'milaura-product-card',
        product: rec_product,
        img_loading: image_loading,
        show_vendor: section.settings.show_vendor,
        show_badges: true,
        show_secondary_image: true,
        force_bestseller_badge: false
      %}
      {%- assign candidate_ids = candidate_ids | append: rec_product.id | append: ',' -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if candidate_count >= min_products -%}
    {%- assign recommendation_cards = candidate_cards -%}
    {%- assign recommendation_mode = 'type' -%}
    {%- assign shown_count = candidate_count -%}
  {%- endif -%}
{%- endif -%}

{%- if shown_count < min_products and fallback_collection != blank -%}
  {%- assign candidate_count = 0 -%}
  {%- assign candidate_ids = ',' -%}
  {%- capture candidate_cards -%}
    {%- for rec_product in fallback_collection.products limit: scan_limit -%}
      {%- if rec_product.id == current_product_id -%}{%- continue -%}{%- endif -%}
      {%- if candidate_count >= max_products -%}{%- break -%}{%- endif -%}
      {%- assign rec_key = ',' | append: rec_product.id | append: ',' -%}
      {%- if candidate_ids contains rec_key -%}{%- continue -%}{%- endif -%}
      {%- assign candidate_count = candidate_count | plus: 1 -%}
      {%- if candidate_count <= 2 -%}{%- assign image_loading = 'eager' -%}{%- else -%}{%- assign image_loading = 'lazy' -%}{%- endif -%}
      {% render 'milaura-product-card',
        product: rec_product,
        img_loading: image_loading,
        show_vendor: section.settings.show_vendor,
        show_badges: true,
        show_secondary_image: true,
        force_bestseller_badge: false
      %}
      {%- assign candidate_ids = candidate_ids | append: rec_product.id | append: ',' -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if candidate_count >= min_products -%}
    {%- assign recommendation_cards = candidate_cards -%}
    {%- assign recommendation_mode = 'fallback' -%}
    {%- assign shown_count = candidate_count -%}
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign heading_title = 'À découvrir aussi'
  assign crosssell_heading_id = 'MilauraCrosssellTitle-' | append: section.id

  if recommendation_mode == 'curated'
    assign heading_title = 'À associer à ce produit'
  elsif recommendation_mode == 'stone'
    assign heading_title = 'D’autres créations avec cette pierre'
    if stone_label != blank
      assign heading_title = 'D’autres créations en ' | append: stone_label
    endif
  elsif recommendation_mode == 'type'
    if current_type contains 'collier'
      assign heading_title = 'D’autres colliers'
    elsif current_type contains 'bracelet'
      assign heading_title = 'D’autres bracelets'
    elsif current_type contains 'bague'
      assign heading_title = 'D’autres bagues'
    elsif current_type contains 'boucle'
      assign heading_title = 'D’autres boucles d’oreilles'
    elsif current_type contains 'bougie'
      assign heading_title = 'D’autres bougies'
    elsif current_type contains 'pierre' or current_type contains 'mineral'
      assign heading_title = 'D’autres pierres'
    endif
  endif
-%}

{%- if shown_count >= min_products -%}
  {% style %}
    #MilauraCrosssell-{{ section.id }} {
      padding: var(--milaura-esp-lg) 0 var(--milaura-esp-xl);
      overflow: hidden;
      background: transparent;
    }

    #MilauraCrosssell-{{ section.id }} .crosssell-header {
      max-width: 1200px;
      margin: 0 auto var(--milaura-esp-md);
      padding-inline: var(--milaura-esp-sm);
    }

    #MilauraCrosssell-{{ section.id }} .crosssell-carousel-wrapper {
      --milaura-rail-gap: var(--milaura-esp-md);
      --milaura-rail-card-desktop: clamp(270px, 24vw, 300px);
    }

    @media screen and (max-width: 749px) {
      #MilauraCrosssell-{{ section.id }} {
        padding: var(--milaura-esp-md) 0 var(--milaura-esp-lg);
      }

      #MilauraCrosssell-{{ section.id }} .crosssell-header {
        margin-bottom: var(--milaura-esp-sm);
      }
    }
  {% endstyle %}

  <section
    id="MilauraCrosssell-{{ section.id }}"
    class="milaura-product-crosssell"
    data-section-id="{{ section.id }}"
    {% if section.settings.show_title %}aria-labelledby="{{ crosssell_heading_id }}"{% else %}aria-label="{{ heading_title | escape }}"{% endif %}
  >
    {%- if section.settings.show_title -%}
      <div class="crosssell-header">
        {%- if recommendation_mode == 'curated' -%}
          {% render 'milaura-section-heading',
            eyebrow: 'Sélection de Karine',
            title: heading_title,
            heading_tag: 'h2',
            heading_id: crosssell_heading_id,
            align: 'center',
            size: 'section',
            eyebrow_style: 'utility'
          %}
        {%- else -%}
          {% render 'milaura-section-heading',
            title: heading_title,
            heading_tag: 'h2',
            heading_id: crosssell_heading_id,
            align: 'center',
            size: 'section',
            eyebrow_style: 'utility'
          %}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="crosssell-carousel-wrapper milaura-product-rail-shell milaura-product-rail-shell--carousel" data-milaura-product-rail-root>
      <button
        type="button"
        class="milaura-product-rail__arrow milaura-product-rail__arrow--previous"
        data-milaura-rail-previous
        aria-label="Produits précédents"
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div
        class="crosssell-carousel milaura-cards milaura-product-rail milaura-product-rail--desktop-carousel"
        data-milaura-product-rail
        role="list"
        tabindex="0"
        aria-label="{{ heading_title | escape }}"
      >
        {{ recommendation_cards }}
      </div>

      <button
        type="button"
        class="milaura-product-rail__arrow milaura-product-rail__arrow--next"
        data-milaura-rail-next
        aria-label="Produits suivants"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>

      {%- if shown_count > 1 -%}
        <div class="milaura-product-rail__navigation" data-milaura-rail-navigation aria-label="Navigation produits" hidden>
          {%- for i in (1..shown_count) -%}
            <button
              type="button"
              class="milaura-product-rail__dot{% if forloop.first %} is-active{% endif %}"
              data-milaura-rail-dot="{{ forloop.index0 }}"
              aria-label="Voir le produit {{ forloop.index }} sur {{ shown_count }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Milaura Crosssell",
  "class": "milaura-section",
  "settings": [
    {
      "type": "header",
      "content": "Source des recommandations"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Collection de recherche",
      "info": "Collection utilisée pour rechercher une famille cohérente de produits."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "min_products",
      "label": "Minimum pour afficher",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "info": "La section est masquée si aucune famille ne contient ce minimum."
    },
    {
      "type": "paragraph",
      "content": "La première famille disponible est affichée seule : sélection manuelle, même pierre, même type, puis collection de repli."
    },
    {
      "type": "header",
      "content": "Présentation"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Afficher le titre contextuel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le vendeur",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Milaura Crosssell"
    }
  ]
}
{% endschema %}
