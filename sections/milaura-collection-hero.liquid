{%- comment -%}
  MILAURA COLLECTION HERO - DYNAMIC ISLAND
  Animation style Apple Dynamic Island + BFM typewriter
  100% CSS - Works in Shopify editor
  @version 4.2.0
{%- endcomment -%}

{%- assign title_length = collection.title | size -%}
{%- assign typing_duration = title_length | times: 0.08 -%}
{%- if typing_duration < 0.8 %}{% assign typing_duration = 0.8 %}{% endif -%}
{%- liquid
  assign editorial_hero_slug = ''
  assign editorial_hero_dark = false
  assign editorial_hero_title = collection.title

  case collection.handle
    when 'bagues-pierres'
      assign editorial_hero_slug = 'bagues'
    when 'par-pierre-amethyste'
      assign editorial_hero_slug = 'amethyste'
      assign editorial_hero_dark = true
      assign editorial_hero_title = 'Bijoux en améthyste'
    when 'par-pierre-aigue-marine'
      assign editorial_hero_slug = 'aigue-marine'
    when 'par-pierre-agate'
      assign editorial_hero_slug = 'agate'
    when 'par-pierre-quartz-rose'
      assign editorial_hero_slug = 'quartz-rose'
    when 'par-pierre-lapis-lazuli'
      assign editorial_hero_slug = 'lapis-lazuli'
      assign editorial_hero_dark = true
    when 'par-pierre-amazonite'
      assign editorial_hero_slug = 'amazonite'
  endcase

  if editorial_hero_slug != blank
    assign editorial_desktop = 'milaura-hero-editorial-collection-' | append: editorial_hero_slug | append: '-desktop.webp'
    assign editorial_mobile = 'milaura-hero-editorial-collection-' | append: editorial_hero_slug | append: '-mobile.webp'
  endif
-%}

{%- if editorial_hero_slug == blank -%}
{%- style -%}
  /* Section principale - collée au header */
  #MilauraCollectionHero-{{ section.id }} {
    padding: 8px var(--milaura-spacing-sm) 6px !important;
    margin-top: 0 !important;
  }

  /* Override du page-width global pour cette section */
  #MilauraCollectionHero-{{ section.id }} .page-width {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-top: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* =============================================
     HERO ROW - Breadcrumb à gauche, Island au centre
     ============================================= */
  #MilauraCollectionHero-{{ section.id }} .hero__row {
    display: flex;
    align-items: center;
    position: relative;
    min-height: 44px;
  }

  /* =============================================
     BREADCRUMB - Position gauche absolue
     ============================================= */
  #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb {
    position: absolute;
    left: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--milaura-text-light, #999);
    z-index: 1;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb a:hover {
    color: var(--milaura-gold, #B9975B);
  }

  #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb svg {
    width: 8px;
    height: 8px;
    opacity: 0.4;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb span {
    color: var(--milaura-text, #333);
  }

  /* =============================================
     DYNAMIC ISLAND - Centré dans le row
     ============================================= */
  #MilauraCollectionHero-{{ section.id }} .hero__island-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__island {
    --milaura-island-aqua: var(--milaura-surface-aqua, #DCEBE8);
    --milaura-island-aqua-deep: #BFEAE3;
    --milaura-island-plum: #4A3147;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 44px;
    padding: 0 24px;

    /* Aigue-marine MilAura */
    background: linear-gradient(145deg, var(--milaura-island-aqua) 0%, var(--milaura-island-aqua-deep) 100%);
    border-radius: 50px;

    /* Contour prune discret et profondeur aigue-marine */
    box-shadow:
      0 0 0 1px rgba(74, 49, 71, 0.22),
      0 12px 32px rgba(100, 183, 172, 0.22),
      0 3px 9px rgba(74, 49, 71, 0.09),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);

    /* Animation d'apparition */
    animation: islandReveal 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    transform-origin: center center;
  }

  @keyframes islandReveal {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Lueur aigue-marine au hover */
  #MilauraCollectionHero-{{ section.id }} .hero__island::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 52px;
    background: linear-gradient(135deg,
      rgba(74, 49, 71, 0.2) 0%,
      transparent 40%,
      transparent 60%,
      rgba(100, 183, 172, 0.36) 100%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__island:hover::before {
    opacity: 1;
  }

  /* Indicateur pulsant (point doré) */
  #MilauraCollectionHero-{{ section.id }} .hero__island-dot {
    width: 6px;
    height: 6px;
    background: var(--milaura-gold, #B9975B);
    border-radius: 50%;
    flex-shrink: 0;
    animation: dotPulse 2s ease-in-out infinite;
    box-shadow: 0 0 8px rgba(185, 151, 91, 0.6);
  }

  @keyframes dotPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 8px rgba(185, 151, 91, 0.6);
    }
    50% {
      opacity: 0.7;
      transform: scale(0.8);
      box-shadow: 0 0 4px rgba(185, 151, 91, 0.3);
    }
  }

  /* =============================================
     TYPEWRITER - 100% CSS
     ============================================= */
  #MilauraCollectionHero-{{ section.id }} .hero__island-title {
    font-family: {{ section.settings.title_font }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: 600;
    color: var(--milaura-island-plum);
    margin: 0;
    white-space: nowrap;
    letter-spacing: 0.3px;
    line-height: 1.2;
    display: inline-flex;
    align-items: center;
  }

  #MilauraCollectionHero-{{ section.id }} .hero__typewriter-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    line-height: 1.2;
    padding-bottom: 0.2em;
    animation: typewriter {{ typing_duration }}s steps({{ title_length }}, end) 0.4s forwards;
  }

  @keyframes typewriter {
    0% { width: 0; }
    100% { width: 100%; }
  }

  /* Curseur clignotant */
  #MilauraCollectionHero-{{ section.id }} .hero__cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--milaura-island-plum);
    margin-left: 2px;
    vertical-align: middle;
    animation: cursorBlink 0.8s step-end infinite;
    animation-delay: 0.4s;
  }

  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Compteur produits */
  #MilauraCollectionHero-{{ section.id }} .hero__island-count {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    background: rgba(74, 49, 71, 0.09);
    border: 1px solid rgba(74, 49, 71, 0.11);
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    color: var(--milaura-island-plum);
    flex-shrink: 0;
    opacity: 0;
    animation: fadeIn 0.4s ease {{ typing_duration | plus: 0.6 }}s forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  /* =============================================
     RESPONSIVE
     ============================================= */
  @media screen and (max-width: 768px) {
    #MilauraCollectionHero-{{ section.id }} {
      padding: 8px var(--milaura-spacing-xs) 6px !important;
      margin-top: 0 !important;
    }

    #MilauraCollectionHero-{{ section.id }} .page-width {
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__row {
      min-height: 40px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb {
      font-size: 10px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island {
      height: 40px;
      padding: 0 18px;
      gap: 10px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-title {
      font-size: 16px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-count {
      padding: 3px 8px;
      font-size: 9px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-dot {
      width: 5px;
      height: 5px;
    }
  }

  /* Tablette - cacher le breadcrumb pour éviter chevauchement */
  @media screen and (max-width: 600px) {
    #MilauraCollectionHero-{{ section.id }} .hero__breadcrumb {
      display: none;
    }
  }

  /* Petit mobile */
  @media screen and (max-width: 380px) {
    #MilauraCollectionHero-{{ section.id }} .hero__island {
      height: 36px;
      padding: 0 14px;
      gap: 8px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-title {
      font-size: 14px;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-count {
      display: none;
    }
  }

  /* =============================================
     REDUCED MOTION
     ============================================= */
  @media (prefers-reduced-motion: reduce) {
    #MilauraCollectionHero-{{ section.id }} .hero__island {
      animation: none;
      opacity: 1;
      transform: none;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__typewriter-text {
      animation: none;
      width: auto;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__cursor {
      display: none;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-dot {
      animation: none;
    }

    #MilauraCollectionHero-{{ section.id }} .hero__island-count {
      animation: none;
      opacity: 1;
    }
  }
{%- endstyle -%}
{%- else -%}
{%- style -%}
  #MilauraCollectionHero-{{ section.id }} {
    position: relative;
    min-height: clamp(560px, 52vw, 760px);
    margin-top: calc(-1 * var(--header-height-desktop)) !important;
    overflow: hidden;
    isolation: isolate;
    color: var(--milaura-prune);
    background: var(--milaura-nacre);
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 0;
    margin-top: calc(-1 * var(--header-height-desktop)) !important;
    padding-inline: 0 !important;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(251, 248, 244, 0.9) 0%, rgba(251, 248, 244, 0.58) 31%, transparent 58%);
  }

  #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__art::after {
    background: linear-gradient(90deg, rgba(19, 24, 32, 0.74) 0%, rgba(19, 24, 32, 0.34) 34%, transparent 59%);
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  #MainContent #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__inner.page-width {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto !important;
    min-height: inherit;
    display: flex;
    align-items: center;
    padding: calc(var(--header-height-desktop) + var(--milaura-esp-lg)) clamp(32px, 4vw, 64px) var(--milaura-esp-xl) !important;
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__copy {
    width: min(540px, 42vw);
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--milaura-esp-xs);
    margin-bottom: var(--milaura-esp-lg);
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-micro);
    letter-spacing: var(--milaura-ls-label);
    text-transform: uppercase;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__eyebrow {
    margin: 0 0 var(--milaura-esp-xs);
    color: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-signature);
    font-size: clamp(25px, 2.25vw, 38px);
    line-height: 1;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__title {
    max-width: 10ch;
    margin: 0;
    color: inherit;
    font-family: var(--milaura-font-display);
    font-size: clamp(48px, 5.6vw, 86px);
    font-weight: 500;
    letter-spacing: var(--milaura-ls-titre);
    line-height: 0.96;
    text-wrap: balance;
  }

  #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__count {
    width: fit-content;
    margin: var(--milaura-esp-lg) 0 0;
    padding-top: var(--milaura-esp-xs);
    border-top: var(--milaura-filet-or);
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 650;
    letter-spacing: var(--milaura-ls-label);
    text-transform: uppercase;
  }

  #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark {
    color: var(--milaura-nacre);
  }

  #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__breadcrumb,
  #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__count {
    color: rgba(251, 248, 244, 0.8);
  }

  #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__eyebrow {
    color: var(--milaura-or-clair);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      margin-top: calc(-1 * var(--header-height-mobile)) !important;
    }

    #MilauraCollectionHero-{{ section.id }} {
      min-height: 760px;
      margin-top: calc(-1 * var(--header-height-mobile)) !important;
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__art::after,
    #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__art::after {
      background: linear-gradient(180deg, rgba(251, 248, 244, 0.94) 0%, rgba(251, 248, 244, 0.68) 27%, transparent 51%);
    }

    #MilauraCollectionHero-{{ section.id }}.milaura-collection-editorial--dark .milaura-collection-editorial__art::after {
      background: linear-gradient(180deg, rgba(19, 24, 32, 0.82) 0%, rgba(19, 24, 32, 0.48) 29%, transparent 52%);
    }

    #MainContent #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__inner.page-width {
      align-items: flex-start;
      padding: calc(var(--header-height-mobile) + var(--milaura-esp-md)) 18px var(--milaura-esp-lg) !important;
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__copy {
      width: min(100%, 430px);
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__breadcrumb {
      margin-bottom: var(--milaura-esp-md);
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__eyebrow {
      font-size: 28px;
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__title {
      max-width: 9ch;
      font-size: clamp(44px, 13vw, 68px);
    }

    #MilauraCollectionHero-{{ section.id }} .milaura-collection-editorial__count {
      margin-top: var(--milaura-esp-md);
      font-size: 11px;
    }
  }
{%- endstyle -%}
{%- endif -%}

{%- if editorial_hero_slug != blank -%}
<section
  id="MilauraCollectionHero-{{ section.id }}"
  class="milaura-collection-editorial{% if editorial_hero_dark %} milaura-collection-editorial--dark{% endif %}"
  aria-labelledby="MilauraCollectionHeroTitle-{{ section.id }}"
>
  <picture class="milaura-collection-editorial__art" aria-hidden="true">
    <source media="(max-width: 749px)" srcset="{{ editorial_mobile | asset_url }}">
    <img
      class="milaura-collection-editorial__image"
      src="{{ editorial_desktop | asset_url }}"
      alt=""
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
    >
  </picture>

  <div class="milaura-collection-editorial__inner page-width">
    <div class="milaura-collection-editorial__copy">
      {%- if section.settings.show_breadcrumb -%}
        <nav class="milaura-collection-editorial__breadcrumb" aria-label="Fil d'Ariane">
          <a href="{{ routes.root_url }}">Accueil</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ editorial_hero_title }}</span>
        </nav>
      {%- endif -%}

      <p class="milaura-collection-editorial__eyebrow">La collection MilAura</p>
      <h1 id="MilauraCollectionHeroTitle-{{ section.id }}" class="milaura-collection-editorial__title">
        {{ editorial_hero_title }}
      </h1>

      {%- if section.settings.show_count -%}
        <p class="milaura-collection-editorial__count">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'modèle', 'modèles' }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- else -%}
<section
  id="MilauraCollectionHero-{{ section.id }}"
  class="milaura-collection-hero"
  aria-label="{{ collection.title | escape }}"
>
  <div class="page-width">
    {%- comment -%} Row: Breadcrumb à gauche + Dynamic Island au centre {%- endcomment -%}
    <div class="hero__row">
      {%- comment -%} Breadcrumb ultra-discret {%- endcomment -%}
      {%- if section.settings.show_breadcrumb -%}
        <nav class="hero__breadcrumb" aria-label="Fil d'Ariane">
          <a href="{{ routes.root_url }}">Accueil</a>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
          <span aria-current="page">{{ collection.title }}</span>
        </nav>
      {%- endif -%}

      {%- comment -%} Dynamic Island {%- endcomment -%}
      <div class="hero__island-wrapper">
      <h1 class="hero__island">
        {%- comment -%} Point doré pulsant {%- endcomment -%}
        <span class="hero__island-dot" aria-hidden="true"></span>

        {%- comment -%} Titre avec typewriter CSS {%- endcomment -%}
        <span class="hero__island-title">
          <span class="hero__typewriter-text">{{ collection.title }}</span>
          {%- if section.settings.show_cursor -%}
            <span class="hero__cursor" aria-hidden="true"></span>
          {%- endif -%}
        </span>

        {%- comment -%} Compteur {%- endcomment -%}
        {%- if section.settings.show_count -%}
          <span class="hero__island-count">
            {{ collection.products_count }} {{ collection.products_count | pluralize: 'modèle', 'modèles' }}
          </span>
        {%- endif -%}
      </h1>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{%- if collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "{{ request.origin }}{{ collection.url }}#collectionpage",
  "name": {{ collection.title | json }},
  "description": {{ collection.description | strip_html | default: collection.title | json }},
  "url": "{{ request.origin }}{{ collection.url }}",
  "isPartOf": { "@id": "{{ shop.url }}/#website" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count }},
    "itemListElement": [
      {%- for product in collection.products limit: 30 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": "{{ request.origin }}{{ product.url }}",
        "name": {{ product.title | json }},
        "image": "{{ product.featured_image | image_url: width: 600 | prepend: 'https:' }}"
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "{{ request.origin }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ request.origin }}{{ collection.url }}"
      }
    ]
  }
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Collection Hero",
  "tag": "section",
  "class": "milaura-section",
  "settings": [
    {
      "type": "header",
      "content": "📝 Contenu"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Afficher le breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Afficher le compteur",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cursor",
      "label": "Afficher le curseur clignotant",
      "default": true,
      "info": "Effet machine à écrire"
    },
    {
      "type": "header",
      "content": "✏️ Style"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Police du titre",
      "options": [
        { "value": "var(--milaura-font-texte)", "label": "Instrument Sans, texte" },
        { "value": "var(--milaura-font-display)", "label": "Gloock, editorial" },
        { "value": "var(--milaura-font-signature)", "label": "Dancing Script, signature" }
      ],
      "default": "var(--milaura-font-texte)"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille du titre",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    }
