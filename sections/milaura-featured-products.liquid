{%- liquid
  assign featured_collection = section.settings.collection
  assign desktop_columns = section.settings.products_to_show | at_most: 4
  if desktop_columns < 1
    assign desktop_columns = 4
  endif
-%}

{%- if featured_collection != blank and featured_collection.products_count > 0 -%}
  {%- style -%}
    #MilauraProd-{{ section.id }} {
      --prod-columns: {{ desktop_columns }};
      padding: var(--milaura-esp-3xl) 0;
      overflow: hidden;
      color: var(--milaura-encre);
      background: var(--milaura-surface);
    }

    #MilauraProd-{{ section.id }}.milaura-products--mineral {
      background: var(--milaura-surface-mineral);
    }

    #MilauraProd-{{ section.id }} *,
    #MilauraProd-{{ section.id }} *::before,
    #MilauraProd-{{ section.id }} *::after {
      box-sizing: border-box;
    }

    #MilauraProd-{{ section.id }} .prod-container {
      width: min(1320px, calc(100% - clamp(32px, 7vw, 112px)));
      margin: 0 auto;
    }

    #MilauraProd-{{ section.id }} .prod-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--milaura-esp-lg);
      margin-bottom: var(--milaura-esp-lg);
    }

    #MilauraProd-{{ section.id }} .prod-eyebrow {
      margin: 0 0 var(--milaura-esp-sm);
      color: var(--milaura-aigue-profonde);
      font-size: var(--milaura-t-label);
      font-weight: 650;
      letter-spacing: var(--milaura-ls-label);
      line-height: var(--milaura-lh-label);
      text-transform: uppercase;
    }

    #MilauraProd-{{ section.id }} .prod-title {
      margin: 0;
      color: var(--milaura-encre);
      font-family: var(--milaura-font-display);
      font-size: var(--milaura-t-h2);
      font-weight: 400;
      line-height: var(--milaura-lh-h2);
    }

    #MilauraProd-{{ section.id }} .prod-subtitle {
      max-width: 620px;
      margin: var(--milaura-esp-sm) 0 0;
      color: var(--milaura-encre-secondaire);
      font-size: var(--milaura-t-corps);
      line-height: var(--milaura-lh-corps);
    }

    #MilauraProd-{{ section.id }} .prod-carousel-wrapper {
      width: min(1320px, calc(100% - clamp(32px, 7vw, 112px)));
      margin: 0 auto;
    }

    #MilauraProd-{{ section.id }} .prod-carousel {
      display: grid;
      grid-template-columns: repeat(var(--prod-columns), minmax(0, 1fr));
      gap: var(--milaura-esp-md);
      align-items: stretch;
    }

    #MilauraProd-{{ section.id }} .prod-carousel .milaura-product-card {
      min-width: 0;
      height: 100%;
    }

    #MilauraProd-{{ section.id }} .prod-link {
      display: inline-flex;
      min-height: var(--milaura-cible-tactile);
      align-items: center;
      gap: var(--milaura-esp-2xs);
      border-bottom: var(--milaura-filet-or);
      color: var(--milaura-encre);
      font-size: var(--milaura-t-label);
      font-weight: 650;
      letter-spacing: var(--milaura-ls-label);
      line-height: var(--milaura-lh-label);
      text-decoration: none;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #MilauraProd-{{ section.id }} .prod-link::after {
      content: '↗';
      color: var(--milaura-or-profond);
      font-size: var(--milaura-t-corps-large);
      font-weight: 400;
      line-height: 1;
    }

    #MilauraProd-{{ section.id }} .prod-link:focus-visible {
      outline: var(--milaura-focus);
      outline-offset: var(--milaura-focus-offset);
    }

    #MilauraProd-{{ section.id }} .prod-mobile-link {
      display: none;
    }

    @media screen and (max-width: 989px) {
      #MilauraProd-{{ section.id }} .prod-carousel-wrapper {
        width: 100%;
      }

      #MilauraProd-{{ section.id }} .prod-carousel {
        display: flex;
        gap: var(--milaura-esp-sm);
        overflow-x: auto;
        padding: 0 max(16px, calc((100vw - 680px) / 2)) var(--milaura-esp-sm);
        scroll-padding-inline: max(16px, calc((100vw - 680px) / 2));
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }

      #MilauraProd-{{ section.id }} .prod-carousel::-webkit-scrollbar {
        display: none;
      }

      #MilauraProd-{{ section.id }} .prod-carousel .milaura-product-card {
        flex: 0 0 min(76vw, 310px);
        width: min(76vw, 310px);
        scroll-snap-align: start;
      }
    }

    @media screen and (max-width: 749px) {
      #MilauraProd-{{ section.id }} {
        padding: var(--milaura-esp-2xl) 0;
      }

      #MilauraProd-{{ section.id }} .prod-container {
        width: min(100% - 32px, 680px);
      }

      #MilauraProd-{{ section.id }} .prod-header {
        grid-template-columns: 1fr;
        gap: var(--milaura-esp-sm);
      }

      #MilauraProd-{{ section.id }} .prod-subtitle {
        font-size: var(--milaura-t-petit);
      }

      #MilauraProd-{{ section.id }} .prod-header .prod-link {
        display: none;
      }

      #MilauraProd-{{ section.id }} .prod-mobile-link {
        display: inline-flex;
        width: fit-content;
        margin-top: var(--milaura-esp-md);
        margin-left: 16px;
      }
    }
  {%- endstyle -%}

  {%- if section.settings.homepage_selection_anchor -%}
    <span id="MilauraSelectionAtelier" class="milaura-product-section-anchor" aria-hidden="true"></span>
  {%- endif -%}

  {% render 'milaura-home-transition', tone: 'nacre' %}
  <section
    id="MilauraProd-{{ section.id }}"
    class="milaura-products milaura-products--{{ section.settings.tone }}"
    aria-labelledby="MilauraProdTitle-{{ section.id }}"
  >
    <div class="prod-container">
      <header class="prod-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="prod-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="MilauraProdTitle-{{ section.id }}" class="prod-title">{{ section.settings.title | escape }}</h2>
          {%- if section.settings.subtitle != blank -%}
            <p class="prod-subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: featured_collection.url }}" class="prod-link">
            <span>
              {{ section.settings.cta_label | escape }}
              {%- if section.settings.show_product_count -%}
                <span class="visually-hidden">, {{ featured_collection.products_count }} produits</span>
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}
      </header>
    </div>

    <div class="prod-carousel-wrapper">
      <div class="prod-carousel milaura-cards" role="list" aria-label="{{ section.settings.title | escape }}">
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {%- assign img_loading = 'lazy' -%}
          {%- if forloop.first -%}
            {%- assign img_loading = 'eager' -%}
          {%- endif -%}

          {% render 'milaura-product-card',
            product: product,
            img_loading: img_loading,
            show_vendor: section.settings.show_vendor,
            show_badges: section.settings.show_badges,
            show_secondary_image: true,
            force_bestseller_badge: false,
            badge_label: section.settings.badge_label
          %}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: featured_collection.url }}" class="prod-link prod-mobile-link">
        {{ section.settings.cta_label | escape }}
      </a>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Sélection MilAura",
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA hero",
      "default": false
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Fond",
      "options": [
        { "value": "nacre", "label": "Nacre" },
        { "value": "mineral", "label": "Minéral" }
      ],
      "default": "nacre"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "À découvrir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nouveautés"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Introduction",
      "default": "Les dernières pièces ajoutées à la boutique."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Nombre de produits"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Afficher le vendeur",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges prouvés",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Libellé de badge",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libellé du lien",
      "default": "Voir toute la sélection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien optionnel"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Annoncer le nombre de produits aux lecteurs d’écran",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Sélection MilAura"
    }
  ]
}
{% endschema %}
