{{ 'milaura-catalogue-hub.css' | asset_url | stylesheet_tag }}
{{ 'milaura-stone-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-stone-directory.js' | asset_url }}" defer="defer"></script>
{%- assign directory_title_id = 'MilauraStoneDirectoryTitle-' | append: section.id -%}
{%- assign last_row = section.blocks.size | minus: 1 | divided_by: 3 -%}

<section id="MilauraStoneDirectory" class="milaura-stone-directory milaura-hub" data-stone-directory aria-labelledby="MilauraStoneDirectoryTitle-{{ section.id }}">
  <div class="milaura-hub__shell">
    {% render 'milaura-section-heading', eyebrow: section.settings.eyebrow, title: section.settings.heading, text: section.settings.text, heading_tag: 'h2', heading_id: directory_title_id, align: 'center', size: 'section', eyebrow_style: 'signature' %}
    <div class="milaura-stone-directory__rows">
      {%- for row in (0..last_row) -%}
        {%- assign row_start = row | times: 3 -%}
        {%- assign first_block = section.blocks[row_start] -%}
        <div class="milaura-stone-directory__row" data-stone-row>
          <div class="milaura-stone-directory__viewport">
            <ul id="MilauraStoneTrack-{{ section.id }}-{{ row }}" class="milaura-stone-directory__track" data-stone-track aria-label="{{ first_block.settings.row_label | default: 'Découvrir les pierres' | escape }}">
              {%- for block in section.blocks offset: row_start limit: 3 -%}
                {%- liquid
                  assign stone_link = block.settings.link
                  if section.settings.preview_mode
                    assign stone_link = block.settings.preview_link
                  endif
                  comment
                    Le compteur suit les bijoux de la landing configuree. Le compteur
                    brut de collection inclut aussi des objets mineraux historiques.
                  endcomment
                  assign stone_count = block.settings.piece_count
                  assign image_connector = '?'
                  if block.settings.image_url contains '?'
                    assign image_connector = '&'
                  endif
                  assign image_base = block.settings.image_url | append: image_connector
                  assign image_sizes = '(max-width: 749px) 92vw, (max-width: 1100px) 45vw, 24vw'
                -%}
                <li class="milaura-stone-directory__item" data-stone-card data-stone-name="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
                  <a class="milaura-hub__destination" href="{{ stone_link }}">
                    <div class="milaura-hub__destination-media">
                      {% # theme-check-disable RemoteAsset %}
                      <img class="milaura-hub__destination-image" src="{{ image_base | escape }}width=900" srcset="{{ image_base | escape }}width=420 420w, {{ image_base | escape }}width=780 780w, {{ image_base | escape }}width=1200 1200w" sizes="{{ image_sizes }}" alt="{{ block.settings.image_alt | escape }}" width="1024" height="1024" loading="lazy">
                      {% # theme-check-enable RemoteAsset %}
                    </div>
                    <div class="milaura-hub__destination-copy">
                      <p class="milaura-hub__destination-count milaura-label">{{ stone_count }} {{ stone_count | pluralize: 'création', 'créations' }}</p>
                      <h3>{{ block.settings.heading | escape }}</h3>
                      <p class="milaura-hub__destination-body">{{ block.settings.body | escape }}</p>
                      <span class="milaura-hub__destination-link">Voir les bijoux <span aria-hidden="true">→</span></span>
                    </div>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
          <div class="milaura-stone-directory__controls" data-stone-controls hidden>
            <button class="milaura-stone-directory__button" type="button" data-stone-prev aria-label="Pierre précédente" aria-controls="MilauraStoneTrack-{{ section.id }}-{{ row }}">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="milaura-stone-directory__progress" aria-hidden="true"><span class="milaura-stone-directory__indicator"></span></div>
            <p class="milaura-stone-directory__position" data-stone-position aria-live="polite" aria-atomic="true">1 / 3</p>
            <button class="milaura-stone-directory__button" type="button" data-stone-next aria-label="Pierre suivante" aria-controls="MilauraStoneTrack-{{ section.id }}-{{ row }}">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Toutes les pierres",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Une pierre, une présence" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Explorez les nuances MilAura" },
    { "type": "text", "id": "text", "label": "Introduction", "default": "Retrouvez les bijoux et les conseils propres à chaque pierre." },
    { "type": "checkbox", "id": "preview_mode", "label": "Utiliser les liens de recette privée", "default": false }
  ],
  "blocks": [{
    "type": "stone",
    "name": "Pierre",
    "settings": [
      { "type": "text", "id": "heading", "label": "Pierre" },
      { "type": "text", "id": "body", "label": "Repère de couleur" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "url", "id": "link", "label": "Landing" },
      { "type": "url", "id": "preview_link", "label": "Landing de recette" },
      { "type": "url", "id": "image_url", "label": "Photographie Shopify existante" },
      { "type": "text", "id": "image_alt", "label": "Description de la photographie" },
      { "type": "number", "id": "piece_count", "label": "Nombre de pièces préparées", "default": 1 },
      { "type": "text", "id": "row_label", "label": "Pierres de cette rangée" }
    ]
  }],
  "presets": [{ "name": "Toutes les pierres" }]
}
{% endschema %}
