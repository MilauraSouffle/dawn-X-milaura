{{ 'milaura-authenticity-reports.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reports_id = 'MilauraAuthenticityReports-' | append: section.id
  assign hero_title_id = reports_id | append: '-title'
  assign process_title_id = reports_id | append: '-process-title'
  assign gallery_title_id = reports_id | append: '-gallery-title'
  assign scope_title_id = reports_id | append: '-scope-title'
  assign karine_title_id = reports_id | append: '-karine-title'
  assign karine_url = section.settings.karine_link

  if karine_url == blank
    assign karine_url = '/collections/selection-de-karine'
  endif
-%}

<article id="{{ reports_id }}" class="milaura-authenticity">
  <section class="milaura-authenticity__hero" aria-labelledby="{{ hero_title_id }}">
    <div class="milaura-authenticity__shell milaura-authenticity__hero-grid">
      <div class="milaura-authenticity__hero-copy">
        <h1 id="{{ hero_title_id }}">Rapports d’authenticité</h1>
        <p class="milaura-authenticity__lead">
          L’un de nos fournisseurs fait analyser des échantillons de lots par le Laboratoire Français de
          Gemmologie, LFG Paris. MilAura présente ici les informations disponibles et leur périmètre exact.
        </p>
        <a class="milaura-action milaura-action--editorial" href="#{{ gallery_title_id }}">
          Consulter les rapports
          <span class="milaura-action__icon" aria-hidden="true">
            <svg viewBox="0 0 18 18">
              <path d="M4 6.5 9 11l5-4.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
            </svg>
          </span>
        </a>
        <p class="milaura-authenticity__scope-note">
          Ces documents portent sur les échantillons analysés. Ils ne constituent pas un certificat individuel
          pour chaque bijou ou minéral MilAura.
        </p>
      </div>

      <figure class="milaura-authenticity__hero-report">
        <div class="milaura-authenticity__document-preview">
          <img
            src="{{ 'milaura-report-lfg-amethyste-08mm-420060.png' | asset_url }}"
            alt="Aperçu volontairement flouté du rapport concernant l’améthyste de 8 millimètres"
            width="1630"
            height="965"
            loading="eager"
            fetchpriority="high"
          >
          <span>Aperçu protégé</span>
        </div>
        <figcaption>
          <strong>Améthyste 8 mm</strong>
          <span>Rapport LFG nº 420060 · 2025-09-10 · aucune indication de traitement</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="milaura-authenticity__process" aria-labelledby="{{ process_title_id }}">
    <div class="milaura-authenticity__shell">
      <h2 id="{{ process_title_id }}">De l’analyse à votre commande</h2>
      <ol class="milaura-authenticity__process-list">
        <li>
          <strong>L’un de nos fournisseurs</strong>
          <span>fait analyser des échantillons sélectionnés dans ses lots.</span>
        </li>
        <li>
          <strong>LFG Paris</strong>
          <span>identifie l’échantillon et signale les traitements observés.</span>
        </li>
        <li>
          <strong>MilAura</strong>
          <span>conserve les rapports disponibles et précise leur portée avant de les présenter.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="milaura-authenticity__gallery" aria-labelledby="{{ gallery_title_id }}">
    <div class="milaura-authenticity__shell">
      <header class="milaura-authenticity__section-heading">
        <h2 id="{{ gallery_title_id }}">Les rapports disponibles</h2>
        <p>
          Les informations principales de chaque rapport sont résumées ci-dessous. Les aperçus sont volontairement
          floutés à la demande du fournisseur.
        </p>
      </header>

      <div class="milaura-authenticity__report-grid">
        <figure class="milaura-authenticity__report">
          <div class="milaura-authenticity__document-preview">
            <img
              src="{{ 'milaura-report-lfg-amethyste-08mm-420060.png' | asset_url }}"
              alt="Aperçu volontairement flouté du rapport concernant l’améthyste de 8 millimètres"
              width="1630"
              height="965"
              loading="lazy"
            >
            <span>Aperçu protégé</span>
          </div>
          <figcaption>
            <strong>Améthyste 8 mm</strong>
            <span>Rapport nº 420060</span>
            <span>2025-09-10 · aucune indication de traitement</span>
          </figcaption>
        </figure>

        <figure class="milaura-authenticity__report">
          <div class="milaura-authenticity__document-preview">
            <img
              src="{{ 'milaura-report-lfg-quartz-rose-08mm-420585.png' | asset_url }}"
              alt="Aperçu volontairement flouté du rapport concernant le quartz rose de 8 millimètres"
              width="1630"
              height="965"
              loading="lazy"
            >
            <span>Aperçu protégé</span>
          </div>
          <figcaption>
            <strong>Quartz rose 8 mm</strong>
            <span>Rapport nº 420585</span>
            <span>2025-09-10 · imprégnation de polymère signalée</span>
          </figcaption>
        </figure>

        <figure class="milaura-authenticity__report">
          <div class="milaura-authenticity__document-preview">
            <img
              src="{{ 'milaura-report-lfg-aigue-marine-08mm-377250.jpg' | asset_url }}"
              alt="Aperçu volontairement flouté du rapport concernant l’aigue-marine de 8 millimètres"
              width="1517"
              height="1037"
              loading="lazy"
            >
            <span>Aperçu protégé</span>
          </div>
          <figcaption>
            <strong>Aigue-marine 8 mm</strong>
            <span>Rapport nº 377250</span>
            <span>2020-09-23 · résine et huile signalées</span>
          </figcaption>
        </figure>

        <figure class="milaura-authenticity__report">
          <div class="milaura-authenticity__document-preview">
            <img
              src="{{ 'milaura-report-lfg-sodalite-06mm-bd030771-8.png' | asset_url }}"
              alt="Aperçu volontairement flouté du rapport concernant la sodalite de 6 millimètres"
              width="1618"
              height="972"
              loading="lazy"
            >
            <span>Aperçu protégé</span>
          </div>
          <figcaption>
            <strong>Sodalite 6 mm</strong>
            <span>Rapport nº BD030771/8</span>
            <span>Date non indiquée sur le scan · aucun traitement signalé</span>
          </figcaption>
        </figure>
      </div>

      <p class="milaura-authenticity__zoom-note">
        Les documents complets ne sont pas accessibles publiquement.
      </p>
    </div>
  </section>

  <section class="milaura-authenticity__scope" aria-labelledby="{{ scope_title_id }}">
    <div class="milaura-authenticity__shell">
      <header class="milaura-authenticity__section-heading milaura-authenticity__section-heading--compact">
        <h2 id="{{ scope_title_id }}">Ce que le rapport atteste</h2>
      </header>

      <div class="milaura-authenticity__scope-grid">
        <div>
          <h3>Pour l’échantillon analysé</h3>
          <ul>
            <li>la matière identifiée par le laboratoire ;</li>
            <li>les dimensions et la masse indiquées ;</li>
            <li>les traitements observés, lorsqu’ils sont mentionnés ;</li>
            <li>un numéro de rapport et, selon le document, une date.</li>
          </ul>
        </div>
        <div>
          <h3>Ce qu’il n’atteste pas</h3>
          <ul>
            <li>une certification globale de toutes les pierres MilAura ;</li>
            <li>l’analyse individuelle de chaque bijou ou minéral ;</li>
            <li>la provenance géographique lorsqu’elle n’est pas écrite ;</li>
            <li>un bénéfice médical ou thérapeutique.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="milaura-authenticity__karine" aria-labelledby="{{ karine_title_id }}">
    <div class="milaura-authenticity__shell milaura-authenticity__karine-grid">
      <figure class="milaura-authenticity__karine-media">
        <img
          src="{{ 'milaura-hero-proof-karine-v2.webp' | asset_url }}"
          alt="Karine, fondatrice de MilAura"
          width="1042"
          height="1474"
          loading="lazy"
        >
      </figure>

      <div class="milaura-authenticity__karine-copy">
        <h2 id="{{ karine_title_id }}">La sélection de Karine</h2>
        <p>
          Karine sélectionne les pièces présentées sur MilAura et vérifie leur aspect avant leur préparation à
          Metz. Les rapports complètent ce contrôle lorsqu’une analyse fournisseur est disponible.
        </p>
        <p>
          Ils ne remplacent ni son regard sur la pierre et la finition, ni les informations propres à chaque
          fiche produit.
        </p>
        <a class="milaura-action milaura-action--editorial" href="{{ karine_url }}">
          Découvrir la sélection de Karine
          <span class="milaura-action__icon" aria-hidden="true">
            <svg viewBox="0 0 18 18">
              <path d="M4 9h9M10 5l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <footer class="milaura-authenticity__source">
    <div class="milaura-authenticity__shell">
      <p>
        Source des analyses : l’un de nos fournisseurs. Les informations ci-dessus ont été relevées sur les rapports
        consultés le 2026-09-10.
      </p>
    </div>
  </footer>
</article>

{% schema %}
{
  "name": "Rapports d’authenticité",
  "tag": "section",
  "class": "section-milaura-authenticity-reports",
  "settings": [
    {
      "type": "url",
      "id": "karine_link",
      "label": "Destination de la sélection de Karine"
    }
  ],
  "presets": [
    {
      "name": "Rapports d’authenticité"
    }
  ]
}
{% endschema %}
