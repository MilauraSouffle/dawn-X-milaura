{{ 'milaura-home-karine-selection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.products_to_show | default: 3
-%}

{%- if featured_collection != blank and featured_collection.products_count > 0 -%}
  <section
    id="MilauraKarineSelection-{{ section.id }}"
    class="milaura-karine-selection"
    style="--milaura-karine-product-columns: {{ product_limit }};"
    aria-labelledby="MilauraKarineSelectionTitle-{{ section.id }}"
  >
    <div class="milaura-karine-selection__inner">
      <div class="milaura-karine-selection__intro">
        {%- if section.settings.label != blank -%}
          <p class="milaura-karine-selection__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        <h2 id="MilauraKarineSelectionTitle-{{ section.id }}" class="milaura-karine-selection__title">
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="milaura-karine-selection__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if section.settings.portrait != blank or section.settings.portrait_asset != blank or section.settings.note != blank -%}
          <div class="milaura-karine-selection__signature">
            {%- if section.settings.portrait != blank -%}
              {{- section.settings.portrait
                | image_url: width: 180
                | image_tag:
                  class: 'milaura-karine-selection__portrait',
                  widths: '96, 144, 180',
                  sizes: '72px',
                  loading: 'lazy',
                  alt: section.settings.portrait_alt
              -}}
            {%- elsif section.settings.portrait_asset != blank -%}
              <img
                class="milaura-karine-selection__portrait"
                src="{{ section.settings.portrait_asset | asset_url }}"
                alt="{{ section.settings.portrait_alt | escape }}"
                width="144"
                height="144"
                loading="lazy"
              >
            {%- endif -%}
            {%- if section.settings.note != blank -%}
              <p>{{ section.settings.note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        <a
          class="milaura-karine-selection__cta milaura-action milaura-action--editorial"
          href="{{ section.settings.cta_link | default: featured_collection.url }}"
        >
          <span>{{ section.settings.cta_label | escape }}</span>
          {% render 'milaura-action-icon' %}
        </a>
      </div>

      <div class="milaura-karine-selection__products milaura-cards" role="list" aria-label="Produits de la sélection de Karine">
        {%- for product in featured_collection.products limit: product_limit -%}
          <div class="milaura-karine-selection__product" role="listitem">
            {% render 'milaura-product-card',
              product: product,
              img_loading: 'lazy',
              show_vendor: false,
              show_badges: section.settings.show_badges,
              show_secondary_image: true,
              force_bestseller_badge: false,
              nested_list_item: false
            %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}


{% schema %}
{
  "name": "Sélection de Karine",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Repère",
      "default": "Le choix de Karine"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "La sélection de Karine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Des bijoux et objets en pierres choisis parmi les pièces disponibles en ce moment."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "La sélection évolue au fil des découvertes de Karine et des pièces disponibles."
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Portrait de Karine"
    },
    {
      "type": "text",
      "id": "portrait_asset",
      "label": "Asset portrait de repli"
    },
    {
      "type": "text",
      "id": "portrait_alt",
      "label": "Texte alternatif",
      "default": "Karine, fondatrice de MilAura"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Produits à afficher",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Action",
      "default": "Voir la sélection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien"
    }
  ],
  "presets": [
    {
      "name": "Sélection de Karine"
    }
  ]
}
{% endschema %}
