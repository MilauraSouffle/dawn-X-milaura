{{ 'milaura-home-paths.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-home-paths.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign path_count = 0
  for block in section.blocks
    if block.type == 'path'
      assign path_count = path_count | plus: 1
    endif
  endfor
-%}

{%- if path_count > 0 -%}
  {% render 'milaura-home-transition', tone: 'nacre' %}
  <section
    id="MilauraHomePaths-{{ section.id }}"
    class="milaura-home-paths"
    aria-labelledby="MilauraHomePathsTitle-{{ section.id }}"
    data-milaura-home-paths
  >
    <div class="milaura-home-paths__inner">
      <header class="milaura-home-paths__header milaura-section-intro">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="milaura-home-paths__eyebrow milaura-section-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="MilauraHomePathsTitle-{{ section.id }}" class="milaura-home-paths__title milaura-section-title">
            {{ section.settings.title | escape }}
          </h2>
        </div>
        {%- if section.settings.lead != blank -%}
          <p class="milaura-home-paths__lead">{{ section.settings.lead | escape }}</p>
        {%- endif -%}
      </header>

      <div class="milaura-home-paths__tabs" role="tablist" aria-label="Choisir un point de départ">
        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'path' -%}
            {%- liquid
              assign tab_index = tab_index | plus: 1
              assign path_variant = block.settings.variant | default: 'jewelry'
              assign tab_label = block.settings.tab_label
              if tab_label == blank
                case path_variant
                  when 'stone'
                    assign tab_label = 'Choisir par pierre'
                  when 'guided'
                    assign tab_label = 'Me laisser guider'
                  else
                    assign tab_label = 'Choisir par bijou'
                endcase
              endif
              assign tab_number = tab_index | prepend: '0' | slice: -2, 2
            -%}
            <button
              id="MilauraHomePathTab-{{ section.id }}-{{ block.id }}"
              class="milaura-home-paths__tab"
              type="button"
              role="tab"
              aria-controls="MilauraHomePathPanel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
              tabindex="{% if tab_index == 1 %}0{% else %}-1{% endif %}"
              data-home-path-tab
              {{ block.shopify_attributes }}
            >
              <span class="milaura-home-paths__tab-number" aria-hidden="true">{{ tab_number }}</span>
              <span class="milaura-home-paths__tab-label">{{ tab_label | escape }}</span>
              <span class="milaura-home-paths__tab-arrow" aria-hidden="true">↗</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="milaura-home-paths__panels">
        {%- assign panel_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'path' -%}
            {%- liquid
              assign panel_index = panel_index | plus: 1
              assign path_image = block.settings.image
              if path_image == blank and block.settings.product != blank
                assign path_image = block.settings.product.featured_image
              endif
              if path_image == blank and block.settings.collection != blank
                assign path_image = block.settings.collection.image
              endif

              assign path_url = block.settings.link
              if path_url == blank and block.settings.collection != blank
                assign path_url = block.settings.collection.url
              endif
              if path_url == blank and block.settings.product != blank
                assign path_url = block.settings.product.url
              endif
              if path_url == blank
                assign path_url = routes.all_products_collection_url
              endif

              assign path_variant = block.settings.variant | default: 'jewelry'
              assign loading_mode = 'lazy'
              if panel_index == 1
                assign loading_mode = 'eager'
              endif
            -%}
            <article
              id="MilauraHomePathPanel-{{ section.id }}-{{ block.id }}"
              class="milaura-home-paths__panel milaura-home-paths__panel--{{ path_variant }}"
              role="tabpanel"
              aria-labelledby="MilauraHomePathTab-{{ section.id }}-{{ block.id }}"
              tabindex="0"
              data-home-path-panel
              {% unless panel_index == 1 %}hidden{% endunless %}
            >
              <a class="milaura-home-paths__panel-link" href="{{ path_url }}">
                <span class="milaura-home-paths__panel-media">
                  {%- if path_image != blank -%}
                    {{- path_image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'milaura-home-paths__panel-image',
                        widths: '420, 620, 840, 1100, 1400, 1600',
                        sizes: '(max-width: 749px) calc(100vw - 64px), (max-width: 989px) 42vw, 36vw',
                        loading: loading_mode,
                        alt: block.settings.image_alt
                    -}}
                  {%- elsif block.settings.asset_name != blank -%}
                    <picture>
                      {%- if block.settings.mobile_asset_name != blank -%}
                        <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_asset_name | asset_url }}">
                      {%- endif -%}
                      <img
                        class="milaura-home-paths__panel-image"
                        src="{{ block.settings.asset_name | asset_url }}"
                        alt="{{ block.settings.image_alt | escape }}"
                        width="1600"
                        height="1067"
                        loading="{{ loading_mode }}"
                      >
                    </picture>
                  {%- endif -%}
                </span>
                <span class="milaura-home-paths__panel-copy">
                  <span>
                    {%- if block.settings.label != blank -%}
                      <span class="milaura-home-paths__panel-label">{{ block.settings.label | escape }}</span>
                    {%- endif -%}
                    <span class="milaura-home-paths__panel-title">{{ block.settings.title | escape }}</span>
                    {%- if block.settings.text != blank -%}
                      <span class="milaura-home-paths__panel-text">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="milaura-home-paths__panel-action milaura-action milaura-action--editorial">
                    <span>{{ block.settings.action | escape }}</span>
                    {% render 'milaura-action-icon' %}
                  </span>
                </span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <noscript>
        <style>
          #MilauraHomePaths-{{ section.id }} .milaura-home-paths__panel[hidden] { display: block !important; }
        </style>
      </noscript>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MilAura chemins de choix",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Trois façons de choisir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Commencez par ce qui compte pour vous."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Une forme à porter, une pierre à découvrir ou un ressenti du moment : choisissez votre point de départ."
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Chemin",
      "settings": [
        {
          "type": "select",
          "id": "variant",
          "label": "Univers",
          "options": [
            { "value": "jewelry", "label": "Bijou" },
            { "value": "stone", "label": "Pierre" },
            { "value": "guided", "label": "Ressenti" }
          ],
          "default": "jewelry"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Libellé de l’onglet"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Repère",
          "default": "Je sais ce que je veux porter"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Choisir un bijou"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "Bracelets, colliers, boucles d’oreilles, pendentifs et bagues."
        },
        {
          "type": "text",
          "id": "action",
          "label": "Action",
          "default": "Voir les bijoux"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection de repli"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit pour la photographie"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photographie"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Asset desktop de repli"
        },
        {
          "type": "text",
          "id": "mobile_asset_name",
          "label": "Asset mobile de repli"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texte alternatif"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MilAura chemins de choix",
      "blocks": [
        { "type": "path" },
        { "type": "path" },
        { "type": "path" }
      ]
    }
  ]
}
{% endschema %}
