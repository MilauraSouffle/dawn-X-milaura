{{ 'milaura-home-paths.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-home-paths.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign path_count = 0
  for block in section.blocks
    if block.type == 'path'
      assign path_count = path_count | plus: 1
    endif
  endfor
-%}

{%- if path_count > 0 -%}
  {% render 'milaura-home-transition', tone: 'nacre' %}
  <section
    id="MilauraHomePaths-{{ section.id }}"
    class="milaura-home-paths"
    aria-labelledby="MilauraHomePathsTitle-{{ section.id }}"
    data-milaura-home-paths
  >
    <div class="milaura-home-paths__inner">
      <header class="milaura-home-paths__header milaura-section-intro">
        <h2 id="MilauraHomePathsTitle-{{ section.id }}" class="milaura-home-paths__title milaura-section-title">
          {{ section.settings.title | escape }}
        </h2>
        <div class="milaura-home-paths__intro-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="milaura-home-paths__eyebrow milaura-section-label">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.lead != blank -%}
            <p class="milaura-home-paths__lead">{{ section.settings.lead | escape }}</p>
          {%- endif -%}
        </div>
      </header>

      <div
        class="milaura-home-paths__cards"
        role="list"
        aria-label="{{ section.settings.eyebrow | default: 'Trois façons de choisir' | escape }}"
        data-home-path-carousel
      >
        {%- assign card_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'path' -%}
            {%- liquid
              assign card_index = card_index | plus: 1
              assign path_variant = block.settings.variant | default: 'jewelry'
              assign card_label = block.settings.tab_label
              if card_label == blank
                case path_variant
                  when 'stone'
                    assign card_label = 'Choisir par pierre'
                  when 'guided'
                    assign card_label = 'Me laisser guider'
                  else
                    assign card_label = 'Choisir par bijou'
                endcase
              endif
              assign card_number = card_index | prepend: '0' | slice: -2, 2
              assign path_image = block.settings.image
              if path_image == blank and block.settings.product != blank
                assign path_image = block.settings.product.featured_image
              endif
              if path_image == blank and block.settings.collection != blank
                assign path_image = block.settings.collection.image
              endif

              assign path_url = block.settings.link
              if path_url == blank and block.settings.collection != blank
                assign path_url = block.settings.collection.url
              endif
              if path_url == blank and block.settings.product != blank
                assign path_url = block.settings.product.url
              endif
              if path_url == blank
                assign path_url = routes.all_products_collection_url
              endif

              assign loading_mode = 'lazy'
              if card_index == 1
                assign loading_mode = 'eager'
              endif
            -%}
            <article
              class="milaura-home-paths__card milaura-home-paths__card--{{ path_variant }}"
              role="listitem"
              data-home-path-card
              data-active="{% if card_index == 1 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <a class="milaura-home-paths__card-link" href="{{ path_url }}">
                <span class="milaura-home-paths__card-heading">
                  <span class="milaura-home-paths__card-number" aria-hidden="true">{{ card_number }}</span>
                  <span class="milaura-home-paths__card-label">{{ card_label | escape }}</span>
                  <span class="milaura-home-paths__card-arrow">{% render 'milaura-action-icon' %}</span>
                </span>
                <span class="milaura-home-paths__card-media">
                  {%- if path_image != blank -%}
                    {{- path_image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'milaura-home-paths__card-image',
                        widths: '420, 620, 840, 1100, 1400, 1600',
                        sizes: '(max-width: 749px) calc(100vw - 68px), (max-width: 989px) 42vw, 30vw',
                        loading: loading_mode,
                        alt: block.settings.image_alt
                    -}}
                  {%- elsif block.settings.asset_name != blank -%}
                    <picture>
                      {%- if block.settings.mobile_asset_name != blank -%}
                        <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_asset_name | asset_url }}">
                      {%- endif -%}
                      <img
                        class="milaura-home-paths__card-image"
                        src="{{ block.settings.asset_name | asset_url }}"
                        alt="{{ block.settings.image_alt | escape }}"
                        width="1254"
                        height="1254"
                        loading="{{ loading_mode }}"
                      >
                    </picture>
                  {%- endif -%}
                </span>
                <span class="milaura-home-paths__card-footer">
                  <span class="milaura-home-paths__card-action milaura-action milaura-action--editorial">
                    <span>{{ block.settings.action | escape }}</span>
                    {% render 'milaura-action-icon' %}
                  </span>
                </span>
              </a>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MilAura chemins de choix",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Trois façons de choisir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Vous cherchez un bijou, une pierre précise ou vous avez besoin de conseils pour choisir ?"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Les pierres et leurs vertus sont passionnantes, mais le choix peut vite devenir complexe. MilAura vous aide à trouver plus facilement le bijou et la pierre qui correspondent à vos goûts et à votre besoin du moment."
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Chemin",
      "settings": [
        {
          "type": "select",
          "id": "variant",
          "label": "Univers",
          "options": [
            { "value": "jewelry", "label": "Bijou" },
            { "value": "stone", "label": "Pierre" },
            { "value": "guided", "label": "Ressenti" }
          ],
          "default": "jewelry"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Titre de la carte"
        },
        {
          "type": "text",
          "id": "action",
          "label": "Action",
          "default": "Voir les bijoux"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection de repli"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit pour la photographie"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photographie"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Asset desktop de repli"
        },
        {
          "type": "text",
          "id": "mobile_asset_name",
          "label": "Asset mobile de repli"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Texte alternatif"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MilAura chemins de choix",
      "blocks": [
        { "type": "path" },
        { "type": "path" },
        { "type": "path" }
      ]
    }
  ]
}
{% endschema %}
