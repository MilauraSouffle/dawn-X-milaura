{%- comment -%}
  Structure de hub catalogue MilAura.
  Aucun produit ni lien de collection n est rendu sans selection explicite.
{%- endcomment -%}

{{ 'milaura-card.css' | asset_url | stylesheet_tag }}

{%- if section.settings.heading != blank or section.settings.introduction != blank or section.blocks.size > 0 -%}
  {%- style -%}
    #MilauraCatalogueHub-{{ section.id }} {
      padding: clamp(32px, 6vw, 72px) 16px;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__inner {
      max-width: 960px;
      margin: 0 auto;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__title {
      margin: 0;
      font-family: var(--milaura-font-display);
      font-size: clamp(32px, 6vw, 56px);
      line-height: 1.1;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__intro {
      max-width: 760px;
      margin-top: 20px;
      font-size: 17px;
      line-height: 1.7;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__content {
      margin-top: 40px;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__block + .milaura-catalogue-hub__block {
      margin-top: 28px;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__block h2 {
      margin: 0 0 10px;
      font-size: clamp(22px, 3vw, 30px);
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__eyebrow {
      margin: 0 0 4px;
      color: var(--milaura-text-light, #666666);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__body {
      font-size: 16px;
      line-height: 1.7;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__selection {
      padding: 20px;
      border: 1px solid rgba(91, 44, 91, 0.2);
      border-radius: 16px;
      background: #ffffff;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__selection-link {
      display: inline-flex;
      margin-top: 12px;
      color: var(--milaura-prune, #5b2c5b);
      font-weight: 700;
      text-underline-offset: 4px;
    }

    #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
      margin-top: 22px;
    }

    @media screen and (max-width: 990px) {
      #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 480px) {
      #MilauraCatalogueHub-{{ section.id }} {
        padding-right: 12px;
        padding-left: 12px;
      }

      #MilauraCatalogueHub-{{ section.id }} .milaura-catalogue-hub__products {
        gap: 10px;
      }
    }
  {%- endstyle -%}

  <main id="MilauraCatalogueHub-{{ section.id }}" class="milaura-catalogue-hub milaura-section">
    <div class="milaura-catalogue-hub__inner">
      {%- if section.settings.heading != blank -%}
        <h1 class="milaura-catalogue-hub__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.introduction != blank -%}
        <div class="milaura-catalogue-hub__intro rte">{{ section.settings.introduction }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="milaura-catalogue-hub__content">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'content' -%}
                {%- if block.settings.heading != blank or block.settings.body != blank -%}
                  <section class="milaura-catalogue-hub__block" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h2>{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="milaura-catalogue-hub__body rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                  </section>
                {%- endif -%}

              {%- when 'correspondence' -%}
                {%- if block.settings.label != blank or block.settings.heading != blank or block.settings.body != blank -%}
                  <section class="milaura-catalogue-hub__block" {{ block.shopify_attributes }}>
                    {%- if block.settings.label != blank -%}
                      <p class="milaura-catalogue-hub__eyebrow">{{ block.settings.label | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      <h2>{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="milaura-catalogue-hub__body rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                  </section>
                {%- endif -%}

              {%- when 'featured_collection' -%}
                {%- assign selected_collection = block.settings.collection -%}
                {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
                  <section class="milaura-catalogue-hub__block milaura-catalogue-hub__selection" {{ block.shopify_attributes }}>
                    <h2>{{ block.settings.heading | default: selected_collection.title | escape }}</h2>
                    {%- if block.settings.body != blank -%}
                      <div class="milaura-catalogue-hub__body rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                    <a class="milaura-catalogue-hub__selection-link" href="{{ selected_collection.url }}">Voir la sélection</a>
                  </section>
                {%- endif -%}

              {%- when 'product_selection' -%}
                {%- capture selection_cards -%}
                  {%- for index in (1..6) -%}
                    {%- assign product_setting = 'product_' | append: index -%}
                    {%- assign selected_product = block.settings[product_setting] -%}
                    {%- if selected_product != blank and selected_product.available -%}
                      {% render 'milaura-card-product',
                        card_product: selected_product,
                        img_loading: 'lazy',
                        show_vendor: false,
                        show_badges: true,
                        show_secondary_image: true,
                        force_bestseller_badge: false
                      %}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- assign selection_cards = selection_cards | strip -%}
                {%- if selection_cards != blank -%}
                  <section class="milaura-catalogue-hub__block" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h2>{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="milaura-catalogue-hub__body rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                    <div class="milaura-catalogue-hub__products milaura-cards">
                      {{ selection_cards }}
                    </div>
                  </section>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </main>
{%- endif -%}

