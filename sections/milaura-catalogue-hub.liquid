{%- comment -%}
  Hub editorial MilAura pour les destinations Mariage, Naissance et Pierre.
  Les produits et collections sont toujours selectionnes explicitement dans le template.
{%- endcomment -%}

{{ 'milaura-section-heading.css' | asset_url | stylesheet_tag }}
{{ 'milaura-catalogue-hub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'milaura-catalogue-hub.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hub_theme = section.settings.theme | default: 'stone'
  assign hero_editorial_desktop = 'milaura-hero-editorial-hub-' | append: hub_theme | append: '-desktop.webp'
  assign hero_editorial_mobile = 'milaura-hero-editorial-hub-' | append: hub_theme | append: '-mobile.webp'
  assign correspondence_count = 0
  assign product_selection_count = 0
  assign destination_count = 0
  assign content_count = 0

  for block in section.blocks
    case block.type
      when 'correspondence'
        assign correspondence_count = correspondence_count | plus: 1
      when 'product_selection'
        assign product_selection_count = product_selection_count | plus: 1
      when 'featured_collection'
        assign selected_collection = block.settings.collection
        if selected_collection != blank and selected_collection.products_count > 0
          assign destination_count = destination_count | plus: 1
        endif
      when 'content'
        assign content_count = content_count | plus: 1
    endcase
  endfor

  assign hub_title_id = 'MilauraCatalogueHubTitle-' | append: section.id
  assign guide_id = 'MilauraHubGuide-' | append: section.id
  assign products_id = 'MilauraHubProducts-' | append: section.id
  assign destinations_id = 'MilauraHubDestinations-' | append: section.id
  assign guide_title_id = guide_id | append: '-title'
  assign destinations_title_id = destinations_id | append: '-title'
  assign hero_target = products_id
  if correspondence_count > 0
    assign hero_target = guide_id
  elsif destination_count > 0
    assign hero_target = destinations_id
  endif
-%}

{%- if section.settings.heading != blank or section.blocks.size > 0 -%}
  <div
    id="MilauraCatalogueHub-{{ section.id }}"
    class="milaura-hub milaura-hub--{{ hub_theme }}"
    data-milaura-hub
  >
    <section class="milaura-hub__hero" aria-labelledby="{{ hub_title_id }}">
      <picture class="milaura-hub__hero-art" aria-hidden="true">
        <source media="(max-width: 749px)" srcset="{{ hero_editorial_mobile | asset_url }}">
        <img
          class="milaura-hub__hero-art-image"
          src="{{ hero_editorial_desktop | asset_url }}"
          alt=""
          width="1600"
          height="1000"
          loading="eager"
          fetchpriority="high"
        >
      </picture>

      <div class="milaura-hub__hero-inner">
        <div class="milaura-hub__hero-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="milaura-hub__signature milaura-signature">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h1 id="{{ hub_title_id }}" class="milaura-hub__title milaura-display">
              {{ section.settings.heading | escape }}
            </h1>
          {%- endif -%}

          {%- if section.settings.introduction != blank -%}
            <div class="milaura-hub__intro rte">{{ section.settings.introduction }}</div>
          {%- endif -%}

          {%- if section.settings.hero_cta_label != blank -%}
            <a class="milaura-hub__hero-link" href="#{{ hero_target }}">
              <span>{{ section.settings.hero_cta_label | escape }}</span>
              <span aria-hidden="true">↓</span>
            </a>
          {%- endif -%}
        </div>

      </div>
    </section>

    <div class="milaura-hub__trust" aria-label="Les engagements MilAura">
      <div class="milaura-hub__trust-inner">
        {%- if section.settings.trust_1 != blank -%}<p>{{ section.settings.trust_1 | escape }}</p>{%- endif -%}
        {%- if section.settings.trust_2 != blank -%}<p>{{ section.settings.trust_2 | escape }}</p>{%- endif -%}
        {%- if section.settings.trust_3 != blank -%}<p>{{ section.settings.trust_3 | escape }}</p>{%- endif -%}
      </div>
    </div>

    {%- if correspondence_count > 0 -%}
      <section id="{{ guide_id }}" class="milaura-hub__section milaura-hub__guide" aria-labelledby="{{ guide_id }}-title">
        <div class="milaura-hub__shell">
          {% render 'milaura-section-heading',
            eyebrow: section.settings.guide_eyebrow,
            title: section.settings.guide_heading,
            text: section.settings.guide_text,
            heading_tag: 'h2',
            heading_id: guide_title_id,
            align: 'center',
            size: 'section',
            eyebrow_style: 'signature'
          %}

          <div class="milaura-hub__tabs" data-hub-tabs>
            <div class="milaura-hub__tablist" role="tablist" aria-label="{{ section.settings.guide_heading | escape }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'correspondence' -%}
                  {%- assign panel_id = 'MilauraHubPanel-' | append: section.id | append: '-' | append: block.id -%}
                  <a
                    class="milaura-hub__tab"
                    href="#{{ panel_id }}"
                    role="tab"
                    aria-controls="{{ panel_id }}"
                    aria-selected="false"
                    tabindex="-1"
                    data-hub-tab
                    data-default="{{ block.settings.is_default }}"
                    {{ block.shopify_attributes }}
                  >
                    <span>{{ block.settings.label | escape }}</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="milaura-hub__panels">
              {%- for block in section.blocks -%}
                {%- if block.type == 'correspondence' -%}
                  {%- assign panel_id = 'MilauraHubPanel-' | append: section.id | append: '-' | append: block.id -%}
                  {%- assign correspondence_collection = block.settings.collection -%}
                  {%- assign correspondence_products = block.settings.products -%}
                  {%- capture correspondence_cards -%}
                    {%- if correspondence_collection != blank and correspondence_collection.products_count > 0 -%}
                      {%- for selected_product in correspondence_collection.products -%}
                        <div class="milaura-hub__product" role="listitem">
                          {% render 'milaura-card-product',
                            card_product: selected_product,
                            img_loading: 'lazy',
                            show_vendor: false,
                            show_badges: section.settings.show_badges,
                            show_secondary_image: true,
                            force_bestseller_badge: false
                          %}
                          {% render 'milaura-editorial-purchase', product: selected_product %}
                        </div>
                      {%- endfor -%}
                    {%- elsif correspondence_products != blank -%}
                      {%- for selected_product in correspondence_products -%}
                        {%- if selected_product != blank -%}
                          <div class="milaura-hub__product" role="listitem">
                            {% render 'milaura-card-product',
                              card_product: selected_product,
                              img_loading: 'lazy',
                              show_vendor: false,
                              show_badges: section.settings.show_badges,
                              show_secondary_image: true,
                              force_bestseller_badge: false
                            %}
                            {% render 'milaura-editorial-purchase', product: selected_product %}
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- assign correspondence_cards = correspondence_cards | strip -%}

                  <article
                    id="{{ panel_id }}"
                    class="milaura-hub__panel{% if correspondence_cards != blank %} milaura-hub__panel--products{% endif %}"
                    role="tabpanel"
                    tabindex="-1"
                    data-hub-panel
                  >
                    <div class="milaura-hub__panel-copy">
                      <p class="milaura-hub__panel-label milaura-label">{{ block.settings.label | escape }}</p>
                      {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
                      {%- if block.settings.body != blank -%}<div class="milaura-hub__panel-body rte">{{ block.settings.body }}</div>{%- endif -%}
                      {%- if correspondence_cards == blank and block.settings.link != blank and block.settings.link_label != blank -%}
                        <a class="milaura-hub__text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
                      {%- endif -%}
                    </div>

                    {%- if correspondence_cards != blank -%}
                      <div
                        class="milaura-hub__product-grid milaura-hub__product-grid--correspondence milaura-cards milaura-cards--editorial"
                        role="list"
                        aria-label="Créations MilAura pour {{ block.settings.heading | escape }}"
                      >
                        {{ correspondence_cards }}
                      </div>
                    {%- endif -%}
                  </article>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if product_selection_count > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_selection' -%}
          {%- capture selection_cards -%}
            {%- assign selection_count = 0 -%}
            {%- for index in (1..6) -%}
              {%- assign product_setting = 'product_' | append: index -%}
              {%- assign selected_product = block.settings[product_setting] -%}
              {%- if selected_product != blank and selected_product.available -%}
                {%- assign selection_count = selection_count | plus: 1 -%}
                {%- assign recommendation_role = 'secondary' -%}
                {%- if selection_count == 1 -%}{%- assign recommendation_role = 'focal' -%}{%- endif -%}
                {% render 'milaura-recommendation-card',
                  recommendation_product: selected_product,
                  recommendation_intent: 'curated',
                  recommendation_reason: block.settings.card_reason,
                  recommendation_role: recommendation_role,
                  img_loading: 'lazy',
                  show_purchase: true
                %}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- assign selection_cards = selection_cards | strip -%}
          {%- assign selection_text = block.settings.body | strip_html -%}

          {%- if selection_cards != blank -%}
            <div id="{{ products_id }}" class="milaura-hub__section milaura-hub__products" {{ block.shopify_attributes }}>
              {% render 'milaura-recommendation-shell',
                recommendation_context: 'editorial',
                recommendation_instance_id: block.id,
                source_product_ids: blank,
                excluded_product_ids: blank,
                recommendation_intents: 'curated',
                recommendation_limit: 6,
                recommendation_minimum: 1,
                recommendation_cards: selection_cards,
                eyebrow: block.settings.eyebrow,
                title: block.settings.heading,
                subtitle: selection_text,
                complementary_title: blank,
                complementary_subtitle: blank,
                related_title: blank,
                related_subtitle: blank
              %}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if destination_count > 0 -%}
      <section id="{{ destinations_id }}" class="milaura-hub__section milaura-hub__destinations" aria-labelledby="{{ destinations_id }}-title">
        <div class="milaura-hub__shell">
          {% render 'milaura-section-heading',
            eyebrow: section.settings.destinations_eyebrow,
            title: section.settings.destinations_heading,
            text: section.settings.destinations_text,
            heading_tag: 'h2',
            heading_id: destinations_title_id,
            align: 'center',
            size: 'section',
            eyebrow_style: 'signature'
          %}

          <div class="milaura-hub__destination-grid" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'featured_collection' -%}
                {%- assign selected_collection = block.settings.collection -%}
                {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
                  {%- assign collection_product = selected_collection.products.first -%}
                  {%- assign collection_media = collection_product.featured_image | default: selected_collection.image -%}
                  <a class="milaura-hub__destination" href="{{ selected_collection.url }}" role="listitem" {{ block.shopify_attributes }}>
                    <div class="milaura-hub__destination-media">
                      {%- if collection_media != blank -%}
                        {{ collection_media
                          | image_url: width: 900
                          | image_tag:
                            widths: '320, 480, 640, 780, 900',
                            sizes: '(max-width: 749px) 82vw, (max-width: 1100px) 45vw, 30vw',
                            loading: 'lazy',
                            class: 'milaura-hub__destination-image',
                            alt: block.settings.heading
                        }}
                      {%- endif -%}
                    </div>
                    <div class="milaura-hub__destination-copy">
                      <p class="milaura-hub__destination-count milaura-label">{{ selected_collection.products_count }} créations</p>
                      <h3>{{ block.settings.heading | default: selected_collection.title | escape }}</h3>
                      {%- if block.settings.body != blank -%}<div class="milaura-hub__destination-body rte">{{ block.settings.body }}</div>{%- endif -%}
                      <span class="milaura-hub__destination-link">Voir les bijoux <span aria-hidden="true">→</span></span>
                    </div>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- if content_count > 0 -%}
      <section class="milaura-hub__section milaura-hub__notes" aria-label="Conseils MilAura">
        <div class="milaura-hub__shell milaura-hub__note-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'content' and block.settings.heading != blank -%}
              <article class="milaura-hub__note" {{ block.shopify_attributes }}>
                <h2>{{ block.settings.heading | escape }}</h2>
                {%- if block.settings.body != blank -%}<div class="milaura-hub__panel-body rte">{{ block.settings.body }}</div>{%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hub éditorial MilAura",
  "tag": "section",
  "class": "section-milaura-catalogue-hub",
  "settings": [
    {
      "type": "select",
      "id": "theme",
      "label": "Univers",
      "default": "stone",
      "options": [
        {"value": "wedding", "label": "Mariage"},
        {"value": "birthstone", "label": "Naissance"},
        {"value": "stone", "label": "Pierres"}
      ]
    },
    {"type": "text", "id": "eyebrow", "label": "Signature"},
    {"type": "text", "id": "heading", "label": "Titre"},
    {"type": "richtext", "id": "introduction", "label": "Introduction"},
    {"type": "text", "id": "hero_cta_label", "label": "Action du Hero", "default": "Découvrir"},
    {"type": "text", "id": "trust_1", "label": "Engagement 1", "default": "Pierres naturelles sélectionnées"},
    {"type": "text", "id": "trust_2", "label": "Engagement 2", "default": "Préparé dans notre atelier à Metz"},
    {"type": "text", "id": "trust_3", "label": "Engagement 3", "default": "Service humain avant et après l'achat"},
    {"type": "text", "id": "guide_eyebrow", "label": "Signature du guide"},
    {"type": "text", "id": "guide_heading", "label": "Titre du guide"},
    {"type": "textarea", "id": "guide_text", "label": "Introduction du guide"},
    {"type": "text", "id": "destinations_eyebrow", "label": "Signature des destinations"},
    {"type": "text", "id": "destinations_heading", "label": "Titre des destinations"},
    {"type": "textarea", "id": "destinations_text", "label": "Introduction des destinations"},
    {"type": "checkbox", "id": "show_badges", "label": "Afficher les badges produit", "default": false}
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Conseil",
      "settings": [
        {"type": "text", "id": "heading", "label": "Titre"},
        {"type": "richtext", "id": "body", "label": "Texte"}
      ]
    },
    {
      "type": "correspondence",
      "name": "Repère",
      "settings": [
        {"type": "text", "id": "label", "label": "Mois ou année"},
        {"type": "text", "id": "heading", "label": "Titre"},
        {"type": "richtext", "id": "body", "label": "Explication"},
        {"type": "collection", "id": "collection", "label": "Collection affichée dans ce repère"},
        {"type": "product_list", "id": "products", "label": "Produits affichés si aucune collection n'est choisie", "limit": 24},
        {"type": "url", "id": "link", "label": "Destination"},
        {"type": "text", "id": "link_label", "label": "Texte du lien"},
        {"type": "checkbox", "id": "is_default", "label": "Repère ouvert par défaut", "default": false}
      ]
    },
    {
      "type": "featured_collection",
      "name": "Destination pierre",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection publique"},
        {"type": "text", "id": "heading", "label": "Titre"},
        {"type": "richtext", "id": "body", "label": "Texte"}
      ]
    },
    {
      "type": "product_selection",
      "name": "Sélection de produits",
      "settings": [
        {"type": "text", "id": "eyebrow", "label": "Signature"},
        {"type": "text", "id": "heading", "label": "Titre"},
        {"type": "richtext", "id": "body", "label": "Texte"},
        {"type": "text", "id": "card_reason", "label": "Raison affichée sur les cartes", "default": "Choisie pour cette sélection."},
        {"type": "product", "id": "product_1", "label": "Produit 1"},
        {"type": "product", "id": "product_2", "label": "Produit 2"},
        {"type": "product", "id": "product_3", "label": "Produit 3"},
        {"type": "product", "id": "product_4", "label": "Produit 4"},
        {"type": "product", "id": "product_5", "label": "Produit 5"},
        {"type": "product", "id": "product_6", "label": "Produit 6"}
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [{"name": "Hub éditorial MilAura"}]
}
{% endschema %}
