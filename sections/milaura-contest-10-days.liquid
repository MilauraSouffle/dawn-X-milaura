{%- liquid
  assign preview_day = section.settings.preview_day | default: 1
  assign selected_prize = section.blocks.first

  for block in section.blocks
    if forloop.index == preview_day
      assign selected_prize = block
    endif
  endfor

  assign selected_asset = blank
  case preview_day
    when 1
      assign selected_asset = 'milaura-concours-jour-01-distributeur-aventurine.webp'
    when 2
      assign selected_asset = 'milaura-concours-jour-02-bague-sodalite.webp'
    when 3
      assign selected_asset = 'milaura-concours-jour-03-bougie-serenite.webp'
    when 4
      assign selected_asset = 'milaura-concours-jour-04-pendentif-sodalite.webp'
    when 5
      assign selected_asset = 'milaura-concours-jour-05-bracelet-rondelles.webp'
    when 6
      assign selected_asset = 'milaura-concours-jour-06-boucles-sodalite.webp'
    when 7
      assign selected_asset = 'milaura-concours-jour-07-bougie-reconfort.webp'
    when 8
      assign selected_asset = 'milaura-concours-jour-08-collier-sodalite.webp'
    when 9
      assign selected_asset = 'milaura-concours-jour-09-bracelet-horus.webp'
  endcase
-%}

<section
  id="MilauraContest-{{ section.id }}"
  class="milaura-contest"
  data-milaura-contest
  data-preview-mode="{{ section.settings.preview_mode }}"
  data-preview-day="{{ preview_day }}"
  data-start-at="{{ section.settings.start_at | escape }}"
  data-end-at="{{ section.settings.end_at | escape }}"
>
  <div class="milaura-contest__hero">
    <div class="milaura-contest__hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="milaura-contest__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="milaura-contest__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="milaura-contest__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}

      <div class="milaura-contest__status" aria-live="polite">
        <span class="milaura-contest__status-day" data-contest-status-day>Jour {{ preview_day }} sur 10</span>
        <span class="milaura-contest__status-text" data-contest-status-text>{{ section.settings.preview_status | escape }}</span>
      </div>

      <p class="milaura-contest__instruction" data-contest-instruction>
        {{ section.settings.opening_instruction | escape }}
      </p>
    </div>

    <div class="milaura-contest__stage">
      <div
        id="MilauraContestPrize-{{ section.id }}"
        class="milaura-contest__reveal"
        data-contest-reveal
        aria-hidden="true"
      >
        <div class="milaura-contest__reveal-media" data-contest-reveal-media>
          {%- if selected_prize.settings.image != blank -%}
            {{- selected_prize.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'milaura-contest__reveal-image',
                widths: '480, 720, 960, 1200',
                sizes: '(min-width: 990px) 42vw, 88vw',
                loading: 'eager',
                alt: selected_prize.settings.title
            -}}
          {%- elsif selected_asset != blank -%}
            <img
              class="milaura-contest__reveal-image"
              src="{{ selected_asset | asset_url }}"
              width="1024"
              height="1024"
              alt="{{ selected_prize.settings.title | escape }}"
              loading="eager"
              data-contest-reveal-image
            >
          {%- else -%}
            <div class="milaura-contest__voucher" data-contest-reveal-voucher>
              <span>MilAura</span>
              <strong>30 €</strong>
              <small>Carte cadeau</small>
            </div>
          {%- endif -%}
        </div>
        <div class="milaura-contest__reveal-copy">
          <span data-contest-reveal-day>Le cadeau du jour</span>
          <h2 data-contest-reveal-title>{{ selected_prize.settings.title | escape }}</h2>
          <p data-contest-reveal-detail>{{ selected_prize.settings.detail | escape }}</p>
          <strong data-contest-reveal-value>{{ selected_prize.settings.value | escape }}</strong>
        </div>
      </div>

      <button
        class="milaura-contest__gift"
        type="button"
        aria-expanded="false"
        aria-controls="MilauraContestPrize-{{ section.id }}"
        data-contest-gift
      >
        <span class="visually-hidden">{{ section.settings.opening_instruction | escape }}</span>
        <span class="milaura-contest__gift-object" aria-hidden="true">
          <span class="milaura-contest__gift-lid"></span>
          <span class="milaura-contest__gift-box"></span>
          <span class="milaura-contest__gift-ribbon"></span>
          <span class="milaura-contest__gift-knot milaura-contest__gift-knot--left"></span>
          <span class="milaura-contest__gift-knot milaura-contest__gift-knot--right"></span>
        </span>
        <span class="milaura-contest__gift-action" data-contest-gift-label>{{ section.settings.gift_button | escape }}</span>
      </button>
    </div>
  </div>

  <div class="milaura-contest__participation" id="participer">
    <div>
      <p class="milaura-contest__section-label">{{ section.settings.participation_eyebrow | escape }}</p>
      <h2>{{ section.settings.participation_title | escape }}</h2>
    </div>
    <ol class="milaura-contest__steps">
      <li>
        <span>01</span>
        <p>{{ section.settings.step_one | escape }}</p>
      </li>
      <li>
        <span>02</span>
        <p>{{ section.settings.step_two | escape }}</p>
      </li>
      <li>
        <span>03</span>
        <p>{{ section.settings.step_three | escape }}</p>
      </li>
    </ol>
    <div class="milaura-contest__social-actions">
      {%- if section.settings.instagram_url != blank -%}
        <a
          class="milaura-contest__social-link milaura-contest__social-link--primary"
          href="{{ section.settings.instagram_url }}"
          target="_blank"
          rel="noopener"
          data-contest-social="instagram"
        >
          <span>{{ section.settings.instagram_label | escape }}</span>
          <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
      {%- if section.settings.facebook_url != blank -%}
        <a
          class="milaura-contest__social-link"
          href="{{ section.settings.facebook_url }}"
          target="_blank"
          rel="noopener"
          data-contest-social="facebook"
        >
          <span>{{ section.settings.facebook_label | escape }}</span>
          <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
    </div>
    <p class="milaura-contest__social-note">{{ section.settings.participation_note | escape }}</p>
  </div>

  <div class="milaura-contest__calendar" id="cadeaux">
    <div class="milaura-contest__section-heading">
      <div>
        <p class="milaura-contest__section-label">{{ section.settings.calendar_eyebrow | escape }}</p>
        <h2>{{ section.settings.calendar_title | escape }}</h2>
      </div>
      <p>{{ section.settings.calendar_intro | escape }}</p>
    </div>

    <div class="milaura-contest__prize-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback_asset = blank
          case forloop.index
            when 1
              assign fallback_asset = 'milaura-concours-jour-01-distributeur-aventurine.webp'
            when 2
              assign fallback_asset = 'milaura-concours-jour-02-bague-sodalite.webp'
            when 3
              assign fallback_asset = 'milaura-concours-jour-03-bougie-serenite.webp'
            when 4
              assign fallback_asset = 'milaura-concours-jour-04-pendentif-sodalite.webp'
            when 5
              assign fallback_asset = 'milaura-concours-jour-05-bracelet-rondelles.webp'
            when 6
              assign fallback_asset = 'milaura-concours-jour-06-boucles-sodalite.webp'
            when 7
              assign fallback_asset = 'milaura-concours-jour-07-bougie-reconfort.webp'
            when 8
              assign fallback_asset = 'milaura-concours-jour-08-collier-sodalite.webp'
            when 9
              assign fallback_asset = 'milaura-concours-jour-09-bracelet-horus.webp'
          endcase
        -%}
        <article
          class="milaura-contest__prize-card{% if forloop.index == preview_day %} is-current{% endif %}"
          data-contest-prize
          data-day="{{ forloop.index }}"
          data-title="{{ block.settings.title | escape }}"
          data-detail="{{ block.settings.detail | escape }}"
          data-value="{{ block.settings.value | escape }}"
          data-has-image="{% if block.settings.image != blank or fallback_asset != blank %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="milaura-contest__prize-media">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image
                | image_url: width: 720
                | image_tag:
                  class: 'milaura-contest__prize-image',
                  widths: '240, 360, 480, 720',
                  sizes: '(min-width: 990px) 19vw, (min-width: 600px) 31vw, 46vw',
                  loading: 'lazy',
                  alt: block.settings.title
              -}}
            {%- elsif fallback_asset != blank -%}
              <img
                class="milaura-contest__prize-image"
                src="{{ fallback_asset | asset_url }}"
                width="1024"
                height="1024"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="milaura-contest__voucher milaura-contest__voucher--card">
                <span>MilAura</span>
                <strong>30 €</strong>
                <small>Carte cadeau</small>
              </div>
            {%- endif -%}
            <span class="milaura-contest__day-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>
          <div class="milaura-contest__prize-copy">
            <p>{{ block.settings.day_label | escape }}</p>
            <h3>{{ block.settings.title | escape }}</h3>
            <span>{{ block.settings.value | escape }}</span>
          </div>
          {%- if block.settings.product_url != blank -%}
            <a class="milaura-contest__prize-link" href="{{ block.settings.product_url }}">
              Voir ce cadeau
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="milaura-contest__rules" id="reglement">
    <div class="milaura-contest__rules-heading">
      <p class="milaura-contest__section-label">{{ section.settings.rules_eyebrow | escape }}</p>
      <h2>{{ section.settings.rules_title | escape }}</h2>
      <p>{{ section.settings.rules_intro | escape }}</p>
    </div>

    <dl class="milaura-contest__rules-grid">
      <div>
        <dt>Qui peut participer ?</dt>
        <dd>{{ section.settings.eligibility | escape }}</dd>
      </div>
      <div>
        <dt>Où ?</dt>
        <dd>{{ section.settings.territory | escape }}</dd>
      </div>
      <div>
        <dt>Quand ?</dt>
        <dd>{{ section.settings.period | escape }}</dd>
      </div>
      <div>
        <dt>Comment sont choisis les gagnants ?</dt>
        <dd>{{ section.settings.draw_method | escape }}</dd>
      </div>
    </dl>

    <details class="milaura-contest__rules-details" data-contest-rules>
      <summary>
        <span>{{ section.settings.rules_button | escape }}</span>
        <span aria-hidden="true">+</span>
      </summary>
      <div class="milaura-contest__rules-body rte">
        {% render 'milaura-contest-rules' %}
      </div>
    </details>

    <p class="milaura-contest__fraud-warning">{{ section.settings.fraud_warning | escape }}</p>
    <p class="milaura-contest__platform-note">{{ section.settings.platform_note | escape }}</p>
  </div>
</section>

{%- style -%}
  #MilauraContest-{{ section.id }},
  #MilauraContest-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraContest-{{ section.id }} {
    overflow: hidden;
    color: var(--milaura-encre);
    background: var(--milaura-surface);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__hero,
  #MilauraContest-{{ section.id }} .milaura-contest__participation,
  #MilauraContest-{{ section.id }} .milaura-contest__calendar,
  #MilauraContest-{{ section.id }} .milaura-contest__rules {
    width: min(1320px, calc(100% - clamp(32px, 7vw, 112px)));
    margin: 0 auto;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(440px, 1.22fr);
    align-items: center;
    min-height: min(860px, calc(100svh - 92px));
    gap: clamp(32px, 6vw, 104px);
    padding: clamp(56px, 8vw, 128px) 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__eyebrow,
  #MilauraContest-{{ section.id }} .milaura-contest__section-label,
  #MilauraContest-{{ section.id }} .milaura-contest__status-day,
  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy > span,
  #MilauraContest-{{ section.id }} .milaura-contest__prize-copy > p {
    margin: 0;
    color: var(--milaura-aigue-profonde);
    font-size: var(--milaura-t-label);
    font-weight: 600;
    line-height: var(--milaura-lh-label);
    letter-spacing: var(--milaura-ls-label);
    text-transform: uppercase;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__title {
    max-width: 720px;
    margin: var(--milaura-esp-sm) 0 0;
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-display);
    font-weight: 400;
    line-height: var(--milaura-lh-display);
    letter-spacing: var(--milaura-ls-display);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__intro {
    max-width: 610px;
    margin-top: var(--milaura-esp-md);
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-corps-large);
    line-height: var(--milaura-lh-corps);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__intro p {
    margin: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--milaura-esp-xs) var(--milaura-esp-md);
    margin-top: var(--milaura-esp-lg);
    padding-top: var(--milaura-esp-md);
    border-top: var(--milaura-filet-or);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__status-text,
  #MilauraContest-{{ section.id }} .milaura-contest__instruction {
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__instruction {
    margin: var(--milaura-esp-md) 0 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__stage {
    position: relative;
    min-height: clamp(500px, 52vw, 690px);
    border: var(--milaura-filet-mineral);
    background: var(--milaura-surface-mineral);
    isolation: isolate;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__stage::before,
  #MilauraContest-{{ section.id }} .milaura-contest__stage::after {
    position: absolute;
    z-index: -1;
    content: '';
  }

  #MilauraContest-{{ section.id }} .milaura-contest__stage::before {
    inset: var(--milaura-esp-md);
    border: var(--milaura-filet);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__stage::after {
    inset: auto var(--milaura-esp-xl) var(--milaura-esp-xl) auto;
    width: 42%;
    border-bottom: var(--milaura-filet-or);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 0;
    color: var(--milaura-encre);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift:disabled {
    cursor: not-allowed;
    opacity: var(--milaura-opacite-disabled);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift:focus-visible,
  #MilauraContest-{{ section.id }} .milaura-contest__social-link:focus-visible,
  #MilauraContest-{{ section.id }} .milaura-contest__prize-link:focus-visible,
  #MilauraContest-{{ section.id }} .milaura-contest__rules-details summary:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: var(--milaura-focus-offset);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-object {
    position: relative;
    display: block;
    width: clamp(230px, 36vw, 410px);
    height: clamp(240px, 37vw, 420px);
    transition: opacity var(--milaura-transition-rapide);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-box,
  #MilauraContest-{{ section.id }} .milaura-contest__gift-lid {
    position: absolute;
    left: 50%;
    display: block;
    border: var(--milaura-filet-or);
    background: var(--milaura-surface-haute);
    box-shadow: var(--milaura-ombre-portee);
    transform: translateX(-50%);
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms ease;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-box {
    bottom: 18%;
    width: 72%;
    height: 48%;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-lid {
    z-index: 2;
    bottom: 63%;
    width: 82%;
    height: 14%;
    transform-origin: 18% 100%;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-ribbon {
    position: absolute;
    z-index: 3;
    bottom: 18%;
    left: 50%;
    width: 7%;
    height: 59%;
    background: var(--milaura-or);
    transform: translateX(-50%);
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms ease;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-knot {
    position: absolute;
    z-index: 4;
    bottom: 76%;
    width: 26%;
    height: 15%;
    border: var(--milaura-filet-or);
    background: var(--milaura-surface-haute);
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1), opacity 420ms ease;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-knot--left {
    left: 25%;
    transform: rotate(18deg);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-knot--right {
    right: 25%;
    transform: rotate(-18deg);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift-action {
    position: absolute;
    bottom: clamp(32px, 5vw, 64px);
    min-height: var(--milaura-cible-tactile);
    padding: var(--milaura-esp-xs) 0 var(--milaura-esp-2xs);
    border-bottom: var(--milaura-filet-action);
    font-size: var(--milaura-t-bouton);
    font-weight: 600;
    line-height: var(--milaura-lh-bouton);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift.is-open .milaura-contest__gift-lid {
    opacity: 0;
    transform: translate(-78%, -260%) rotate(-16deg);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift.is-open .milaura-contest__gift-box {
    opacity: 0;
    transform: translate(-50%, 90%);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift.is-open .milaura-contest__gift-ribbon,
  #MilauraContest-{{ section.id }} .milaura-contest__gift.is-open .milaura-contest__gift-knot {
    opacity: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__gift.is-open {
    pointer-events: none;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal {
    position: absolute;
    inset: var(--milaura-esp-lg);
    z-index: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    opacity: 0;
    transform: translateY(var(--milaura-esp-md));
    transition: opacity 440ms ease 180ms, transform 620ms cubic-bezier(0.22, 1, 0.36, 1) 120ms;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-media {
    display: grid;
    place-items: center;
    min-height: 0;
    overflow: hidden;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-image {
    display: block;
    width: min(100%, 520px);
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--milaura-esp-2xs) var(--milaura-esp-md);
    padding-top: var(--milaura-esp-md);
    border-top: var(--milaura-filet-or);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy > span {
    grid-column: 1 / -1;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy h2 {
    margin: 0;
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-h3);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__reveal-copy strong {
    align-self: start;
    color: var(--milaura-encre);
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__voucher {
    display: grid;
    place-items: center;
    align-content: center;
    width: min(82%, 420px);
    aspect-ratio: 4 / 3;
    color: var(--milaura-encre);
    border: var(--milaura-filet-or);
    background: var(--milaura-surface-haute);
    box-shadow: var(--milaura-ombre-portee);
  }

  #MilauraContest-{{ section.id }} .milaura-contest__voucher span {
    font-family: var(--milaura-font-signature);
    font-size: var(--milaura-t-signature);
    font-weight: 600;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__voucher strong {
    margin-top: var(--milaura-esp-xs);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h2);
    font-weight: 400;
  }

  #MilauraContest-{{ section.id }} .milaura-contest__voucher small {
    color: var(--milaura-encre-secondaire);
