<section id="MilauraContest-{{ section.id }}" class="milaura-contest-simple" data-milaura-contest-simple>
  <h1 class="visually-hidden">{{ section.settings.title | escape }}</h1>

  <picture class="milaura-contest-simple__hero">
    <source media="(max-width: 749px)" srcset="{{ 'milaura-grand-jeu-2026-hero-mobile.webp' | asset_url }}" width="1080" height="1350">
    <img
      src="{{ 'milaura-grand-jeu-2026-hero-desktop.webp' | asset_url }}"
      width="1920"
      height="1080"
      alt="{{ section.settings.hero_alt | escape }}"
      loading="eager"
      fetchpriority="high"
    >
  </picture>

  <div class="milaura-contest-simple__content">
    <div class="milaura-contest-simple__tabs" role="tablist" aria-label="Informations du jeu concours">
      <button
        id="MilauraContestConditionsTab-{{ section.id }}"
        class="milaura-contest-simple__tab is-active"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="MilauraContestConditions-{{ section.id }}"
        data-contest-tab="conditions"
      >
        Conditions de participation
      </button>
      <button
        id="MilauraContestRulesTab-{{ section.id }}"
        class="milaura-contest-simple__tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="MilauraContestRules-{{ section.id }}"
        data-contest-tab="rules"
        tabindex="-1"
      >
        Règlement du jeu
      </button>
    </div>

    <div
      id="MilauraContestConditions-{{ section.id }}"
      class="milaura-contest-simple__panel"
      role="tabpanel"
      aria-labelledby="MilauraContestConditionsTab-{{ section.id }}"
      data-contest-panel="conditions"
    >
      <div class="milaura-contest-simple__intro">
        <div>
          <h2>{{ section.settings.conditions_title | escape }}</h2>
          <p>{{ section.settings.conditions_intro | escape }}</p>
        </div>
        <p class="milaura-contest-simple__period">{{ section.settings.period | escape }}</p>
      </div>

      <ol class="milaura-contest-simple__steps">
        <li><span>1</span><p>{{ section.settings.step_one | escape }}</p></li>
        <li><span>2</span><p>{{ section.settings.step_two | escape }}</p></li>
        <li><span>3</span><p>{{ section.settings.step_three | escape }}</p></li>
      </ol>

      <div class="milaura-contest-simple__actions">
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Participer sur Instagram</a>
        <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener">Participer sur Facebook</a>
      </div>

      <div class="milaura-contest-simple__conditions-grid">
        <div>
          <h3>Qui peut participer ?</h3>
          <p>{{ section.settings.eligibility | escape }}</p>
        </div>
        <div>
          <h3>Comment sont choisis les gagnants ?</h3>
          <p>{{ section.settings.draw_method | escape }}</p>
        </div>
        <div>
          <h3>{{ section.settings.offer_title | escape }}</h3>
          <p>{{ section.settings.offer_text | escape }}</p>
        </div>
      </div>

      <aside class="milaura-contest-simple__warning" aria-label="Alerte contre les faux comptes">
        <h3>Attention aux faux comptes</h3>
        <p>{{ section.settings.fraud_warning | escape }}</p>
      </aside>
    </div>

    <div
      id="MilauraContestRules-{{ section.id }}"
      class="milaura-contest-simple__panel milaura-contest-simple__panel--rules"
      role="tabpanel"
      aria-labelledby="MilauraContestRulesTab-{{ section.id }}"
      data-contest-panel="rules"
      hidden
    >
      <h2>Règlement du Grand Jeu MilAura</h2>
      <div class="milaura-contest-simple__rules rte">{% render 'milaura-contest-rules' %}</div>
    </div>
  </div>

  <div class="milaura-contest-simple__gifts" id="les-cadeaux">
    <div class="milaura-contest-simple__gifts-heading">
      <h2>{{ section.settings.gifts_title | escape }}</h2>
      <p>{{ section.settings.gifts_intro | escape }}</p>
    </div>

    <div class="milaura-contest-simple__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign fallback_asset = blank
          case forloop.index
            when 1
              assign fallback_asset = 'milaura-concours-jour-01-distributeur-aventurine.webp'
            when 2
              assign fallback_asset = 'milaura-concours-jour-02-bague-sodalite.webp'
            when 3
              assign fallback_asset = 'milaura-concours-jour-03-bougie-serenite.webp'
            when 4
              assign fallback_asset = 'milaura-concours-jour-04-pendentif-sodalite.webp'
            when 5
              assign fallback_asset = 'milaura-concours-jour-05-bracelet-rondelles.webp'
            when 6
              assign fallback_asset = 'milaura-concours-jour-06-boucles-sodalite.webp'
            when 7
              assign fallback_asset = 'milaura-concours-jour-07-bougie-reconfort.webp'
            when 8
              assign fallback_asset = 'milaura-concours-jour-08-collier-sodalite.webp'
            when 9
              assign fallback_asset = 'milaura-concours-jour-09-bracelet-horus.webp'
          endcase
        -%}

        <article class="milaura-contest-simple__card" {{ block.shopify_attributes }}>
          {%- if block.settings.product_url != blank -%}
            <a href="{{ block.settings.product_url }}" aria-label="Voir {{ block.settings.title | escape }}">
          {%- endif -%}

          <div class="milaura-contest-simple__media">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image
                | image_url: width: 720
                | image_tag:
                  class: 'milaura-contest-simple__image',
                  widths: '240, 360, 480, 720',
                  sizes: '(min-width: 990px) 18vw, (min-width: 600px) 31vw, 47vw',
                  loading: 'lazy',
                  alt: block.settings.title
              -}}
            {%- elsif fallback_asset != blank -%}
              <img
                class="milaura-contest-simple__image"
                src="{{ fallback_asset | asset_url }}"
                width="1024"
                height="1024"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="milaura-contest-simple__voucher">
                <span>MilAura</span>
                <strong>30 €</strong>
                <small>Carte cadeau</small>
              </div>
            {%- endif -%}
            <span class="milaura-contest-simple__day">Jour {{ forloop.index }}</span>
          </div>

          <div class="milaura-contest-simple__card-copy">
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.detail | escape }}</p>
            <strong>{{ block.settings.value | escape }}</strong>
          </div>

          {%- if block.settings.product_url != blank -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>

  <p class="milaura-contest-simple__platform-note">{{ section.settings.platform_note | escape }}</p>
</section>

{%- style -%}
  #MilauraContest-{{ section.id }},
  #MilauraContest-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraContest-{{ section.id }} {
    overflow: hidden;
    color: var(--milaura-encre);
    background: var(--milaura-surface);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__hero,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__hero img {
    display: block;
    width: 100%;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__hero {
    background: var(--milaura-surface-haute);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__hero img {
    height: auto;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__content,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__platform-note {
    width: min(1320px, calc(100% - clamp(32px, 7vw, 112px)));
    margin-inline: auto;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__content {
    padding-top: clamp(40px, 6vw, 80px);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tabs {
    display: flex;
    gap: clamp(24px, 5vw, 64px);
    overflow-x: auto;
    border-bottom: var(--milaura-filet);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tab {
    position: relative;
    min-height: var(--milaura-cible-tactile);
    padding: 0 0 var(--milaura-esp-sm);
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-bouton);
    font-weight: 600;
    white-space: nowrap;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tab::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    content: '';
    background: transparent;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tab.is-active {
    color: var(--milaura-encre);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tab.is-active::after {
    background: var(--milaura-or);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__tab:focus-visible,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__actions a:focus-visible,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__card a:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: var(--milaura-focus-offset);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__panel {
    padding: clamp(40px, 6vw, 80px) 0 clamp(64px, 8vw, 112px);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__panel[hidden] {
    display: none;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__intro,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.46fr);
    gap: clamp(32px, 8vw, 120px);
    align-items: end;
  }

  #MilauraContest-{{ section.id }} h2,
  #MilauraContest-{{ section.id }} h3,
  #MilauraContest-{{ section.id }} p {
    margin-top: 0;
  }

  #MilauraContest-{{ section.id }} h2 {
    margin-bottom: var(--milaura-esp-md);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h2);
    font-weight: 400;
    line-height: var(--milaura-lh-h2);
    letter-spacing: var(--milaura-ls-titre);
  }

  #MilauraContest-{{ section.id }} h3 {
    margin-bottom: var(--milaura-esp-xs);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-h3);
  }

  #MilauraContest-{{ section.id }} p,
  #MilauraContest-{{ section.id }} li {
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__intro > div > p {
    max-width: 64ch;
    margin-bottom: 0;
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-corps-large);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__period {
    margin-bottom: 0;
    padding-top: var(--milaura-esp-md);
    color: var(--milaura-encre-secondaire);
    border-top: var(--milaura-filet-or);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--milaura-filet);
    border-bottom: var(--milaura-filet);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: var(--milaura-esp-sm);
    min-height: 132px;
    padding: var(--milaura-esp-md);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__steps li + li {
    border-left: var(--milaura-filet);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__steps span {
    color: var(--milaura-amethyste);
    font-size: var(--milaura-t-h3);
    line-height: 1;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__steps p {
    margin-bottom: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--milaura-esp-md) var(--milaura-esp-lg);
    margin-top: var(--milaura-esp-lg);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__actions a {
    min-height: var(--milaura-cible-conversion);
    padding: var(--milaura-esp-xs) 0 var(--milaura-esp-2xs);
    color: var(--milaura-encre);
    font-size: var(--milaura-t-bouton);
    font-weight: 600;
    text-decoration: none;
    border-bottom: var(--milaura-filet-action);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__conditions-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(48px, 7vw, 88px);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__conditions-grid > div {
    padding-top: var(--milaura-esp-md);
    border-top: var(--milaura-filet-mineral);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__conditions-grid p {
    margin-bottom: 0;
    color: var(--milaura-encre-secondaire);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__warning {
    margin-top: clamp(40px, 6vw, 72px);
    padding: var(--milaura-esp-lg);
    border: var(--milaura-filet-mineral);
    background: var(--milaura-surface-mineral);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__warning p {
    max-width: 88ch;
    margin-bottom: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__panel--rules > h2,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__rules {
    max-width: 860px;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__rules h3 {
    margin-top: var(--milaura-esp-lg);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__rules p,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__rules li {
    color: var(--milaura-encre-secondaire);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts {
    padding: clamp(64px, 9vw, 128px) 0;
    border-top: var(--milaura-filet);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading h2,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading p {
    margin-bottom: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading p {
    color: var(--milaura-encre-secondaire);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card {
    min-width: 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card > a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border: var(--milaura-filet);
    border-radius: var(--milaura-rayon-carte);
    background: var(--milaura-surface-haute);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--milaura-transition-rapide);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card a:hover .milaura-contest-simple__image {
    transform: scale(1.018);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__day {
    position: absolute;
    top: var(--milaura-esp-xs);
    left: var(--milaura-esp-xs);
    padding: var(--milaura-esp-3xs) var(--milaura-esp-2xs);
    color: var(--milaura-nacre-pure);
    font-size: var(--milaura-t-petit);
    font-weight: 600;
    border-radius: var(--milaura-rayon-sm);
    background: var(--milaura-prune);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__voucher {
    display: grid;
    align-content: center;
    height: 100%;
    padding: var(--milaura-esp-md);
    color: var(--milaura-nacre-pure);
    background: var(--milaura-surface-profonde);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__voucher span,
  #MilauraContest-{{ section.id }} .milaura-contest-simple__voucher small {
    font-size: var(--milaura-t-petit);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__voucher strong {
    margin: var(--milaura-esp-xs) 0;
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h2);
    font-weight: 400;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card-copy {
    padding: var(--milaura-esp-sm) var(--milaura-esp-2xs) 0;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card-copy h3 {
    margin-bottom: var(--milaura-esp-2xs);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    font-weight: 600;
    line-height: 1.35;
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card-copy p {
    margin-bottom: var(--milaura-esp-2xs);
    color: var(--milaura-encre-secondaire);
    font-size: var(--milaura-t-petit);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__card-copy strong {
    font-size: var(--milaura-t-petit);
  }

  #MilauraContest-{{ section.id }} .milaura-contest-simple__platform-note {
    padding: 0 0 clamp(64px, 8vw, 112px);
    color: var(--milaura-encre-tertiaire);
    font-size: var(--milaura-t-petit);
    line-height: var(--milaura-lh-petit);
  }

  @media screen and (max-width: 989px) {
    #MilauraContest-{{ section.id }} .milaura-contest-simple__intro,
    #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts-heading {
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-md);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__conditions-grid {
      grid-template-columns: 1fr;
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraContest-{{ section.id }} .milaura-contest-simple__content,
    #MilauraContest-{{ section.id }} .milaura-contest-simple__gifts,
    #MilauraContest-{{ section.id }} .milaura-contest-simple__platform-note {
      width: min(100% - 32px, 680px);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__tabs {
      gap: var(--milaura-esp-lg);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__steps {
      grid-template-columns: 1fr;
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__steps li {
      min-height: auto;
      padding-inline: 0;
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__steps li + li {
      border-top: var(--milaura-filet);
      border-left: 0;
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__actions {
      display: grid;
      gap: var(--milaura-esp-sm);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__actions a {
      width: fit-content;
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__warning {
      padding: var(--milaura-esp-md);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--milaura-esp-lg) var(--milaura-esp-sm);
    }

    #MilauraContest-{{ section.id }} .milaura-contest-simple__media {
      border-radius: var(--milaura-rayon-carte-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraContest-{{ section.id }} .milaura-contest-simple__image {
      transition: none;
    }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('MilauraContest-{{ section.id }}');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-contest-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-contest-panel]'));

    function activate(tab) {
      var target = tab.getAttribute('data-contest-tab');

      tabs.forEach(function (item) {
        var selected = item === tab;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-selected', selected ? 'true' : 'false');
        item.setAttribute('tabindex', selected ? '0' : '-1');
      });

      panels.forEach(function (panel) {
        panel.hidden = panel.getAttribute('data-contest-panel') !== target;
      });
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        activate(tab);
      });

      tab.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        var direction = event.key === 'ArrowRight' ? 1 : -1;
        var next = tabs[(index + direction + tabs.length) % tabs.length];
        activate(next);
        next.focus();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Grand Jeu MilAura",
  "tag": "section",
  "class": "milaura-contest-section",
  "limit": 1,
  "max_blocks": 10,
