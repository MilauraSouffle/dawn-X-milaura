<script>
  (() => {
    const root = document.getElementById('MilauraContest-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const gift = root.querySelector('[data-contest-gift]');
    const reveal = root.querySelector('[data-contest-reveal]');
    const cards = Array.from(root.querySelectorAll('[data-contest-prize]'));
    const statusDay = root.querySelector('[data-contest-status-day]');
    const statusText = root.querySelector('[data-contest-status-text]');
    const instruction = root.querySelector('[data-contest-instruction]');
    const heroMedia = root.querySelector('[data-contest-reveal-media]');
    const heroTitle = root.querySelector('[data-contest-reveal-title]');
    const heroDetail = root.querySelector('[data-contest-reveal-detail]');
    const heroValue = root.querySelector('[data-contest-reveal-value]');
    const heroDay = root.querySelector('[data-contest-reveal-day]');
    const giftLabel = root.querySelector('[data-contest-gift-label]');

    if (!gift || !reveal || !cards.length) return;

    const emit = (name, detail = {}) => {
      const payload = { event: name, campaign: '10-jours-10-cadeaux', ...detail };
      if (Array.isArray(window.dataLayer)) window.dataLayer.push(payload);
      document.dispatchEvent(new CustomEvent(name, { detail: payload }));
    };

    const setHeroDay = (day) => {
      const card = cards.find((item) => Number(item.dataset.day) === day) || cards[0];
      const sourceImage = card.querySelector('img');
      const sourceVoucher = card.querySelector('.milaura-contest__voucher');

      cards.forEach((item) => item.classList.toggle('is-current', item === card));
      heroTitle.textContent = card.dataset.title || '';
      heroDetail.textContent = card.dataset.detail || '';
      heroValue.textContent = card.dataset.value || '';
      heroDay.textContent = `Cadeau du jour ${day}`;

      if (sourceImage) {
        heroMedia.innerHTML = '';
        const image = sourceImage.cloneNode(true);
        image.className = 'milaura-contest__reveal-image';
        image.loading = 'eager';
        heroMedia.appendChild(image);
      } else if (sourceVoucher) {
        heroMedia.innerHTML = '';
        const voucher = sourceVoucher.cloneNode(true);
        voucher.className = 'milaura-contest__voucher';
        heroMedia.appendChild(voucher);
      }

      root.dataset.activeDay = String(day);
      statusDay.textContent = `Jour ${day} sur 10`;
    };

    const previewMode = root.dataset.previewMode === 'true';
    const previewDay = Math.min(10, Math.max(1, Number(root.dataset.previewDay) || 1));
    const startAt = Date.parse(root.dataset.startAt);
    const endAt = Date.parse(root.dataset.endAt);
    const now = Date.now();
    let activeDay = previewDay;
    let state = 'active';

    if (!previewMode && Number.isFinite(startAt) && Number.isFinite(endAt)) {
      if (now < startAt) {
        activeDay = 1;
        state = 'upcoming';
      } else if (now > endAt) {
        activeDay = 10;
        state = 'ended';
      } else {
        activeDay = Math.min(10, Math.floor((now - startAt) / 86400000) + 1);
      }
    }

    setHeroDay(activeDay);

    if (state === 'upcoming') {
      gift.disabled = true;
      statusText.textContent = 'Le jeu ouvre bientôt. Les dix cadeaux sont déjà présentés plus bas.';
      instruction.textContent = 'Revenez à l’ouverture pour découvrir le premier cadeau.';
      giftLabel.textContent = 'Bientôt disponible';
    } else if (state === 'ended') {
      statusText.textContent = 'Le jeu est terminé. Le tirage au sort est en préparation.';
      instruction.textContent = 'Retrouvez les dix cadeaux et le règlement ci-dessous.';
      giftLabel.textContent = 'Voir le dernier cadeau';
    }

    gift.addEventListener('click', () => {
      gift.classList.add('is-open');
      gift.setAttribute('aria-expanded', 'true');
      reveal.classList.add('is-visible');
      reveal.setAttribute('aria-hidden', 'false');
      emit('milaura_contest_gift_open', { contest_day: activeDay });
    });

    root.querySelectorAll('[data-contest-social]').forEach((link) => {
      link.addEventListener('click', () => {
        emit('milaura_contest_social_click', {
          contest_day: activeDay,
          platform: link.dataset.contestSocial,
          destination: link.href
        });
      });
    });

    const rules = root.querySelector('[data-contest-rules]');
    if (rules) {
      rules.addEventListener('toggle', () => {
        if (rules.open) emit('milaura_contest_rules_open', { contest_day: activeDay });
      });
    }
  })();
</script>

