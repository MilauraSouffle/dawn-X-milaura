
{%- liquid
  assign selected_count = 0
  assign selection_title_id = 'MilauraSelectionTitle-' | append: section.id
  assign media_description_id = 'MilauraSelectionMediaDescription-' | append: section.id
  assign campaign_video_desktop = section.settings.campaign_video
  assign campaign_video_mobile = section.settings.campaign_video_mobile | default: campaign_video_desktop
  assign campaign_poster_desktop = section.settings.campaign_poster
  assign campaign_poster_mobile = section.settings.campaign_poster_mobile | default: campaign_poster_desktop

  for block in section.blocks
    assign block_product = block.settings.product
    if block_product != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
-%}

{%- if selected_count > 0 -%}
  <script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if campaign_video_desktop != blank -%}
  <script src="{{ 'milaura-home-seasonal-media.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  #MilauraSelectionAtelier {
    scroll-margin-top: 150px;
  }

  #MilauraSelection-{{ section.id }} {
    position: relative;
    overflow: hidden;
    color: var(--milaura-encre);
    background: var(--milaura-nacre);
  }

  #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
    padding: 0 0 {% if selected_count > 0 %}clamp(48px, 5vw, 72px){% else %}0{% endif %} !important;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__shell {
    width: 100%;
    margin: 0 auto;
  }

  #MainContent > #shopify-section-{{ section.id }} #MilauraSelection-{{ section.id }} .milaura-season__shell {
    padding-top: 0 !important;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign {
    position: relative;
    isolation: isolate;
    color: var(--milaura-encre);
    background: var(--milaura-nacre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media {
    margin: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--milaura-nacre-ombre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-frame::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset-block: 0;
    left: 0;
    width: clamp(48px, 9vw, 136px);
    background: linear-gradient(90deg, var(--milaura-nacre-ombre) 0%, transparent 100%);
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__picture,
  #MilauraSelection-{{ section.id }} .milaura-season__video,
  #MilauraSelection-{{ section.id }} .milaura-season__image {
    width: 100%;
    height: 100%;
    display: block;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__video,
  #MilauraSelection-{{ section.id }} .milaura-season__image {
    object-fit: cover;
    object-position: center;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-toggle {
    position: absolute;
    z-index: 3;
    right: clamp(16px, 3vw, 44px);
    bottom: clamp(16px, 3vw, 44px);
    min-width: 58px;
    min-height: 44px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--milaura-esp-2xs) var(--milaura-esp-xs);
    border: 1px solid currentColor;
    border-radius: 0;
    color: var(--milaura-nacre-pure);
    background: color-mix(in srgb, var(--milaura-encre) 66%, transparent);
    backdrop-filter: blur(8px);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 650;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-transform: uppercase;
    cursor: pointer;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-toggle:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: 4px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__copy {
    position: static;
    z-index: 2;
    width: min(1280px, calc(100% - clamp(32px, 6vw, 88px)));
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    grid-template-rows: auto auto auto;
    column-gap: clamp(48px, 7vw, 112px);
    margin: 0 auto;
    padding-top: clamp(32px, 4vw, 52px);
    transform: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__lead {
    display: contents;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__eyebrow {
    grid-column: 1;
    grid-row: 1;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: var(--milaura-esp-xs);
    margin-bottom: var(--milaura-esp-xs);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__title {
    grid-column: 1;
    grid-row: 2;
    max-width: 100%;
    display: grid;
    justify-items: start;
    margin: 0;
    color: var(--milaura-prune);
    font-family: var(--milaura-font-signature);
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1;
    text-wrap: balance;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__title-main,
  #MilauraSelection-{{ section.id }} .milaura-season__title-secondary {
    display: block;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__title-main {
    font-size: clamp(5.2rem, 14vw, 7rem);
    line-height: 0.92;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__title-secondary {
    max-width: 15ch;
    margin-top: 0.08em;
    font-size: clamp(3.2rem, 8.5vw, 4.2rem);
    line-height: 1;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__description {
    grid-column: 1;
    grid-row: 3;
    max-width: 50ch;
    margin: var(--milaura-esp-sm) 0 0;
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
    opacity: 1;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__description p {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--milaura-esp-md);
    align-items: end;
    align-self: end;
    margin-top: 0;
    padding: var(--milaura-esp-sm) 0;
    border-block: var(--milaura-filet-mineral);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-label {
    display: block;
    margin-bottom: var(--milaura-esp-2xs);
    color: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 650;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-transform: uppercase;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-title {
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-heading);
    text-decoration: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
    color: var(--milaura-prune);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    font-weight: 700;
    white-space: nowrap;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__actions {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--milaura-esp-sm) var(--milaura-esp-md);
    align-self: start;
    margin-top: var(--milaura-esp-sm);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta--secondary {
    border-bottom-color: var(--milaura-aigue-pierre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:focus-visible,
  #MilauraSelection-{{ section.id }} .grid__card:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: 5px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__more {
    width: min(1280px, calc(100% - clamp(32px, 6vw, 88px)));
    margin: clamp(42px, 5vw, 68px) auto 0;
    padding-top: clamp(30px, 4vw, 48px);
    border-top: var(--milaura-filet);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__more-title {
    margin: 0 0 var(--milaura-esp-md);
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: var(--milaura-filet-mineral);
    background: transparent;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card {
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card-info {
    flex: 1 1 auto;
    padding: var(--milaura-esp-sm) var(--milaura-esp-sm) 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .milaura-editorial-purchase {
    width: auto;
    margin: var(--milaura-esp-xs) var(--milaura-esp-sm) var(--milaura-esp-sm);
    padding-top: var(--milaura-esp-2xs);
    border-top: 0;
  }

  @media screen and (min-width: 990px) {
    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      min-height: min(56.25vw, 900px);
      background: var(--milaura-nacre-ombre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media {
      position: relative;
      z-index: 1;
      width: 100%;
      min-width: 0;
      background: var(--milaura-nacre-ombre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame::before {
      width: min(58vw, 900px);
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--milaura-nacre-ombre) 98%, transparent) 0%,
        color-mix(in srgb, var(--milaura-nacre-ombre) 88%, transparent) 48%,
        color-mix(in srgb, var(--milaura-nacre-ombre) 44%, transparent) 76%,
        transparent 100%
      );
    }

    #MilauraSelection-{{ section.id }} .milaura-season__video,
    #MilauraSelection-{{ section.id }} .milaura-season__image {
      object-fit: cover;
      object-position: center;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      position: absolute;
      z-index: 3;
      inset: 0 auto 0 0;
      width: min(48vw, 740px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 0;
      padding: clamp(44px, 5vw, 76px) clamp(34px, 4vw, 64px) clamp(44px, 5vw, 76px) max(clamp(40px, 6vw, 88px), calc((100vw - 1440px) / 2));
      background: transparent;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      max-width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title-main {
      font-size: clamp(7.4rem, 7vw, 10.4rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title-secondary {
      max-width: 14ch;
      font-size: clamp(3.8rem, 3.4vw, 5.2rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      max-width: 36ch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      width: min(100%, 540px);
      margin-top: clamp(22px, 2.2vw, 34px);
      padding-block: var(--milaura-esp-xs);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      width: min(100%, 540px);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-toggle {
      right: clamp(18px, 2vw, 32px);
      bottom: clamp(18px, 2vw, 32px);
    }
  }

  @media screen and (max-width: 989px) {
    #MilauraSelectionAtelier {
      scroll-margin-top: 112px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      min-height: 0;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame::before {
      inset-block: auto 0;
      width: 100%;
      height: clamp(36px, 8vw, 64px);
      background: linear-gradient(0deg, var(--milaura-nacre) 0%, transparent 100%);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      width: min(900px, calc(100% - 40px));
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__eyebrow,
    #MilauraSelection-{{ section.id }} .milaura-season__title,
    #MilauraSelection-{{ section.id }} .milaura-season__description,
    #MilauraSelection-{{ section.id }} .milaura-season__featured,
    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      grid-column: 1;
      grid-row: auto;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      margin-top: var(--milaura-esp-md);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      margin-top: var(--milaura-esp-sm);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      font-size: inherit;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      font-size: var(--milaura-t-corps);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(254px, 78vw);
      gap: var(--milaura-esp-sm);
      padding: 4px 18px 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-left: 18px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards::-webkit-scrollbar {
      display: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__card {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
      padding: 0 0 {% if selected_count > 0 %}48px{% else %}0{% endif %} !important;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__shell {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      color: var(--milaura-encre);
      background: var(--milaura-nacre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
      aspect-ratio: 1 / 1;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame::before {
      height: 72%;
      background: linear-gradient(
        0deg,
        color-mix(in srgb, var(--milaura-nacre) 98%, transparent) 0%,
        color-mix(in srgb, var(--milaura-nacre) 88%, transparent) 42%,
        color-mix(in srgb, var(--milaura-nacre) 28%, transparent) 76%,
        transparent 100%
      );
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-toggle {
      right: var(--milaura-esp-xs);
      top: var(--milaura-esp-xs);
      bottom: auto;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      display: contents;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__lead {
      z-index: 3;
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      display: block;
      min-width: 0;
      padding: 0 16px 76px;
      pointer-events: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__eyebrow {
      margin-bottom: var(--milaura-esp-xs);
      color: var(--milaura-aigue-profonde);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      max-width: 100%;
      color: var(--milaura-prune);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      grid-column: 1;
      grid-row: 2;
      width: calc(100% - 32px);
      margin: 0 auto;
      padding-top: 26px;
      color: var(--milaura-encre-secondaire);
      opacity: 1;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-xs);
      margin-top: var(--milaura-esp-md);
      padding: var(--milaura-esp-sm) 0;
      border-block: var(--milaura-filet-mineral);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-label {
      color: var(--milaura-aigue-profonde);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-title,
    #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
      color: var(--milaura-prune);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      color: var(--milaura-prune) !important;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
      justify-self: start;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      z-index: 4;
      grid-column: 1;
      grid-row: 1;
      align-self: end;
      justify-self: start;
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-xs);
      margin: 0 16px 14px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      width: fit-content;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__more {
      width: 100%;
      margin-top: 38px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__more-title {
      padding-inline: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      transition: none;
    }
  }
{%- endstyle -%}

{% render 'milaura-home-transition', tone: 'nacre' %}
<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season"
  aria-labelledby="{{ selection_title_id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <div class="milaura-season__campaign">
      <figure class="milaura-season__media">
        <div class="milaura-season__media-frame"{% if campaign_video_desktop != blank %} data-milaura-home-seasonal-media{% endif %}>
          {%- if campaign_video_desktop != blank -%}
            <video
              class="milaura-season__video"
              poster="{{ campaign_poster_desktop | asset_url }}"
              preload="metadata"
              muted
              playsinline
              disablepictureinpicture
              aria-describedby="{{ media_description_id }}"
              data-milaura-home-seasonal-video
              data-src-desktop="{{ campaign_video_desktop | asset_url }}"
              data-src-mobile="{{ campaign_video_mobile | asset_url }}"
              data-poster-desktop="{{ campaign_poster_desktop | asset_url }}"
              data-poster-mobile="{{ campaign_poster_mobile | asset_url }}"
            ></video>
            <button
              class="milaura-season__media-toggle"
              type="button"
              aria-label="Rejouer la vidéo"
              data-milaura-home-seasonal-replay
            >
              <span data-milaura-home-seasonal-replay-label>Rejouer</span>
            </button>
          {%- else -%}
            <picture class="milaura-season__picture">
              <source media="(max-width: 749px)" srcset="{{ campaign_poster_mobile | asset_url }}">
              <img
                class="milaura-season__image"
                src="{{ campaign_poster_desktop | asset_url }}"
                width="1672"
                height="941"
                alt="{{ section.settings.campaign_media_description | escape }}"
                loading="lazy"
                decoding="async"
              >
            </picture>
          {%- endif -%}
        </div>
        {%- if campaign_video_desktop != blank -%}
          <figcaption id="{{ media_description_id }}" class="milaura-season__media-caption">
            {{ section.settings.campaign_media_description | escape }}
          </figcaption>
        {%- endif -%}
      </figure>

      <div class="milaura-season__copy">
        <div class="milaura-season__lead">
          {%- if section.settings.campaign_eyebrow != blank -%}
            <p class="milaura-season__eyebrow milaura-section-label">{{ section.settings.campaign_eyebrow | escape }}</p>
          {%- endif -%}

          <h1 id="{{ selection_title_id }}" class="milaura-season__title milaura-section-title">
            <span class="milaura-season__title-main">{{ section.settings.campaign_title | escape }}</span>
            {%- if section.settings.campaign_title_secondary != blank -%}
              <span class="milaura-season__title-secondary">{{ section.settings.campaign_title_secondary | escape }}</span>
            {%- endif -%}
          </h1>
        </div>

        {%- if section.settings.campaign_description != blank -%}
          <div class="milaura-season__description">{{ section.settings.campaign_description }}</div>
        {%- endif -%}

        <div class="milaura-season__actions">
          {%- if section.settings.selection_cta_label != blank and section.settings.selection_cta_link != blank -%}
            <a class="milaura-season__cta milaura-action milaura-action--editorial" href="{{ section.settings.selection_cta_link }}">
              <span>{{ section.settings.selection_cta_label | escape }}</span>
              {% render 'milaura-action-icon' %}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__more">
        <h3 class="milaura-season__more-title">{{ section.settings.more_products_title | escape }}</h3>
        <div class="milaura-season__cards milaura-cards milaura-cards--editorial" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
                {% render 'milaura-card-product',
                  card_product: product,
                  img_loading: 'lazy',
                  show_vendor: false,
                  show_badges: section.settings.show_badges,
                  show_secondary_image: true,
                  force_bestseller_badge: false
                %}
                {% render 'milaura-editorial-purchase', product: product %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

