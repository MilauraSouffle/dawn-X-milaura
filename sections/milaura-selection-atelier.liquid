{{ 'milaura-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_count = 0
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  for block in section.blocks
    if block.settings.product != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #MilauraSelectionAtelier {
    scroll-margin-top: 150px;
  }

  #MilauraSelection-{{ section.id }} {
    --season-prune: #2f222d;
    --season-prune-soft: #4a3545;
    --season-gold: #bc9858;
    --season-aqua: #76bcb7;
    --season-aqua-deep: #3f8583;
    --season-nacre: #fffdf9;
    --season-ink: #322a31;
    --season-muted: #716870;
    padding: clamp(46px, 6vw, 88px) 0 clamp(60px, 7vw, 104px);
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 12%, rgba(118, 188, 183, 0.18), transparent 29%),
      linear-gradient(180deg, #fff 0%, var(--season-nacre) 55%, rgba(241, 232, 216, 0.38) 100%);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__shell {
    width: min(1500px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign {
    min-height: clamp(390px, 38vw, 610px);
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(0, 1.45fr);
    overflow: hidden;
    border-radius: 30px 30px 122px 30px;
    background: var(--season-prune);
    box-shadow: 0 26px 70px rgba(47, 34, 45, 0.15);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(42px, 5.5vw, 86px);
    color: var(--season-nacre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__kicker {
    margin: 0 0 16px;
    color: #9dd8d4;
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-title,
  #MilauraSelection-{{ section.id }} .milaura-season__selection-title {
    margin: 0;
    color: #e1bd78;
    font-family: var(--milaura-font-script, 'Dancing Script'), cursive;
    font-weight: 600;
    letter-spacing: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-title {
    max-width: 470px;
    font-size: clamp(3.7rem, 6vw, 6.4rem);
    line-height: 0.88;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__name {
    margin: 22px 0 0;
    color: var(--season-nacre);
    font-family: var(--milaura-font-heading, 'Playfair Display'), serif;
    font-size: clamp(1.15rem, 1.7vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.28;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__description {
    max-width: 430px;
    margin: 18px 0 0;
    color: rgba(255, 253, 249, 0.78);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: clamp(0.94rem, 1.05vw, 1.08rem);
    line-height: 1.65;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__photo {
    position: relative;
    min-height: 390px;
    overflow: hidden;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 48%;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(47, 34, 45, 0.2), transparent 28%);
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 28px;
    margin: clamp(44px, 5vw, 72px) 0 24px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-title {
    font-size: clamp(3rem, 4.6vw, 5rem);
    line-height: 1;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
    max-width: 510px;
    margin: 0;
    color: var(--season-muted);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    line-height: 1.55;
    text-align: right;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(15px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card {
    min-width: 0;
    display: flex;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card {
    width: 100%;
    height: 100%;
    border-color: rgba(63, 133, 131, 0.42);
    box-shadow: 0 8px 22px rgba(47, 34, 45, 0.045);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card:hover {
    border-color: var(--season-aqua-deep);
    box-shadow: 0 13px 30px rgba(63, 133, 131, 0.15);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(34px, 4vw, 54px);
    padding: 0 18px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 9px 10px 9px 24px;
    border: 1px solid rgba(188, 152, 88, 0.7);
    border-radius: 999px;
    color: #fff;
    background: var(--season-prune);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(47, 34, 45, 0.14);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-arrow {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--season-prune);
    background: var(--season-gold);
    font-size: 1.05rem;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:focus-visible,
  #MilauraSelection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--season-aqua-deep);
    outline-offset: 5px;
  }

  @media screen and (max-width: 989px) {
    #MilauraSelectionAtelier {
      scroll-margin-top: 112px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__shell {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      width: calc(100% - 32px);
      min-height: auto;
      margin: 0 16px;
      grid-template-columns: 1fr;
      border-radius: 24px 24px 72px 24px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      min-height: 320px;
      padding: 38px 30px 42px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign-title {
      font-size: clamp(3.8rem, 17vw, 5.5rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__photo {
      min-height: 360px;
      order: -1;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__photo::after {
      background: linear-gradient(180deg, transparent 66%, rgba(47, 34, 45, 0.25));
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
      display: block;
      margin: 42px 18px 22px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
      margin-top: 8px;
      text-align: left;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(246px, 78vw);
      gap: 14px;
      padding: 4px 18px 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-left: 18px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards::-webkit-scrollbar {
      display: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__card {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraSelection-{{ section.id }} {
      padding-top: 46px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-title {
      font-size: clamp(2.9rem, 13vw, 4rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
      max-width: 340px;
      font-size: 0.94rem;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      font-size: 0.72rem;
      letter-spacing: 0.055em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season"
  aria-labelledby="MilauraSelectionTitle-{{ section.id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <div class="milaura-season__campaign">
      <div class="milaura-season__copy">
        {%- if section.settings.campaign_kicker != blank -%}
          <p class="milaura-season__kicker">{{ section.settings.campaign_kicker | escape }}</p>
        {%- endif -%}
        <h2 id="MilauraSelectionTitle-{{ section.id }}" class="milaura-season__campaign-title">
          {{ section.settings.campaign_title | escape }}
        </h2>
        {%- if section.settings.campaign_subtitle != blank -%}
          <p class="milaura-season__name">{{ section.settings.campaign_subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.campaign_description != blank -%}
          <p class="milaura-season__description">{{ section.settings.campaign_description | escape }}</p>
        {%- endif -%}
      </div>
      <div class="milaura-season__photo">
        <img
          src="{{ campaign_asset | asset_url }}"
          alt="{{ section.settings.campaign_image_alt | escape }}"
          loading="lazy"
          width="1024"
          height="1536"
        >
      </div>
    </div>

    <header class="milaura-season__selection-heading">
      <h3 class="milaura-season__selection-title">{{ section.settings.title | escape }}</h3>
      {%- if section.settings.subtitle != blank -%}
        <p class="milaura-season__selection-note">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__cards milaura-cards" role="list">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
              {% render 'milaura-card-product',
                card_product: product,
                img_loading: 'lazy',
                show_vendor: false,
                show_badges: section.settings.show_badges,
                show_secondary_image: true,
                force_bestseller_badge: false
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="milaura-season__cta-wrap">
        <a class="milaura-season__cta" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="milaura-season__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "section",
  "class": "section-milaura-selection-atelier",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA de la page d'accueil",
      "default": true
    },
    {
      "type": "text",
      "id": "campaign_kicker",
      "label": "Signature de la saison",
      "default": "Éclats des Maldives"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "La sélection d’août"
    },
    {
      "type": "text",
      "id": "campaign_subtitle",
      "label": "Sous-titre de la campagne",
      "default": "Une escale entre lagon et lumière"
    },
    {
      "type": "textarea",
      "id": "campaign_description",
      "label": "Texte de la campagne",
      "default": "Des bijoux choisis par Karine pour leurs reflets dorés, leurs pierres naturelles et leur lumière estivale."
    },
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_image_alt",
      "label": "Texte alternatif du visuel",
      "default": "Eau aigue-marine sur une plage de sable nacré"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre des produits",
      "default": "La sélection du moment"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Introduction des produits",
      "default": "Une première escale avant de découvrir l’univers complet d’août."
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir toute la sélection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière"
    }
  ]
}
{% endschema %}
