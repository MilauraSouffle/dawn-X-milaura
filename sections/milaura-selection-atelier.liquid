{{ 'milaura-card.css' | asset_url | stylesheet_tag }}
{{ 'milaura-section-heading.css' | asset_url | stylesheet_tag }}
<script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign selected_count = 0
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  assign selection_title_id = 'MilauraSelectionTitle-' | append: section.id
  for block in section.blocks
    if block.settings.product != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  #MilauraSelectionAtelier {
    scroll-margin-top: 150px;
  }

  #MilauraSelection-{{ section.id }} {
    --season-prune: var(--milaura-prune);
    --season-gold: var(--milaura-or);
    --season-aqua: var(--milaura-aigue);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--milaura-nacre) url('{{ campaign_asset | asset_url }}') center 48% / cover no-repeat;
  }

  #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
    padding: clamp(58px, 7vw, 96px) 0 clamp(60px, 7vw, 96px) !important;
  }

  #MilauraSelection-{{ section.id }}::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: var(--milaura-nacre);
    opacity: 0.76;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__shell {
    position: relative;
    z-index: 1;
    width: min(1500px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
    margin-bottom: clamp(34px, 4vw, 54px);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card {
    width: 100%;
    height: auto;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 4vw, 48px);
    padding: 0 18px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--milaura-esp-xs);
    padding: 8px 0 6px;
    border-bottom: var(--milaura-filet-or);
    color: var(--milaura-prune);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 650;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: gap 180ms ease, color 180ms ease;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:hover {
    gap: var(--milaura-esp-sm);
    color: var(--milaura-aigue-profonde);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-arrow {
    color: var(--milaura-or-profond);
    font-size: 18px;
    line-height: 1;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:focus-visible,
  #MilauraSelection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--milaura-aigue-profonde);
    outline-offset: 5px;
  }

  @media screen and (max-width: 989px) {
    #MilauraSelectionAtelier {
      scroll-margin-top: 112px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__shell {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
      padding: 0 22px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(254px, 78vw);
      gap: 16px;
      padding: 4px 18px 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-left: 18px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards::-webkit-scrollbar {
      display: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__card {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
      padding: 68px 0 52px !important;
    }

    #MilauraSelection-{{ section.id }}::before {
      opacity: 0.82;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
      margin-bottom: 28px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      font-size: 11px;
      letter-spacing: 0.09em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season"
  aria-labelledby="MilauraSelectionTitle-{{ section.id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>
  <span class="milaura-section-divider" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <div class="milaura-season__selection-heading">
      {% render 'milaura-section-heading',
        eyebrow: section.settings.campaign_date,
        title: section.settings.campaign_title,
        text: section.settings.campaign_description,
        heading_tag: 'h2',
        heading_id: selection_title_id,
        align: 'center',
        size: 'section',
        eyebrow_style: 'signature'
      %}
    </div>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__cards milaura-cards milaura-cards--editorial" role="list">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
              {% render 'milaura-card-product',
                card_product: product,
                img_loading: 'lazy',
                show_vendor: false,
                show_badges: section.settings.show_badges,
                show_secondary_image: true,
                force_bestseller_badge: false
              %}
              {% render 'milaura-editorial-purchase', product: product %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="milaura-season__cta-wrap">
        <a class="milaura-season__cta" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="milaura-season__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "section",
  "class": "section-milaura-selection-atelier",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA de la page d'accueil",
      "default": true
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_date",
      "label": "Date de la campagne",
      "default": "Août 2026"
    },
    {
      "type": "textarea",
      "id": "campaign_description",
      "label": "Texte de la campagne",
      "default": "Des bijoux choisis par Karine pour leurs reflets dorés, leurs pierres naturelles et leur lumière estivale."
    },
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_image_alt",
      "label": "Texte alternatif du visuel",
      "default": "Eau aigue-marine sur une plage de sable nacré"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir toute la sélection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière"
    }
  ]
}
{% endschema %}
