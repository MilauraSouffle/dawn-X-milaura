{{ 'milaura-section-heading.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = section.settings.featured_product
  assign selected_count = 0
  assign selection_title_id = 'MilauraSelectionTitle-' | append: section.id
  assign media_description_id = 'MilauraSelectionMediaDescription-' | append: section.id
  assign campaign_poster_desktop = section.settings.campaign_poster
  assign campaign_poster_mobile = section.settings.campaign_poster_mobile | default: campaign_poster_desktop

  for block in section.blocks
    assign block_product = block.settings.product
    if block_product != blank
      if featured_product == blank or block_product.handle != featured_product.handle
        assign selected_count = selected_count | plus: 1
      endif
    endif
  endfor
-%}

{%- if selected_count > 0 -%}
  <script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'milaura-seasonal-media.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  #MilauraSelectionAtelier {
    scroll-margin-top: 150px;
  }

  #MilauraSelection-{{ section.id }} {
    position: relative;
    overflow: hidden;
    color: var(--milaura-encre);
    background: var(--milaura-nacre);
    border-block: var(--milaura-filet-mineral);
  }

  #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
    padding: 0 0 clamp(48px, 5vw, 72px) !important;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__shell {
    width: 100%;
    margin: 0 auto;
  }

  #MainContent > #shopify-section-{{ section.id }} #MilauraSelection-{{ section.id }} .milaura-season__shell {
    padding-top: 0 !important;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign {
    position: relative;
    isolation: isolate;
    color: var(--milaura-encre);
    background: var(--milaura-nacre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media {
    margin: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
    position: relative;
    min-height: clamp(420px, 43vw, 660px);
    overflow: hidden;
    background: var(--milaura-nacre-ombre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-frame::before {
    content: '';
    position: absolute;
    z-index: 0;
    inset: -12%;
    background:
      radial-gradient(circle at 72% 34%, color-mix(in srgb, var(--milaura-aigue-pierre) 42%, transparent) 0 8%, transparent 32%),
      radial-gradient(circle at 34% 82%, color-mix(in srgb, var(--milaura-or-clair) 26%, transparent) 0 5%, transparent 28%),
      var(--milaura-nacre-ombre);
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-frame::after {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--milaura-nacre-pure) 60%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--milaura-aigue-pierre) 56%, transparent);
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__living-scene,
  #MilauraSelection-{{ section.id }} .milaura-season__product-portrait {
    position: absolute;
    inset: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__living-scene {
    z-index: 1;
    overflow: hidden;
    perspective: 1100px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__product-portrait {
    inset: 3% 3% 1% 1%;
    transform-origin: 56% 58%;
    will-change: transform;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__picture,
  #MilauraSelection-{{ section.id }} .milaura-season__image {
    width: 100%;
    height: 100%;
    display: block;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__image {
    object-fit: contain;
    object-position: 58% 52%;
    -webkit-mask-image: radial-gradient(ellipse 68% 62% at 58% 52%, var(--milaura-encre) 54%, transparent 98%);
    mask-image: radial-gradient(ellipse 68% 62% at 58% 52%, var(--milaura-encre) 54%, transparent 98%);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__mineral-orbit {
    position: absolute;
    z-index: 2;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--milaura-aigue-profonde);
    filter: drop-shadow(0 8px 10px color-mix(in srgb, var(--milaura-prune) 8%, transparent));
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__branch,
  #MilauraSelection-{{ section.id }} .milaura-season__twig {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__branch {
    stroke-width: 2;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__twig {
    stroke-width: 1.2;
    opacity: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__leaf {
    fill: color-mix(in srgb, var(--milaura-aigue) 28%, transparent);
    stroke: currentColor;
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__berry {
    position: absolute;
    z-index: 3;
    left: var(--berry-x);
    top: var(--berry-y);
    width: clamp(8px, 0.9vw, 13px);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--milaura-nacre-pure) 68%, transparent);
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, var(--milaura-nacre-pure) 0 8%, transparent 24%),
      radial-gradient(circle at 68% 72%, var(--milaura-prune) 0, var(--milaura-aigue-profonde) 72%);
    box-shadow: 0 5px 9px color-mix(in srgb, var(--milaura-prune) 18%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__glint {
    position: absolute;
    z-index: 4;
    left: 56.4%;
    top: 72%;
    width: clamp(22px, 3vw, 46px);
    aspect-ratio: 1;
    color: var(--milaura-or-clair);
    opacity: 0;
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__glint::before,
  #MilauraSelection-{{ section.id }} .milaura-season__glint::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
    transform: translateY(-50%);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__glint::after {
    transform: translateY(-50%) rotate(90deg);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__media-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__copy {
    position: relative;
    z-index: 2;
    width: min(1280px, calc(100% - clamp(32px, 6vw, 88px)));
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    grid-template-rows: auto auto auto;
    column-gap: clamp(48px, 7vw, 112px);
    margin: 0 auto;
    padding-top: clamp(32px, 4vw, 52px);
    transform: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__eyebrow {
    grid-column: 1;
    grid-row: 1;
    margin: 0 0 var(--milaura-esp-sm);
    color: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 700;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-transform: uppercase;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__title {
    position: relative;
    grid-column: 1;
    grid-row: 2;
    max-width: 12ch;
    margin: 0;
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h2);
    font-weight: 400;
    letter-spacing: var(--milaura-ls-heading);
    line-height: var(--milaura-lh-heading);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__butterfly {
    position: absolute;
    z-index: 5;
    top: clamp(78px, 21%, 152px);
    right: clamp(18px, 8%, 96px);
    width: clamp(28px, 2.6vw, 42px);
    color: var(--milaura-aigue-profonde);
    opacity: 0;
    pointer-events: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__butterfly svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__butterfly-wing {
    fill: color-mix(in srgb, var(--milaura-aigue-pierre) 52%, transparent);
    stroke: currentColor;
    stroke-width: 1.2;
    transform-box: fill-box;
    transform-origin: center right;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__butterfly-wing--right {
    transform-origin: center left;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__butterfly-body {
    fill: var(--milaura-or-profond);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__description {
    grid-column: 1;
    grid-row: 3;
    max-width: 50ch;
    margin: var(--milaura-esp-sm) 0 0;
    color: var(--milaura-encre-secondaire);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    line-height: var(--milaura-lh-corps);
    opacity: 1;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__description p {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--milaura-esp-md);
    align-items: end;
    align-self: end;
    margin-top: 0;
    padding: var(--milaura-esp-sm) 0;
    border-block: var(--milaura-filet-mineral);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-label {
    display: block;
    margin-bottom: var(--milaura-esp-2xs);
    color: var(--milaura-aigue-profonde);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 650;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-transform: uppercase;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-title {
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
    line-height: var(--milaura-lh-heading);
    text-decoration: none;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
    color: var(--milaura-prune);
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-corps);
    font-weight: 700;
    white-space: nowrap;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__actions {
    grid-column: 2;
    grid-row: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--milaura-esp-sm) var(--milaura-esp-md);
    align-self: start;
    margin-top: var(--milaura-esp-sm);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: var(--milaura-esp-xs);
    padding: var(--milaura-esp-2xs) 0;
    border-bottom: var(--milaura-filet-or);
    color: var(--milaura-prune) !important;
    font-family: var(--milaura-font-texte);
    font-size: var(--milaura-t-label);
    font-weight: 700;
    letter-spacing: var(--milaura-ls-label);
    line-height: var(--milaura-lh-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, gap 180ms ease, border-color 180ms ease;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta--secondary {
    border-bottom-color: var(--milaura-aigue-pierre);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:hover {
    gap: var(--milaura-esp-sm);
    color: var(--milaura-aigue-profonde) !important;
    border-color: var(--milaura-aigue-profonde);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:focus-visible,
  #MilauraSelection-{{ section.id }} .grid__card:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: 5px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__more {
    width: min(1280px, calc(100% - clamp(32px, 6vw, 88px)));
    margin: clamp(42px, 5vw, 68px) auto 0;
    padding-top: clamp(30px, 4vw, 48px);
    border-top: var(--milaura-filet);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__more-title {
    margin: 0 0 var(--milaura-esp-md);
    color: var(--milaura-prune);
    font-family: var(--milaura-font-display);
    font-size: var(--milaura-t-h3);
    font-weight: 400;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border: var(--milaura-filet-mineral);
    background: transparent;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card {
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card-info {
    flex: 1 1 auto;
    padding: var(--milaura-esp-sm) var(--milaura-esp-sm) 0;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .milaura-editorial-purchase {
    width: auto;
    margin: var(--milaura-esp-xs) var(--milaura-esp-sm) var(--milaura-esp-sm);
    padding-top: var(--milaura-esp-2xs);
    border-top: 0;
  }

  @media screen and (min-width: 990px) {
    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      display: grid;
      grid-template-columns: minmax(380px, 0.76fr) minmax(0, 1fr);
      align-items: stretch;
      background: var(--milaura-nacre-ombre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      display: flex;
      align-items: center;
      background: var(--milaura-nacre-ombre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
      width: 100%;
      flex: 0 0 auto;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      grid-column: 1;
      grid-row: 1;
      width: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 0;
      padding: clamp(44px, 5vw, 76px) clamp(40px, 5vw, 76px) clamp(44px, 5vw, 76px) max(clamp(40px, 6vw, 88px), calc((100vw - 1280px) / 2));
      background: var(--milaura-nacre-ombre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      max-width: 10ch;
      font-size: clamp(3.6rem, 4.1vw, 6.2rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      max-width: 42ch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      width: 100%;
      margin-top: clamp(24px, 2.4vw, 38px);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      width: 100%;
    }
  }

  @media screen and (max-width: 989px) {
    #MilauraSelectionAtelier {
      scroll-margin-top: 112px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      min-height: 0;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      width: min(900px, calc(100% - 40px));
      grid-template-columns: 1fr;
      column-gap: 0;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__eyebrow,
    #MilauraSelection-{{ section.id }} .milaura-season__title,
    #MilauraSelection-{{ section.id }} .milaura-season__description,
    #MilauraSelection-{{ section.id }} .milaura-season__featured,
    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      grid-column: 1;
      grid-row: auto;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      margin-top: var(--milaura-esp-md);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      margin-top: var(--milaura-esp-sm);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      font-size: var(--milaura-t-h2);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      font-size: var(--milaura-t-corps);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__butterfly {
      top: 78px;
      right: 12%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(254px, 78vw);
      gap: var(--milaura-esp-sm);
      padding: 4px 18px 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-left: 18px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards::-webkit-scrollbar {
      display: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__card {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > #MilauraSelection-{{ section.id }} {
      padding: 0 0 48px !important;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__shell {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign {
      display: grid;
      grid-template-columns: 1fr;
      color: var(--milaura-encre);
      background: var(--milaura-nacre);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__media-frame {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__product-portrait {
      inset: 2% -8% -2% -6%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__image {
      object-position: 55% 50%;
      -webkit-mask-image: radial-gradient(ellipse 72% 66% at 55% 50%, var(--milaura-encre) 56%, transparent 98%);
      mask-image: radial-gradient(ellipse 72% 66% at 55% 50%, var(--milaura-encre) 56%, transparent 98%);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__glint {
      left: 55%;
      top: 72%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__copy {
      position: relative;
      width: calc(100% - 32px);
      display: block;
      margin: 0 auto;
      padding-top: 28px;
      transform: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__eyebrow {
      color: var(--milaura-aigue-profonde);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__title {
      max-width: 17ch;
      color: var(--milaura-prune);
      font-size: var(--milaura-t-h3);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__butterfly {
      top: 18px;
      right: 8px;
      width: 30px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__description {
      margin-top: var(--milaura-esp-sm);
      color: var(--milaura-encre-secondaire);
      opacity: 1;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured {
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-xs);
      margin-top: var(--milaura-esp-md);
      padding: var(--milaura-esp-sm) 0;
      border-block: var(--milaura-filet-mineral);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-label {
      color: var(--milaura-aigue-profonde);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-title,
    #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
      color: var(--milaura-prune);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      color: var(--milaura-prune) !important;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__featured-price {
      justify-self: start;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-xs);
      margin-top: var(--milaura-esp-sm);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      width: fit-content;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__more {
      width: 100%;
      margin-top: 38px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__more-title {
      padding-inline: 18px;
    }
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__product-portrait {
    animation: MilauraProductFloat-{{ section.id }} 9s cubic-bezier(0.42, 0, 0.36, 1) 0.4s infinite;
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__branch {
    animation: MilauraBranchDraw-{{ section.id }} 2.6s cubic-bezier(0.32, 0.7, 0.2, 1) 0.15s forwards;
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__twig {
    animation: MilauraTwigReveal-{{ section.id }} 0.8s ease-out 1.45s forwards;
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__leaf {
    animation: MilauraLeafOpen-{{ section.id }} 0.75s cubic-bezier(0.2, 0.8, 0.25, 1.2) var(--leaf-delay, 1.4s) forwards;
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__berry {
    animation: MilauraBerryFall-{{ section.id }} 6.8s cubic-bezier(0.32, 0.02, 0.22, 1) var(--berry-delay) infinite;
  }

  #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene].is-seasonal-active .milaura-season__glint {
    animation: MilauraGlint-{{ section.id }} 5.8s ease-in-out 2.3s infinite;
  }

  #MilauraSelection-{{ section.id }}.is-seasonal-active .milaura-season__butterfly {
    animation: MilauraButterflyLand-{{ section.id }} 3.4s cubic-bezier(0.18, 0.72, 0.18, 1) 0.9s forwards;
  }

  #MilauraSelection-{{ section.id }}.is-seasonal-active .milaura-season__butterfly-wing--left {
    animation: MilauraWingLeft-{{ section.id }} 0.2s ease-in-out 0.9s 13 alternate;
  }

  #MilauraSelection-{{ section.id }}.is-seasonal-active .milaura-season__butterfly-wing--right {
    animation: MilauraWingRight-{{ section.id }} 0.2s ease-in-out 0.9s 13 alternate;
  }

  @keyframes MilauraProductFloat-{{ section.id }} {
    0%, 100% {
      transform: translate3d(var(--seasonal-shift-x, 0px), calc(var(--seasonal-shift-y, 0px) + 3px), 0) rotateY(var(--seasonal-rotate-y, 0deg)) rotateZ(-0.35deg) scale(1.015);
    }
    50% {
      transform: translate3d(var(--seasonal-shift-x, 0px), calc(var(--seasonal-shift-y, 0px) - 7px), 14px) rotateY(var(--seasonal-rotate-y, 0deg)) rotateZ(0.35deg) scale(1.035);
    }
  }

  @keyframes MilauraBranchDraw-{{ section.id }} {
    to { stroke-dashoffset: 0; }
  }

  @keyframes MilauraTwigReveal-{{ section.id }} {
    to { opacity: 0.72; }
  }

  @keyframes MilauraLeafOpen-{{ section.id }} {
    to { transform: scale(1); }
  }

  @keyframes MilauraBerryFall-{{ section.id }} {
    0%, 10% { opacity: 0; transform: translate3d(0, -5px, 0) scale(0.8); }
    18%, 34% { opacity: 0.94; transform: translate3d(0, 0, 0) scale(1); }
    72% { opacity: 0.9; transform: translate3d(var(--berry-drift), var(--berry-fall), 0) rotate(170deg) scale(0.96); }
    84%, 100% { opacity: 0; transform: translate3d(var(--berry-drift), calc(var(--berry-fall) + 34px), 0) rotate(210deg) scale(0.82); }
  }

  @keyframes MilauraGlint-{{ section.id }} {
    0%, 66%, 100% { opacity: 0; transform: rotate(45deg) scale(0.45); }
    74% { opacity: 0.92; transform: rotate(45deg) scale(1); }
    82% { opacity: 0; transform: rotate(45deg) scale(1.35); }
  }

  @keyframes MilauraButterflyLand-{{ section.id }} {
    0% { opacity: 0; transform: translate3d(210px, -90px, 0) rotate(18deg) scale(0.7); }
    28% { opacity: 1; transform: translate3d(120px, -26px, 0) rotate(-12deg) scale(0.9); }
    58% { transform: translate3d(48px, 14px, 0) rotate(8deg) scale(1); }
    82% { transform: translate3d(12px, -5px, 0) rotate(-4deg) scale(0.96); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0) scale(0.94); }
  }

  @keyframes MilauraWingLeft-{{ section.id }} {
    from { transform: rotateY(0deg); }
    to { transform: rotateY(52deg); }
  }

  @keyframes MilauraWingRight-{{ section.id }} {
    from { transform: rotateY(0deg); }
    to { transform: rotateY(-52deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraSelection-{{ section.id }} .milaura-season__cta,
    #MilauraSelection-{{ section.id }} [data-milaura-seasonal-scene] *,
    #MilauraSelection-{{ section.id }} .milaura-season__butterfly {
      animation: none !important;
      transition: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__branch {
      stroke-dashoffset: 0;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__twig,
    #MilauraSelection-{{ section.id }} .milaura-season__butterfly {
      opacity: 0.72;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__leaf {
      transform: scale(1);
    }
  }
{%- endstyle -%}

<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season"
  aria-labelledby="{{ selection_title_id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <div class="milaura-season__campaign">
      <figure class="milaura-season__media">
        <div class="milaura-season__media-frame" data-milaura-seasonal-scene>
          <div class="milaura-season__living-scene">
            <div class="milaura-season__product-portrait" data-milaura-seasonal-product>
              {%- if featured_product != blank and featured_product.featured_image != blank -%}
                {{
                  featured_product.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'milaura-season__image',
                    widths: '560, 760, 980, 1200, 1400',
                    sizes: '(max-width: 749px) 112vw, (max-width: 989px) 100vw, 62vw',
                    loading: 'lazy',
                    alt: section.settings.campaign_media_description
                }}
              {%- else -%}
            <picture class="milaura-season__picture">
              <source media="(max-width: 749px)" srcset="{{ campaign_poster_mobile | asset_url }}">
              <img
                class="milaura-season__image"
                src="{{ campaign_poster_desktop | asset_url }}"
                width="1672"
                height="941"
                alt="{{ section.settings.campaign_media_description | escape }}"
                loading="lazy"
                decoding="async"
              >
            </picture>
              {%- endif -%}
            </div>

            <svg class="milaura-season__mineral-orbit" viewBox="0 0 900 620" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <path class="milaura-season__branch" d="M 920 28 C 820 64 834 154 746 185 C 682 207 695 276 620 306 C 560 330 540 398 462 432" />
              <path class="milaura-season__twig" d="M 805 121 C 756 104 726 78 704 42 M 744 187 C 790 187 824 169 858 136 M 676 247 C 630 230 601 198 584 163 M 617 307 C 662 299 697 278 724 246 M 548 380 C 501 367 464 338 442 300" />
              <path class="milaura-season__leaf" style="--leaf-delay: 1.35s" d="M 724 82 C 691 72 673 48 676 20 C 710 28 729 50 724 82 Z" />
              <path class="milaura-season__leaf" style="--leaf-delay: 1.55s" d="M 801 171 C 821 140 849 126 877 134 C 861 164 836 179 801 171 Z" />
              <path class="milaura-season__leaf" style="--leaf-delay: 1.7s" d="M 606 204 C 577 190 562 165 570 138 C 600 149 616 174 606 204 Z" />
              <path class="milaura-season__leaf" style="--leaf-delay: 1.9s" d="M 676 284 C 700 254 730 244 756 256 C 735 284 708 295 676 284 Z" />
              <path class="milaura-season__leaf" style="--leaf-delay: 2.05s" d="M 474 352 C 442 342 423 319 427 291 C 460 298 480 321 474 352 Z" />
            </svg>

            <span class="milaura-season__berry" style="--berry-x: 80%; --berry-y: 24%; --berry-delay: 2.1s; --berry-drift: -28px; --berry-fall: 148px" aria-hidden="true"></span>
            <span class="milaura-season__berry" style="--berry-x: 72%; --berry-y: 40%; --berry-delay: 3.35s; --berry-drift: 22px; --berry-fall: 170px" aria-hidden="true"></span>
            <span class="milaura-season__berry" style="--berry-x: 63%; --berry-y: 56%; --berry-delay: 4.55s; --berry-drift: -18px; --berry-fall: 132px" aria-hidden="true"></span>
            <span class="milaura-season__glint" aria-hidden="true"></span>
          </div>
        </div>
        <figcaption id="{{ media_description_id }}" class="milaura-season__media-caption">
          {{ section.settings.campaign_media_description | escape }}
        </figcaption>
      </figure>

      <div class="milaura-season__copy">
        {%- if section.settings.campaign_eyebrow != blank -%}
          <p class="milaura-season__eyebrow">{{ section.settings.campaign_eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="{{ selection_title_id }}" class="milaura-season__title">
          {{ section.settings.campaign_title | escape }}
        </h2>

        <span class="milaura-season__butterfly" aria-hidden="true">
          <svg viewBox="0 0 48 34" role="presentation">
            <path class="milaura-season__butterfly-wing milaura-season__butterfly-wing--left" d="M 23 17 C 16 1 3 2 3 11 C 3 20 12 24 23 19 Z" />
            <path class="milaura-season__butterfly-wing milaura-season__butterfly-wing--right" d="M 25 17 C 32 1 45 2 45 11 C 45 20 36 24 25 19 Z" />
            <path class="milaura-season__butterfly-wing milaura-season__butterfly-wing--left" d="M 23 19 C 15 21 9 25 12 30 C 16 35 21 28 24 21 Z" />
            <path class="milaura-season__butterfly-wing milaura-season__butterfly-wing--right" d="M 25 19 C 33 21 39 25 36 30 C 32 35 27 28 24 21 Z" />
            <ellipse class="milaura-season__butterfly-body" cx="24" cy="18" rx="1.6" ry="8" />
          </svg>
        </span>

        {%- if section.settings.campaign_description != blank -%}
          <div class="milaura-season__description">{{ section.settings.campaign_description }}</div>
        {%- endif -%}

        {%- if featured_product != blank -%}
          <div class="milaura-season__featured">
            <div>
              {%- if section.settings.product_label != blank -%}
                <span class="milaura-season__featured-label">{{ section.settings.product_label | escape }}</span>
              {%- endif -%}
              <a class="milaura-season__featured-title" href="{{ featured_product.url }}">
                {{ featured_product.title | escape }}
              </a>
            </div>
            <span class="milaura-season__featured-price">{{ featured_product.price | money }}</span>
          </div>
        {%- endif -%}

        <div class="milaura-season__actions">
          {%- if featured_product != blank and section.settings.product_cta_label != blank -%}
            <a class="milaura-season__cta" href="{{ featured_product.url }}">
              <span>{{ section.settings.product_cta_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if section.settings.selection_cta_label != blank and section.settings.selection_cta_link != blank -%}
            <a class="milaura-season__cta milaura-season__cta--secondary" href="{{ section.settings.selection_cta_link }}">
              <span>{{ section.settings.selection_cta_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__more">
        <h3 class="milaura-season__more-title">{{ section.settings.more_products_title | escape }}</h3>
        <div class="milaura-season__cards milaura-cards milaura-cards--editorial" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              {%- if featured_product == blank or product.handle != featured_product.handle -%}
                <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
                  {% render 'milaura-card-product',
                    card_product: product,
                    img_loading: 'lazy',
                    show_vendor: false,
                    show_badges: section.settings.show_badges,
                    show_secondary_image: true,
                    force_bestseller_badge: false
                  %}
                  {% render 'milaura-editorial-purchase', product: product %}
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "section",
  "class": "section-milaura-selection-atelier",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA de la page d'accueil",
      "default": true
    },
    {
      "type": "text",
      "id": "campaign_eyebrow",
      "label": "Sur-titre de campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Accroche",
      "default": "La sélection du moment"
    },
    {
      "type": "richtext",
      "id": "campaign_description",
      "label": "Texte de campagne",
      "default": "<p>Découvrez les produits choisis ce mois-ci par Karine.</p>"
    },
    {
      "type": "text",
      "id": "campaign_poster",
      "label": "Image de secours desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_poster_mobile",
      "label": "Image de secours mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_media_description",
      "label": "Description accessible du média",
      "default": "Présentation portée du produit vedette de la sélection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Produit vedette"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "Libellé du produit vedette",
      "default": "Le choix de Karine"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "CTA du produit",
      "default": "Voir le produit"
    },
    {
      "type": "text",
      "id": "selection_cta_label",
      "label": "CTA de la sélection",
      "default": "Découvrir la sélection"
    },
    {
      "type": "url",
      "id": "selection_cta_link",
      "label": "Lien de la sélection"
    },
    {
      "type": "text",
      "id": "more_products_title",
      "label": "Titre des produits complémentaires",
      "default": "Dans la même sélection"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit complémentaire",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière"
    }
  ]
}
{% endschema %}
