{{ 'milaura-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_count = 0
  assign campaign_asset = section.settings.campaign_asset | default: 'milaura-selection-aout-lagon.webp'
  for block in section.blocks
    if block.settings.product != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #MilauraSelectionAtelier {
    scroll-margin-top: 150px;
  }

  #MilauraSelection-{{ section.id }} {
    --season-prune: #2f222d;
    --season-prune-soft: #4a3545;
    --season-gold: #bc9858;
    --season-aqua: #76bcb7;
    --season-aqua-deep: #3f8583;
    --season-nacre: #fffdf9;
    --season-ink: #322a31;
    --season-muted: #716870;
    padding: clamp(36px, 4.5vw, 64px) 0 clamp(54px, 6vw, 84px);
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 12%, rgba(118, 188, 183, 0.18), transparent 29%),
      linear-gradient(180deg, #fff 0%, var(--season-nacre) 55%, rgba(241, 232, 216, 0.38) 100%);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__shell {
    width: min(1500px, calc(100% - clamp(32px, 6vw, 92px)));
    margin: 0 auto;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
    display: block;
    margin: 0 0 26px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
    width: 100%;
    max-width: none;
    margin: 15px 0 0;
    color: var(--season-muted);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: clamp(0.95rem, 1.05vw, 1.08rem);
    line-height: 1.45;
    text-align: center;
    white-space: nowrap;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini {
    width: 100%;
    height: clamp(76px, 6.5vw, 94px);
    display: grid;
    grid-template-columns: 38% 62%;
    overflow: hidden;
    border: 1px solid rgba(63, 133, 131, 0.3);
    border-radius: 14px;
    box-shadow: 0 8px 22px rgba(47, 34, 45, 0.07);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--prune {
    justify-content: center;
    padding: 0 clamp(20px, 3vw, 48px);
    color: #9dd8d4;
    background: var(--season-prune);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--lagoon {
    justify-content: center;
    padding: 0 clamp(20px, 3vw, 48px);
    color: var(--season-prune);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--lagoon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 52%;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--lagoon::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 253, 249, 0.3);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-word {
    position: relative;
    z-index: 1;
    margin: 0;
    color: inherit;
    font-family: var(--milaura-font-script, 'Dancing Script'), cursive;
    font-size: clamp(2.35rem, 3vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--lagoon .milaura-season__campaign-mini-word {
    text-shadow: 0 1px 12px rgba(255, 253, 249, 0.9);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(15px, 1.8vw, 28px);
    align-items: stretch;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card {
    min-width: 0;
    display: flex;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card {
    width: 100%;
    height: 100%;
    border-color: rgba(63, 133, 131, 0.42);
    box-shadow: 0 8px 22px rgba(47, 34, 45, 0.045);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__card .grid__card:hover {
    border-color: var(--season-aqua-deep);
    box-shadow: 0 13px 30px rgba(63, 133, 131, 0.15);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: clamp(34px, 4vw, 54px);
    padding: 0 18px;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 9px 10px 9px 24px;
    border: 1px solid rgba(188, 152, 88, 0.7);
    border-radius: 999px;
    color: #fff;
    background: var(--season-prune);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(47, 34, 45, 0.14);
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta-arrow {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--season-prune);
    background: var(--season-gold);
    font-size: 1.05rem;
  }

  #MilauraSelection-{{ section.id }} .milaura-season__cta:focus-visible,
  #MilauraSelection-{{ section.id }} .grid__card:focus-visible {
    outline: 3px solid var(--season-aqua-deep);
    outline-offset: 5px;
  }

  @media screen and (max-width: 989px) {
    #MilauraSelectionAtelier {
      scroll-margin-top: 112px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__shell {
      width: 100%;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-heading {
      margin: 0 18px 22px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
      margin-top: 13px;
      white-space: normal;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(246px, 78vw);
      gap: 14px;
      padding: 4px 18px 18px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-left: 18px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cards::-webkit-scrollbar {
      display: none;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__card {
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    #MilauraSelection-{{ section.id }} {
      padding-top: 36px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__selection-note {
      max-width: 360px;
      margin-right: auto;
      margin-left: auto;
      font-size: 0.94rem;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini {
      height: 78px;
      grid-template-columns: 59% 41%;
      border-radius: 12px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-word {
      font-size: clamp(1.55rem, 6.8vw, 2.15rem);
    }

    #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--prune,
    #MilauraSelection-{{ section.id }} .milaura-season__campaign-mini-part--lagoon {
      padding: 0 10px;
    }

    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      font-size: 0.72rem;
      letter-spacing: 0.055em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraSelection-{{ section.id }} .milaura-season__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season"
  aria-labelledby="MilauraSelectionTitle-{{ section.id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <header class="milaura-season__selection-heading">
      {%- if section.settings.campaign_title != blank -%}
        <div class="milaura-season__campaign-mini" aria-label="{{ section.settings.campaign_title | escape }}">
          <div class="milaura-season__campaign-mini-part milaura-season__campaign-mini-part--prune">
            <h2 id="MilauraSelectionTitle-{{ section.id }}" class="milaura-season__campaign-mini-word">
              {{ section.settings.campaign_title | escape }}
            </h2>
          </div>
          <div class="milaura-season__campaign-mini-part milaura-season__campaign-mini-part--lagoon">
            <img
              src="{{ campaign_asset | asset_url }}"
              alt=""
              loading="lazy"
              width="1024"
              height="1536"
            >
            <span class="milaura-season__campaign-mini-word">{{ section.settings.campaign_date | escape }}</span>
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.campaign_description != blank -%}
        <p class="milaura-season__selection-note">{{ section.settings.campaign_description | escape }}</p>
      {%- endif -%}
    </header>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__cards milaura-cards" role="list">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
              {% render 'milaura-card-product',
                card_product: product,
                img_loading: 'lazy',
                show_vendor: false,
                show_badges: section.settings.show_badges,
                show_secondary_image: true,
                force_bestseller_badge: false
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="milaura-season__cta-wrap">
        <a class="milaura-season__cta" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_label | escape }}</span>
          <span class="milaura-season__cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "section",
  "class": "section-milaura-selection-atelier",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA de la page d'accueil",
      "default": true
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Titre de la campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_date",
      "label": "Date de la campagne",
      "default": "Août 2026"
    },
    {
      "type": "textarea",
      "id": "campaign_description",
      "label": "Texte de la campagne",
      "default": "Des bijoux choisis par Karine pour leurs reflets dorés, leurs pierres naturelles et leur lumière estivale."
    },
    {
      "type": "text",
      "id": "campaign_asset",
      "label": "Nom du visuel dans les assets",
      "default": "milaura-selection-aout-lagon.webp"
    },
    {
      "type": "text",
      "id": "campaign_image_alt",
      "label": "Texte alternatif du visuel",
      "default": "Eau aigue-marine sur une plage de sable nacré"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir toute la sélection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière"
    }
  ]
}
{% endschema %}
