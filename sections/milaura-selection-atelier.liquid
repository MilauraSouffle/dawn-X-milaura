{{ 'milaura-home-seasonal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_count = 0
  assign selection_title_id = 'MilauraSelectionTitle-' | append: section.id
  assign media_description_id = 'MilauraSelectionMediaDescription-' | append: section.id
  assign campaign_video_desktop = section.settings.campaign_video
  assign campaign_video_mobile = section.settings.campaign_video_mobile | default: campaign_video_desktop
  assign campaign_poster_desktop = section.settings.campaign_poster
  assign campaign_poster_mobile = section.settings.campaign_poster_mobile | default: campaign_poster_desktop
  assign campaign_art_composite = section.settings.campaign_art_composite
  assign campaign_art_composite_mobile = section.settings.campaign_art_composite_mobile | default: campaign_art_composite
  assign campaign_art_accent = section.settings.campaign_art_accent
  assign campaign_art_accent_mobile = section.settings.campaign_art_accent_mobile | default: campaign_art_accent
  assign campaign_art_primary = section.settings.campaign_art_primary
  assign campaign_art_secondary = section.settings.campaign_art_secondary
  assign campaign_art_tertiary = section.settings.campaign_art_tertiary
  assign campaign_art_quaternary = section.settings.campaign_art_quaternary
  assign campaign_has_art = false
  assign campaign_heading_tag = 'h2'
  assign campaign_image_loading = 'lazy'
  assign campaign_image_priority = 'auto'

  if section.settings.homepage_hero
    assign campaign_heading_tag = 'h1'
    assign campaign_image_loading = 'eager'
    assign campaign_image_priority = 'high'
  endif

  if campaign_art_composite != blank or campaign_art_accent != blank or campaign_art_primary != blank or campaign_art_secondary != blank or campaign_art_tertiary != blank or campaign_art_quaternary != blank
    assign campaign_has_art = true
  endif

  for block in section.blocks
    assign block_product = block.settings.product
    if block_product != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
-%}

{%- if selected_count > 0 -%}
  <script src="{{ 'milaura-editorial-purchase.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if campaign_video_desktop != blank -%}
  <script src="{{ 'milaura-home-seasonal-media.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- unless section.settings.homepage_hero -%}
  {% render 'milaura-home-transition', tone: 'nacre' %}
{%- endunless -%}
<section
  id="MilauraSelection-{{ section.id }}"
  class="milaura-season{% if selected_count > 0 %} milaura-season--has-products{% endif %}{% if section.settings.homepage_hero %} milaura-season--homepage-hero{% endif %}"
  aria-labelledby="{{ selection_title_id }}"
  {% if section.settings.homepage_selection_anchor %}data-homepage-selection-anchor{% endif %}
>
  <span id="MilauraSelectionAtelier" aria-hidden="true"></span>

  <div class="milaura-season__shell">
    <div class="milaura-season__campaign">
      <figure class="milaura-season__media">
        <div class="milaura-season__media-frame"{% if campaign_video_desktop != blank %} data-milaura-home-seasonal-media{% endif %}>
          {%- if campaign_video_desktop != blank -%}
            <picture class="milaura-season__picture milaura-season__fallback" aria-hidden="true">
              <source media="(max-width: 749px)" srcset="{{ campaign_poster_mobile | asset_url }}">
              <img
                class="milaura-season__image"
                src="{{ campaign_poster_desktop | asset_url }}"
                width="1280"
                height="720"
                alt=""
                loading="{{ campaign_image_loading }}"
                fetchpriority="{{ campaign_image_priority }}"
                decoding="async"
              >
            </picture>
            <video
              class="milaura-season__video"
              poster="{{ campaign_poster_desktop | asset_url }}"
              preload="none"
              muted
              loop
              playsinline
              disablepictureinpicture
              aria-describedby="{{ media_description_id }}"
              data-milaura-home-seasonal-video
              data-src-desktop="{{ campaign_video_desktop | asset_url }}"
              data-src-mobile="{{ campaign_video_mobile | asset_url }}"
              data-poster-desktop="{{ campaign_poster_desktop | asset_url }}"
              data-poster-mobile="{{ campaign_poster_mobile | asset_url }}"
            ></video>
            <button
              class="milaura-season__media-toggle"
              type="button"
              aria-label="Lire la vidéo"
              aria-pressed="false"
              data-milaura-home-seasonal-replay
            >
              <span data-milaura-home-seasonal-replay-label>Lire</span>
            </button>
          {%- else -%}
            <picture class="milaura-season__picture">
              <source media="(max-width: 749px)" srcset="{{ campaign_poster_mobile | asset_url }}">
              <img
                class="milaura-season__image"
                src="{{ campaign_poster_desktop | asset_url }}"
                width="1672"
                height="941"
                alt="{{ section.settings.campaign_media_description | escape }}"
                loading="{{ campaign_image_loading }}"
                fetchpriority="{{ campaign_image_priority }}"
                decoding="async"
              >
            </picture>
          {%- endif -%}
        </div>
        {%- if campaign_video_desktop != blank -%}
          <figcaption id="{{ media_description_id }}" class="milaura-season__media-caption">
            {{ section.settings.campaign_media_description | escape }}
          </figcaption>
        {%- endif -%}
      </figure>

      {%- if campaign_has_art -%}
        <div class="milaura-season__product-art{% if campaign_art_composite != blank %} milaura-season__product-art--composite{% endif %}" aria-hidden="true">
          {%- if campaign_art_composite != blank -%}
            <picture class="milaura-season__product-art-composite">
              <source media="(max-width: 749px)" srcset="{{ campaign_art_composite_mobile | asset_url }}">
              <img
                class="milaura-season__product-art-composite-image"
                src="{{ campaign_art_composite | asset_url }}"
                alt=""
                width="1536"
                height="1024"
                loading="{{ campaign_image_loading }}"
                fetchpriority="{{ campaign_image_priority }}"
                decoding="async"
              >
            </picture>
          {%- endif -%}
          {%- if campaign_art_primary != blank -%}
            <img
              class="milaura-season__product-art-item milaura-season__product-art-item--primary"
              src="{{ campaign_art_primary | asset_url }}"
              alt=""
              width="1024"
              height="1536"
              loading="{{ campaign_image_loading }}"
              fetchpriority="{{ campaign_image_priority }}"
              decoding="async"
            >
          {%- endif -%}
          {%- if campaign_art_accent != blank -%}
            <picture class="milaura-season__product-art-accent">
              {%- if campaign_art_accent_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ campaign_art_accent_mobile | asset_url }}">
              {%- endif -%}
              <img
                class="milaura-season__product-art-accent-image"
                src="{{ campaign_art_accent | asset_url }}"
                alt=""
                width="1536"
                height="1024"
                loading="{{ campaign_image_loading }}"
                fetchpriority="{{ campaign_image_priority }}"
                decoding="async"
              >
            </picture>
          {%- endif -%}
          {%- if campaign_art_secondary != blank -%}
            <img
              class="milaura-season__product-art-item milaura-season__product-art-item--secondary"
              src="{{ campaign_art_secondary | asset_url }}"
              alt=""
              width="1254"
              height="1254"
              loading="{{ campaign_image_loading }}"
              fetchpriority="{{ campaign_image_priority }}"
              decoding="async"
            >
          {%- endif -%}
          {%- if campaign_art_tertiary != blank -%}
            <img
              class="milaura-season__product-art-item milaura-season__product-art-item--tertiary"
              src="{{ campaign_art_tertiary | asset_url }}"
              alt=""
              width="1000"
              height="1250"
              loading="{{ campaign_image_loading }}"
              fetchpriority="{{ campaign_image_priority }}"
              decoding="async"
            >
          {%- endif -%}
          {%- if campaign_art_quaternary != blank -%}
            <img
              class="milaura-season__product-art-item milaura-season__product-art-item--quaternary"
              src="{{ campaign_art_quaternary | asset_url }}"
              alt=""
              width="1000"
              height="1000"
              loading="{{ campaign_image_loading }}"
              fetchpriority="{{ campaign_image_priority }}"
              decoding="async"
            >
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="milaura-season__copy">
        <div class="milaura-season__lead">
          {%- if section.settings.campaign_eyebrow != blank -%}
            <p class="milaura-season__eyebrow milaura-section-label">{{ section.settings.campaign_eyebrow | escape }}</p>
          {%- endif -%}

          <{{ campaign_heading_tag }} id="{{ selection_title_id }}" class="milaura-season__title milaura-section-title">
            <span class="milaura-season__title-main">{{ section.settings.campaign_title | escape }}</span>
            {%- if section.settings.campaign_title_secondary != blank -%}
              <span class="milaura-season__title-secondary">{{ section.settings.campaign_title_secondary | escape }}</span>
            {%- endif -%}
          </{{ campaign_heading_tag }}>
        </div>

        {%- if section.settings.campaign_description != blank -%}
          <div class="milaura-season__description">{{ section.settings.campaign_description }}</div>
        {%- endif -%}

        <div class="milaura-season__actions">
          {%- if section.settings.selection_cta_label != blank and section.settings.selection_cta_link != blank -%}
            <a class="milaura-season__cta milaura-action milaura-action--editorial" href="{{ section.settings.selection_cta_link }}">
              <span>{{ section.settings.selection_cta_label | escape }}</span>
              {% render 'milaura-action-icon' %}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if selected_count > 0 -%}
      <div class="milaura-season__more">
        <h3 class="milaura-season__more-title">{{ section.settings.more_products_title | escape }}</h3>
        <div class="milaura-season__cards milaura-cards milaura-cards--editorial" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <div class="milaura-season__card" role="listitem" {{ block.shopify_attributes }}>
                {% render 'milaura-card-product',
                  card_product: product,
                  img_loading: 'lazy',
                  show_vendor: false,
                  show_badges: section.settings.show_badges,
                  show_secondary_image: true,
                  force_bestseller_badge: false
                %}
                {% render 'milaura-editorial-purchase', product: product %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sélection saisonnière",
  "tag": "section",
  "class": "section-milaura-selection-atelier",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "homepage_selection_anchor",
      "label": "Cible du CTA de la page d'accueil",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "homepage_hero",
      "label": "Utiliser comme hero de la page d'accueil",
      "default": false
    },
    {
      "type": "text",
      "id": "campaign_eyebrow",
      "label": "Sur-titre de campagne",
      "default": "La sélection de Karine"
    },
    {
      "type": "text",
      "id": "campaign_title",
      "label": "Accroche principale",
      "default": "La sélection du moment"
    },
    {
      "type": "text",
      "id": "campaign_title_secondary",
      "label": "Accroche secondaire",
      "default": "Les choix de Karine"
    },
    {
      "type": "richtext",
      "id": "campaign_description",
      "label": "Texte de campagne",
      "default": "<p>Découvrez les produits choisis ce mois-ci par Karine.</p>"
    },
    {
      "type": "text",
      "id": "campaign_video",
      "label": "Vidéo desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_poster",
      "label": "Poster desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_video_mobile",
      "label": "Vidéo mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_poster_mobile",
      "label": "Poster mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_media_description",
      "label": "Description accessible du média",
      "default": "Présentation portée du produit vedette de la sélection"
    },
    {
      "type": "text",
      "id": "campaign_art_composite",
      "label": "Composition bijoux desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_composite_mobile",
      "label": "Composition bijoux mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_accent",
      "label": "Accent suspendu desktop dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_accent_mobile",
      "label": "Accent suspendu mobile dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_primary",
      "label": "Produit principal dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_secondary",
      "label": "Produit secondaire dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_tertiary",
      "label": "Troisième produit dans les assets"
    },
    {
      "type": "text",
      "id": "campaign_art_quaternary",
      "label": "Quatrième produit dans les assets"
    },
    {
      "type": "text",
      "id": "selection_cta_label",
      "label": "CTA de la sélection",
      "default": "Découvrir la sélection"
    },
    {
      "type": "url",
      "id": "selection_cta_link",
      "label": "Lien de la sélection"
    },
    {
      "type": "text",
      "id": "more_products_title",
      "label": "Titre des produits complémentaires",
      "default": "Dans la même sélection"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Afficher les badges produit",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit complémentaire",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sélection saisonnière"
    }
  ]
}
{% endschema %}
