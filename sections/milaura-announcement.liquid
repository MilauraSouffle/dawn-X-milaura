{%- liquid
  assign announcement_statement = section.settings.statement | strip
  assign announcement_statement_mobile = section.settings.statement_mobile | strip
  assign announcement_service = section.settings.service | strip

  if announcement_statement == blank or announcement_statement == 'Karine choisit chaque pièce et prépare chaque commande à Metz.' or announcement_statement == 'Pierres naturelles sélectionnées avec exigence. Service humain avant et après votre achat.'
    assign announcement_statement = 'Pierres choisies avec exigence. Conseils humains 6j/7.'
  endif

  if announcement_statement_mobile == blank or announcement_statement_mobile == 'Pierres sélectionnées avec exigence. Service humain avant et après l’achat.'
    assign announcement_statement_mobile = 'Pierres choisies avec exigence. Conseils humains 6j/7.'
  endif

  if announcement_service == blank or announcement_service == 'Pierres naturelles · Bijoux · Conseil avant et après l’achat' or announcement_service == 'Équipe disponible 6j/7 · Commandes préparées et expédiées depuis notre atelier à Metz'
    assign announcement_service = 'Commandes préparées et expédiées depuis notre atelier à Metz.'
  endif
-%}

{% style %}
  :root {
    --milaura-announcement-height: 48px;
  }

  #MilauraAnnouncement-{{ section.id }} {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000001;
    display: flex;
    height: var(--milaura-announcement-height);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: var(--milaura-filet-mineral);
    color: var(--milaura-prune);
    background: var(--milaura-nacre);
    font-family: var(--milaura-font-texte);
  }

  body {
    padding-top: var(--milaura-announcement-height);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
    display: flex;
    width: min(100%, 1640px);
    min-width: 0;
    align-items: center;
    justify-content: center;
    padding: var(--milaura-esp-2xs) 32px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.085em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mark {
    width: 26px;
    height: 1px;
    flex: 0 0 auto;
    margin-right: 14px;
    background: var(--milaura-or);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
    margin: 0;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-mobile {
    display: none;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    display: inline-flex;
    align-items: center;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service::before {
    width: 1px;
    height: 14px;
    margin: 0 18px;
    background: var(--milaura-prune);
    content: '';
    opacity: 0.22;
  }

  @media screen and (max-width: 820px) {
    :root {
      --milaura-announcement-height: 52px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      padding: 7px 10px;
      font-size: 8.5px;
      letter-spacing: 0.035em;
      white-space: nowrap;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mark,
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-desktop,
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-mobile {
      display: inline;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 360px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      font-size: 8px;
      letter-spacing: 0.025em;
    }
  }
{% endstyle %}

<aside id="MilauraAnnouncement-{{ section.id }}" aria-label="Engagement MilAura">
  <div class="milaura-announcement__inner">
    <span class="milaura-announcement__mark" aria-hidden="true"></span>
    <p class="milaura-announcement__statement">
      <span class="milaura-announcement__statement-desktop">{{ announcement_statement | escape }}</span>
      <span class="milaura-announcement__statement-mobile">{{ announcement_statement_mobile | escape }}</span>
    </p>
    <span class="milaura-announcement__service">{{ announcement_service | escape }}</span>
  </div>
</aside>

{% schema %}
{
  "name": "Signature MilAura",
  "settings": [
    {
      "type": "text",
      "id": "statement",
      "label": "Promesse",
      "default": "Pierres choisies avec exigence. Conseils humains 6j/7."
    },
    {
      "type": "text",
      "id": "statement_mobile",
      "label": "Promesse sur mobile",
      "default": "Pierres choisies avec exigence. Conseils humains 6j/7."
    },
    {
      "type": "text",
      "id": "service",
      "label": "Détail sur ordinateur",
      "default": "Commandes préparées et expédiées depuis notre atelier à Metz."
    }
  ],
  "presets": [
    {
      "name": "Signature MilAura"
    }
  ]
}
{% endschema %}
