{%- liquid
  assign announcement_eyebrow = section.settings.eyebrow | strip
  assign announcement_statement = section.settings.statement | strip
  assign announcement_statement_mobile = section.settings.statement_mobile | strip
  assign announcement_service = section.settings.service | strip
  assign announcement_service_mobile = section.settings.service_mobile | strip

  if announcement_eyebrow == blank or announcement_eyebrow == 'MilAura · Metz'
    assign announcement_eyebrow = 'L’engagement MilAura'
  endif

  if announcement_statement == blank or announcement_statement == 'Karine choisit chaque pièce et prépare chaque commande à Metz.'
    assign announcement_statement = 'Pierres naturelles sélectionnées avec exigence. Service humain avant et après votre achat.'
  endif

  if announcement_statement_mobile == blank
    assign announcement_statement_mobile = 'Pierres sélectionnées avec exigence. Service humain avant et après l’achat.'
  endif

  if announcement_service == blank or announcement_service == 'Pierres naturelles · Bijoux · Conseil avant et après l’achat'
    assign announcement_service = 'Équipe disponible 6j/7 · Commandes préparées et expédiées depuis notre atelier à Metz'
  endif

  if announcement_service_mobile == blank or announcement_service_mobile == 'Pierres naturelles · Bijoux · Conseil'
    assign announcement_service_mobile = 'Équipe disponible 6j/7 · Commande préparée et expédiée depuis notre atelier à Metz'
  endif
-%}

{% style %}
  :root {
    --milaura-announcement-height: max({{ section.settings.bar_height | default: 68 }}px, 88px);
  }

  #MilauraAnnouncement-{{ section.id }} {
    --announcement-aqua: {{ section.settings.background_color | default: '#dce9e7' }};
    --announcement-aqua-deep: {{ section.settings.accent_color | default: '#3f7474' }};
    --announcement-prune: {{ section.settings.text_color | default: '#2f222d' }};
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000001;
    height: var(--milaura-announcement-height);
    overflow: hidden;
    color: var(--announcement-prune);
    background: linear-gradient(104deg, #f7fbfa 0%, var(--announcement-aqua) 46%, #c7dfdc 100%);
    border-bottom: 1px solid rgba(63, 116, 116, 0.22);
    box-shadow: 0 7px 22px rgba(47, 34, 45, 0.09);
  }

  body {
    padding-top: var(--milaura-announcement-height);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
    width: min(1640px, calc(100% - 72px));
    height: 100%;
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(460px, 1.62fr) minmax(340px, 1.16fr);
    align-items: center;
    gap: clamp(24px, 3vw, 56px);
    margin: 0 auto;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
    min-width: 0;
    font-family: 'Lato', sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement,
  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    margin: 0;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
    max-width: 46ch;
    justify-self: center;
    font-family: 'MilAura Gloock', 'Playfair Display', serif;
    font-size: clamp(1.08rem, 1.25vw, 1.28rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.16;
    text-align: center;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    max-width: 48ch;
    justify-self: end;
    color: var(--announcement-aqua-deep);
    font-family: 'Lato', sans-serif;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.28;
    text-align: right;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-mobile,
  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-mobile {
    display: none;
  }

  @media screen and (min-width: 990px) and (max-width: 1199px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 48px);
      grid-template-columns: minmax(0, 1.25fr) minmax(310px, 1fr);
      gap: 28px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      justify-self: start;
      font-size: 1.05rem;
      text-align: left;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      font-size: 0.82rem;
    }
  }

  @media screen and (max-width: 989px) {
    :root {
      --milaura-announcement-height: 108px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 28px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      padding: 9px 0;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
      display: block;
      font-size: 0.64rem;
      letter-spacing: 0.12em;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      width: min(100%, 42ch);
      font-size: clamp(0.98rem, 4.1vw, 1.08rem);
      line-height: 1.14;
      text-align: center;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      max-width: 48ch;
      justify-self: auto;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      line-height: 1.18;
      text-align: center;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-desktop,
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-desktop {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement-mobile,
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-mobile {
      display: inline;
    }
  }

  @media screen and (max-width: 420px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 20px);
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      font-size: 0.98rem;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      font-size: 0.76rem;
    }
  }
{% endstyle %}

<aside id="MilauraAnnouncement-{{ section.id }}" aria-label="Les engagements MilAura">
  <div class="milaura-announcement__inner">
    <span class="milaura-announcement__identity">
      {{ announcement_eyebrow | escape }}
    </span>
    <p class="milaura-announcement__statement">
      <span class="milaura-announcement__statement-desktop">{{ announcement_statement | escape }}</span>
      <span class="milaura-announcement__statement-mobile">{{ announcement_statement_mobile | escape }}</span>
    </p>
    <p class="milaura-announcement__service">
      <span class="milaura-announcement__service-desktop">{{ announcement_service | escape }}</span>
      <span class="milaura-announcement__service-mobile">{{ announcement_service_mobile | escape }}</span>
    </p>
  </div>
</aside>

{% schema %}
{
  "name": "Signature MilAura",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Signature",
      "default": "L’engagement MilAura"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Activité et exigence",
      "default": "Pierres naturelles sélectionnées avec exigence. Service humain avant et après votre achat."
    },
    {
      "type": "text",
      "id": "statement_mobile",
      "label": "Activité et exigence sur mobile",
      "default": "Pierres sélectionnées avec exigence. Service humain avant et après l’achat."
    },
    {
      "type": "text",
      "id": "service",
      "label": "Qualité de service",
      "default": "Équipe disponible 6j/7 · Commandes préparées et expédiées depuis notre atelier à Metz"
    },
    {
      "type": "text",
      "id": "service_mobile",
      "label": "Qualité de service sur mobile",
      "default": "Équipe disponible 6j/7 · Commande préparée et expédiée depuis notre atelier à Metz"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond aigue-marine",
      "default": "#dce9e7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Aigue-marine profonde",
      "default": "#3f7474"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte prune",
      "default": "#2f222d"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Hauteur de la signature",
      "min": 60,
      "max": 76,
      "step": 2,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Signature MilAura"
    }
  ]
}
{% endschema %}
