{% style %}
  :root {
    --milaura-announcement-height: {{ section.settings.bar_height | default: 68 }}px;
  }

  #MilauraAnnouncement-{{ section.id }} {
    --announcement-aqua: {{ section.settings.background_color | default: '#dce9e7' }};
    --announcement-aqua-deep: {{ section.settings.accent_color | default: '#3f7474' }};
    --announcement-prune: {{ section.settings.text_color | default: '#2f222d' }};
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000001;
    height: var(--milaura-announcement-height);
    overflow: hidden;
    color: var(--announcement-prune);
    background: linear-gradient(104deg, #f7fbfa 0%, var(--announcement-aqua) 46%, #c7dfdc 100%);
    border-bottom: 1px solid rgba(63, 116, 116, 0.22);
    box-shadow: 0 7px 22px rgba(47, 34, 45, 0.09);
  }

  body {
    padding-top: var(--milaura-announcement-height);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
    width: min(1520px, calc(100% - 64px));
    height: 100%;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) minmax(460px, 1.8fr) minmax(240px, 1fr);
    align-items: center;
    gap: clamp(24px, 3.5vw, 64px);
    margin: 0 auto;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
    min-width: 0;
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1;
    text-transform: uppercase;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement,
  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    margin: 0;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
    font-family: 'MilAura Gloock', 'Playfair Display', serif;
    font-size: clamp(1.12rem, 1.35vw, 1.34rem);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.1;
    text-align: center;
    white-space: nowrap;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    max-width: 34ch;
    justify-self: end;
    color: var(--announcement-aqua-deep);
    font-family: 'Lato', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.015em;
    line-height: 1.35;
    text-align: right;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    :root {
      --milaura-announcement-height: 76px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 28px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      padding: 7px 0;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      width: min(100%, 35ch);
      font-size: clamp(1.02rem, 4.2vw, 1.16rem);
      line-height: 1.12;
      text-align: center;
      white-space: normal;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      max-width: none;
      justify-self: auto;
      font-size: 0.75rem;
      font-weight: 750;
      letter-spacing: 0.035em;
      line-height: 1.15;
      text-align: center;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-desktop {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service-mobile {
      display: inline;
    }
  }

  @media screen and (max-width: 420px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 20px);
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      font-size: 1.04rem;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      font-size: 0.73rem;
    }
  }
{% endstyle %}

<aside id="MilauraAnnouncement-{{ section.id }}" aria-label="L'engagement MilAura">
  <div class="milaura-announcement__inner">
    <span class="milaura-announcement__identity">
      {{ section.settings.eyebrow | default: 'MilAura · Metz' | escape }}
    </span>
    <p class="milaura-announcement__statement">
      {{ section.settings.statement | default: 'Karine choisit chaque pièce et prépare chaque commande à Metz.' | escape }}
    </p>
    <p class="milaura-announcement__service">
      <span class="milaura-announcement__service-desktop">
        {{ section.settings.service | default: 'Pierres naturelles · Bijoux · Conseil avant et après l’achat' | escape }}
      </span>
      <span class="milaura-announcement__service-mobile">
        {{ section.settings.service_mobile | default: 'Pierres naturelles · Bijoux · Conseil' | escape }}
      </span>
    </p>
  </div>
</aside>

{% schema %}
{
  "name": "Signature MilAura",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Signature",
      "default": "MilAura · Metz"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Activité et exigence",
      "default": "Karine choisit chaque pièce et prépare chaque commande à Metz."
    },
    {
      "type": "text",
      "id": "service",
      "label": "Qualité de service",
      "default": "Pierres naturelles · Bijoux · Conseil avant et après l’achat"
    },
    {
      "type": "text",
      "id": "service_mobile",
      "label": "Qualité de service sur mobile",
      "default": "Pierres naturelles · Bijoux · Conseil"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond aigue-marine",
      "default": "#dce9e7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Aigue-marine profonde",
      "default": "#3f7474"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte prune",
      "default": "#2f222d"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Hauteur de la signature",
      "min": 60,
      "max": 76,
      "step": 2,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "Signature MilAura"
    }
  ]
}
{% endschema %}
