{% style %}
  :root {
    --milaura-announcement-height: {{ section.settings.bar_height | default: 50 }}px;
  }

  #MilauraAnnouncement-{{ section.id }} {
    --announcement-nacre: #fbf8f3;
    --announcement-aqua: {{ section.settings.background_color | default: '#dce9e7' }};
    --announcement-aqua-deep: {{ section.settings.accent_color | default: '#3f7474' }};
    --announcement-prune: {{ section.settings.text_color | default: '#2f222d' }};
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000001;
    height: var(--milaura-announcement-height);
    overflow: hidden;
    color: var(--announcement-prune);
    background:
      radial-gradient(circle at 11% 50%, rgba(255, 255, 255, 0.72) 0 3px, transparent 4px),
      radial-gradient(circle at 88% 18%, rgba(63, 116, 116, 0.12) 0 1px, transparent 2px),
      linear-gradient(104deg, #f7fbfa 0%, var(--announcement-aqua) 38%, #cde4e1 100%);
    border-bottom: 1px solid rgba(63, 116, 116, 0.22);
    box-shadow: 0 5px 18px rgba(47, 34, 45, 0.08);
    isolation: isolate;
  }

  #MilauraAnnouncement-{{ section.id }}::before,
  #MilauraAnnouncement-{{ section.id }}::after {
    content: '';
    position: absolute;
    z-index: -1;
    border: 1px solid rgba(63, 116, 116, 0.2);
    border-radius: 49% 51% 44% 56% / 57% 43% 57% 43%;
    pointer-events: none;
  }

  #MilauraAnnouncement-{{ section.id }}::before {
    top: -44px;
    left: clamp(10px, 4vw, 72px);
    width: 98px;
    height: 98px;
    transform: rotate(18deg);
  }

  #MilauraAnnouncement-{{ section.id }}::after {
    right: clamp(10px, 5vw, 88px);
    bottom: -56px;
    width: 118px;
    height: 118px;
    border-color: rgba(73, 50, 70, 0.11);
    transform: rotate(-13deg);
  }

  body {
    padding-top: var(--milaura-announcement-height);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
    width: min(1440px, calc(100% - 48px));
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 3vw, 54px);
    margin: 0 auto;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: max-content;
    font-family: 'Lato', sans-serif;
    font-size: 0.69rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1;
    text-transform: uppercase;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral {
    position: relative;
    width: 22px;
    height: 22px;
    display: block;
    flex: 0 0 auto;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral::before,
  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral::after {
    content: '';
    position: absolute;
    border: 1px solid;
    pointer-events: none;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral::before {
    inset: 2px 5px 3px 3px;
    border-color: rgba(63, 116, 116, 0.84);
    border-radius: 47% 53% 44% 56% / 56% 45% 55% 44%;
    transform: rotate(-12deg);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral::after {
    inset: 5px 2px 1px 6px;
    border-color: rgba(73, 50, 70, 0.48);
    border-radius: 53% 47% 56% 44% / 44% 56% 48% 52%;
    transform: rotate(11deg);
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement,
  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    margin: 0;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
    overflow: hidden;
    font-family: 'MilAura Gloock', 'Playfair Display', serif;
    font-size: clamp(0.94rem, 1.1vw, 1.08rem);
    font-weight: 400;
    letter-spacing: -0.012em;
    line-height: 1.2;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
    min-width: max-content;
    color: var(--announcement-aqua-deep);
    font-family: 'Lato', sans-serif;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.095em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: min(100% - 28px, 760px);
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'identity statement'
        'service service';
      column-gap: 14px;
      row-gap: 2px;
      padding: 6px 0 5px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
      grid-area: identity;
      font-size: 0.59rem;
      letter-spacing: 0.1em;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral {
      width: 18px;
      height: 18px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      grid-area: statement;
      font-family: 'Lato', sans-serif;
      font-size: 0.68rem;
      font-weight: 760;
      letter-spacing: 0.01em;
      text-align: right;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      grid-area: service;
      min-width: 0;
      font-size: 0.57rem;
      letter-spacing: 0.08em;
      text-align: center;
    }
  }

  @media screen and (max-width: 420px) {
    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__inner {
      width: calc(100% - 20px);
      column-gap: 9px;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__identity {
      font-size: 0.54rem;
      letter-spacing: 0.075em;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__mineral {
      display: none;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__statement {
      font-size: 0.62rem;
    }

    #MilauraAnnouncement-{{ section.id }} .milaura-announcement__service {
      font-size: 0.53rem;
    }
  }
{% endstyle %}

<aside id="MilauraAnnouncement-{{ section.id }}" aria-label="L'engagement MilAura">
  <div class="milaura-announcement__inner">
    <span class="milaura-announcement__identity">
      <span class="milaura-announcement__mineral" aria-hidden="true"></span>
      <span>{{ section.settings.eyebrow | default: 'MilAura · Metz' | escape }}</span>
    </span>
    <p class="milaura-announcement__statement">
      {{ section.settings.statement | default: 'Bijoux, pierres naturelles et rituels sélectionnés avec exigence' | escape }}
    </p>
    <p class="milaura-announcement__service">
      {{ section.settings.service | default: 'Conseil attentionné · préparation soignée' | escape }}
    </p>
  </div>
</aside>

{% schema %}
{
  "name": "Signature MilAura",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Signature",
      "default": "MilAura · Metz"
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Activité et exigence",
      "default": "Bijoux, pierres naturelles et rituels sélectionnés avec exigence"
    },
    {
      "type": "text",
      "id": "service",
      "label": "Qualité de service",
      "default": "Conseil attentionné · préparation soignée"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fond aigue-marine",
      "default": "#dce9e7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Aigue-marine profonde",
      "default": "#3f7474"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte prune",
      "default": "#2f222d"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Hauteur de la signature",
      "min": 46,
      "max": 58,
      "step": 2,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Signature MilAura"
    }
  ]
}
{% endschema %}
