{%- liquid
  assign proof_interval = section.settings.rotation_speed | default: 6 | times: 1000
  assign certificate_url = section.settings.certificate_link
  assign karine_url = section.settings.karine_link
  assign rewards_url = section.settings.rewards_link

  if certificate_url == blank
    assign certificate_url = '/pages/contact-milaura?view=milaura-certificats'
  endif
  if karine_url == blank
    assign karine_url = '/collections/selection-de-karine'
  endif
  if rewards_url == blank
    assign rewards_url = routes.cart_url
  endif
-%}

{% style %}
  :root {
    --milaura-announcement-height: 40px;
  }

  body {
    padding-top: var(--milaura-announcement-height);
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 1000001;
  }

  #MilauraTrustTicker-{{ section.id }} {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000001;
    height: var(--milaura-announcement-height);
    overflow: hidden;
    border-bottom: var(--milaura-filet-or);
    color: var(--milaura-prune);
    background: var(--milaura-quartz-rose-poudre);
    font-family: var(--milaura-font-texte);
  }

  #MilauraTrustTicker-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__inner {
    width: min(100%, 1440px);
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px;
    align-items: stretch;
    margin-inline: auto;
    padding-left: clamp(14px, 3vw, 40px);
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__stage {
    position: relative;
    min-width: 0;
    height: 100%;
    touch-action: pan-y;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide {
    position: absolute;
    inset: 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    visibility: hidden;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--milaura-transition-rapide),
      transform var(--milaura-transition-rapide),
      visibility 0s linear var(--milaura-transition-rapide);
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide.is-active {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__copy {
    min-width: 0;
    overflow: hidden;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.015em;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__copy--mobile {
    display: none;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__link-icon {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;
    color: var(--milaura-amethyste-profonde);
    transition: transform var(--milaura-transition-rapide);
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide:hover .milaura-trust-ticker__link-icon,
  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide:focus-visible .milaura-trust-ticker__link-icon {
    transform: translateX(3px);
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide:focus-visible,
  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next:focus-visible {
    outline: var(--milaura-focus);
    outline-offset: -4px;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next {
    width: 44px;
    min-height: 40px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-left: var(--milaura-filet-mineral);
    color: var(--milaura-prune);
    background: transparent;
    cursor: pointer;
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next svg {
    width: 16px;
    height: 16px;
    transition: transform var(--milaura-transition-rapide);
  }

  #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next:hover svg {
    transform: translateX(3px);
  }

  @media screen and (max-width: 749px) {
    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__inner {
      grid-template-columns: minmax(0, 1fr) 40px;
      padding-left: 10px;
    }

    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide {
      justify-content: flex-start;
      gap: 6px;
    }

    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__copy {
      font-size: clamp(10px, 2.8vw, 11.5px);
      letter-spacing: 0;
    }

    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__copy--desktop {
      display: none;
    }

    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__copy--mobile {
      display: block;
    }

    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next {
      width: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__slide,
    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__link-icon,
    #MilauraTrustTicker-{{ section.id }} .milaura-trust-ticker__next svg {
      transition: none;
    }
  }
{% endstyle %}

<aside
  id="MilauraTrustTicker-{{ section.id }}"
  class="milaura-trust-ticker"
  aria-label="Les engagements MilAura"
  data-milaura-trust-ticker
  data-rotation-interval="{{ proof_interval }}"
>
  <div class="milaura-trust-ticker__inner">
    <div class="milaura-trust-ticker__stage" data-trust-stage>
      <a
        class="milaura-trust-ticker__slide is-active"
        href="{{ certificate_url }}"
        data-trust-slide
        aria-hidden="false"
      >
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--desktop">
          Rapports d’authenticité LFG disponibles · Voir les analyses
        </span>
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--mobile">
          Rapports LFG disponibles · Voir les analyses
        </span>
        <svg class="milaura-trust-ticker__link-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
        </svg>
      </a>

      <a
        class="milaura-trust-ticker__slide"
        href="{{ karine_url }}"
        data-trust-slide
        aria-hidden="true"
        tabindex="-1"
      >
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--desktop">
          Sélectionnées par Karine, contrôlées et préparées à Metz · Découvrir sa sélection
        </span>
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--mobile">
          Choisies par Karine · Préparées à Metz
        </span>
        <svg class="milaura-trust-ticker__link-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
        </svg>
      </a>

      <a
        class="milaura-trust-ticker__slide"
        href="{{ rewards_url }}"
        data-trust-slide
        aria-hidden="true"
        tabindex="-1"
      >
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--desktop">
          30 € : livraison offerte en point relais · 50 € : un cadeau · 80 € : -15 %
        </span>
        <span class="milaura-trust-ticker__copy milaura-trust-ticker__copy--mobile">
          30 € relais offert · 50 € cadeau · 80 € -15 %
        </span>
        <svg class="milaura-trust-ticker__link-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"/>
        </svg>
      </a>
    </div>

    <button
      class="milaura-trust-ticker__next"
      type="button"
      aria-label="Afficher l’engagement suivant"
      data-trust-next
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M4 3l5 5-5 5M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"/>
      </svg>
    </button>
  </div>
</aside>

<script>
  (() => {
    const root = document.getElementById('MilauraTrustTicker-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const slides = Array.from(root.querySelectorAll('[data-trust-slide]'));
    const stage = root.querySelector('[data-trust-stage]');
    const nextButton = root.querySelector('[data-trust-next]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const interval = Number(root.dataset.rotationInterval) || 6000;
    const controller = new AbortController();
    let activeIndex = 0;
    let timer = null;
    let pointerStart = null;

    if (slides.length < 2 || !stage || !nextButton) return;

    const render = (index) => {
      activeIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        slide.tabIndex = isActive ? 0 : -1;
      });
    };

    const stop = () => {
      if (!timer) return;
      window.clearInterval(timer);
      timer = null;
    };

    const start = () => {
      stop();
      if (reducedMotion.matches || document.hidden) return;
      timer = window.setInterval(() => render(activeIndex + 1), interval);
    };

    const cartDrawer = document.querySelector('cart-drawer');
    const syncCartDrawer = () => {
      const drawerIsOpen = cartDrawer?.classList.contains('active') || false;
      root.hidden = drawerIsOpen;
      if (drawerIsOpen) stop();
      else start();
    };

    const cartDrawerObserver = cartDrawer ? new MutationObserver(syncCartDrawer) : null;
    cartDrawerObserver?.observe(cartDrawer, { attributes: true, attributeFilter: ['class'] });

    const advance = () => {
      render(activeIndex + 1);
      start();
    };

    nextButton.addEventListener('click', advance, { signal: controller.signal });
    root.addEventListener('mouseenter', stop, { signal: controller.signal });
    root.addEventListener('mouseleave', start, { signal: controller.signal });
    root.addEventListener('focusin', stop, { signal: controller.signal });
    root.addEventListener('focusout', start, { signal: controller.signal });

    stage.addEventListener('pointerdown', (event) => {
      pointerStart = event.clientX;
    }, { signal: controller.signal });

    stage.addEventListener('pointerup', (event) => {
      if (pointerStart === null) return;
      const distance = event.clientX - pointerStart;
      pointerStart = null;
      if (Math.abs(distance) < 35) return;
      render(activeIndex + (distance < 0 ? 1 : -1));
      start();
    }, { signal: controller.signal });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    }, { signal: controller.signal });

    reducedMotion.addEventListener('change', start, { signal: controller.signal });
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId !== '{{ section.id }}') return;
      stop();
      cartDrawerObserver?.disconnect();
      controller.abort();
    }, { signal: controller.signal });

    render(0);
    syncCartDrawer();
  })();
</script>

{% schema %}
{
  "name": "Bandeau de confiance",
  "settings": [
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Durée de chaque message",
      "min": 5,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "url",
      "id": "certificate_link",
      "label": "Destination des rapports"
    },
    {
      "type": "url",
      "id": "karine_link",
      "label": "Destination de la sélection de Karine"
    },
    {
      "type": "url",
      "id": "rewards_link",
      "label": "Destination des avantages panier"
    }
  ],
  "presets": [
    {
      "name": "Bandeau de confiance"
    }
  ]
}
{% endschema %}
