{%- liquid
  assign quiz_page = pages['diagnostic-emotionnel']
  assign quiz_url = section.settings.quiz_link
  if quiz_url == blank and quiz_page != blank
    assign quiz_url = quiz_page.url
  endif
  if quiz_url == blank
    assign quiz_url = '/pages/diagnostic-emotionnel'
  endif
-%}

{%- style -%}
  #MilauraChoiceDoors {
    scroll-margin-top: 150px;
  }

  #MilauraChoices-{{ section.id }} {
    --choices-prune: #2f222d;
    --choices-gold: #b9975b;
    --choices-aqua: #6fa9a6;
    --choices-aqua-soft: rgba(111, 169, 166, 0.42);
    --choices-nacre: #fffdf9;
    --choices-paper: #ffffff;
    --choices-line: rgba(47, 34, 45, 0.12);
    padding: clamp(58px, 7vw, 104px) 0 clamp(66px, 7.5vw, 112px);
    color: var(--choices-prune);
    background:
      linear-gradient(180deg, rgba(255, 253, 249, 0.7), rgba(255, 255, 255, 0) 32%),
      var(--choices-paper);
    font-family: var(--milaura-font-body, 'Lato'), sans-serif;
  }

  #MilauraChoices-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__intro {
    width: min(760px, calc(100% - 36px));
    margin: 0 auto clamp(36px, 4.5vw, 58px);
    text-align: center;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0 0 10px;
    color: var(--choices-aqua);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__kicker::before,
  #MilauraChoices-{{ section.id }} .choice-doors__kicker::after {
    content: '';
    width: 26px;
    height: 1px;
    background: currentColor;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__title {
    margin: 0;
    color: var(--choices-gold);
    font-family: var(--milaura-font-script, 'Dancing Script'), cursive;
    font-size: clamp(3rem, 5.2vw, 5rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.04;
    text-shadow: 0 2px 12px rgba(185, 151, 91, 0.12);
    text-wrap: balance;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__lead {
    max-width: 620px;
    margin: 13px auto 0;
    color: rgba(47, 34, 45, 0.72);
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1.58;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__grid {
    width: min(1540px, calc(100% - clamp(32px, 5vw, 80px)));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: 0 auto;
  }

  #MilauraChoices-{{ section.id }} .choice-door {
    position: relative;
    min-width: 0;
    min-height: 330px;
    padding: clamp(30px, 3vw, 46px);
    overflow: hidden;
    border: 1px solid var(--choices-aqua-soft);
    border-radius: 20px;
    background: var(--choices-nacre);
    box-shadow: 0 9px 26px rgba(54, 105, 103, 0.06);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--choices-aqua);
    transform: scaleX(0.34);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door:hover,
  #MilauraChoices-{{ section.id }} .choice-door:focus-within {
    border-color: var(--choices-aqua);
    box-shadow: 0 14px 34px rgba(54, 105, 103, 0.12);
    transform: translateY(-3px);
  }

  #MilauraChoices-{{ section.id }} .choice-door:hover::before,
  #MilauraChoices-{{ section.id }} .choice-door:focus-within::before,
  #MilauraChoices-{{ section.id }} .choice-door[open]::before {
    transform: scaleX(1);
  }

  #MilauraChoices-{{ section.id }} .choice-door summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 18px;
    color: var(--choices-prune);
    cursor: pointer;
    list-style: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door summary::-webkit-details-marker {
    display: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door__eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--choices-aqua);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #MilauraChoices-{{ section.id }} .choice-door__title {
    display: block;
    color: var(--choices-prune);
    font-family: var(--milaura-font-heading, 'Playfair Display'), serif;
    font-size: clamp(1.9rem, 2.35vw, 2.7rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.06;
    text-wrap: balance;
  }

  #MilauraChoices-{{ section.id }} .choice-door__toggle {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 1px solid rgba(185, 151, 91, 0.6);
    border-radius: 50%;
    color: var(--choices-gold);
    background: var(--choices-paper);
    font-size: 1rem;
    line-height: 1;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door[open] .choice-door__toggle {
    color: var(--choices-paper);
    background: var(--choices-gold);
    transform: rotate(45deg);
  }

  #MilauraChoices-{{ section.id }} .choice-door__content {
    margin-top: 28px;
  }

  #MilauraChoices-{{ section.id }} .choice-door__description {
    max-width: 36ch;
    margin: 0 0 22px;
    color: rgba(47, 34, 45, 0.68);
    font-size: 1rem;
    line-height: 1.58;
  }

  #MilauraChoices-{{ section.id }} .choice-door__links {
    display: flex;
    flex-wrap: wrap;
    gap: 11px 20px;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    color: var(--choices-prune);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: var(--choices-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link:hover::after,
  #MilauraChoices-{{ section.id }} .choice-door__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 10px 12px 10px 23px;
    border: 1px solid rgba(185, 151, 91, 0.74);
    border-radius: 999px;
    color: var(--choices-nacre);
    background: var(--choices-prune);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(47, 34, 45, 0.14);
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta-arrow {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    color: var(--choices-prune);
    background: var(--choices-gold);
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta:hover .choice-door__cta-arrow {
    transform: translateX(3px);
  }

  #MilauraChoices-{{ section.id }} .choice-door summary:focus-visible,
  #MilauraChoices-{{ section.id }} .choice-door__link:focus-visible,
  #MilauraChoices-{{ section.id }} .choice-door__cta:focus-visible {
    outline: 2px solid var(--choices-aqua);
    outline-offset: 5px;
  }

  @media screen and (min-width: 768px) {
    #MilauraChoices-{{ section.id }} .choice-door summary {
      cursor: default;
    }

    #MilauraChoices-{{ section.id }} .choice-door[open] > .choice-door__content {
      display: block;
    }

    #MilauraChoices-{{ section.id }} .choice-door__toggle {
      display: none;
    }
  }

  @media screen and (max-width: 980px) and (min-width: 768px) {
    #MilauraChoices-{{ section.id }} .choice-doors__grid {
      width: calc(100% - 48px);
      gap: 14px;
    }

    #MilauraChoices-{{ section.id }} .choice-door {
      padding: 28px 24px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__title {
      font-size: 1.75rem;
    }
  }

  @media screen and (max-width: 767px) {
    #MilauraChoiceDoors {
      scroll-margin-top: 112px;
    }

    #MilauraChoices-{{ section.id }} {
      padding: 48px 0 72px;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__intro {
      margin-bottom: 30px;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__kicker {
      margin-bottom: 8px;
      font-size: 0.7rem;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__kicker::before,
    #MilauraChoices-{{ section.id }} .choice-doors__kicker::after {
      width: 20px;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__title {
      font-size: clamp(2.6rem, 12vw, 3.55rem);
    }

    #MilauraChoices-{{ section.id }} .choice-doors__lead {
      margin-top: 11px;
      font-size: 1rem;
      line-height: 1.55;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__grid {
      width: calc(100% - 32px);
      display: block;
    }

    #MilauraChoices-{{ section.id }} .choice-door {
      min-height: 0;
      padding: 22px 20px;
      border-radius: 16px;
      transform: none;
    }

    #MilauraChoices-{{ section.id }} .choice-door + .choice-door {
      margin-top: 12px;
    }

    #MilauraChoices-{{ section.id }} .choice-door:hover,
    #MilauraChoices-{{ section.id }} .choice-door:focus-within {
      transform: none;
    }

    #MilauraChoices-{{ section.id }} .choice-door__eyebrow {
      margin-bottom: 5px;
      font-size: 0.69rem;
    }

    #MilauraChoices-{{ section.id }} .choice-door__title {
      font-size: 1.55rem;
    }

    #MilauraChoices-{{ section.id }} .choice-door__toggle {
      width: 32px;
      height: 32px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__content {
      padding-bottom: 3px;
      margin-top: 18px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__description {
      margin-bottom: 15px;
      font-size: 1rem;
    }

    #MilauraChoices-{{ section.id }} .choice-door__links {
      gap: 9px 18px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__link {
      min-height: 32px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__cta {
      min-height: 48px;
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraChoices-{{ section.id }} .choice-door,
    #MilauraChoices-{{ section.id }} .choice-door::before,
    #MilauraChoices-{{ section.id }} .choice-door__toggle,
    #MilauraChoices-{{ section.id }} .choice-door__link::after,
    #MilauraChoices-{{ section.id }} .choice-door__cta,
    #MilauraChoices-{{ section.id }} .choice-door__cta-arrow {
      transition: none;
    }
  }
{%- endstyle -%}

<section id="MilauraChoiceDoors" aria-labelledby="MilauraChoicesTitle-{{ section.id }}">
  <div id="MilauraChoices-{{ section.id }}" class="milaura-choice-doors">
    <div class="choice-doors__intro">
      <p class="choice-doors__kicker">{{ section.settings.kicker | default: 'Besoin d’un peu d’aide ?' }}</p>
      <h2 id="MilauraChoicesTitle-{{ section.id }}" class="choice-doors__title">
        {{ section.settings.title | default: 'Comment souhaitez-vous choisir ?' }}
      </h2>
      <p class="choice-doors__lead">
        {{ section.settings.lead | default: 'Si aucun coup de cœur ne s’est encore imposé, explorez par bijou, par besoin ou avec les conseils de Karine.' }}
      </p>
    </div>

    <nav class="choice-doors__grid" aria-label="Choisir votre parcours MilAura">
      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Par type de création</span>
            <span class="choice-door__title">Choisir mon bijou</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je sais déjà ce que j’ai envie de porter.</p>
          <div class="choice-door__links">
            <a class="choice-door__link" href="{{ routes.collections_url }}/bracelets-pierres">Bracelets</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/colliers-pierres">Colliers</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/boucles-oreilles">Boucles d’oreilles</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/pendentifs">Pendentifs</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/bijoux-pierres-naturelles">Tous les bijoux</a>
          </div>
        </div>
      </details>

      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Selon votre besoin du moment</span>
            <span class="choice-door__title">Choisir selon mon besoin</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je pars de ce que je ressens aujourd’hui.</p>
          <div class="choice-door__links">
            <a class="choice-door__link" href="{{ routes.collections_url }}/serenite-sommeil">Sérénité</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/protection-energie">Protection</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/amour-relations">Amour &amp; confiance</a>
            <a class="choice-door__link" href="#MilauraBenefits-milaura_benefits_explorer_XxAi7N">Tous les besoins</a>
          </div>
        </div>
      </details>

      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Avec les conseils de Karine</span>
            <span class="choice-door__title">Me laisser guider</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je réponds à quelques questions pour découvrir les pierres qui correspondent à mon besoin actuel.</p>
          <a class="choice-door__cta" href="{{ quiz_url }}">
            <span>Faire le diagnostic</span>
            <span class="choice-door__cta-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </details>
    </nav>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('MilauraChoices-{{ section.id }}');
    if (!root) return;

    const doors = Array.from(root.querySelectorAll('.choice-door'));
    const mobileQuery = window.matchMedia('(max-width: 767px)');

    doors.forEach((door) => {
      const summary = door.querySelector('summary');
      summary?.addEventListener('click', (event) => {
        if (!mobileQuery.matches) event.preventDefault();
      });

      door.addEventListener('toggle', () => {
        if (!mobileQuery.matches || !door.open) return;
        doors.forEach((otherDoor) => {
          if (otherDoor !== door) otherDoor.removeAttribute('open');
        });
      });
    });

    const syncDoors = (isMobile) => {
      doors.forEach((door, index) => {
        if (isMobile) {
          door.toggleAttribute('open', index === 0);
        } else {
          door.setAttribute('open', '');
        }
      });
    };

    syncDoors(mobileQuery.matches);
    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', (event) => syncDoors(event.matches));
    } else {
      mobileQuery.addListener((event) => syncDoors(event.matches));
    }
  })();
</script>

{% schema %}
{
  "name": "Portes de découverte",
  "tag": "section",
  "class": "milaura-choice-doors-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Surtitre",
      "default": "Besoin d’un peu d’aide ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Comment souhaitez-vous choisir ?"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Si aucun coup de cœur ne s’est encore imposé, explorez par bijou, par besoin ou avec les conseils de Karine."
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Lien du diagnostic"
    }
  ],
  "presets": [
    {
      "name": "Portes de découverte"
    }
  ]
}
{% endschema %}
