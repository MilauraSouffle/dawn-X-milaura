{%- liquid
  assign quiz_page = pages['diagnostic-emotionnel']
  assign quiz_url = section.settings.quiz_link
  if quiz_url == blank and quiz_page != blank
    assign quiz_url = quiz_page.url
  endif
  if quiz_url == blank
    assign quiz_url = '/pages/diagnostic-emotionnel'
  endif
-%}

{%- style -%}
  @font-face {
    font-family: 'MilAura Gloock';
    src: url('{{ 'milaura-gloock-regular.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'MilAura Instrument';
    src: url('{{ 'milaura-instrument-sans-variable.ttf' | asset_url }}') format('truetype-variations');
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
  }

  #MilauraChoices-{{ section.id }} {
    --choices-nacre: #fbf8f3;
    --choices-paper: #fffdf9;
    --choices-ink: #2f222d;
    --choices-gold: #b9975b;
    --choices-aqua: #6fa9a6;
    --choices-aqua-soft: #dce9e7;
    --choices-quartz-soft: #eee0dd;
    color: var(--choices-ink);
    background: var(--choices-paper);
    font-family: 'MilAura Instrument', sans-serif;
    scroll-margin-top: 150px;
  }

  #MilauraChoiceDoors {
    scroll-margin-top: 150px;
  }

  #MilauraChoices-{{ section.id }} * {
    box-sizing: border-box;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__intro {
    width: min(100%, 1400px);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    align-items: end;
    gap: 40px;
    margin: 0 auto;
    padding: clamp(72px, 7vw, 112px) clamp(28px, 5vw, 72px) clamp(38px, 4vw, 58px);
  }

  #MilauraChoices-{{ section.id }} .choice-doors__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    color: var(--choices-aqua);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__kicker::before {
    content: '';
    width: 30px;
    height: 1px;
    background: currentColor;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__title {
    max-width: 13ch;
    margin: 0;
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(3.3rem, 5.2vw, 6.2rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
    text-wrap: balance;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__lead {
    max-width: 43ch;
    margin: 0 0 8px auto;
    color: rgba(47, 34, 45, 0.68);
    font-size: clamp(1.0625rem, 1.1vw, 1.125rem);
    line-height: 1.58;
  }

  #MilauraChoices-{{ section.id }} .choice-doors__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(47, 34, 45, 0.14);
    border-bottom: 1px solid rgba(47, 34, 45, 0.14);
    background: var(--choices-nacre);
  }

  #MilauraChoices-{{ section.id }} .choice-door {
    min-width: 0;
    min-height: 330px;
    padding: clamp(34px, 3.5vw, 58px) clamp(28px, 3.5vw, 56px) 36px;
    border-right: 1px solid rgba(47, 34, 45, 0.13);
    transition: background-color 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door:last-child {
    border-right: 0;
  }

  #MilauraChoices-{{ section.id }} .choice-door:nth-child(2) {
    background: rgba(220, 233, 231, 0.46);
  }

  #MilauraChoices-{{ section.id }} .choice-door:nth-child(3) {
    background: rgba(238, 224, 221, 0.34);
  }

  #MilauraChoices-{{ section.id }} .choice-door:hover,
  #MilauraChoices-{{ section.id }} .choice-door:focus-within {
    background: var(--choices-paper);
  }

  #MilauraChoices-{{ section.id }} .choice-door summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 18px;
    color: var(--choices-ink);
    cursor: pointer;
    list-style: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door summary::-webkit-details-marker {
    display: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--choices-aqua);
    font-size: 0.75rem;
    font-weight: 720;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #MilauraChoices-{{ section.id }} .choice-door__title {
    display: block;
    font-family: 'MilAura Gloock', serif;
    font-size: clamp(2rem, 2.6vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  #MilauraChoices-{{ section.id }} .choice-door__toggle {
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(47, 34, 45, 0.2);
    border-radius: 50%;
    font-size: 1rem;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door[open] .choice-door__toggle {
    background: var(--choices-aqua-soft);
    transform: rotate(45deg);
  }

  #MilauraChoices-{{ section.id }} .choice-door__content {
    margin-top: 28px;
  }

  #MilauraChoices-{{ section.id }} .choice-door__description {
    max-width: 34ch;
    margin: 0 0 23px;
    color: rgba(47, 34, 45, 0.65);
    font-size: 1rem;
    line-height: 1.55;
  }

  #MilauraChoices-{{ section.id }} .choice-door__links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 18px;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--choices-ink);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.4;
    text-decoration: none;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: var(--choices-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door__link:hover::after,
  #MilauraChoices-{{ section.id }} .choice-door__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 11px 18px;
    border-radius: 999px;
    color: var(--choices-paper);
    background: var(--choices-ink);
    font-size: 1rem;
    font-weight: 730;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease, background-color 180ms ease;
  }

  #MilauraChoices-{{ section.id }} .choice-door__cta:hover {
    color: var(--choices-ink);
    background: var(--choices-aqua-soft);
  }

  #MilauraChoices-{{ section.id }} .choice-door summary:focus-visible,
  #MilauraChoices-{{ section.id }} .choice-door__link:focus-visible,
  #MilauraChoices-{{ section.id }} .choice-door__cta:focus-visible {
    outline: 2px solid var(--choices-aqua);
    outline-offset: 5px;
  }

  @media screen and (min-width: 768px) {
    #MilauraChoices-{{ section.id }} .choice-door summary {
      cursor: default;
    }

    #MilauraChoices-{{ section.id }} .choice-door[open] > .choice-door__content {
      display: block;
    }

    #MilauraChoices-{{ section.id }} .choice-door__toggle {
      display: none;
    }
  }

  @media screen and (max-width: 900px) and (min-width: 768px) {
    #MilauraChoices-{{ section.id }} .choice-doors__intro {
      padding-right: 36px;
      padding-left: 36px;
    }

    #MilauraChoices-{{ section.id }} .choice-door {
      padding-right: 28px;
      padding-left: 28px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__title {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 767px) {
    #MilauraChoiceDoors,
    #MilauraChoices-{{ section.id }} {
      scroll-margin-top: 112px;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__intro {
      display: block;
      padding: 58px 20px 30px;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__kicker {
      margin-bottom: 12px;
      font-size: 0.75rem;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__title {
      max-width: 12ch;
      font-size: clamp(2.65rem, 11.2vw, 3.35rem);
      line-height: 0.96;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__lead {
      margin: 18px 0 0;
      font-size: 1rem;
      line-height: 1.55;
    }

    #MilauraChoices-{{ section.id }} .choice-doors__grid {
      display: block;
      border-bottom: 0;
    }

    #MilauraChoices-{{ section.id }} .choice-door {
      min-height: 0;
      padding: 18px 20px;
      border-right: 0;
      border-bottom: 1px solid rgba(47, 34, 45, 0.13);
    }

    #MilauraChoices-{{ section.id }} .choice-door__eyebrow {
      margin-bottom: 5px;
      font-size: 0.75rem;
    }

    #MilauraChoices-{{ section.id }} .choice-door__title {
      font-size: 1.55rem;
    }

    #MilauraChoices-{{ section.id }} .choice-door__toggle {
      width: 31px;
      height: 31px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__content {
      padding-bottom: 9px;
      margin-top: 18px;
    }

    #MilauraChoices-{{ section.id }} .choice-door__description {
      margin-bottom: 16px;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraChoices-{{ section.id }} .choice-door,
    #MilauraChoices-{{ section.id }} .choice-door__toggle,
    #MilauraChoices-{{ section.id }} .choice-door__link::after,
    #MilauraChoices-{{ section.id }} .choice-door__cta {
      transition: none;
    }
  }
{%- endstyle -%}

<section id="MilauraChoiceDoors" aria-labelledby="MilauraChoicesTitle-{{ section.id }}">
  <div id="MilauraChoices-{{ section.id }}" class="milaura-choice-doors">
    <div class="choice-doors__intro">
      <div>
        <p class="choice-doors__kicker">{{ section.settings.kicker | default: 'Besoin d’un peu d’aide ?' }}</p>
        <h2 id="MilauraChoicesTitle-{{ section.id }}" class="choice-doors__title">
          {{ section.settings.title | default: 'Comment souhaitez-vous choisir ?' }}
        </h2>
      </div>
      <p class="choice-doors__lead">
        {{ section.settings.lead | default: 'Si aucun coup de cœur ne s’est encore imposé, explorez par bijou, par besoin ou avec les conseils de Karine.' }}
      </p>
    </div>

    <nav class="choice-doors__grid" aria-label="Choisir votre parcours MilAura">
      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Par type de création</span>
            <span class="choice-door__title">Choisir mon bijou</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je sais déjà ce que j’ai envie de porter.</p>
          <div class="choice-door__links">
            <a class="choice-door__link" href="{{ routes.collections_url }}/bracelets-pierres">Bracelets</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/colliers-pierres">Colliers</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/bijoux-pierres-naturelles">Bagues</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/boucles-oreilles">Boucles d’oreilles</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/rituels-bien-etre">Rituels</a>
          </div>
        </div>
      </details>

      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Selon votre besoin du moment</span>
            <span class="choice-door__title">Choisir selon mon besoin</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je pars de ce que je ressens aujourd’hui.</p>
          <div class="choice-door__links">
            <a class="choice-door__link" href="{{ routes.collections_url }}/serenite-sommeil">Sérénité</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/protection-energie">Protection</a>
            <a class="choice-door__link" href="{{ routes.collections_url }}/amour-relations">Amour & confiance</a>
            <a class="choice-door__link" href="#MilauraBenefits-milaura_benefits_explorer_XxAi7N">Tous les besoins</a>
          </div>
        </div>
      </details>

      <details class="choice-door" open>
        <summary>
          <span>
            <span class="choice-door__eyebrow">Avec les conseils de Karine</span>
            <span class="choice-door__title">Me laisser guider</span>
          </span>
          <span class="choice-door__toggle" aria-hidden="true">+</span>
        </summary>
        <div class="choice-door__content">
          <p class="choice-door__description">Je réponds à quelques questions pour découvrir les pierres qui correspondent à mon besoin actuel.</p>
          <a class="choice-door__cta" href="{{ quiz_url }}">Faire le diagnostic <span aria-hidden="true">→</span></a>
        </div>
      </details>
    </nav>
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('MilauraChoices-{{ section.id }}');
    if (!root) return;

    const doors = Array.from(root.querySelectorAll('.choice-door'));
    const mobileQuery = window.matchMedia('(max-width: 767px)');

    doors.forEach((door) => {
      const summary = door.querySelector('summary');
      summary?.addEventListener('click', (event) => {
        if (!mobileQuery.matches) event.preventDefault();
      });
    });

    const syncDoors = (isMobile) => {
      doors.forEach((door) => {
        if (isMobile) {
          door.removeAttribute('open');
        } else {
          door.setAttribute('open', '');
        }
      });
    };

    syncDoors(mobileQuery.matches);
    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener('change', (event) => syncDoors(event.matches));
    } else {
      mobileQuery.addListener((event) => syncDoors(event.matches));
    }
  })();
</script>

{% schema %}
{
  "name": "Portes de découverte",
  "tag": "section",
  "class": "milaura-choice-doors-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Surtitre",
      "default": "Besoin d’un peu d’aide ?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Comment souhaitez-vous choisir ?"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Si aucun coup de cœur ne s’est encore imposé, explorez par bijou, par besoin ou avec les conseils de Karine."
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Lien du diagnostic"
    }
  ],
  "presets": [
    {
      "name": "Portes de découverte"
    }
  ]
}
{% endschema %}
