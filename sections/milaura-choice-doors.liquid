{{ 'milaura-choice-doors.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign quiz_page = pages['diagnostic-emotionnel']
  assign quiz_url = section.settings.quiz_link
  if quiz_url == blank and quiz_page != blank
    assign quiz_url = quiz_page.url
  endif
  if quiz_url == blank
    assign quiz_url = '/pages/diagnostic-emotionnel'
  endif

  assign quiz_asset = section.settings.quiz_asset | default: 'milaura-hero-proof-karine-v2.webp'
  assign type_count = 0
  assign emotion_count = 0
  for block in section.blocks
    if block.type == 'type_card'
      assign type_count = type_count | plus: 1
    elsif block.type == 'emotion_card'
      assign emotion_count = emotion_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  #MilauraChoiceDoors,
  #MilauraChoiceDoors-{{ section.id }} {
    scroll-margin-top: 150px;
  }

  @media screen and (max-width: 749px) {
    #MilauraChoiceDoors,
    #MilauraChoiceDoors-{{ section.id }} {
      scroll-margin-top: 112px;
    }
  }
{%- endstyle -%}

<section
  id="MilauraChoiceDoors-{{ section.id }}"
  class="milaura-choice-flow"
  aria-labelledby="MilauraChoiceTitle-{{ section.id }}"
  data-milaura-choice-flow
>
  <span id="MilauraChoiceDoors" aria-hidden="true"></span>
  <span class="milaura-choice-flow__rule milaura-choice-flow__rule--top" aria-hidden="true"></span>
  <span class="milaura-choice-flow__rule milaura-choice-flow__rule--bottom" aria-hidden="true"></span>

  <div class="milaura-choice-flow__shell">
    <header class="milaura-choice-flow__masthead milaura-choice-flow__reveal">
      {%- if section.settings.kicker != blank -%}
        <p class="milaura-choice-flow__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 id="MilauraChoiceTitle-{{ section.id }}" class="milaura-choice-flow__title">
        {{ section.settings.title | escape }}
        {%- if section.settings.title_accent != blank -%}
          <span class="milaura-choice-flow__title-accent">{{ section.settings.title_accent | escape }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.lead != blank -%}
        <p class="milaura-choice-flow__lead">{{ section.settings.lead | escape }}</p>
      {%- endif -%}
    </header>

    {%- if type_count > 0 -%}
      <details class="milaura-choice-flow__chapter milaura-choice-flow__chapter--type milaura-choice-flow__reveal" data-choice-details>
        <summary class="milaura-choice-flow__chapter-summary">
          <span class="milaura-choice-flow__chapter-head">
            {%- if section.settings.type_kicker != blank -%}
              <span class="milaura-choice-flow__chapter-kicker">{{ section.settings.type_kicker | escape }}</span>
            {%- endif -%}
            <span class="milaura-choice-flow__chapter-title" role="heading" aria-level="3">
              {{ section.settings.type_title | escape }}
            </span>
            {%- if section.settings.type_lead != blank -%}
              <span class="milaura-choice-flow__chapter-lead">{{ section.settings.type_lead | escape }}</span>
            {%- endif -%}
            <span class="milaura-choice-flow__chapter-toggle" aria-hidden="true">
              <span class="milaura-choice-flow__chapter-toggle-closed">Voir les bijoux</span>
              <span class="milaura-choice-flow__chapter-toggle-open">Réduire</span>
              <span class="milaura-choice-flow__chapter-toggle-icon">+</span>
            </span>
          </span>
          <span class="milaura-choice-flow__chapter-preview milaura-choice-flow__chapter-preview--type" aria-hidden="true">
            {%- assign type_preview_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'type_card' and type_preview_count < 3 -%}
                {%- liquid
                  assign preview_collection = block.settings.collection
                  assign preview_product = block.settings.product
                  assign preview_image = block.settings.image
                  if preview_image == blank and preview_product != blank
                    assign preview_image = preview_product.featured_image
                  endif
                  if preview_image == blank and preview_collection != blank and preview_collection.image != blank
                    assign preview_image = preview_collection.image
                  endif
                  if preview_image == blank and preview_collection != blank and preview_collection.products.first != blank
                    assign preview_image = preview_collection.products.first.featured_image
                  endif
                  assign type_preview_count = type_preview_count | plus: 1
                -%}
                <span class="milaura-choice-flow__preview-tile" style="--preview-index: {{ type_preview_count }};">
                  {%- if preview_image != blank -%}
                    {{- preview_image
                      | image_url: width: 420
                      | image_tag:
                        class: 'milaura-choice-flow__preview-image',
                        widths: '180, 280, 420',
                        sizes: '(max-width: 749px) 24vw, 150px',
                        loading: 'lazy',
                        alt: ''
                    -}}
                  {%- elsif block.settings.asset_name != blank -%}
                    <img
                      class="milaura-choice-flow__preview-image"
                      src="{{ block.settings.asset_name | asset_url }}"
                      alt=""
                      loading="lazy"
                      width="320"
                      height="400"
                    >
                  {%- endif -%}
                  <span>{{ block.settings.heading | escape }}</span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        </summary>

        <div class="milaura-choice-flow__chapter-content">
          <span class="milaura-choice-flow__mobile-hint" aria-hidden="true">Faire défiler</span>
          <nav aria-label="Choisir un type de bijou">
          <ul class="milaura-choice-flow__type-grid" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'type_card' -%}
                {%- liquid
                  assign card_collection = block.settings.collection
                  assign card_product = block.settings.product
                  assign card_image = block.settings.image
                  if card_image == blank and card_product != blank
                    assign card_image = card_product.featured_image
                  endif
                  if card_image == blank and card_collection != blank and card_collection.image != blank
                    assign card_image = card_collection.image
                  endif
                  if card_image == blank and card_collection != blank and card_collection.products.first != blank
                    assign card_image = card_collection.products.first.featured_image
                  endif

                  assign card_url = block.settings.link
                  if card_url == blank and card_collection != blank
                    assign card_url = card_collection.url
                  endif
                -%}
                <li
                  class="milaura-choice-flow__type-card milaura-choice-flow__reveal"
                  style="--choice-index: {{ forloop.index0 }};"
                  {{ block.shopify_attributes }}
                >
                  <a
                    class="milaura-choice-flow__type-link"
                    href="{{ card_url }}"
                    data-choice-path="type"
                    data-choice-value="{{ block.settings.heading | handleize }}"
                  >
                    {%- if card_image != blank -%}
                      {{- card_image
                        | image_url: width: 1000
                        | image_tag:
                          class: 'milaura-choice-flow__type-image',
                          widths: '260, 380, 520, 720, 1000',
                          sizes: '(max-width: 989px) 78vw, 20vw',
                          loading: 'lazy',
                          alt: block.settings.heading
                      -}}
                    {%- elsif block.settings.asset_name != blank -%}
                      <img
                        class="milaura-choice-flow__type-image"
                        src="{{ block.settings.asset_name | asset_url }}"
                        alt="{{ block.settings.heading | escape }}"
                        loading="lazy"
                        width="800"
                        height="1040"
                      >
                    {%- endif -%}
                    <span class="milaura-choice-flow__type-copy">
                      <span>
                        <span class="milaura-choice-flow__type-label">
                          {{ block.settings.label | default: 'Explorer' | escape }}
                        </span>
                        <span class="milaura-choice-flow__type-title">{{ block.settings.heading | escape }}</span>
                      </span>
                      <span class="milaura-choice-flow__arrow" aria-hidden="true">→</span>
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          </nav>

          {%- if section.settings.type_all_label != blank and section.settings.type_all_link != blank -%}
            <a class="milaura-choice-flow__all-link" href="{{ section.settings.type_all_link }}">
              <span>{{ section.settings.type_all_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}

    {%- if emotion_count > 0 -%}
      <details class="milaura-choice-flow__chapter milaura-choice-flow__chapter--emotion milaura-choice-flow__reveal" data-choice-details>
        <summary class="milaura-choice-flow__chapter-summary">
          <span class="milaura-choice-flow__chapter-head">
            {%- if section.settings.emotion_kicker != blank -%}
              <span class="milaura-choice-flow__chapter-kicker">{{ section.settings.emotion_kicker | escape }}</span>
            {%- endif -%}
            <span class="milaura-choice-flow__chapter-title" role="heading" aria-level="3">
              {{ section.settings.emotion_title | escape }}
            </span>
            {%- if section.settings.emotion_lead != blank -%}
              <span class="milaura-choice-flow__chapter-lead">{{ section.settings.emotion_lead | escape }}</span>
            {%- endif -%}
            <span class="milaura-choice-flow__chapter-toggle" aria-hidden="true">
              <span class="milaura-choice-flow__chapter-toggle-closed">Explorer mes besoins</span>
              <span class="milaura-choice-flow__chapter-toggle-open">Réduire</span>
              <span class="milaura-choice-flow__chapter-toggle-icon">+</span>
            </span>
          </span>
          <span class="milaura-choice-flow__chapter-preview milaura-choice-flow__chapter-preview--emotion" aria-hidden="true">
            {%- assign emotion_preview_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'emotion_card' and emotion_preview_count < 3 -%}
                {%- assign emotion_preview_count = emotion_preview_count | plus: 1 -%}
                <span class="milaura-choice-flow__preview-tile" style="--preview-index: {{ emotion_preview_count }};">
                  {%- if block.settings.image != blank -%}
                    {{- block.settings.image
                      | image_url: width: 420
                      | image_tag:
                        class: 'milaura-choice-flow__preview-image',
                        widths: '180, 280, 420',
                        sizes: '(max-width: 749px) 24vw, 150px',
                        loading: 'lazy',
                        alt: ''
                    -}}
                  {%- elsif block.settings.desktop_asset != blank -%}
                    <img
                      class="milaura-choice-flow__preview-image"
                      src="{{ block.settings.desktop_asset | asset_url }}"
                      alt=""
                      loading="lazy"
                      width="320"
                      height="400"
                    >
                  {%- endif -%}
                  <span>{{ block.settings.stone | escape }}</span>
                </span>
              {%- endif -%}
            {%- endfor -%}
          </span>
        </summary>

        <div class="milaura-choice-flow__chapter-content">
          <span class="milaura-choice-flow__mobile-hint" aria-hidden="true">Faire défiler</span>
          <nav aria-label="Choisir une pierre selon votre ressenti">
          <ul class="milaura-choice-flow__emotion-grid" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'emotion_card' -%}
                <li
                  class="milaura-choice-flow__emotion-card milaura-choice-flow__reveal"
                  style="--choice-index: {{ forloop.index0 }};"
                  {{ block.shopify_attributes }}
                >
                  <a
                    class="milaura-choice-flow__emotion-link"
                    href="{{ block.settings.link }}"
                    data-choice-path="emotion"
                    data-choice-value="{{ block.settings.stone | handleize }}"
                  >
                    <span class="milaura-choice-flow__emotion-window">
                      {%- if block.settings.image != blank -%}
                        {{- block.settings.image
                          | image_url: width: 900
                          | image_tag:
                            class: 'milaura-choice-flow__emotion-image',
                            widths: '220, 340, 480, 680, 900',
                            sizes: '(max-width: 989px) 58vw, 20vw',
                            loading: 'lazy',
                            alt: block.settings.stone
                        -}}
                      {%- elsif block.settings.desktop_asset != blank -%}
                        <picture>
                          {%- if block.settings.mobile_asset != blank -%}
                            <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_asset | asset_url }}">
                          {%- endif -%}
                          <img
                            class="milaura-choice-flow__emotion-image"
                            src="{{ block.settings.desktop_asset | asset_url }}"
                            alt="{{ block.settings.stone | escape }}"
                            loading="lazy"
                            width="720"
                            height="960"
                          >
                        </picture>
                      {%- endif -%}
                    </span>
                    <span class="milaura-choice-flow__emotion-copy">
                      <span class="milaura-choice-flow__emotion-need">{{ block.settings.need | escape }}</span>
                      <span class="milaura-choice-flow__emotion-stone">{{ block.settings.stone | escape }}</span>
                      {%- if block.settings.note != blank -%}
                        <span class="milaura-choice-flow__emotion-note">{{ block.settings.note | escape }}</span>
                      {%- endif -%}
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          </nav>

          {%- if section.settings.emotion_all_label != blank and section.settings.emotion_all_link != blank -%}
            <a class="milaura-choice-flow__all-link" href="{{ section.settings.emotion_all_link }}">
              <span>{{ section.settings.emotion_all_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}
        </div>
      </details>
    {%- endif -%}

    <aside class="milaura-choice-flow__quiz milaura-choice-flow__reveal" aria-labelledby="MilauraChoiceQuizTitle-{{ section.id }}">
      <div class="milaura-choice-flow__quiz-media">
        <span class="milaura-choice-flow__quiz-orbit" aria-hidden="true"></span>
        <span class="milaura-choice-flow__quiz-portrait">
          {%- if section.settings.quiz_image != blank -%}
            {{- section.settings.quiz_image
              | image_url: width: 720
              | image_tag:
                class: 'milaura-choice-flow__quiz-image',
                widths: '280, 420, 560, 720',
                sizes: '(max-width: 749px) 142px, 210px',
                loading: 'lazy',
                alt: section.settings.quiz_image_alt
            -}}
          {%- else -%}
            <img
              class="milaura-choice-flow__quiz-image"
              src="{{ quiz_asset | asset_url }}"
              alt="{{ section.settings.quiz_image_alt | escape }}"
              loading="lazy"
              width="560"
              height="560"
            >
          {%- endif -%}
        </span>
        <span class="milaura-choice-flow__quiz-caption">Karine · Fondatrice</span>
      </div>
      <div class="milaura-choice-flow__quiz-copy">
        {%- if section.settings.quiz_kicker != blank -%}
          <p class="milaura-choice-flow__quiz-kicker">{{ section.settings.quiz_kicker | escape }}</p>
        {%- endif -%}
        <h3 id="MilauraChoiceQuizTitle-{{ section.id }}" class="milaura-choice-flow__quiz-title">
          {{ section.settings.quiz_title | escape }}
        </h3>
        {%- if section.settings.quiz_text != blank -%}
          <p class="milaura-choice-flow__quiz-text">{{ section.settings.quiz_text | escape }}</p>
        {%- endif -%}
        <ul class="milaura-choice-flow__quiz-meta" aria-label="Informations sur le diagnostic">
          {%- if section.settings.quiz_meta_1 != blank -%}<li>{{ section.settings.quiz_meta_1 | escape }}</li>{%- endif -%}
          {%- if section.settings.quiz_meta_2 != blank -%}<li>{{ section.settings.quiz_meta_2 | escape }}</li>{%- endif -%}
          {%- if section.settings.quiz_meta_3 != blank -%}<li>{{ section.settings.quiz_meta_3 | escape }}</li>{%- endif -%}
        </ul>
        <a
          class="milaura-choice-flow__quiz-cta"
          href="{{ quiz_url }}"
          data-choice-path="quiz"
          data-choice-value="diagnostic-emotionnel"
        >
          <span>{{ section.settings.quiz_cta_label | escape }}</span>
          <span class="milaura-choice-flow__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<script src="{{ 'milaura-choice-doors.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Guide de découverte",
  "tag": "section",
  "class": "milaura-choice-doors-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Surtitre",
      "default": "Le guide MilAura"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Votre prochain bijou"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Ligne manuscrite",
      "default": "commence ici."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Introduction",
      "default": "Partez d’une forme, d’un ressenti ou laissez Karine vous guider. Trois façons simples de trouver ce qui vous ressemble."
    },
    {
      "type": "header",
      "content": "Choix par type"
    },
    {
      "type": "text",
      "id": "type_kicker",
      "label": "Surtitre",
      "default": "Choisir par forme"
    },
    {
      "type": "text",
      "id": "type_title",
      "label": "Titre",
      "default": "Quel bijou avez-vous envie de porter ?"
    },
    {
      "type": "textarea",
      "id": "type_lead",
      "label": "Introduction",
      "default": "Entrez directement par la création que vous imaginez déjà."
    },
    {
      "type": "text",
      "id": "type_all_label",
      "label": "Lien vers tous les bijoux",
      "default": "Voir tous les bijoux"
    },
    {
      "type": "url",
      "id": "type_all_link",
      "label": "Destination de tous les bijoux"
    },
    {
      "type": "header",
      "content": "Choix par ressenti"
    },
    {
      "type": "text",
      "id": "emotion_kicker",
      "label": "Surtitre",
      "default": "Choisir par ressenti"
    },
    {
      "type": "text",
      "id": "emotion_title",
      "label": "Titre",
      "default": "De quoi avez-vous besoin aujourd’hui ?"
    },
    {
      "type": "textarea",
      "id": "emotion_lead",
      "label": "Introduction",
      "default": "Commencez par votre émotion du moment. La pierre vient ensuite, comme une direction à explorer."
    },
    {
      "type": "text",
      "id": "emotion_all_label",
      "label": "Lien vers toutes les pierres",
      "default": "Explorer toutes les pierres"
    },
    {
      "type": "url",
      "id": "emotion_all_link",
      "label": "Destination de toutes les pierres"
    },
    {
      "type": "header",
      "content": "Diagnostic"
    },
    {
      "type": "image_picker",
      "id": "quiz_image",
      "label": "Photo de Karine"
    },
    {
      "type": "text",
      "id": "quiz_asset",
      "label": "Photo de secours dans les assets",
      "default": "milaura-hero-proof-karine-v2.webp"
    },
    {
      "type": "text",
      "id": "quiz_image_alt",
      "label": "Texte alternatif de la photo",
      "default": "Karine, fondatrice de MilAura"
    },
    {
      "type": "text",
      "id": "quiz_kicker",
      "label": "Surtitre",
      "default": "Vous hésitez encore ?"
    },
    {
      "type": "text",
      "id": "quiz_title",
      "label": "Titre",
      "default": "Laissez Karine vous guider."
    },
    {
      "type": "textarea",
      "id": "quiz_text",
      "label": "Introduction",
      "default": "Répondez à quelques questions simples et découvrez les pierres qui correspondent à votre ressenti du moment."
    },
    {
      "type": "text",
      "id": "quiz_meta_1",
      "label": "Information 1",
      "default": "2 minutes"
    },
    {
      "type": "text",
      "id": "quiz_meta_2",
      "label": "Information 2",
      "default": "5 profils"
    },
    {
      "type": "text",
      "id": "quiz_meta_3",
      "label": "Information 3",
      "default": "Résultat immédiat"
    },
    {
      "type": "text",
      "id": "quiz_cta_label",
      "label": "Texte du bouton",
      "default": "Faire le diagnostic"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Lien du diagnostic"
    }
  ],
  "blocks": [
    {
      "type": "type_card",
      "name": "Type de bijou",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Petit libellé",
          "default": "Explorer"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Nom",
          "default": "Bracelets"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Produit utilisé comme visuel"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "asset_name",
          "label": "Visuel de secours dans les assets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien personnalisé"
        }
      ]
    },
    {
      "type": "emotion_card",
      "name": "Ressenti et pierre",
      "settings": [
        {
          "type": "text",
          "id": "need",
          "label": "Ressenti ou besoin",
          "default": "Retrouver le calme"
        },
        {
          "type": "text",
          "id": "stone",
          "label": "Pierre",
          "default": "Améthyste"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Associations courtes",
          "default": "Sérénité · sommeil · recentrage"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "desktop_asset",
          "label": "Visuel desktop dans les assets"
        },
        {
          "type": "text",
          "id": "mobile_asset",
          "label": "Visuel mobile dans les assets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide de découverte",
      "blocks": [
        { "type": "type_card" },
        { "type": "type_card" },
        { "type": "type_card" },
        { "type": "emotion_card" },
        { "type": "emotion_card" },
        { "type": "emotion_card" }
      ]
    }
  ]
}
{% endschema %}
