{%- comment -%}
  Fragment HTML d'un produit cure dans un contexte client.
  Le produit est resolu par Shopify depuis son URL au moment du rendu.
{%- endcomment -%}

<div data-milaura-product-fragment>
  {%- if product != blank and product.available and product.featured_image != blank -%}
    {% render 'milaura-recommendation-card',
      recommendation_product: product,
      recommendation_intent: 'curated',
      recommendation_origin: 'catalogue',
      recommendation_fallback_tier: 'catalogue',
      recommendation_role: 'focal',
      img_loading: 'lazy',
      show_purchase: true
    %}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Milaura product fragment",
  "tag": "section",
  "class": "milaura-product-fragment-section",
  "settings": []
}
{% endschema %}
