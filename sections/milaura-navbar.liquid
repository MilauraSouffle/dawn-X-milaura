      padding: 14px 44px 14px 46px;
      border-radius: 50px;
    }

    .milaura-search-panel {
      max-height: 85vh;
    }

    .milaura-search-pill {
      font-size: 12px;
      padding: 6px 12px;
    }

    .milaura-search-results {
