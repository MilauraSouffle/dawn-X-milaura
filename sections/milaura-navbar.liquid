<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} {
    z-index: 1000000 !important;
  }

  /* ============================================
     MILAURA NAVBAR - VERSION CTA & CRO
     Badge Quiz visible sur TOUS les écrans
     ============================================ */

  /* --- CONTENEUR PRINCIPAL --- */
  #MilauraNav-{{ section.id }} {
    position: fixed;
    top: 38px;
    left: 0;
    width: 100%;
    z-index: 1000000;
    display: flex;
    justify-content: center;
    padding: 0 24px;
    pointer-events: none;
    transition: top 0.3s ease;
    box-sizing: border-box;
  }

  /* --- WRAPPER SNAKE (contient l'ombre) --- */
  #MilauraNav-{{ section.id }} .nav-snake-wrapper {
    position: relative;
    padding: 2px;
    border-radius: 100px;
    pointer-events: auto;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.04);
    animation: slideDown 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
    max-width: 1280px;
    width: 100%;
  }

  /* Animation de balayage subtile */
  #MilauraNav-{{ section.id }} .nav-snake-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(192, 160, 98, 0.1) 50%,
      transparent 100%
    );
    animation: breathSweep 5s ease-in-out infinite;
    z-index: 0;
    pointer-events: none;
    border-radius: 100px;
  }

  /* --- INTÉRIEUR GLASSMORPHISM --- */
  #MilauraNav-{{ section.id }} .nav-inner {
    position: relative;
    z-index: 1;
    background: rgba(253, 251, 247, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px 6px 24px;
    gap: 16px;
    border: 1px solid rgba(192, 160, 98, 0.15);
  }

  /* --- LOGO --- */
  #MilauraNav-{{ section.id }} .nav-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  #MilauraNav-{{ section.id }} .nav-logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    display: block;
    transition: height 0.3s ease;
  }

  #MilauraNav-{{ section.id }} .nav-logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--milaura-text);
    font-weight: 600;
  }

  /* --- LIENS DU MENU (Desktop uniquement) --- */
  #MilauraNav-{{ section.id }} .nav-links {
    display: flex;
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    flex: 1;
    justify-content: center;
  }

  #MilauraNav-{{ section.id }} .nav-link {
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    color: var(--milaura-text);
    text-decoration: none;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: color 0.3s ease;
    position: relative;
    white-space: nowrap;
  }

  #MilauraNav-{{ section.id }} .nav-link::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -4px;
    left: 50%;
    background: linear-gradient(90deg, var(--milaura-gold), var(--milaura-gold-light));
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
    border-radius: 2px;
  }

  #MilauraNav-{{ section.id }} .nav-link:hover {
    color: var(--milaura-gold-dark);
  }

  #MilauraNav-{{ section.id }} .nav-link:hover::after {
    width: 100%;
  }

  /* --- DROPDOWN DESKTOP --- */
  #MilauraNav-{{ section.id }} .nav-item {
    position: relative;
  }

  #MilauraNav-{{ section.id }} .nav-item-has-children > .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  #MilauraNav-{{ section.id }} .nav-link-chevron {
    width: 12px;
    height: 12px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  #MilauraNav-{{ section.id }} .nav-item-has-children:hover .nav-link-chevron {
    transform: rotate(180deg);
  }

  #MilauraNav-{{ section.id }} .nav-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(192, 160, 98, 0.15);
    border-radius: 16px;
    padding: 12px 8px;
    min-width: 220px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1), 0 2px 8px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    list-style: none;
    margin: 0;
    z-index: 100;
  }

  #MilauraNav-{{ section.id }} .nav-item-has-children:hover .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Zone invisible pour maintenir le hover entre le lien et le dropdown */
  #MilauraNav-{{ section.id }} .nav-item-has-children::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 16px;
  }

  #MilauraNav-{{ section.id }} .nav-dropdown li {
    margin: 0;
  }

  #MilauraNav-{{ section.id }} .nav-dropdown-link {
    display: block;
    padding: 10px 16px;
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    color: var(--milaura-text);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-radius: 10px;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  #MilauraNav-{{ section.id }} .nav-dropdown-link:hover {
    background: rgba(192, 160, 98, 0.1);
    color: var(--milaura-gold-dark);
  }

  /* ============================================
     MEGA-MENU DESKTOP - Subcategories 3 niveaux
     ============================================ */
  #MilauraNav-{{ section.id }} .nav-megamenu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(192, 160, 98, 0.18);
    border-radius: 20px;
    padding: 28px 32px;
    min-width: 480px;
    box-shadow:
      0 16px 48px rgba(0, 0, 0, 0.1),
      0 2px 8px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 100;
  }

  #MilauraNav-{{ section.id }} .nav-item-has-megamenu:hover .nav-megamenu,
  #MilauraNav-{{ section.id }} .nav-item-has-megamenu:focus-within .nav-megamenu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Accessibilite : focus-within pour le dropdown simple aussi */
  #MilauraNav-{{ section.id }} .nav-item-has-children:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Bridge hover entre le lien et le mega-menu */
  #MilauraNav-{{ section.id }} .nav-megamenu::before {
    content: '';
    position: absolute;
    top: -16px;
    left: 0;
    right: 0;
    height: 16px;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-columns {
    display: flex;
    gap: 28px;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-column {
    flex: 1;
    min-width: 130px;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-column--single {
    flex: 0 0 auto;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-column-title {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--milaura-gold-dark);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid rgba(192, 160, 98, 0.2);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-column-title:hover {
    color: var(--milaura-gold);
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-link {
    display: block;
    padding: 7px 12px;
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    color: var(--milaura-text);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.3px;
    border-radius: 8px;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  #MilauraNav-{{ section.id }} .nav-megamenu-link:hover {
    background: rgba(192, 160, 98, 0.1);
    color: var(--milaura-gold-dark);
  }

  /* --- LIEN NOUVEAUTES : micro-badge dore --- */
  #MilauraNav-{{ section.id }} .nav-link--nouveautes {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  #MilauraNav-{{ section.id }} .nav-link--nouveautes::after {
    content: 'NEW';
    font-family: 'Lato', sans-serif;
    font-size: 0.55rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: #fff;
    background: linear-gradient(135deg, var(--milaura-gold) 0%, var(--milaura-gold-light) 100%);
    padding: 2px 6px;
    border-radius: 20px;
    line-height: 1;
    flex-shrink: 0;
    animation: badgeShimmer 3s ease-in-out infinite;
    background-size: 200% 200%;
  }

  /* Mobile : badge Nouveautes dore */
  #MilauraNav-{{ section.id }} .nav-mobile-link--nouveautes {
    color: var(--milaura-gold-light) !important;
  }

  /* ============================================
     SUPER CTA BADGE QUIZ - LE CŒUR DU FUNNEL
     Visible sur TOUS les écrans avec halo pulsant
     ============================================ */
  #MilauraNav-{{ section.id }} .nav-quiz-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(145deg, #52394d 0%, #493246 48%, #382733 100%);
    color: #fff;
    padding: 12px 24px;
    border: 1px solid rgba(215, 184, 223, 0.34);
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(47, 34, 45, 0.24);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    white-space: nowrap;
    position: relative;
    flex-shrink: 0;
    animation: none;
  }

  /* Filet or statique : le CTA reste visible sans animation concurrente. */
  #MilauraNav-{{ section.id }} .nav-quiz-badge::before {
    content: '';
    position: absolute;
    inset: -4px 2px;
    border-radius: 50px;
    border: 1px solid rgba(185, 151, 91, 0.78);
    box-shadow: none;
    animation: none;
    pointer-events: none;
  }

  @keyframes haloPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(192, 160, 98, 0.6);
    }
    50% {
      box-shadow: 0 0 0 12px rgba(192, 160, 98, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(192, 160, 98, 0);
    }
  }

  @keyframes badgeShimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  #MilauraNav-{{ section.id }} .nav-quiz-badge:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 10px 28px rgba(47, 34, 45, 0.3);
  }

  #MilauraNav-{{ section.id }} .nav-quiz-badge:hover::before {
    animation: none;
  }

  #MilauraNav-{{ section.id }} .badge-icon {
    font-size: 1.4rem;
    animation: iconBounce 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes iconBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-2px) scale(1.1); }
  }

  #MilauraNav-{{ section.id }} .badge-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.2;
  }

  #MilauraNav-{{ section.id }} .badge-title {
    font-family: 'Lato', sans-serif;
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  #MilauraNav-{{ section.id }} .badge-subtitle {
    display: none;
  }

  /* --- ZONE DROITE (badge + icônes) --- */
  #MilauraNav-{{ section.id }} .nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  /* --- ICÔNES --- */
  #MilauraNav-{{ section.id }} .nav-icons {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-shrink: 0;
  }

  #MilauraNav-{{ section.id }} .nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--milaura-text);
    transition: transform 0.3s ease, color 0.3s ease;
    text-decoration: none;
  }

  #MilauraNav-{{ section.id }} .nav-icon:hover {
    color: var(--milaura-gold);
    transform: scale(1.1);
  }

  #MilauraNav-{{ section.id }} .nav-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Lien contact (memes styles que les autres nav-icon) */
  #MilauraNav-{{ section.id }} .nav-contact-icon {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    line-height: 1;
  }

  /* Badge compteur panier (header) */
  #MilauraNav-{{ section.id }} .nav-cart-icon {
    position: relative;
  }

  #MilauraNav-{{ section.id }} .nav-cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    background: linear-gradient(135deg, var(--milaura-gold) 0%, var(--milaura-gold-dark) 100%);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    pointer-events: none;
  }

  /* --- MENU TOGGLE - 2 traits dores (luxe) --- */
  #MilauraNav-{{ section.id }} .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    padding: 10px;
    background: transparent;
    border: none;
    z-index: 10;
  }

  #MilauraNav-{{ section.id }} .nav-burger span {
    width: 20px;
    height: 2px;
    background: linear-gradient(90deg, var(--milaura-gold), var(--milaura-gold-light));
    border-radius: 2px;
    display: block;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: center;
  }

  /* 2e trait plus court - asymetrie luxe */
  #MilauraNav-{{ section.id }} .nav-burger span:nth-child(2) {
    width: 14px;
    margin-left: auto;
  }

  #MilauraNav-{{ section.id }} .nav-burger:hover span {
    background: linear-gradient(90deg, var(--milaura-gold-light), var(--milaura-gold));
  }

  #MilauraNav-{{ section.id }} .nav-burger:hover span:nth-child(2) {
    width: 20px;
  }

  /* Active → X */
  #MilauraNav-{{ section.id }} .nav-burger.active span:nth-child(1) {
    transform: rotate(45deg) translate(2.8px, 2.8px);
  }

  #MilauraNav-{{ section.id }} .nav-burger.active span:nth-child(2) {
    width: 20px;
    transform: rotate(-45deg) translate(2.8px, -2.8px);
  }

  /* ============================================
     MENU MOBILE - ECRIN MILAURA
     ============================================ */

  #MilauraNav-{{ section.id }} .nav-mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 999998;
    background: rgba(47, 34, 45, 0.28);
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms ease, visibility 220ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    padding: 126px 28px 36px;
    overflow-y: auto;
    color: #fbf8f3;
    background:
      radial-gradient(circle at 88% 24%, rgba(111, 169, 166, 0.13), transparent 30%),
      linear-gradient(155deg, #2f222d 0%, #382733 52%, #261b24 100%);
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-14px);
    transition:
      opacity 240ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 240ms ease;
    pointer-events: auto;
    -webkit-overflow-scrolling: touch;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-menu.active,
  #MilauraNav-{{ section.id }} .nav-mobile-menu.opening {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-menu.closing {
    opacity: 0;
    visibility: visible;
    transform: translateY(-10px);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-shell {
    position: relative;
    width: min(100%, 680px);
    min-height: 100%;
    margin: 0 auto;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 0 14px;
    border-bottom: 1px solid rgba(111, 169, 166, 0.46);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-heading {
    min-width: 0;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-kicker {
    display: block;
    margin-bottom: 3px;
    color: #b9975b;
    font-family: 'Lato', sans-serif;
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-title {
    margin: 0;
    color: #fbf8f3;
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.42rem, 4vw, 1.8rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.1px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-back {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    padding: 0;
    place-items: center;
    color: #b9975b;
    background: transparent;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-back:hover,
  #MilauraNav-{{ section.id }} .nav-mobile-back:focus-visible {
    color: #e6c88b;
    background: rgba(185, 151, 91, 0.08);
    transform: scale(1.06);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-back:focus-visible {
    outline: 2px solid #6fa9a6;
    outline-offset: 2px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-back svg {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 2px 5px rgba(185, 151, 91, 0.18));
  }

  #MilauraNav-{{ section.id }} .nav-mobile-links {
    display: flex;
    position: relative;
    z-index: 1;
    flex-direction: column;
    gap: 0;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-link {
    display: flex;
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 55px;
    padding: 14px 2px;
    align-items: center;
    justify-content: space-between;
    color: #fbf8f3;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(111, 169, 166, 0.28);
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.08rem, 3.6vw, 1.34rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.15px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color 180ms ease, padding-left 180ms ease, background-color 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-link:hover,
  #MilauraNav-{{ section.id }} .nav-mobile-link:focus-visible,
  #MilauraNav-{{ section.id }} .nav-mobile-link.open {
    padding-left: 9px;
    color: #efdaf2;
    background: rgba(111, 169, 166, 0.08);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-link:focus-visible,
  #MilauraNav-{{ section.id }} .nav-mobile-sublink:focus-visible,
  #MilauraNav-{{ section.id }} .nav-mobile-group-title:focus-visible,
  #MilauraNav-{{ section.id }} .nav-mobile-cercle-link:focus-visible {
    outline: 2px solid #6fa9a6;
    outline-offset: -2px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-link--nouveautes {
    color: #d8bd84 !important;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-parent .nav-link-chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: #6fa9a6;
    transition: transform 200ms ease, color 200ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-parent.open .nav-link-chevron {
    color: #b9975b;
    transform: rotate(180deg);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-submenu {
    max-height: 0;
    margin: 0;
    padding: 0 10px;
    overflow: hidden;
    visibility: hidden;
    list-style: none;
    background: rgba(251, 248, 243, 0.045);
    border-left: 1px solid rgba(111, 169, 166, 0.56);
    border-radius: 0 16px 16px 0;
    opacity: 0;
    transition:
      max-height 260ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 200ms ease,
      padding 200ms ease,
      opacity 180ms ease,
      visibility 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-submenu.open {
    max-height: 1200px;
    margin: 8px 0 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    visibility: visible;
    opacity: 1;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-sublink {
    display: block;
    position: relative;
    padding: 11px 14px 11px 22px;
    color: rgba(251, 248, 243, 0.82);
    border-bottom: 1px solid rgba(215, 184, 223, 0.1);
    font-family: 'Lato', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    transition: color 180ms ease, background-color 180ms ease, padding-left 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-sublink::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 8px;
    width: 5px;
    height: 5px;
    background: #b9975b;
    border-radius: 50%;
    opacity: 0.72;
    transform: translateY(-50%);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-sublink:hover,
  #MilauraNav-{{ section.id }} .nav-mobile-sublink:focus-visible {
    padding-left: 27px;
    color: #ffffff;
    background: rgba(111, 169, 166, 0.09);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-sublink--all {
    color: #d7b8df;
    font-weight: 800;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-group {
    padding: 4px 0;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-group-title {
    display: block;
    padding: 12px 14px 4px;
    color: #d8bd84;
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 1.15px;
    text-decoration: none;
    text-transform: uppercase;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-group-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle {
    position: relative;
    z-index: 1;
    margin-top: 18px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-link {
    display: flex;
    min-height: 76px;
    padding: 13px 15px;
    align-items: center;
    gap: 14px;
    color: #fbf8f3;
    background: rgba(251, 248, 243, 0.055);
    border: 1px solid rgba(111, 169, 166, 0.42);
    border-radius: 22px;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-link:hover,
  #MilauraNav-{{ section.id }} .nav-mobile-cercle-link:focus-visible {
    background: rgba(111, 169, 166, 0.12);
    border-color: rgba(185, 151, 91, 0.68);
    transform: translateY(-1px);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-mark {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-ring {
    position: absolute;
    display: block;
    border: 1.4px solid;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-ring--gold {
    inset: 8px 2px 7px 4px;
    border-color: #b9975b;
    border-radius: 48% 52% 46% 54% / 53% 45% 55% 47%;
    transform: rotate(10deg);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-ring--aqua {
    inset: 4px 8px 4px 6px;
    border-color: #6fa9a6;
    border-radius: 53% 47% 55% 45% / 46% 54% 48% 52%;
    transform: rotate(-13deg);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-copy {
    min-width: 0;
    flex: 1;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-title,
  #MilauraNav-{{ section.id }} .nav-mobile-cercle-subtitle {
    display: block;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-subtitle {
    margin-top: 3px;
    color: rgba(251, 248, 243, 0.58);
    font-family: 'Lato', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.45px;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-cercle-arrow {
    flex: 0 0 auto;
    color: #b9975b;
    font-size: 1.15rem;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-secondary {
    display: flex;
    margin-top: 14px;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-secondary a {
    position: relative;
    padding: 8px 14px;
    color: rgba(251, 248, 243, 0.68);
    font-family: 'Lato', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.9px;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-secondary a + a::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 3px;
    height: 3px;
    background: #6fa9a6;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  #MilauraNav-{{ section.id }} .nav-mobile-secondary a:hover,
  #MilauraNav-{{ section.id }} .nav-mobile-secondary a:focus-visible {
    color: #efdaf2;
  }

  #MilauraNav-{{ section.id }} .nav-mobile-secondary a:focus-visible {
    outline: 1px solid #6fa9a6;
    outline-offset: 2px;
  }

  /* --- ANIMATIONS --- */
  @keyframes breathSweep {
    0% { left: -100%; opacity: 0; }
    50% { opacity: 1; }
    100% { left: 150%; opacity: 0; }
  }

  @keyframes slideDown {
    from { transform: translateY(-100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* ============================================
     RESPONSIVE - Badge TOUJOURS visible
     ============================================ */

  /* DESKTOP LARGE (> 1100px) : Tout visible */
  @media screen and (min-width: 1101px) {
    #MilauraNav-{{ section.id }} .nav-burger {
      display: none;
    }
  }

  /* TABLETTE (768px - 1100px) : Menu burger, badge visible */
  @media screen and (max-width: 1100px) {
    #MilauraNav-{{ section.id }} .nav-links {
      display: none;
    }

    #MilauraNav-{{ section.id }} .nav-burger {
      display: flex;
    }

    #MilauraNav-{{ section.id }} .nav-inner {
      padding: 6px 12px 6px 16px;
      gap: 12px;
    }

    #MilauraNav-{{ section.id }} .nav-logo-img {
      height: 46px;
    }

    /* Badge plus compact sur tablette */
    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      padding: 10px 18px;
      gap: 10px;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      font-size: 0.85rem;
    }

    #MilauraNav-{{ section.id }} .badge-subtitle {
      font-size: 0.7rem;
    }

    #MilauraNav-{{ section.id }} .badge-icon {
      font-size: 1.2rem;
    }

    /* Icônes plus confortables sur tablette */
    #MilauraNav-{{ section.id }} .nav-icons {
      gap: 18px;
    }

    #MilauraNav-{{ section.id }} .nav-icon {
      padding: 6px;
    }

    #MilauraNav-{{ section.id }} .nav-icon svg {
      width: 22px;
      height: 22px;
    }
  }

  /* MOBILE LARGE (481px - 767px) : Badge simplifié */
  @media screen and (max-width: 767px) {
    #MilauraNav-{{ section.id }} {
      padding: 0 16px;
    }

    #MilauraNav-{{ section.id }} .nav-inner {
      padding: 6px 10px 6px 14px;
      gap: 10px;
    }

    #MilauraNav-{{ section.id }} .nav-logo-img {
      height: 40px;
    }

    /* Badge sans subtitle sur mobile */
    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      padding: 10px 16px;
      gap: 8px;
    }

    #MilauraNav-{{ section.id }} .badge-subtitle {
      display: none;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      font-size: 0.8rem;
    }

    #MilauraNav-{{ section.id }} .badge-icon {
      font-size: 1.1rem;
    }

    /* Icones masquees sur mobile - remplacees par le dock fixe en bas */
    #MilauraNav-{{ section.id }} .nav-icons {
      display: none;
    }

  }

  /* MOBILE PETIT (< 480px) : Badge icône uniquement */
  @media screen and (max-width: 480px) {
    #MilauraNav-{{ section.id }} {
      padding: 0 10px;
    }

    #MilauraNav-{{ section.id }} .nav-inner {
      padding: 5px 8px 5px 12px;
      gap: 8px;
    }

    #MilauraNav-{{ section.id }} .nav-logo-img {
      height: 36px;
    }

    /* Badge ultra compact - icône + texte court */
    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      padding: 8px 14px;
      gap: 6px;
    }

    #MilauraNav-{{ section.id }} .badge-content {
      display: flex;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      font-size: 0.7rem;
      letter-spacing: 0;
    }

    #MilauraNav-{{ section.id }} .badge-icon {
      font-size: 1rem;
    }

    #MilauraNav-{{ section.id }} .nav-burger {
      padding: 8px;
      gap: 5px;
    }

    #MilauraNav-{{ section.id }} .nav-burger span {
      width: 18px;
    }

    #MilauraNav-{{ section.id }} .nav-burger span:nth-child(2) {
      width: 12px;
    }
  }

  /* TRÈS PETIT ÉCRAN (< 360px) : Ajustements extrêmes */
  @media screen and (max-width: 360px) {
    #MilauraNav-{{ section.id }} .nav-logo-img {
      height: 32px;
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      padding: 7px 12px;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      font-size: 0.65rem;
    }

    #MilauraNav-{{ section.id }} .badge-icon {
      font-size: 0.9rem;
    }
  }

  /* MOBILE : mini-header de marque, navigation principale dans le dock */
  @media screen and (max-width: 768px) {
    #MilauraNav-{{ section.id }} {
      padding: 0 12px;
    }

    #MilauraNav-{{ section.id }} .nav-snake-wrapper {
      max-width: none;
      padding: 0;
      border-radius: 0;
      box-shadow: none;
      animation: none;
    }

    #MilauraNav-{{ section.id }} .nav-snake-wrapper::before {
      display: none;
    }

    #MilauraNav-{{ section.id }} .nav-inner {
      padding: 7px 2px;
      gap: 14px;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    #MilauraNav-{{ section.id }} .nav-burger,
    #MilauraNav-{{ section.id }} .nav-icons {
      display: none !important;
    }

    #MilauraNav-{{ section.id }} .nav-logo-link {
      min-width: 70px;
      min-height: 64px;
      justify-content: flex-start;
    }

    #MilauraNav-{{ section.id }} .nav-logo-img {
      width: auto;
      height: 68px;
      transform: scale(1.08);
      transform-origin: left center;
      filter: drop-shadow(0 5px 10px rgba(47, 34, 45, 0.12));
    }

    #MilauraNav-{{ section.id }} .nav-right {
      margin-left: auto;
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      min-height: 47px;
      padding: 10px 18px;
      color: #fbf8f3;
      background: linear-gradient(145deg, #52394d 0%, #493246 48%, #382733 100%);
      border: 1px solid rgba(215, 184, 223, 0.34);
      border-radius: 56% 44% 52% 48% / 52% 47% 53% 48%;
      box-shadow: 0 9px 22px rgba(47, 34, 45, 0.24);
      isolation: isolate;
      animation: none;
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge::before,
    #MilauraNav-{{ section.id }} .nav-quiz-badge::after {
      content: '';
      position: absolute;
      pointer-events: none;
      border-radius: inherit;
      box-shadow: none;
      animation: none;
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge::before {
      inset: -4px 2px;
      border: 1px solid rgba(185, 151, 91, 0.88);
      transform: rotate(1.4deg);
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge::after {
      inset: -7px 5px;
      border: 1px solid rgba(111, 169, 166, 0.88);
      transform: rotate(-1.5deg);
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge:hover {
      transform: none;
      box-shadow: 0 9px 22px rgba(47, 34, 45, 0.2);
    }

    #MilauraNav-{{ section.id }} .badge-content {
      position: relative;
      z-index: 1;
      align-items: center;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      color: #fbf8f3;
      font-size: 0.76rem;
      font-weight: 800;
      line-height: 1;
      letter-spacing: 0.45px;
      text-shadow: none;
    }
  }

  @media screen and (max-width: 359px) {
    #MilauraNav-{{ section.id }} {
      padding: 0 9px;
    }

    #MilauraNav-{{ section.id }} .nav-logo-link {
      min-width: 60px;
      min-height: 58px;
    }

    #MilauraNav-{{ section.id }} .nav-logo-img {
      height: 60px;
      transform: scale(1.05);
    }

    #MilauraNav-{{ section.id }} .nav-quiz-badge {
      min-height: 44px;
      padding: 9px 14px;
    }

    #MilauraNav-{{ section.id }} .badge-title {
      font-size: 0.68rem;
    }
  }

  /* ============================================
     RESPONSIVE MENU MOBILE
     ============================================ */

  @media screen and (max-width: 1100px) {
    #MilauraNav-{{ section.id }} .nav-snake-wrapper {
      z-index: 1000000;
    }

    #MilauraNav-{{ section.id }} .nav-mobile-menu {
      padding: 122px 28px 36px;
    }
  }

  @media screen and (max-width: 768px) {
    #MilauraNav-{{ section.id }} .nav-mobile-menu {
      padding: 124px 18px calc(var(--milaura-mobile-dock-total, 88px) + 18px);
    }

    #MilauraNav-{{ section.id }} .nav-mobile-sublink {
      font-size: 0.84rem;
    }
  }

  @media screen and (max-width: 480px) {
    #MilauraNav-{{ section.id }} .nav-mobile-menu {
      padding-top: 118px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #MilauraNav-{{ section.id }} .nav-mobile-link {
      min-height: 52px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
  }

  @media screen and (max-width: 360px) {
    #MilauraNav-{{ section.id }} .nav-mobile-menu {
      padding-top: 108px;
      padding-right: 13px;
      padding-left: 13px;
    }

    #MilauraNav-{{ section.id }} .nav-mobile-cercle-link {
      min-height: 70px;
      padding: 10px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      transition: none !important;
      animation: none !important;
    }
  }

{% endstyle %}

<div id="MilauraNav-{{ section.id }}">
  <div class="nav-snake-wrapper">
    <div class="nav-inner">

      <!-- Menu toggle (mobile/tablette) - 2 traits dores -->
      <button
        type="button"
        class="nav-burger"
        aria-label="Menu"
        aria-controls="mobile-menu-{{ section.id }}"
        aria-expanded="false"
        id="burger-{{ section.id }}"
      >
        <span></span>
        <span></span>
      </button>

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="nav-logo-link">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: height: 120 | image_tag: class: 'nav-logo-img', loading: 'eager' }}
        {% else %}
          <span class="nav-logo-text">Mil'Aura</span>
        {% endif %}
      </a>

      <!-- Liens Desktop (cachés sur mobile/tablette) -->
      <ul class="nav-links">
        {%- for link in linklists[section.settings.menu].links -%}
          {%- if link.links.size > 0 -%}
            {%- assign has_grandchildren = false -%}
            {%- for child in link.links -%}
              {%- if child.links.size > 0 -%}
                {%- assign has_grandchildren = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            <li class="nav-item nav-item-has-children{% if has_grandchildren %} nav-item-has-megamenu{% endif %}">
              <a href="{{ link.url }}" class="nav-link">
                {{ link.title }}
                <svg class="nav-link-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </a>
              {%- if has_grandchildren -%}
                <!-- MEGA-MENU : colonnes par sous-categorie -->
                <div class="nav-megamenu">
                  <div class="nav-megamenu-columns">
                    {%- for child in link.links -%}
                      {%- if child.links.size > 0 -%}
                        <div class="nav-megamenu-column">
                          <a href="{{ child.url }}" class="nav-megamenu-column-title">{{ child.title }}</a>
                          <ul class="nav-megamenu-links">
                            {%- for grandchild in child.links -%}
                              {%- assign _skip = false -%}
                              {%- if grandchild.type == 'collection_link' -%}
                                {%- if grandchild.object == blank or grandchild.object.products_count == 0 -%}
                                  {%- assign _skip = true -%}
                                {%- endif -%}
                              {%- endif -%}
                              {%- unless _skip -%}
                                <li><a href="{{ grandchild.url }}" class="nav-megamenu-link">{{ grandchild.title }}</a></li>
                              {%- endunless -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- else -%}
                        {%- assign _skip = false -%}
                        {%- if child.type == 'collection_link' -%}
                          {%- if child.object == blank or child.object.products_count == 0 -%}
                            {%- assign _skip = true -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- unless _skip -%}
                          <div class="nav-megamenu-column nav-megamenu-column--single">
                            <a href="{{ child.url }}" class="nav-megamenu-link">{{ child.title }}</a>
                          </div>
                        {%- endunless -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <!-- DROPDOWN SIMPLE (2 niveaux) -->
                <ul class="nav-dropdown">
                  {%- for child in link.links -%}
                    {%- assign _skip = false -%}
                    {%- if child.type == 'collection_link' -%}
                      {%- if child.object == blank or child.object.products_count == 0 -%}
                        {%- assign _skip = true -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- unless _skip -%}
                      <li><a href="{{ child.url }}" class="nav-dropdown-link">{{ child.title }}</a></li>
                    {%- endunless -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- else -%}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link{% if link.title contains 'Nouveaut' or link.title contains 'nouveaut' %} nav-link--nouveautes{% endif %}">{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <!-- Zone Droite : Badge Quiz + Icônes (TOUJOURS visible) -->
      <div class="nav-right">
        <!-- Badge Quiz Super CTA - Visible sur TOUS les écrans -->
        <a href="{{ section.settings.quiz_link | default: '/pages/diagnostic-emotionnel' }}" class="nav-quiz-badge">
          <div class="badge-content">
            <span class="badge-title">{{ section.settings.quiz_label | default: 'Trouver ma pierre' }}</span>
            {%- if section.settings.quiz_subtitle != blank -%}
              <span class="badge-subtitle">{{ section.settings.quiz_subtitle }}</span>
            {%- endif -%}
          </div>
        </a>

        <!-- Icônes -->
        <div class="nav-icons">
        <button type="button" class="nav-icon nav-search-toggle" aria-label="Rechercher" data-milaura-search-toggle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>
        <a href="{{ routes.account_url }}" class="nav-icon" aria-label="Compte">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
        {% if section.settings.show_contact_icon %}
          <a href="{{ section.settings.contact_page_url | default: '/pages/contact' }}" class="nav-icon nav-contact-icon" aria-label="Contact">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </a>
        {% endif %}
        <a href="{{ routes.cart_url }}" class="nav-icon nav-cart-icon" aria-label="Panier">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
