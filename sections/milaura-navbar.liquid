    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .milaura-search-overlay,
    .milaura-search-panel,
    .milaura-search-pill {
      transition: none;
    }
  }
</style>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const burger = document.getElementById('burger-' + sectionId);
    const closeBtn = document.getElementById('close-menu-' + sectionId);
    const mobileMenu = document.getElementById('mobile-menu-' + sectionId);
    const overlay = document.getElementById('mobile-overlay-' + sectionId);
    const desktopCartCount = document.getElementById('desktop-cart-count-' + sectionId);

    let isAnimating = false;
    let lastFocusedElement = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const menuTransitionDuration = reduceMotion ? 0 : 240;
    function setPageInert(isInert) {
      Array.from(document.querySelectorAll('main, footer')).forEach(function(target) {
        if (target.querySelector('.milaura-dock')) return;
        target.inert = isInert;
      });
    }

    function notifyMenuState(isOpen) {
      document.dispatchEvent(new CustomEvent('milaura:menu-state', {
        detail: {
          expanded: isOpen,
          controls: mobileMenu.id
        }
      }));
    }

    function openMenu() {
      if (isAnimating) return;
      isAnimating = true;
      lastFocusedElement = document.activeElement;

      burger.classList.add('active');
      burger.setAttribute('aria-expanded', 'true');
      overlay.classList.add('active');
      mobileMenu.classList.remove('closing');
      mobileMenu.classList.add('opening');
      mobileMenu.setAttribute('aria-hidden', 'false');
      setPageInert(true);
      document.body.style.overflow = 'hidden';
      notifyMenuState(true);

      setTimeout(function() {
        mobileMenu.classList.remove('opening');
        mobileMenu.classList.add('active');
        isAnimating = false;
        if (closeBtn) closeBtn.focus();
      }, menuTransitionDuration);
    }

    function closeMenu() {
      if (isAnimating) return;
      isAnimating = true;

      burger.classList.remove('active');
      burger.setAttribute('aria-expanded', 'false');
      overlay.classList.remove('active');
      mobileMenu.classList.remove('active');
      mobileMenu.classList.remove('opening');
      mobileMenu.classList.add('closing');
      mobileMenu.setAttribute('aria-hidden', 'true');
      notifyMenuState(false);

      setTimeout(function() {
        mobileMenu.classList.remove('closing');
        isAnimating = false;
        document.body.style.overflow = '';
        setPageInert(false);
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
      }, menuTransitionDuration);
    }

    // Événements burger
    if (burger) {
      burger.addEventListener('click', function() {
        if (mobileMenu.classList.contains('active') || mobileMenu.classList.contains('opening')) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    }

    // Fermer au clic sur l'overlay
    if (overlay) {
      overlay.addEventListener('click', closeMenu);
    }

    const closeLinks = mobileMenu.querySelectorAll('[data-close-menu]');
    closeLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        setTimeout(closeMenu, 100);
      });
    });

    document.addEventListener('keydown', function(e) {
      const isOpen = mobileMenu.classList.contains('active') || mobileMenu.classList.contains('opening');
      if (!isOpen) return;

      if (e.key === 'Escape') {
        closeMenu();
        return;
      }

      if (e.key === 'Tab') {
        const focusableElements = Array.from(mobileMenu.querySelectorAll(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter(function(element) {
          return element.offsetParent !== null && window.getComputedStyle(element).visibility !== 'hidden';
        });

        if (focusableElements.length === 0) {
          e.preventDefault();
          mobileMenu.focus();
          return;
        }

        const firstFocusable = focusableElements[0];
        const lastFocusable = focusableElements[focusableElements.length - 1];

        if (e.shiftKey && document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable.focus();
        } else if (!e.shiftKey && document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable.focus();
        }
      }
    });

    var parentItems = mobileMenu.querySelectorAll('[data-toggle-submenu]');
    parentItems.forEach(function(item) {
      item.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var submenu = item.nextElementSibling;
        var isOpen = item.getAttribute('aria-expanded') === 'true';

        parentItems.forEach(function(other) {
          other.classList.remove('open');
          other.setAttribute('aria-expanded', 'false');
          if (other.nextElementSibling) {
            other.nextElementSibling.classList.remove('open');
            other.nextElementSibling.setAttribute('aria-hidden', 'true');
          }
        });

        if (!isOpen) {
          item.classList.add('open');
          item.setAttribute('aria-expanded', 'true');
          if (submenu) {
            submenu.classList.add('open');
            submenu.setAttribute('aria-hidden', 'false');
          }
        }
      });
    });

    window.addEventListener('resize', function() {
      if (window.innerWidth > 1100 && (mobileMenu.classList.contains('active') || mobileMenu.classList.contains('opening'))) {
        closeMenu();
      }
    });

    // --- MISE À JOUR DU COMPTEUR PANIER ---
    function updateCartCount() {
      if (typeof fetch !== 'undefined') {
        fetch('/cart.js')
          .then(function(response) { return response.json(); })
          .then(function(cart) {
            [desktopCartCount].forEach(function(el) {
              if (el) {
                if (cart.item_count > 0) {
                  el.textContent = cart.item_count;
                  el.style.display = 'flex';
                } else {
                  el.style.display = 'none';
                }
              }
            });
          })
          .catch(function() {});
      }
    }

    // Initialiser le compteur
    updateCartCount();

    // Écouter les changements de panier (Shopify standard)
    document.addEventListener('cart:updated', updateCartCount);

    // --- SEARCH OVERLAY ---
    var searchOverlay = document.getElementById('milaura-search-overlay-' + sectionId);
    var searchToggle = document.querySelector('#MilauraNav-' + sectionId + ' [data-milaura-search-toggle]');
    var searchInput = document.getElementById('MilauraSearch-' + sectionId);
    var searchBackdrop = searchOverlay ? searchOverlay.querySelector('.milaura-search-backdrop') : null;
    var searchCloseBtn = searchOverlay ? searchOverlay.querySelector('.milaura-search-close') : null;

    function openSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      setTimeout(function() { if (searchInput) searchInput.focus(); }, 350);
    }

    function closeSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.remove('active');
      document.body.style.overflow = '';
      if (searchInput) searchInput.blur();
    }

    if (searchToggle) searchToggle.addEventListener('click', openSearch);
    if (searchBackdrop) searchBackdrop.addEventListener('click', closeSearch);
    if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearch);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && searchOverlay && searchOverlay.classList.contains('active')) {
        closeSearch();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (searchOverlay && searchOverlay.classList.contains('active')) {
          closeSearch();
        } else {
          openSearch();
        }
      }
    });

    // Quick filter pills
    var searchPills = searchOverlay ? searchOverlay.querySelectorAll('[data-search-term]') : [];
    searchPills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var term = pill.getAttribute('data-search-term');
        if (searchInput) {
          searchInput.value = term;
          searchInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        searchPills.forEach(function(p) { p.classList.remove('active'); });
        pill.classList.add('active');
      });
    });

    // Expose globally for dock
    window.milauraOpenSearch = openSearch;

    // --- LOGO SCROLL TO TOP ---
    const logoLink = document.querySelector('#MilauraNav-' + sectionId + ' .nav-logo-link');
    if (logoLink) {
      logoLink.addEventListener('click', function(e) {
        const currentPath = window.location.pathname;
        const rootUrl = '{{ routes.root_url }}';
        const isHomepage = currentPath === rootUrl || (rootUrl === '/' && currentPath === '/');

        if (isHomepage) {
          e.preventDefault();
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        }
      });
    }
  })();
</script>

<!-- ============ TOAST GLOBAL PANIER ============ -->
<div id="milaura-cart-toast" class="milaura-cart-toast" aria-live="polite" role="status">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
  <span id="milaura-cart-toast-msg">Ajouté au panier</span>
</div>

<style>
  .milaura-cart-toast {
    position: fixed;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(27, 27, 27, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    padding: 14px 28px;
    border-radius: 50px;
    font-family: 'Lato', sans-serif;
    font-size: 15px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10000000;
    transition: top 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    pointer-events: none;
  }
  .milaura-cart-toast svg {
    color: #4CAF50;
    flex-shrink: 0;
  }
  .milaura-cart-toast.is-visible {
    top: 24px;
  }
  @media (prefers-reduced-motion: reduce) {
    .milaura-cart-toast { transition: none; }
  }
</style>

<script>
(function() {
  'use strict';
  var toastEl = document.getElementById('milaura-cart-toast');
  var msgEl = document.getElementById('milaura-cart-toast-msg');
  var timer = null;

  window.milauraCartToast = function(msg) {
    if (!toastEl || !msgEl) return;
    msgEl.textContent = msg || 'Ajouté au panier';
    toastEl.classList.add('is-visible');
    if (timer) clearTimeout(timer);
    timer = setTimeout(function() {
      toastEl.classList.remove('is-visible');
    }, 3000);
  };
})();
</script>

