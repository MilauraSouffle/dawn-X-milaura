  .milaura-search-results .predictive-search__item {
    border-radius: 12px;
    padding: 8px 12px;
    transition: background 0.2s ease;
  }

  .milaura-search-results .predictive-search__item:hover {
    background: rgba(192, 160, 98, 0.08);
  }

  .milaura-search-results .predictive-search__image {
    border-radius: 8px;
    object-fit: cover;
  }

  .milaura-search-results .predictive-search__item-heading {
    color: #000;
    font-weight: 500;
  }

  .milaura-search-results .predictive-search__item--term .svg-wrapper {
    color: var(--milaura-gold, #C0A062);
  }

  /* Search toggle button styling */
  .nav-search-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    line-height: 1;
  }

  /* Mobile */
  @media screen and (max-width: 767px) {
    .milaura-search-overlay {
      padding-top: 20px;
      align-items: flex-start;
    }

    .milaura-search-panel {
      width: 95%;
      padding: 24px 18px;
      border-radius: 20px;
      max-height: 85vh;
