            {%- endif -%}
          </div>
        </a>
        </div>
      </div><!-- fin nav-right -->

    </div>
  </div>

  <!-- Overlay du menu mobile -->
  <div class="nav-mobile-overlay" id="mobile-overlay-{{ section.id }}"></div>

  <!-- Menu mobile : écrin prune entre l'en-tête et le dock -->
  <div
    class="nav-mobile-menu"
    id="mobile-menu-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="mobile-menu-title-{{ section.id }}"
    tabindex="-1"
  >
    <div class="nav-mobile-shell">
      <div class="nav-mobile-header">
        <div class="nav-mobile-heading">
          <span class="nav-mobile-kicker">Créateur d'émotions</span>
          <h2 class="nav-mobile-title" id="mobile-menu-title-{{ section.id }}">Explorer MilAura</h2>
        </div>

        <!-- Controle utilitaire : croix or simple. Le double anneau est reserve au Cercle et aux cadres photo importants. -->
        <button type="button" class="nav-mobile-back" id="close-menu-{{ section.id }}" aria-label="Fermer le menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"/>
          </svg>
        </button>
      </div>

      <ul class="nav-mobile-links">
      {%- for link in linklists[section.settings.menu].links -%}
        {%- if link.links.size > 0 -%}
          <li>
            <button
              type="button"
              class="nav-mobile-link nav-mobile-parent"
              data-toggle-submenu
              aria-expanded="false"
              aria-controls="mobile-submenu-{{ section.id }}-{{ forloop.index }}"
            >
              <span>{{ link.title }}</span>
              <svg class="nav-link-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <ul
              class="nav-mobile-submenu"
              id="mobile-submenu-{{ section.id }}-{{ forloop.index }}"
              aria-hidden="true"
            >
              <li>
                <a href="{{ link.url }}" class="nav-mobile-sublink nav-mobile-sublink--all" data-close-menu>Tout découvrir</a>
              </li>
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  <li class="nav-mobile-group">
                    <a href="{{ child.url }}" class="nav-mobile-group-title" data-close-menu>{{ child.title }}</a>
                    <ul class="nav-mobile-group-links">
                      {%- for grandchild in child.links -%}
                        {%- assign _skip = false -%}
                        {%- if grandchild.type == 'collection_link' -%}
                          {%- if grandchild.object == blank or grandchild.object.products_count == 0 -%}
                            {%- assign _skip = true -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- unless _skip -%}
                          <li><a href="{{ grandchild.url }}" class="nav-mobile-sublink" data-close-menu>{{ grandchild.title }}</a></li>
                        {%- endunless -%}
                      {%- endfor -%}
                    </ul>
                  </li>
                {%- else -%}
                  {%- assign _skip = false -%}
                  {%- if child.type == 'collection_link' -%}
                    {%- if child.object == blank or child.object.products_count == 0 -%}
                      {%- assign _skip = true -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- unless _skip -%}
                    <li><a href="{{ child.url }}" class="nav-mobile-sublink" data-close-menu>{{ child.title }}</a></li>
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- else -%}
          <li>
            <a href="{{ link.url }}" class="nav-mobile-link{% if link.title contains 'Nouveaut' or link.title contains 'nouveaut' %} nav-mobile-link--nouveautes{% endif %}" data-close-menu>
              {{ link.title }}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
      </ul>

      <div class="nav-mobile-cercle">
        <a href="{{ routes.account_url }}" class="nav-mobile-cercle-link" data-close-menu>
          <span class="nav-mobile-cercle-mark" aria-hidden="true">
            <span class="nav-mobile-cercle-ring nav-mobile-cercle-ring--gold"></span>
            <span class="nav-mobile-cercle-ring nav-mobile-cercle-ring--aqua"></span>
          </span>
          <span class="nav-mobile-cercle-copy">
            <span class="nav-mobile-cercle-title">Le Cercle MilAura</span>
            <span class="nav-mobile-cercle-subtitle">Votre espace personnel</span>
          </span>
          <span class="nav-mobile-cercle-arrow" aria-hidden="true">→</span>
        </a>
