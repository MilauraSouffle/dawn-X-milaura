{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
{{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
{{ 'milaura-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'milaura-navigation.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign primary_menu = linklists[section.settings.menu]
  assign quiz_url = section.settings.quiz_link | default: '/pages/diagnostic-emotionnel'
  assign contact_url = section.settings.contact_page_url | default: '/pages/contact-milaura'
  assign mon_ecrin_url = settings.milaura_c1_mon_ecrin_url | default: routes.account_url
-%}

<div
  id="MilauraNav-{{ section.id }}"
  class="milaura-navigation{% if request.page_type == 'index' %} milaura-home-hero-nav{% endif %}"
  data-milaura-navigation
>
  <header class="nav-snake-wrapper">
    <div class="nav-inner">
      <button
        type="button"
        class="nav-burger"
        aria-label="Ouvrir le menu"
        aria-controls="MilauraMobileNav-{{ section.id }}"
        aria-expanded="false"
        data-nav-burger
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M4 8h16M4 16h16" />
        </svg>
      </button>

      <a href="{{ routes.root_url }}" class="nav-logo-link" aria-label="{{ shop.name | escape }}, accueil">
        {%- if section.settings.logo != blank -%}
          {{- section.settings.logo
            | image_url: height: 120
            | image_tag:
              class: 'nav-logo-img',
              loading: 'eager',
              widths: '180, 240',
              sizes: '120px',
              alt: shop.name
          -}}
        {%- else -%}
          <span class="nav-logo-text">MilAura</span>
        {%- endif -%}
      </a>

      <nav class="nav-desktop" aria-label="Navigation principale">
        <ul class="nav-links" role="list">
          {%- for link in primary_menu.links -%}
            {%- liquid
              assign link_handle = link.title | handleize
              assign nav_group = link_handle
              assign nav_display_title = link.title
              if link_handle == 'bougies-et-senteurs' or link_handle == 'bougies-senteurs' or link_handle == 'rituels-et-bien-etre' or link_handle == 'rituels-bien-etre'
                assign nav_group = 'rituels-bien-etre'
                assign nav_display_title = 'Rituels & bien-être'
              endif
              assign has_curated_children = false
              if nav_group == 'bijoux' or nav_group == 'pierres' or nav_group == 'rituels-bien-etre' or nav_group == 'cadeaux' or nav_group == 'guides'
                assign has_curated_children = true
              endif
            -%}
            {%- if link.links.size > 0 or has_curated_children -%}
              <li class="nav-item">
                <button
                  type="button"
                  class="nav-link"
                  aria-expanded="false"
                  aria-controls="MilauraDropdown-{{ section.id }}-{{ forloop.index }}"
                  data-nav-desktop-toggle
                >
                  {{ nav_display_title | escape }}
                  <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m7 9 5 5 5-5" />
                  </svg>
                </button>

                <div class="nav-dropdown" id="MilauraDropdown-{{ section.id }}-{{ forloop.index }}">
                  <ul class="nav-dropdown-list{% unless nav_group == 'bijoux' %} nav-dropdown-list--single{% endunless %}" role="list">
                    {%- if has_curated_children -%}
                      {%- render 'milaura-nav-curated-links', group: nav_group, mobile: false -%}
                    {%- else -%}
                      {%- for child in link.links -%}
                        {%- liquid
                          assign skip_child = false
                          if child.type == 'collection_link'
                            if child.object == blank or child.object.products_count == 0
                              assign skip_child = true
                            endif
                          endif
                        -%}
                        {%- unless skip_child -%}
                          {%- if child.links.size > 0 -%}
                            <li class="nav-dropdown-column">
                              <a class="nav-dropdown-column-title" href="{{ child.url }}">{{ child.title | escape }}</a>
                              <ul role="list">
                                {%- for grandchild in child.links -%}
                                  {%- liquid
                                    assign skip_grandchild = false
                                    if grandchild.type == 'collection_link'
                                      if grandchild.object == blank or grandchild.object.products_count == 0
                                        assign skip_grandchild = true
                                      endif
                                    endif
                                  -%}
                                  {%- unless skip_grandchild -%}
                                    <li>
                                      <a class="nav-dropdown-link" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                                    </li>
                                  {%- endunless -%}
                                {%- endfor -%}
                              </ul>
                            </li>
                          {%- else -%}
                            <li>
                              <a class="nav-dropdown-link" href="{{ child.url }}">{{ child.title | escape }}</a>
                            </li>
                          {%- endif -%}
                        {%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>
                </div>
              </li>
            {%- else -%}
              <li class="nav-item">
                <a
                  href="{{ link.url }}"
                  class="nav-link{% if link.title contains 'Nouveaut' or link.title contains 'nouveaut' %} nav-link--nouveautes{% endif %}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="{{ quiz_url }}" class="nav-quiz-badge">
          <span class="badge-title">{{ section.settings.quiz_label | default: 'Trouver ma pierre' | escape }}</span>
        </a>

        <div class="nav-icons">
          <button type="button" class="nav-icon" aria-label="Rechercher" data-milaura-search-toggle>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
          </button>

          <a href="{{ mon_ecrin_url }}" class="nav-icon nav-account-icon" aria-label="Mon Écrin, mon compte">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="8" r="3.4" />
              <path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6" />
            </svg>
          </a>

          {%- if section.settings.show_contact_icon -%}
            <a href="{{ contact_url }}" class="nav-icon nav-contact-icon" aria-label="Contacter MilAura">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 5.5h16v11H8l-4 3v-14Z" />
                <path d="M8 10h8M8 13h5" />
              </svg>
            </a>
          {%- endif -%}

          <a href="{{ routes.cart_url }}" class="nav-icon nav-cart-icon" aria-label="Panier">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 8h14l-1 12H6L5 8Z" />
              <path d="M9 9V6a3 3 0 0 1 6 0v3" />
            </svg>
            <span id="cart-icon-bubble">
              {%- if cart != empty -%}
                <span class="nav-cart-count">{{ cart.item_count }}</span>
              {%- endif -%}
            </span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <div
    class="nav-overlay"
    id="MilauraMobileNav-{{ section.id }}"
    aria-hidden="true"
    data-nav-mobile
  >
    <button type="button" class="nav-overlay-backdrop" aria-label="Fermer le menu" data-nav-mobile-backdrop></button>
    <div class="nav-mobile-panel" role="dialog" aria-modal="true" aria-labelledby="MilauraMobileTitle-{{ section.id }}">
      <div class="nav-mobile-header">
        <div class="nav-mobile-brand">
          {%- if section.settings.logo != blank -%}
            {{- section.settings.logo
              | image_url: height: 96
              | image_tag:
                class: 'nav-mobile-brand-logo',
                loading: 'eager',
                widths: '72, 96',
                sizes: '48px',
                alt: ''
            -}}
          {%- endif -%}
          <span class="nav-mobile-eyebrow">MilAura</span>
          <h2 class="nav-mobile-title" id="MilauraMobileTitle-{{ section.id }}">Bijoux &amp; émotions</h2>
        </div>
        <button type="button" class="nav-panel-close" aria-label="Fermer le menu" data-nav-mobile-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <nav aria-label="Navigation mobile">
        <ul class="nav-mobile-list" role="list">
          {%- for link in primary_menu.links -%}
            {%- liquid
              assign mobile_link_handle = link.title | handleize
              assign mobile_nav_group = mobile_link_handle
              assign mobile_nav_display_title = link.title
              if mobile_link_handle == 'bougies-et-senteurs' or mobile_link_handle == 'bougies-senteurs' or mobile_link_handle == 'rituels-et-bien-etre' or mobile_link_handle == 'rituels-bien-etre'
                assign mobile_nav_group = 'rituels-bien-etre'
                assign mobile_nav_display_title = 'Rituels & bien-être'
              endif
              assign mobile_has_curated_children = false
              if mobile_nav_group == 'bijoux' or mobile_nav_group == 'pierres' or mobile_nav_group == 'rituels-bien-etre' or mobile_nav_group == 'cadeaux' or mobile_nav_group == 'guides'
                assign mobile_has_curated_children = true
              endif
            -%}
            <li>
              {%- if link.links.size > 0 or mobile_has_curated_children -%}
                <details>
                  <summary class="nav-mobile-summary">
                    <span>{{ mobile_nav_display_title | escape }}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                      <path d="m7 9 5 5 5-5" />
                    </svg>
                  </summary>
                  <ul class="nav-mobile-sublist" role="list">
                    {%- if mobile_has_curated_children -%}
                      {%- render 'milaura-nav-curated-links', group: mobile_nav_group, mobile: true -%}
                    {%- else -%}
                      {%- for child in link.links -%}
                        {%- liquid
                          assign skip_mobile_child = false
                          if child.type == 'collection_link'
                            if child.object == blank or child.object.products_count == 0
                              assign skip_mobile_child = true
                            endif
                          endif
                        -%}
                        {%- unless skip_mobile_child -%}
                          <li>
                            <a class="{% if child.links.size > 0 %}nav-mobile-group-title{% else %}nav-mobile-sublink{% endif %}" href="{{ child.url }}" data-nav-close-mobile>
                              {{ child.title | escape }}
                            </a>
                            {%- if child.links.size > 0 -%}
                              <ul class="nav-mobile-sublist" role="list">
                                {%- for grandchild in child.links -%}
                                  {%- liquid
                                    assign skip_mobile_grandchild = false
                                    if grandchild.type == 'collection_link'
                                      if grandchild.object == blank or grandchild.object.products_count == 0
                                        assign skip_mobile_grandchild = true
                                      endif
                                    endif
                                  -%}
                                  {%- unless skip_mobile_grandchild -%}
                                    <li>
                                      <a class="nav-mobile-sublink" href="{{ grandchild.url }}" data-nav-close-mobile>{{ grandchild.title | escape }}</a>
                                    </li>
                                  {%- endunless -%}
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </ul>
                </details>
              {%- else -%}
                <a class="nav-mobile-direct" href="{{ link.url }}" data-nav-close-mobile>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="nav-mobile-utilities">
        <a class="nav-mobile-utility" href="{{ quiz_url }}">Trouver ma pierre</a>
        <button type="button" class="nav-mobile-utility" data-milaura-search-toggle>Rechercher</button>
        <a class="nav-mobile-utility" href="{{ contact_url }}">Nous contacter</a>
        <a class="nav-mobile-utility" href="{{ routes.cart_url }}">Voir le panier</a>
        <a class="nav-mobile-circle" href="{{ mon_ecrin_url }}">
          <span class="nav-mobile-circle-mark" aria-hidden="true"></span>
          <span>
            <span class="nav-mobile-circle-title">Mon Écrin</span>
            <span class="nav-mobile-circle-copy">Votre compte, vos commandes et votre pierre</span>
          </span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="nav-search-overlay" aria-hidden="true" data-nav-search>
    <button type="button" class="nav-search-backdrop" aria-label="Fermer la recherche" data-nav-search-backdrop></button>
    <div class="nav-search-panel" role="dialog" aria-modal="true" aria-labelledby="MilauraSearchTitle-{{ section.id }}">
      <div class="nav-search-header">
        <div>
          <span class="nav-search-eyebrow">Recherche</span>
          <h2 class="nav-search-title" id="MilauraSearchTitle-{{ section.id }}">Que cherchez-vous ?</h2>
        </div>
        <button type="button" class="nav-search-close" aria-label="Fermer la recherche" data-nav-search-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      {%- if settings.predictive_search_enabled -%}
        <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- else -%}
        <search-form>
      {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="nav-search-form">
          <div class="nav-search-field">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-4-4" />
            </svg>
            <input
              id="MilauraSearchInput-{{ section.id }}"
              class="nav-search-input search__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Un bijou, une pierre, un rituel"
              data-nav-search-input
              {% if settings.predictive_search_enabled %}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {% endif %}
            >
            <input type="hidden" name="options[prefix]" value="last">
          </div>

          <ul class="nav-search-links" role="list" aria-label="Accès rapides">
            <li><a href="{{ routes.collections_url }}/bijoux-pierres-naturelles">Tous les bijoux</a></li>
            <li><a href="/pages/bijoux-par-pierre">Bijoux par pierre</a></li>
            <li><a href="{{ routes.collections_url }}/rituels-bien-etre">Rituels & bien-être</a></li>
            <li><a href="{{ routes.collections_url }}/nouveautes">Nouveautés</a></li>
          </ul>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- else -%}
        </search-form>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="milaura-cart-toast" aria-live="polite" role="status" data-milaura-cart-toast>
  <span aria-hidden="true">✓</span>
  <span data-milaura-cart-toast-copy>Ajouté au panier</span>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification' -%}
{%- endif -%}

{% schema %}
{
  "name": "Navigation MilAura",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Orientation"
    },
    {
      "type": "text",
      "id": "quiz_label",
      "label": "Libellé du diagnostic",
      "default": "Trouver ma pierre"
    },
    {
      "type": "url",
      "id": "quiz_link",
      "label": "Lien du diagnostic"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "checkbox",
      "id": "show_contact_icon",
      "label": "Afficher le contact",
      "default": true
    },
    {
      "type": "url",
      "id": "contact_page_url",
      "label": "Page de contact"
    }
  ],
  "presets": [
    {
      "name": "Navigation MilAura"
    }
  ]
}
{% endschema %}
