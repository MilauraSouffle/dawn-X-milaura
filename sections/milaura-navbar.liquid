      <nav class="nav-mobile-secondary" aria-label="Découvrir MilAura">
        <a href="{{ routes.root_url }}pages/notre-histoire" data-close-menu>Notre histoire</a>
        <a href="{{ routes.root_url }}blogs/journal" data-close-menu>Le Journal</a>
      </nav>
    </div>
  </div>
</div>

<!-- ============ SEARCH OVERLAY MILAURA ============ -->
<div class="milaura-search-overlay" id="milaura-search-overlay-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Rechercher">
  <div class="milaura-search-backdrop"></div>
  <div class="milaura-search-panel">
    <div class="milaura-search-header">
      <span class="milaura-search-title">Rechercher</span>
      <button type="button" class="milaura-search-close" aria-label="Fermer la recherche">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="milaura-search-body">

    {%- if settings.predictive_search_enabled -%}
      <predictive-search class="milaura-search-form-wrapper" data-loading-text="{{ 'accessibility.loading' | t }}">
    {%- else -%}
      <search-form class="milaura-search-form-wrapper">
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" role="search" class="milaura-search-form">
      <div class="milaura-search-input-wrapper">
        <svg class="milaura-search-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          class="milaura-search-input search__input field__input"
          id="MilauraSearch-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Que cherchez-vous ?"
          {%- if settings.predictive_search_enabled -%}
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          {%- endif -%}
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="reset" class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}" aria-label="Effacer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="milaura-search-hint">
        <span class="milaura-search-kbd">Esc</span> pour fermer
        <span class="milaura-search-hint-sep">·</span>
        <span class="milaura-search-kbd">⌘K</span> pour ouvrir
      </div>

      <div class="milaura-search-filters">
        <span class="milaura-search-filters-label">Recherches rapides</span>
        <div class="milaura-search-pills">
          <button type="button" class="milaura-search-pill" data-search-term="pierres">💎 Pierres</button>
          <button type="button" class="milaura-search-pill" data-search-term="bracelet">📿 Bracelets</button>
          <button type="button" class="milaura-search-pill" data-search-term="bougies">🕯️ Bougies</button>
          <button type="button" class="milaura-search-pill" data-search-term="bijoux">✨ Bijoux</button>
          <button type="button" class="milaura-search-pill" data-search-term="senteurs">🌸 Senteurs</button>
          <button type="button" class="milaura-search-pill" data-search-term="améthyste">Améthyste</button>
          <button type="button" class="milaura-search-pill" data-search-term="quartz rose">Quartz rose</button>
          <button type="button" class="milaura-search-pill" data-search-term="labradorite">Labradorite</button>
          <button type="button" class="milaura-search-pill" data-search-term="œil de tigre">Oeil de tigre</button>
        </div>
      </div>

      {%- if settings.predictive_search_enabled -%}
        <div class="predictive-search predictive-search--header milaura-search-results" tabindex="-1" data-predictive-search>
          {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
        </div>
        <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
      {%- endif -%}
    </form>

    {%- if settings.predictive_search_enabled -%}
      </predictive-search>
    {%- else -%}
      </search-form>
    {%- endif -%}
    </div>{%- comment -%} fin milaura-search-body {%- endcomment -%}
  </div>
</div>

<style>
  /* ============================================
     MILAURA SEARCH OVERLAY - VISION OS
     ============================================ */
  .milaura-search-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1000001;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 110px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .milaura-search-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .milaura-search-backdrop {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .milaura-search-panel {
    position: relative;
    width: 92%;
    max-width: 640px;
    background: rgba(253, 251, 247, 0.96);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(192, 160, 98, 0.3);
    border-radius: 24px;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.12),
      0 0 0 1px rgba(192, 160, 98, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transform: translateY(-20px) scale(0.98);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    max-height: 75vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .milaura-search-overlay.active .milaura-search-panel {
    transform: translateY(0) scale(1);
  }

  /* Search header (title + close) - always visible */
  .milaura-search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px 24px;
    flex-shrink: 0;
    border-bottom: 1px solid rgba(192, 160, 98, 0.1);
  }

  @media screen and (max-width: 767px) {
    .milaura-search-header {
      padding: 16px 18px 14px 18px;
    }
  }

  /* Scrollable body */
  .milaura-search-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px 24px 24px;
  }

  @media screen and (max-width: 767px) {
    .milaura-search-body {
      padding: 16px 18px 20px 18px;
    }
  }

  .milaura-search-title {
    font-family: var(--font-heading-family, 'Playfair Display'), serif;
    font-size: 18px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.7);
    letter-spacing: 0.02em;
  }

  /* Close button */
  .milaura-search-close {
    width: 36px; height: 36px;
    min-width: 36px;
    border: 1px solid rgba(192, 160, 98, 0.25);
    background: rgba(255, 255, 255, 0.7);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    padding: 0;
    flex-shrink: 0;
  }

  @media screen and (max-width: 767px) {
    .milaura-search-close {
      width: 40px; height: 40px;
      min-width: 40px;
    }
  }

  .milaura-search-close svg {
    width: 16px; height: 16px;
    color: rgba(0, 0, 0, 0.5);
  }

  .milaura-search-close:hover {
    background: rgba(192, 160, 98, 0.12);
    border-color: rgba(192, 160, 98, 0.4);
  }

  .milaura-search-close:hover svg {
    color: var(--milaura-gold-dark, #8F723A);
  }

  /* Search input */
  .milaura-search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .milaura-search-input-icon {
    position: absolute;
    left: 20px;
    width: 20px; height: 20px;
    color: var(--milaura-gold, #C0A062);
    pointer-events: none;
  }

  .milaura-search-input {
    width: 100%;
    padding: 16px 50px 16px 52px;
    font-family: 'Lato', sans-serif;
    font-size: 1.05rem;
    border: 1px solid rgba(192, 160, 98, 0.25);
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    outline: none;
    color: #000;
    transition: all 0.3s ease;
    -webkit-appearance: none;
  }

  .milaura-search-input::placeholder {
    color: rgba(0, 0, 0, 0.3);
    font-style: italic;
  }

  .milaura-search-input:focus {
    border-color: var(--milaura-gold, #C0A062);
    box-shadow: 0 0 0 4px rgba(192, 160, 98, 0.12);
    background: rgba(255, 255, 255, 0.9);
  }

  .milaura-search-input-wrapper .reset__button {
    position: absolute;
    right: 14px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: rgba(0, 0, 0, 0.3);
  }

  .milaura-search-input-wrapper .reset__button:hover {
    color: rgba(0, 0, 0, 0.6);
  }

  /* Keyboard hints */
  .milaura-search-hint {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.3);
  }

  @media screen and (min-width: 768px) {
    .milaura-search-hint {
      display: flex;
    }
  }

  .milaura-search-kbd {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 5px;
    font-family: 'SF Mono', 'Menlo', monospace;
    font-size: 11px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .milaura-search-hint-sep {
    color: rgba(0, 0, 0, 0.15);
  }

  /* Quick filter pills */
  .milaura-search-filters {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(192, 160, 98, 0.1);
  }

  .milaura-search-filters-label {
    display: block;
    font-family: var(--font-heading-family, 'Playfair Display'), serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.5);
    margin-bottom: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .milaura-search-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .milaura-search-pill {
    padding: 7px 16px;
    border: 1px solid rgba(192, 160, 98, 0.25);
    border-radius: 50px;
    background: rgba(192, 160, 98, 0.06);
    font-family: 'Lato', sans-serif;
    font-size: 13px;
    color: var(--milaura-gold-dark, #8F723A);
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .milaura-search-pill:hover {
    background: rgba(192, 160, 98, 0.15);
    border-color: rgba(192, 160, 98, 0.4);
    transform: translateY(-1px);
  }

  .milaura-search-pill.active {
    background: var(--milaura-gold, #C0A062);
    color: #fff;
    border-color: var(--milaura-gold, #C0A062);
    box-shadow: 0 4px 12px rgba(192, 160, 98, 0.3);
  }

  /* Predictive search results overrides */
  .milaura-search-results {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    margin-top: 16px;
    max-height: 35vh;
    overflow-y: auto;
    border-top: 1px solid rgba(192, 160, 98, 0.1) !important;
    padding-top: 12px;
  }

  .milaura-search-results .predictive-search__results-groups-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .milaura-search-results .predictive-search__heading {
    font-family: var(--font-heading-family, 'Playfair Display'), serif;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--milaura-gold-dark, #8F723A);
