{{ 'milaura-home-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign journal_blog = blogs[section.settings.blog_handle]
  assign journal_url = journal_blog.url | default: '/blogs/journal'
-%}

<section
  class="milaura-home-editorial"
  aria-labelledby="MilauraHomeEditorialTitle-{{ section.id }}"
>
  <div class="milaura-home-editorial__inner">
    <div class="milaura-home-editorial__heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="milaura-home-editorial__eyebrow milaura-section-label">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="MilauraHomeEditorialTitle-{{ section.id }}" class="milaura-home-editorial__title milaura-section-title">
        {{ section.settings.title | escape }}
      </h2>
      {%- if section.settings.lead != blank -%}
        <p class="milaura-home-editorial__lead">{{ section.settings.lead | escape }}</p>
      {%- endif -%}
    </div>

    <nav class="milaura-home-editorial__links" aria-label="Journal et histoire MilAura">
      <a class="milaura-home-editorial__link milaura-home-editorial__link--primary milaura-action milaura-action--primary" href="{{ journal_url }}">
        <span>{{ section.settings.journal_label | escape }}</span>
        {% render 'milaura-action-icon' %}
      </a>
      {%- if section.settings.story_link != blank and section.settings.story_label != blank -%}
        <a class="milaura-home-editorial__link milaura-home-editorial__link--secondary milaura-action milaura-action--editorial" href="{{ section.settings.story_link }}">
          <span>{{ section.settings.story_label | escape }}</span>
          {% render 'milaura-action-icon' %}
        </a>
      {%- endif -%}
    </nav>
  </div>
</section>

{% schema %}
{
  "name": "MilAura Bandeau guides",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Le regard de Karine"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Choisir avec des repères simples."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Description",
      "default": "Vertus, entretien, choix d’un bijou ou d’une première pierre : Karine partage ses conseils pour vous aider à trouver ce qui vous correspond."
    },
    {
      "type": "text",
      "id": "blog_handle",
      "label": "Handle du Journal",
      "default": "journal"
    },
    {
      "type": "text",
      "id": "journal_label",
      "label": "Lien Journal",
      "default": "Lire le Journal"
    },
    {
      "type": "url",
      "id": "story_link",
      "label": "Lien histoire"
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Libellé histoire",
      "default": "Découvrir MilAura"
    }
  ],
  "presets": [
    {
      "name": "MilAura Bandeau guides"
    }
  ]
}
{% endschema %}
