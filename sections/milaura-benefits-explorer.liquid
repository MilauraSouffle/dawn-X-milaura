{%- liquid
  assign is_landing = false
  if section.settings.presentation == 'landing'
    assign is_landing = true
  endif

  assign query_parameter = section.settings.query_parameter | default: 'intention' | handleize
  assign landing_title = section.settings.landing_title | default: 'Quelle pierre choisir ?'
  assign landing_intro_text = section.settings.landing_intro | strip_html | strip
-%}

{% style %}
  /* ============================================
     MILAURA BENEFITS EXPLORER - V10 (HYBRID)
     Desktop: Navigation classique + Cartes
     Mobile: Accordéon optimisé conversion
     ============================================ */

  #MilauraBenefits-{{ section.id }} {
    width: 100%;
    padding: 1px 0 var(--milaura-spacing-md) 0;
    background: transparent;
    margin-top: 4px;
    margin-bottom: var(--milaura-spacing-sm);
    transition: background-image 0.5s ease-in-out;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing {
    --benefits-ink: #2f222d;
    --benefits-plum: #603b5f;
    --benefits-aqua: #6fa9a6;
    --benefits-gold: #b9975b;
    --benefits-nacre: #fbf8f3;
    margin: 0;
    padding: 0 0 clamp(48px, 7vw, 96px);
    color: var(--benefits-ink);
    background: var(--benefits-nacre);
    font-family: var(--milaura-font-texte);
    overflow: hidden;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-hero {
    position: relative;
    width: min(calc(100% - 44px), 1380px);
    min-height: 310px;
    display: grid;
    grid-template-columns: minmax(330px, 0.78fr) minmax(520px, 1.22fr);
    align-items: center;
    gap: clamp(30px, 4vw, 62px);
    margin: 0 auto;
    padding: clamp(18px, 2vw, 28px) 0;
    border-bottom: 1px solid rgba(47, 34, 45, 0.13);
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-copy {
    min-width: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    color: var(--benefits-aqua);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-kicker::before {
    content: '';
    width: 34px;
    height: 1px;
    background: currentColor;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-title {
    max-width: 9ch;
    margin: 0;
    color: var(--benefits-ink);
    font-family: var(--milaura-font-display);
    font-size: clamp(4rem, 4.5vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-wrap: balance;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-accent {
    display: block;
    max-width: 24ch;
    margin-top: 8px;
    color: var(--benefits-plum);
    font-family: var(--milaura-font-display);
    font-size: clamp(1.75rem, 2vw, 2.7rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-intro {
    max-width: 48ch;
    margin: 16px 0 0;
    color: rgba(47, 34, 45, 0.76);
    font-size: clamp(1.35rem, 1.15vw, 1.6rem);
    line-height: 1.52;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin-top: 20px;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-start {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid var(--benefits-ink);
    border-radius: 6px;
    color: var(--benefits-nacre);
    background: var(--benefits-ink);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.095em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-start span {
    color: var(--benefits-gold);
    font-size: 1.6rem;
    line-height: 1;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-start:hover {
    color: var(--benefits-ink);
    background: transparent;
    transform: translateY(-2px);
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-start:focus-visible {
    outline: 2px solid var(--benefits-aqua);
    outline-offset: 4px;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-disclaimer {
    width: min(calc(100% - 36px), 900px);
    margin: 16px auto 0;
    color: rgba(47, 34, 45, 0.6);
    font-size: 1.1rem;
    line-height: 1.45;
    text-align: center;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-triptych {
    height: clamp(270px, 24vw, 318px);
    display: flex;
    gap: clamp(7px, 0.9vw, 12px);
    min-width: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(47, 34, 45, 0.18);
    border-radius: 5px;
    color: #fff;
    background: #e8e1da;
    text-decoration: none;
    box-shadow: 0 16px 38px rgba(47, 34, 45, 0.1);
    opacity: 0;
    transform: translateY(18px);
    animation: benefitsTriptychReveal 620ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    transition: flex 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 280ms ease, box-shadow 280ms ease;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:nth-child(2) {
    animation-delay: 90ms;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:nth-child(3) {
    animation-delay: 180ms;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:hover,
  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:focus-visible {
    flex-grow: 1.32;
    z-index: 2;
    transform: translateY(-4px);
    box-shadow: 0 24px 48px rgba(47, 34, 45, 0.17);
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:focus-visible {
    outline: 2px solid var(--benefits-aqua);
    outline-offset: 3px;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.035);
    opacity: 1;
    transition: opacity 210ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1), filter 280ms ease;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:hover .benefits-triptych-image,
  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel:focus-visible .benefits-triptych-image {
    transform: scale(1.09);
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel::after {
    content: '';
    position: absolute;
    inset: 38% 0 0;
    background: linear-gradient(to bottom, transparent, rgba(28, 20, 28, 0.78));
    pointer-events: none;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-caption {
    position: absolute;
    z-index: 1;
    right: 14px;
    bottom: 14px;
    left: 14px;
    display: grid;
    gap: 3px;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 180ms ease, transform 240ms ease;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel.is-changing .benefits-triptych-image {
    opacity: 0;
    transform: scale(1.08);
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-panel.is-changing .benefits-triptych-caption {
    opacity: 0;
    transform: translateY(7px);
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-stone {
    font-family: var(--milaura-font-display);
    font-size: clamp(1.7rem, 1.7vw, 2.5rem);
    line-height: 1;
  }

  #MilauraBenefits-{{ section.id }} .benefits-triptych-intention {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  @keyframes benefitsTriptychReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-dashboard {
    width: min(94%, 1320px);
    padding: clamp(18px, 3vw, 42px);
    border: 1px solid rgba(185, 151, 91, 0.35);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 26px 80px rgba(47, 34, 45, 0.08);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background-position: center;
    background-size: cover;
    background-blend-mode: soft-light;
    transition: background-image 0.5s ease-in-out;
    scroll-margin-top: 120px;
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-header {
    max-width: 760px;
    display: block;
    margin: 0 auto clamp(28px, 4vw, 46px);
    padding: 0;
    border: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-subtitle {
    font-size: clamp(1.45rem, 1.5vw, 1.7rem);
    line-height: 1.55;
  }

  /* --- CONTENEUR GLOBAL (transparent sur desktop) --- */
  #MilauraBenefits-{{ section.id }} .benefits-dashboard {
    position: relative;
    z-index: 2;
    border: none;
    box-shadow: none;
    border-radius: 0;
    background: transparent;
    margin: 0 auto;
    max-width: 1400px;
    width: 92%;
    padding: var(--milaura-spacing-md);
  }

  #MilauraBenefits-{{ section.id }} .benefits-header {
    text-align: center;
    margin-bottom: 40px;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    border: 1px solid rgba(185, 151, 91, 0.3);
    padding: 20px 30px;
    display: inline-block;
    width: auto;
    margin-left: auto;
    margin-right: auto;
  }

  /* Centrage du header inline-block */
  #MilauraBenefits-{{ section.id }} .benefits-dashboard {
    text-align: center;
  }

  #MilauraBenefits-{{ section.id }} .benefits-layout {
    text-align: left;
  }

  #MilauraBenefits-{{ section.id }} .benefits-header .milaura-heading {
    font-family: var(--milaura-font-signature);
    text-transform: none;
    margin-bottom: 10px;
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-header .milaura-heading {
    margin: 0 0 12px;
    color: var(--benefits-ink);
    font-family: var(--milaura-font-display);
    font-size: clamp(2.15rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  #MilauraBenefits-{{ section.id }} .benefits-subtitle {
    color: {{ section.settings.subtitle_color | default: '#666666' }};
    font-size: {{ section.settings.subtitle_size | default: 1.1 }}rem;
  }

  /* ============================================
     DESKTOP LAYOUT (> 990px) - STYLE CLASSIQUE
     ============================================ */
  #MilauraBenefits-{{ section.id }} .benefits-layout {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 40px;
    align-items: start;
  }

  /* --- NAVIGATION GAUCHE (DESKTOP) --- */
  #MilauraBenefits-{{ section.id }} .benefits-nav {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  /* Cacher le contenu accordéon sur desktop */
  #MilauraBenefits-{{ section.id }} .benefit-accordion-content {
    display: none;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn {
    border-radius: 20px;
    padding: 20px;
    text-align: left;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    width: 100%;
    position: relative;
    min-height: 48px;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;

    /* Style cadre bijou */
    border: 2px solid transparent;
    background:
      linear-gradient(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.95)) padding-box,
      linear-gradient(135deg,
        rgba(255, 240, 200, 0.92) 0%,
        rgba(214, 176, 96, 0.92) 18%,
        rgba(255, 232, 172, 0.92) 42%,
        rgba(176, 130, 48, 0.92) 70%,
        rgba(255, 240, 200, 0.92) 100%) border-box;
    box-shadow:
      0 10px 28px rgba(0,0,0,0.06),
      0 0 0 1px rgba(255,255,255,0.65) inset;
  }

  /* Effet shimmer au hover */
  #MilauraBenefits-{{ section.id }} .benefit-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 240, 200, 0.4) 50%,
      transparent 100%
    );
    transition: left 0.6s ease;
    pointer-events: none;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn:hover::before {
    left: 100%;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn:hover {
    transform: translateY(-3px);
    box-shadow:
      0 14px 40px rgba(0,0,0,0.10),
      0 0 0 1px rgba(255,255,255,0.75) inset,
      0 0 24px rgba(214, 176, 96, 0.28);
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn:focus-visible {
    outline: 2px solid var(--milaura-gold);
    outline-offset: 2px;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn.is-active {
    background:
      linear-gradient(rgba(255, 248, 225, 0.95), rgba(255, 248, 225, 0.95)) padding-box,
      linear-gradient(135deg,
        rgba(255, 240, 200, 1) 0%,
        rgba(214, 176, 96, 1) 18%,
        rgba(255, 232, 172, 1) 42%,
        rgba(176, 130, 48, 1) 70%,
        rgba(255, 240, 200, 1) 100%) border-box;
    box-shadow:
      0 16px 46px rgba(0,0,0,0.12),
      0 0 0 1px rgba(255,255,255,0.55) inset,
      0 0 34px rgba(214, 176, 96, 0.28);
    transform: translateY(-2px);
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn.is-active::before {
    display: none;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-content {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-text {
    flex: 1;
    min-width: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-name {
    font-family: var(--milaura-font-heading);
    font-weight: 700;
    color: {{ section.settings.btn_name_color }};
    font-size: 1.5rem;
    display: block;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-tagline {
    font-family: var(--milaura-font-body);
    font-size: 1.1rem;
    color: var(--milaura-text-light);
    display: block;
    margin-top: 6px;
  }

  #MilauraBenefits-{{ section.id }} .benefit-btn-stone {
    display: block;
    margin-top: 3px;
    color: var(--benefits-plum, #603b5f);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefit-btn-icon {
    display: none;
  }

  /* Prix caché sur desktop */
  #MilauraBenefits-{{ section.id }} .benefit-btn-price {
    display: none;
  }

  /* Chevron caché sur desktop */
  #MilauraBenefits-{{ section.id }} .benefit-btn-chevron {
    display: none;
  }

  /* --- ZONE DROITE (DESKTOP) --- */
  #MilauraBenefits-{{ section.id }} .benefits-content {
    display: grid;
    grid-template-areas: "stack";
    position: relative;
  }

  #MilauraBenefits-{{ section.id }} .benefit-card {
    grid-area: stack;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.4s ease-in-out;
    display: flex;
    align-items: center;
    padding: var(--milaura-spacing-md);
  }

  #MilauraBenefits-{{ section.id }} .benefit-card.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  /* --- BOITE TEXTE DESKTOP --- */
  #MilauraBenefits-{{ section.id }} .benefit-info-box {
    position: relative;
    z-index: 2;
    max-width: 480px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: var(--milaura-spacing-md);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    border: 2px solid transparent;
    transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  /* Badge best-seller */
  #MilauraBenefits-{{ section.id }} .benefit-badge {
    display: inline-block;
    background: linear-gradient(135deg, var(--milaura-gold) 0%, #D4B678 100%);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 12px;
  }

  #MilauraBenefits-{{ section.id }} .benefit-info-subtitle {
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 1.1rem;
    color: {{ section.settings.info_subtitle_color }};
    font-weight: 700;
    margin-bottom: 10px;
  }

  #MilauraBenefits-{{ section.id }} .benefit-info-title {
    font-family: var(--milaura-font-heading);
    font-size: 2.2rem;
    color: {{ section.settings.info_title_color }};
    margin-bottom: 15px;
    line-height: 1.2;
  }

  #MilauraBenefits-{{ section.id }} .benefit-info-desc {
    font-family: var(--milaura-font-body);
    color: var(--milaura-text);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  /* --- PRODUIT MINI DESKTOP --- */
  #MilauraBenefits-{{ section.id }} .benefit-product-mini {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.1);
    flex-wrap: wrap;
  }

  #MilauraBenefits-{{ section.id }} .benefit-product-thumb {
    width: 70px;
    height: 70px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefit-product-info {
    flex: 1;
    min-width: 0;
  }

  #MilauraBenefits-{{ section.id }} .benefit-product-title {
    font-weight: 700;
    margin-bottom: 5px;
    color: var(--milaura-text);
    font-size: 1.3rem;
  }

  #MilauraBenefits-{{ section.id }} .benefit-product-price {
    color: var(--milaura-gold);
    font-weight: 700;
    font-size: 1.4rem;
  }

  /* CTA Desktop */
  #MilauraBenefits-{{ section.id }} .benefit-product-cta {
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 160px;
    padding: 11px 24px;
    font-size: 1.05rem;
    border-radius: 999px;
    border: 1px solid rgba(214, 176, 96, 0.55);
    background: linear-gradient(
      135deg,
      rgba(255, 240, 200, 0.92) 0%,
      rgba(214, 176, 96, 0.92) 18%,
      rgba(255, 232, 172, 0.92) 42%,
      rgba(176, 130, 48, 0.92) 70%,
      rgba(255, 240, 200, 0.92) 100%
    );
    color: #000;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.3px;
    box-shadow:
      0 12px 32px rgba(130, 90, 30, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.25) inset;
    transition: transform 180ms ease, box-shadow 220ms ease;
    cursor: pointer;
  }

  #MilauraBenefits-{{ section.id }} .benefit-product-cta:hover {
    transform: translateY(-2px);
    box-shadow:
      0 16px 40px rgba(130, 90, 30, 0.20),
      0 0 0 1px rgba(255, 255, 255, 0.30) inset,
      0 0 24px rgba(214, 176, 96, 0.28);
  }

  /* Image mobile cachée sur desktop */
  #MilauraBenefits-{{ section.id }} .benefit-mobile-image {
    display: none;
  }

  /* Produit mobile caché sur desktop */
  #MilauraBenefits-{{ section.id }} .benefit-product-mobile {
    display: none;
  }

  /* ============================================
     MOBILE / TABLETTE (≤ 990px) - ACCORDÉON
     ============================================ */
  @media screen and (max-width: 990px) {
    #MilauraBenefits-{{ section.id }} {
      padding: var(--milaura-spacing-sm) 0 var(--milaura-spacing-xs) 0;
      margin-top: var(--milaura-spacing-sm);
      margin-bottom: var(--milaura-spacing-xs);
      background-image: none !important;
    }

    #MilauraBenefits-{{ section.id }} .benefits-dashboard {
      width: 94%;
      padding: 16px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(185, 151, 91, 0.4);
      box-shadow: 0 10px 40px rgba(185, 151, 91, 0.15);
      text-align: left;
    }

    #MilauraBenefits-{{ section.id }} .benefits-header {
      margin-bottom: 20px;
      padding: 0 4px;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: none;
      border-radius: 0;
      display: block;
      width: auto;
    }

    #MilauraBenefits-{{ section.id }} .benefits-layout {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Cacher la zone desktop */
    #MilauraBenefits-{{ section.id }} .benefits-content {
      display: none !important;
    }

    /* Navigation devient accordéon */
    #MilauraBenefits-{{ section.id }} .benefits-nav {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Wrapper accordéon - Cadre doré */
    #MilauraBenefits-{{ section.id }} .benefit-accordion-item {
      margin-bottom: 12px;
      border-radius: 16px;
      border: 2px solid rgba(185, 151, 91, 0.35);
      background: rgba(255, 255, 255, 0.7);
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
      box-shadow: 0 4px 15px rgba(185, 151, 91, 0.1);
    }

    #MilauraBenefits-{{ section.id }} .benefit-accordion-item:last-child {
      margin-bottom: 0;
    }

    #MilauraBenefits-{{ section.id }} .benefit-accordion-item:hover {
      border-color: rgba(185, 151, 91, 0.55);
      box-shadow: 0 6px 20px rgba(185, 151, 91, 0.18);
    }

    #MilauraBenefits-{{ section.id }} .benefit-accordion-item.is-expanded {
      border-color: var(--milaura-gold);
      box-shadow: 0 8px 30px rgba(185, 151, 91, 0.25);
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 16px 14px;
      margin: 0;
      transform: none !important;
      box-shadow: none;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn::before {
      display: none;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn:hover {
      background: rgba(185, 151, 91, 0.05);
      transform: none !important;
      box-shadow: none;
      border: none;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn.is-active {
      background: rgba(185, 151, 91, 0.08);
      border: none;
      box-shadow: none;
      transform: none !important;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-icon {
      font-size: 1.6rem;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(185, 151, 91, 0.1) 0%, rgba(185, 151, 91, 0.05) 100%);
      border-radius: 12px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-name {
      font-size: 1.3rem;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-tagline {
      font-size: 0.95rem;
      margin-top: 4px;
    }

    /* Prix visible sur mobile */
    #MilauraBenefits-{{ section.id }} .benefit-btn-price {
      display: block;
      font-family: var(--milaura-font-body);
      font-size: 0.85rem;
      color: var(--milaura-gold);
      font-weight: 700;
      margin-top: 4px;
    }

    /* Chevron accordéon visible */
    #MilauraBenefits-{{ section.id }} .benefit-btn-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: rgba(185, 151, 91, 0.15);
      border: 2px solid rgba(185, 151, 91, 0.3);
      border-radius: 50%;
      flex-shrink: 0;
      margin-left: auto;
      transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-chevron svg {
      width: 18px;
      height: 18px;
      color: var(--milaura-gold);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn:hover .benefit-btn-chevron {
      background: rgba(185, 151, 91, 0.25);
      border-color: rgba(185, 151, 91, 0.5);
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn.is-active .benefit-btn-chevron {
      background: var(--milaura-gold);
      border-color: var(--milaura-gold);
      box-shadow: 0 4px 15px rgba(185, 151, 91, 0.4);
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn.is-active .benefit-btn-chevron svg {
      color: #fff;
      transform: rotate(180deg);
    }

    /* Contenu accordéon visible sur mobile */
    #MilauraBenefits-{{ section.id }} .benefit-accordion-content {
      display: block;
      max-height: none;
      overflow: visible;
    }

    #MilauraBenefits-{{ section.id }}.is-enhanced .benefit-accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #MilauraBenefits-{{ section.id }}.is-enhanced .benefit-accordion-content.is-open {
      max-height: 1500px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-accordion-inner {
      padding: 0 8px 20px 8px;
    }

    /* Image en haut sur mobile */
    #MilauraBenefits-{{ section.id }} .benefit-mobile-image {
      display: block;
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-radius: 16px;
      margin-bottom: 16px;
      border: 2px solid rgba(185, 151, 91, 0.2);
    }

    #MilauraBenefits-{{ section.id }} .benefit-info-box {
      background: rgba(255, 255, 255, 0.95);
      padding: 20px;
      border-radius: 20px;
      max-width: 100%;
      border: 1px solid rgba(185, 151, 91, 0.15);
    }

    #MilauraBenefits-{{ section.id }} .benefit-info-title {
      font-size: 2rem;
      margin-bottom: 12px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-info-subtitle {
      font-size: 0.95rem;
      margin-bottom: 6px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-info-desc {
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    /* Produit mobile visible */
    #MilauraBenefits-{{ section.id }} .benefit-product-mobile {
      display: block;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 16px;
      padding: 14px;
      border: 1px solid rgba(185, 151, 91, 0.15);
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 14px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-thumb {
      width: 70px;
      height: 70px;
      border-radius: 14px;
      border: 2px solid rgba(185, 151, 91, 0.2);
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-title {
      font-family: var(--milaura-font-heading);
      font-size: 1.05rem;
      margin-bottom: 6px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-price {
      display: inline-block;
      background: linear-gradient(135deg, rgba(185, 151, 91, 0.15) 0%, rgba(185, 151, 91, 0.08) 100%);
      color: var(--milaura-gold-dark, #926451);
      font-weight: 800;
      font-size: 1.15rem;
      padding: 5px 12px;
      border-radius: 12px;
      border: 1px solid rgba(185, 151, 91, 0.25);
    }

    /* CTA Mobile - Gros et visible */
    #MilauraBenefits-{{ section.id }} .benefit-cta-mobile {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      min-height: 52px;
      padding: 14px 24px;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-decoration: none;
      color: #000;
      background: linear-gradient(
        135deg,
        rgba(255, 240, 200, 0.95) 0%,
        rgba(214, 176, 96, 0.95) 20%,
        rgba(255, 232, 172, 0.95) 45%,
        rgba(176, 130, 48, 0.95) 75%,
        rgba(255, 240, 200, 0.95) 100%
      );
      border: 2px solid rgba(214, 176, 96, 0.6);
      border-radius: 14px;
      box-shadow:
        0 8px 25px rgba(185, 151, 91, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
      cursor: pointer;
      animation: ctaPulse 3s ease-in-out infinite;
    }

    @keyframes ctaPulse {
      0%, 100% { box-shadow: 0 8px 25px rgba(185, 151, 91, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.5); }
      50% { box-shadow: 0 8px 35px rgba(185, 151, 91, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 0 20px rgba(185, 151, 91, 0.3); }
    }

    #MilauraBenefits-{{ section.id }} .benefit-cta-mobile:hover {
      animation: none;
    }

    #MilauraBenefits-{{ section.id }} .benefit-cta-icon {
      font-size: 1.2rem;
    }

    /* Cacher produit desktop mini sur mobile */
    #MilauraBenefits-{{ section.id }} .benefit-product-mini {
      display: none;
    }
  }

  /* Tablette : image responsive via aspect-ratio */
  @media screen and (min-width: 769px) and (max-width: 990px) {
    #MilauraBenefits-{{ section.id }} .benefit-mobile-image {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  /* Très petit mobile */
  @media screen and (max-width: 480px) {
    #MilauraBenefits-{{ section.id }} .benefits-dashboard {
      width: 96%;
      padding: 12px;
      border-radius: 20px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn {
      padding: 14px 4px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-icon {
      width: 40px;
      height: 40px;
      font-size: 1.4rem;
    }

    #MilauraBenefits-{{ section.id }} .benefit-btn-name {
      font-size: 1.2rem;
    }

    #MilauraBenefits-{{ section.id }} .benefit-mobile-image {
      height: 150px;
    }

    #MilauraBenefits-{{ section.id }} .benefit-info-title {
      font-size: 1.8rem;
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-row {
      flex-wrap: wrap;
    }

    #MilauraBenefits-{{ section.id }} .benefit-product-mobile .benefit-product-thumb {
      width: 60px;
      height: 60px;
    }
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-footer {
    width: min(92%, 960px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 26px;
    margin: clamp(34px, 5vw, 64px) auto 0;
    padding: clamp(24px, 3vw, 38px);
    border-top: 1px solid rgba(47, 34, 45, 0.16);
    border-bottom: 1px solid rgba(47, 34, 45, 0.16);
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-footer-kicker {
    margin: 0 0 8px;
    color: var(--benefits-aqua);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-footer-title {
    margin: 0;
    color: var(--benefits-ink);
    font-family: var(--milaura-font-display);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-footer-text {
    max-width: 60ch;
    margin: 10px 0 0;
    color: rgba(47, 34, 45, 0.68);
    font-size: 1.5rem;
    line-height: 1.6;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-diagnostic {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    border: 1px solid var(--benefits-plum);
    border-radius: 999px;
    color: var(--benefits-plum);
    background: transparent;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 200ms ease, background-color 200ms ease, transform 200ms ease;
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-diagnostic:hover {
    color: #fff;
    background: var(--benefits-plum);
    transform: translateY(-2px);
  }

  #MilauraBenefits-{{ section.id }} .benefits-landing-diagnostic:focus-visible {
    outline: 2px solid var(--benefits-aqua);
    outline-offset: 4px;
  }

  @media screen and (max-width: 990px) {
    #MilauraBenefits-{{ section.id }}.benefits-explorer--landing {
      padding-bottom: 56px;
      background: var(--benefits-nacre);
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-hero {
      width: min(calc(100% - 28px), 720px);
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 24px 0 20px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-title {
      max-width: 11ch;
      font-size: clamp(3.8rem, 12vw, 5.8rem);
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-triptych {
      height: clamp(170px, 42vw, 250px);
    }

    #MilauraBenefits-{{ section.id }} .benefits-triptych-caption {
      right: 10px;
      bottom: 10px;
      left: 10px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-triptych-intention {
      display: none;
    }

    #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-dashboard {
      width: min(94%, 720px);
      padding: 16px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.8);
    }

    #MilauraBenefits-{{ section.id }}.benefits-explorer--landing .benefits-header {
      padding: 8px 5px 4px;
      text-align: center;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-footer {
      grid-template-columns: 1fr;
      width: min(92%, 720px);
      padding-inline: 4px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-diagnostic {
      width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    #MilauraBenefits-{{ section.id }} .benefits-landing-hero {
      gap: 12px;
      padding: 14px 0 12px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-kicker {
      margin-bottom: 8px;
      font-size: 1rem;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-title {
      font-size: clamp(3.6rem, 11.5vw, 4.6rem);
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-accent {
      margin-top: 5px;
      font-size: 1.55rem;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-intro {
      display: none;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-actions {
      align-items: stretch;
      gap: 9px;
      margin-top: 10px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-start {
      width: 100%;
    }

    #MilauraBenefits-{{ section.id }} .benefits-landing-triptych {
      height: 112px;
      gap: 5px;
    }

    #MilauraBenefits-{{ section.id }} .benefits-triptych-stone {
      font-size: 1.05rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MilauraBenefits-{{ section.id }} *,
    #MilauraBenefits-{{ section.id }} *::before,
    #MilauraBenefits-{{ section.id }} *::after {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstyle %}

<div
  id="MilauraBenefits-{{ section.id }}"
  class="benefits-explorer{% if is_landing %} benefits-explorer--landing{% endif %}"
  data-landing-mode="{{ is_landing }}"
  data-query-parameter="{{ query_parameter }}"
>
  {%- if is_landing -%}
    <header class="benefits-landing-hero">
      <div class="benefits-landing-copy">
        {%- if section.settings.landing_eyebrow != blank -%}
          <p class="benefits-landing-kicker">{{ section.settings.landing_eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="benefits-landing-title">{{ landing_title | escape }}</h1>
        {%- if section.settings.landing_accent != blank -%}
          <span class="benefits-landing-accent">{{ section.settings.landing_accent | escape }}</span>
        {%- endif -%}
        {%- if section.settings.landing_intro != blank -%}
          <div class="benefits-landing-intro rte">{{ section.settings.landing_intro }}</div>
        {%- endif -%}
        <div class="benefits-landing-actions">
          <a class="benefits-landing-start" href="#MilauraBenefitsDashboard-{{ section.id }}">
            {{ section.settings.start_label | default: 'Commencer mon choix' | escape }}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="benefits-landing-triptych" aria-label="Trois pierres à découvrir">
        {%- for block in section.blocks limit: 3 -%}
          {%- assign stone_key = block.settings.stone_name | handleize -%}
          {%- assign intention_key = block.settings.intention_slug | strip | handleize -%}
          {%- if intention_key == blank -%}
            {%- assign intention_key = block.settings.emotion | handleize -%}
          {%- endif -%}
          {%- assign triptych_asset = blank -%}
          {%- case stone_key -%}
            {%- when 'amethyste' -%}
              {%- assign triptych_asset = 'milaura-benefit-amethyste-desktop.webp' -%}
            {%- when 'quartz-rose' -%}
              {%- assign triptych_asset = 'milaura-benefit-quartz-rose-desktop.webp' -%}
            {%- when 'citrine' -%}
              {%- assign triptych_asset = 'milaura-benefit-citrine-desktop.webp' -%}
            {%- when 'tourmaline-noire' -%}
              {%- assign triptych_asset = 'milaura-benefit-tourmaline-desktop.webp' -%}
            {%- when 'aventurine-verte' -%}
              {%- assign triptych_asset = 'milaura-benefit-aventurine-desktop.webp' -%}
          {%- endcase -%}
          <a
            class="benefits-triptych-panel"
            data-triptych-slot
            data-source-index="{{ forloop.index0 }}"
            href="?{{ query_parameter }}={{ intention_key | url_encode }}#MilauraBenefitsDashboard-{{ section.id }}"
            aria-label="Choisir {{ block.settings.stone_name | escape }} pour {{ block.settings.emotion | escape }}"
          >
            {%- if triptych_asset != blank -%}
              <img
                class="benefits-triptych-image"
                src="{{ triptych_asset | asset_url }}"
                alt="{{ block.settings.stone_name | escape }}"
                width="900"
                height="1080"
                loading="eager"
                decoding="async"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- elsif block.settings.stone_image != blank -%}
              <img
                class="benefits-triptych-image"
                src="{{ block.settings.stone_image | image_url: width: 900 }}"
                alt="{{ block.settings.stone_name | escape }}"
                width="900"
                height="1080"
                loading="eager"
                decoding="async"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- elsif block.settings.product.featured_image != blank -%}
              <img
                class="benefits-triptych-image"
                src="{{ block.settings.product.featured_image | image_url: width: 900 }}"
                alt="{{ block.settings.stone_name | escape }}"
                width="900"
                height="1080"
                loading="eager"
                decoding="async"
                {% if forloop.first %}fetchpriority="high"{% endif %}
              >
            {%- endif -%}
            <span class="benefits-triptych-caption">
              <span class="benefits-triptych-stone">{{ block.settings.stone_name | escape }}</span>
              <span class="benefits-triptych-intention">{{ block.settings.emotion | escape }}</span>
            </span>
          </a>
        {%- endfor -%}
      </div>

      <div class="benefits-triptych-sources" hidden aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- assign stone_key = block.settings.stone_name | handleize -%}
          {%- assign intention_key = block.settings.intention_slug | strip | handleize -%}
          {%- if intention_key == blank -%}
            {%- assign intention_key = block.settings.emotion | handleize -%}
          {%- endif -%}
          {%- assign triptych_asset = blank -%}
          {%- case stone_key -%}
            {%- when 'amethyste' -%}
              {%- assign triptych_asset = 'milaura-benefit-amethyste-desktop.webp' -%}
            {%- when 'quartz-rose' -%}
              {%- assign triptych_asset = 'milaura-benefit-quartz-rose-desktop.webp' -%}
            {%- when 'citrine' -%}
              {%- assign triptych_asset = 'milaura-benefit-citrine-desktop.webp' -%}
            {%- when 'tourmaline-noire' -%}
              {%- assign triptych_asset = 'milaura-benefit-tourmaline-desktop.webp' -%}
            {%- when 'aventurine-verte' -%}
              {%- assign triptych_asset = 'milaura-benefit-aventurine-desktop.webp' -%}
          {%- endcase -%}
          <span
            data-triptych-source
            data-stone="{{ block.settings.stone_name | escape }}"
            data-emotion="{{ block.settings.emotion | escape }}"
            data-intention="{{ intention_key | escape }}"
            data-href="?{{ query_parameter }}={{ intention_key | url_encode }}#MilauraBenefitsDashboard-{{ section.id }}"
            {%- if triptych_asset != blank %}
              data-image="{{ triptych_asset | asset_url }}"
            {%- elsif block.settings.stone_image != blank %}
              data-image="{{ block.settings.stone_image | image_url: width: 900 }}"
            {%- elsif block.settings.product.featured_image != blank %}
              data-image="{{ block.settings.product.featured_image | image_url: width: 900 }}"
            {%- endif %}
          ></span>
        {%- endfor -%}
      </div>
    </header>
  {%- endif -%}

  <div class="benefits-dashboard" id="MilauraBenefitsDashboard-{{ section.id }}">
    {% if section.settings.title != blank %}
      <div class="benefits-header">
        <h2 class="milaura-heading">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="benefits-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="benefits-layout">
      <!-- Navigation (Desktop: tabs, Mobile: accordéon) -->
      <nav class="benefits-nav" role="tablist" aria-label="Sélecteur de besoins">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          {%- assign stone_key = block.settings.stone_name | handleize -%}
          {%- assign optimized_stone_mobile_asset = blank -%}
          {%- case stone_key -%}
            {%- when 'amethyste' -%}
              {%- assign optimized_stone_mobile_asset = 'milaura-benefit-amethyste-mobile.webp' -%}
            {%- when 'quartz-rose' -%}
              {%- assign optimized_stone_mobile_asset = 'milaura-benefit-quartz-rose-mobile.webp' -%}
            {%- when 'citrine' -%}
              {%- assign optimized_stone_mobile_asset = 'milaura-benefit-citrine-mobile.webp' -%}
            {%- when 'tourmaline-noire' -%}
              {%- assign optimized_stone_mobile_asset = 'milaura-benefit-tourmaline-mobile.webp' -%}
            {%- when 'aventurine-verte' -%}
              {%- assign optimized_stone_mobile_asset = 'milaura-benefit-aventurine-mobile.webp' -%}
          {%- endcase -%}
          {%- assign intention_key = block.settings.intention_slug | strip | handleize -%}
          {%- if intention_key == blank -%}
            {%- assign intention_key = block.settings.emotion | handleize -%}
          {%- endif -%}
          <div
            class="benefit-accordion-item"
            data-accordion-index="{{ forloop.index0 }}"
            data-intention="{{ intention_key }}"
          >
            <button
              type="button"
              id="benefit-btn-{{ block.id }}"
              class="benefit-btn"
              data-target="benefit-{{ block.id }}"
              data-index="{{ forloop.index0 }}"
              data-intention="{{ intention_key }}"
              role="tab"
              aria-selected="false"
              aria-controls="benefit-{{ block.id }}"
              aria-expanded="false"
              {{ block.shopify_attributes }}
            >
              <div class="benefit-btn-content">
                <span class="benefit-btn-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                <div class="benefit-btn-text">
                  <span class="benefit-btn-name">{{ block.settings.emotion }}</span>
                  <span class="benefit-btn-stone">{{ block.settings.stone_name }}</span>
                  <span class="benefit-btn-tagline">{{ block.settings.tagline }}</span>
                  {%- if prod != blank -%}
                    <span class="benefit-btn-price">À partir de {{ prod.price | money }}</span>
                  {%- endif -%}
                </div>
                <div class="benefit-btn-chevron">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </div>
              </div>
            </button>

            <!-- Contenu accordéon (mobile uniquement) -->
            <div class="benefit-accordion-content" id="accordion-{{ block.id }}">
              <div class="benefit-accordion-inner">
                {%- if optimized_stone_mobile_asset != blank -%}
                  <img
                    src="{{ optimized_stone_mobile_asset | asset_url }}"
                    alt="{{ block.settings.stone_name }}"
                    class="benefit-mobile-image"
                    loading="lazy"
                    decoding="async"
                    width="640"
                    height="427"
                  >
                {%- elsif block.settings.stone_image != blank -%}
                  <img
                    src="{{ block.settings.stone_image | image_url: width: 640 }}"
                    alt="{{ block.settings.stone_name }}"
                    class="benefit-mobile-image"
                    loading="lazy"
                    decoding="async"
                    width="{{ block.settings.stone_image.width }}"
                    height="{{ block.settings.stone_image.height }}"
                  >
                {%- endif -%}

                <div class="benefit-info-box">
                  {%- if block.settings.is_bestseller -%}
                    <span class="benefit-badge">Best-seller</span>
                  {%- endif -%}
                  <div class="benefit-info-subtitle">{{ block.settings.stone_subtitle }}</div>
                  <h3 class="benefit-info-title">{{ block.settings.stone_name }}</h3>
                  <div class="benefit-info-desc">{{ block.settings.description }}</div>

                  {%- if prod != blank -%}
                    <div class="benefit-product-mobile">
                      <div class="benefit-product-row">
                        {%- if prod.featured_image -%}
                          <img
                            src="{{ prod.featured_image | image_url: width: 160 }}"
                            alt="{{ prod.title }}"
                            class="benefit-product-thumb"
                            loading="lazy"
                            decoding="async"
                            width="{{ prod.featured_image.width }}"
                            height="{{ prod.featured_image.height }}"
                          >
                        {%- endif -%}
                        <div class="benefit-product-info">
                          <div class="benefit-product-title">{{ prod.title }}</div>
                          <div class="benefit-product-price">{{ prod.price | money }}</div>
                        </div>
                      </div>
                      <a href="{{ prod.url }}" class="benefit-cta-mobile">
                        <span class="benefit-cta-icon">✨</span>
                        <span>{{ block.settings.product_cta_label | default: 'Je découvre cette pierre' }}</span>
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </nav>

      <!-- DESKTOP: Zone de contenu à droite (cartes empilées) -->
      <div class="benefits-content" id="benefits-content-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          {%- assign stone_key = block.settings.stone_name | handleize -%}
          {%- assign intention_key = block.settings.intention_slug | strip | handleize -%}
          {%- if intention_key == blank -%}
            {%- assign intention_key = block.settings.emotion | handleize -%}
          {%- endif -%}
          {%- assign optimized_stone_desktop_asset = blank -%}
          {%- case stone_key -%}
            {%- when 'amethyste' -%}
              {%- assign optimized_stone_desktop_asset = 'milaura-benefit-amethyste-desktop.webp' -%}
            {%- when 'quartz-rose' -%}
              {%- assign optimized_stone_desktop_asset = 'milaura-benefit-quartz-rose-desktop.webp' -%}
            {%- when 'citrine' -%}
              {%- assign optimized_stone_desktop_asset = 'milaura-benefit-citrine-desktop.webp' -%}
            {%- when 'tourmaline-noire' -%}
              {%- assign optimized_stone_desktop_asset = 'milaura-benefit-tourmaline-desktop.webp' -%}
            {%- when 'aventurine-verte' -%}
              {%- assign optimized_stone_desktop_asset = 'milaura-benefit-aventurine-desktop.webp' -%}
          {%- endcase -%}
          {%- assign desktop_stone_src = blank -%}
          {%- if optimized_stone_desktop_asset != blank -%}
            {%- assign desktop_stone_src = optimized_stone_desktop_asset | asset_url -%}
          {%- elsif block.settings.stone_image != blank -%}
            {%- assign desktop_stone_src = block.settings.stone_image | image_url: width: 1100 -%}
          {%- endif -%}
          <div
            id="benefit-{{ block.id }}"
            class="benefit-card {% if forloop.first %}is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="benefit-btn-{{ block.id }}"
            tabindex="0"
            data-bg-image="{{ desktop_stone_src }}"
            data-intention="{{ intention_key }}"
          >
            <div class="benefit-info-box">
              {%- if block.settings.is_bestseller -%}
                <span class="benefit-badge">Best-seller</span>
              {%- endif -%}
              <div class="benefit-info-subtitle">{{ block.settings.stone_subtitle }}</div>
              <h3 class="benefit-info-title">{{ block.settings.stone_name }}</h3>
              <div class="benefit-info-desc">{{ block.settings.description }}</div>

              {%- if prod != blank -%}
                <div class="benefit-product-mini">
                  {%- if prod.featured_image -%}
                    <img
                      src="{{ prod.featured_image | image_url: width: 160 }}"
                      alt="{{ prod.title }}"
                      class="benefit-product-thumb"
                      loading="lazy"
                      decoding="async"
                      width="{{ prod.featured_image.width }}"
                      height="{{ prod.featured_image.height }}"
                    >
                  {%- endif -%}
                  <div class="benefit-product-info">
                    <div class="benefit-product-title">{{ prod.title }}</div>
                    <div class="benefit-product-price">{{ prod.price | money }}</div>
                  </div>
                  <a href="{{ prod.url }}" class="benefit-product-cta">
                    {{ block.settings.product_cta_label | default: 'Découvrir' }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if is_landing and section.settings.landing_note != blank -%}
    <p class="benefits-landing-disclaimer">{{ section.settings.landing_note | escape }}</p>
  {%- endif -%}

  {%- if is_landing and section.settings.diagnostic_link != blank -%}
    <aside class="benefits-landing-footer" aria-labelledby="MilauraBenefitsDiagnostic-{{ section.id }}">
      <div>
        <p class="benefits-landing-footer-kicker">Pour aller plus loin</p>
        <h2 class="benefits-landing-footer-title" id="MilauraBenefitsDiagnostic-{{ section.id }}">
          {{ section.settings.diagnostic_title | default: 'Vous hésitez encore ?' | escape }}
        </h2>
        {%- if section.settings.diagnostic_text != blank -%}
          <p class="benefits-landing-footer-text">{{ section.settings.diagnostic_text | escape }}</p>
        {%- endif -%}
      </div>
      <a class="benefits-landing-diagnostic" href="{{ section.settings.diagnostic_link }}">
        {{ section.settings.diagnostic_label | default: 'Faire le diagnostic complet' | escape }}
      </a>
    </aside>
  {%- endif -%}
</div>

{%- if is_landing -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": {{ canonical_url | append: '#webpage' | json }},
          "url": {{ canonical_url | json }},
          "name": {{ landing_title | json }},
          "description": {{ landing_intro_text | json }},
          "isPartOf": {
            "@type": "WebSite",
            "url": {{ shop.url | json }},
            "name": {{ shop.name | json }}
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Accueil",
              "item": {{ shop.url | append: routes.root_url | json }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ landing_title | json }},
              "item": {{ canonical_url | json }}
            }
          ]
        }
      ]
    }
  </script>
{%- endif -%}

<script>
  (function () {
    'use strict';

    var sectionId = '{{ section.id }}';
    var container = document.getElementById('MilauraBenefits-' + sectionId);
    if (!container) return;

    var btns = Array.prototype.slice.call(container.querySelectorAll('.benefit-btn'));
    var cards = Array.prototype.slice.call(container.querySelectorAll('.benefit-card'));
    var accordionContents = Array.prototype.slice.call(container.querySelectorAll('.benefit-accordion-content'));
    var accordionItems = Array.prototype.slice.call(container.querySelectorAll('.benefit-accordion-item'));
    var navigation = container.querySelector('.benefits-nav');
    var triptych = container.querySelector('.benefits-landing-triptych');
    var triptychSlots = Array.prototype.slice.call(container.querySelectorAll('[data-triptych-slot]'));
    var triptychSources = Array.prototype.slice.call(container.querySelectorAll('[data-triptych-source]'));

    function shuffleTriptychOrder(values) {
      var shuffled = values.slice();

      for (var i = shuffled.length - 1; i > 0; i -= 1) {
        var randomIndex = Math.floor(Math.random() * (i + 1));
        var currentValue = shuffled[i];
        shuffled[i] = shuffled[randomIndex];
        shuffled[randomIndex] = currentValue;
      }

      return shuffled;
    }

    function initializeTriptychRotation() {
      if (!triptych || triptychSlots.length !== 3 || triptychSources.length < 4) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var sourceCount = triptychSources.length;
      var currentIndices = triptychSlots.map(function (slot, index) {
        var sourceIndex = Number(slot.getAttribute('data-source-index'));
        return Number.isFinite(sourceIndex) ? sourceIndex : index;
      });
      var rotationOrder = shuffleTriptychOrder(
        triptychSources.map(function (_, index) { return index; })
      );
      var rotationCursor = Math.floor(Math.random() * sourceCount);
      var rotationTicks = 0;
      var rotationPaused = false;
      var rotationTimer = null;

      triptychSources.forEach(function (source) {
        var imageUrl = source.getAttribute('data-image');
        if (!imageUrl) return;
        var preload = new Image();
        preload.src = imageUrl;
      });

      function nextIndices() {
        for (var attempt = 0; attempt < sourceCount; attempt += 1) {
          var candidate = triptychSlots.map(function (_, slotIndex) {
            return rotationOrder[(rotationCursor + slotIndex) % sourceCount];
          });

          rotationCursor = (rotationCursor + 3) % sourceCount;

          var everySlotChanges = candidate.every(function (sourceIndex, slotIndex) {
            return sourceIndex !== currentIndices[slotIndex];
          });

          if (everySlotChanges) return candidate;
        }

        return currentIndices.map(function (sourceIndex) {
          return (sourceIndex + 1) % sourceCount;
        });
      }

      function updateSlot(slot, sourceIndex, delay) {
        window.setTimeout(function () {
          var source = triptychSources[sourceIndex];
          var image = slot.querySelector('.benefits-triptych-image');
          var stone = slot.querySelector('.benefits-triptych-stone');
          var intention = slot.querySelector('.benefits-triptych-intention');
          var stoneName = source.getAttribute('data-stone') || '';
          var emotion = source.getAttribute('data-emotion') || '';
          var imageUrl = source.getAttribute('data-image') || '';

          slot.classList.add('is-changing');

          window.setTimeout(function () {
            slot.setAttribute('data-source-index', String(sourceIndex));
            slot.setAttribute('href', source.getAttribute('data-href') || '#MilauraBenefitsDashboard-' + sectionId);
            slot.setAttribute('aria-label', 'Choisir ' + stoneName + ' pour ' + emotion);

            if (image && imageUrl) {
              image.setAttribute('src', imageUrl);
              image.setAttribute('alt', stoneName);
            }
            if (stone) stone.textContent = stoneName;
            if (intention) intention.textContent = emotion;

            window.requestAnimationFrame(function () {
              slot.classList.remove('is-changing');
            });
          }, 210);
        }, delay);
      }

      function rotateTriptych() {
        if (rotationPaused || document.hidden) return;
        if (!document.documentElement.contains(container)) {
          window.clearInterval(rotationTimer);
          return;
        }

        var candidate = nextIndices();
        candidate.forEach(function (sourceIndex, slotIndex) {
          updateSlot(triptychSlots[slotIndex], sourceIndex, slotIndex * 90);
        });
        currentIndices = candidate;
        rotationTicks += 1;

        if (rotationTicks % sourceCount === 0) {
          rotationOrder = shuffleTriptychOrder(rotationOrder);
          rotationCursor = Math.floor(Math.random() * sourceCount);
        }
      }

      triptych.addEventListener('mouseenter', function () { rotationPaused = true; });
      triptych.addEventListener('mouseleave', function () { rotationPaused = false; });
      triptych.addEventListener('focusin', function () { rotationPaused = true; });
      triptych.addEventListener('focusout', function () { rotationPaused = false; });

      rotationTimer = window.setInterval(rotateTriptych, 3000);
    }

    initializeTriptychRotation();

    if (btns.length === 0) return;

    container.classList.add('is-enhanced');

    var landingMode = container.getAttribute('data-landing-mode') === 'true';
    var queryParameter = container.getAttribute('data-query-parameter') || 'intention';
    var backgroundTarget = landingMode ? container.querySelector('.benefits-dashboard') : container;
    var currentIndex = -1;
    var lastWidth = window.innerWidth;

    function normalizeIntention(value) {
      return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function requestedIntention() {
      if (!landingMode || !window.URLSearchParams) return '';

      var rawValue = new URLSearchParams(window.location.search).get(queryParameter);
      var normalizedValue = normalizeIntention(rawValue);
      var aliases = {
        apaisement: 'calme',
        anxiete: 'calme',
        serenite: 'calme',
        sommeil: 'calme',
        stress: 'calme',
        confiance: 'douceur',
        amour: 'douceur',
        motivation: 'energie',
        elan: 'energie',
        ancrage: 'protection',
        reussite: 'chance'
      };

      return aliases[normalizedValue] || normalizedValue;
    }

    function initialIndexFromQuery() {
      var intention = requestedIntention();
      if (!intention) return -1;

      return btns.findIndex(function (btn) {
        return normalizeIntention(btn.getAttribute('data-intention')) === intention;
      });
    }

    var queryIndex = initialIndexFromQuery();

    function isMobile() {
      return window.innerWidth <= 990;
    }

    function configureAccessibility() {
      var mobile = isMobile();

      if (navigation) {
        if (mobile) {
          navigation.removeAttribute('role');
        } else {
          navigation.setAttribute('role', 'tablist');
        }
      }

      btns.forEach(function (btn, index) {
        if (mobile) {
          btn.removeAttribute('role');
          btn.removeAttribute('aria-selected');
          btn.setAttribute('aria-controls', accordionContents[index].id);
          btn.setAttribute('aria-expanded', index === currentIndex ? 'true' : 'false');
        } else {
          btn.setAttribute('role', 'tab');
          btn.removeAttribute('aria-expanded');
          btn.setAttribute('aria-controls', cards[index].id);
          btn.setAttribute('aria-selected', index === currentIndex ? 'true' : 'false');
        }
      });
    }

    function shareSelection(index) {
      if (!landingMode || !window.history || !window.URL) return;

      var intention = normalizeIntention(btns[index].getAttribute('data-intention'));
      if (!intention) return;

      var nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set(queryParameter, intention);
      window.history.replaceState({}, '', nextUrl.toString());
    }

    function clearSharedSelection() {
      if (!landingMode || !window.history || !window.URL) return;

      var nextUrl = new URL(window.location.href);
      nextUrl.searchParams.delete(queryParameter);
      window.history.replaceState({}, '', nextUrl.toString());
    }

    function trackSelection(index) {
      if (!landingMode) return;

      var detail = {
        intention: normalizeIntention(btns[index].getAttribute('data-intention')),
        stone: cards[index] ? cards[index].querySelector('.benefit-info-title').textContent.trim() : ''
      };

      document.dispatchEvent(new CustomEvent('milaura:stone-intention-selected', { detail: detail }));
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'milaura_stone_intention_selected',
        milaura_intention: detail.intention,
        milaura_stone: detail.stone
      });
    }

    function closeAllMobile() {
      btns.forEach(function (btn) {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-expanded', 'false');
      });
      accordionContents.forEach(function (content) {
        content.classList.remove('is-open');
        content.setAttribute('aria-hidden', 'true');
      });
      accordionItems.forEach(function (item) {
        item.classList.remove('is-expanded');
      });
      currentIndex = -1;
      configureAccessibility();
    }

    function activateTab(index, source) {
      if (index < 0 || index >= btns.length) return;

      // Sur mobile, fermer l'onglet actif d'abord (un seul ouvert)
      if (isMobile() && currentIndex >= 0 && currentIndex !== index) {
        btns[currentIndex].classList.remove('is-active');
        btns[currentIndex].setAttribute('aria-expanded', 'false');
        accordionContents[currentIndex].classList.remove('is-open');
        accordionContents[currentIndex].setAttribute('aria-hidden', 'true');
        accordionItems[currentIndex].classList.remove('is-expanded');
      }

      currentIndex = index;

      btns.forEach(function (btn, i) {
        var isActive = i === index;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      });

      cards.forEach(function (card, i) {
        var isActive = i === index;
        card.classList.toggle('is-active', isActive);
        card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        card.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      if (!isMobile()) {
        var bgUrl = cards[index] && cards[index].getAttribute('data-bg-image');
        if (bgUrl && backgroundTarget) {
          backgroundTarget.style.backgroundImage = "url('" + bgUrl + "')";
        }
      }

      if (isMobile()) {
        accordionContents[index].classList.add('is-open');
        accordionContents[index].setAttribute('aria-hidden', 'false');
        accordionItems[index].classList.add('is-expanded');
      }

      configureAccessibility();

      if (source === 'user') {
        shareSelection(index);
        trackSelection(index);
      }
    }

    // Click : uniquement sur le bouton, rien d'autre
    btns.forEach(function (btn, i) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();

        if (isMobile() && i === currentIndex) {
          // Toggle : fermer si déjà ouvert
          closeAllMobile();
          clearSharedSelection();
          return;
        }

        activateTab(i, 'user');
      });
    });

    // Navigation clavier
    container.addEventListener('keydown', function (e) {
      if (!e.target.classList.contains('benefit-btn')) return;

      var focusedIndex = btns.indexOf(e.target);
      var newIndex = focusedIndex;

      switch (e.key) {
        case 'ArrowDown':
        case 'ArrowRight':
          e.preventDefault();
          newIndex = (focusedIndex + 1) % btns.length;
          break;
        case 'ArrowUp':
        case 'ArrowLeft':
          e.preventDefault();
          newIndex = (focusedIndex - 1 + btns.length) % btns.length;
          break;
        case 'Home':
          e.preventDefault();
          newIndex = 0;
          break;
        case 'End':
          e.preventDefault();
          newIndex = btns.length - 1;
          break;
        default:
          return;
      }

      if (newIndex !== focusedIndex) {
        activateTab(newIndex, 'user');
        btns[newIndex].focus();
      }
    });

    // Init
    function initializeState(preserveCurrent) {
      var targetIndex = preserveCurrent && currentIndex >= 0 ? currentIndex : queryIndex;

      if (!isMobile()) {
        activateTab(targetIndex >= 0 ? targetIndex : 0, 'init');
      } else {
        if (backgroundTarget) backgroundTarget.style.backgroundImage = '';
        if (targetIndex >= 0) {
          activateTab(targetIndex, 'init');
        } else {
          closeAllMobile();
        }
      }
    }

    initializeState(false);

    // Resize : uniquement si la LARGEUR change (ignore toolbar iOS)
    window.addEventListener('resize', function () {
      var newWidth = window.innerWidth;
      if (newWidth !== lastWidth) {
        lastWidth = newWidth;
        initializeState(true);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Milaura Benefits Explorer",
  "settings": [
    { "type": "header", "content": "📝 Contenu" },
    { "type": "text", "id": "title", "label": "Titre Section", "default": "De quoi as-tu besoin ?" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Trouve la pierre qui te correspond" },
    {
      "type": "select",
      "id": "presentation",
      "label": "Présentation",
      "options": [
        { "value": "embedded", "label": "Section intégrée" },
        { "value": "landing", "label": "Page guide complète" }
      ],
      "default": "embedded"
    },
    { "type": "header", "content": "Page guide complète" },
    { "type": "text", "id": "landing_eyebrow", "label": "Repère", "default": "Le guide MilAura" },
    { "type": "text", "id": "landing_title", "label": "Titre principal", "default": "Quelle pierre choisir ?" },
    { "type": "text", "id": "landing_accent", "label": "Accroche", "default": "Commencez par ce que vous souhaitez inviter dans votre quotidien." },
    {
      "type": "richtext",
      "id": "landing_intro",
      "label": "Introduction",
      "default": "<p>Le choix peut partir d'une couleur, d'un bijou ou d'une intention symbolique. Explorez les associations traditionnelles, puis découvrez une création MilAura réellement disponible.</p>"
    },
    { "type": "text", "id": "start_label", "label": "Bouton de démarrage", "default": "Commencer mon choix" },
    {
      "type": "text",
      "id": "landing_note",
      "label": "Note de transparence",
