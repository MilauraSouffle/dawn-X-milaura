{%- comment -%}
  Snippet: milaura-card-product
  Lien media + informations de la carte produit partagee.
  Le cadre et le controle d'achat appartiennent au parent
  snippets/milaura-product-card.liquid.

  Params:
  - card_product: le produit
  - img_loading: 'eager' ou 'lazy' (defaut: 'lazy')
  - show_vendor: boolean
  - show_badges: boolean (defaut: true)
  - show_secondary_image: boolean (defaut: true)
  - force_bestseller_badge: boolean
  - badge_label: texte du badge (defaut: 'Bestseller')
  - recommendation_media: boolean, active des sources plus larges pour une mise
    en avant editoriale sans modifier les cartes standard
  - recommendation_focal: boolean, ajuste le hint responsive du media focal
  - recommendation_object_asset: asset PNG transparent valide pour la scene
  - recommendation_object_width / height: dimensions intrinseques de cet asset
{%- endcomment -%}

{%- liquid
  assign secondary_image_enabled = true
  if show_secondary_image == false
    assign secondary_image_enabled = false
  endif
  assign secondary_image = card_product.images[1]
  assign primary_alt = card_product.featured_image.alt | default: card_product.title
  assign secondary_alt = secondary_image.alt | default: card_product.title
  assign recommendation_video = blank
  if recommendation_media and recommendation_focal
    assign product_videos = card_product.media | where: 'media_type', 'video'
    assign recommendation_video = product_videos.first
  endif
  assign recommendation_sizes = '(max-width: 749px) 82vw, (max-width: 989px) 60vw, 25vw'
  if recommendation_focal
    assign recommendation_sizes = '(max-width: 749px) 100vw, (max-width: 989px) 82vw, 50vw'
  endif
-%}

<a href="{{ card_product.url }}" class="grid__card">
  <div class="grid__card-img">
    {%- if show_badges != false -%}
      {%- if force_bestseller_badge or card_product.metafields.milaura.is_bestseller -%}
        <span class="grid__card-badge grid__card-badge--new">{{ badge_label | default: 'Bestseller' }}</span>
      {%- elsif card_product.available == false -%}
        <span class="grid__card-badge grid__card-badge--soldout">Rupture</span>
      {%- elsif card_product.compare_at_price > card_product.price -%}
        <span class="grid__card-badge grid__card-badge--sale">Promo</span>
      {%- else -%}
        {%- assign mc_product_date = card_product.created_at | date: '%s' | plus: 0 -%}
        {%- assign mc_thirty_days_ago = 'now' | date: '%s' | minus: 2592000 -%}
        {%- if mc_product_date > mc_thirty_days_ago -%}
          <span class="grid__card-badge grid__card-badge--new">Nouveau</span>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- if recommendation_object_asset != blank -%}
      <img
        class="grid__card-image grid__card-image--primary milaura-recommendation-card__object-image"
        src="{{ recommendation_object_asset | asset_url }}"
        alt="{{ primary_alt | escape }}"
        loading="{{ img_loading | default: 'lazy' }}"
        decoding="async"
        width="{{ recommendation_object_width | default: 1254 }}"
        height="{{ recommendation_object_height | default: 1254 }}"
      >
    {%- endif -%}

    {%- if recommendation_video != blank -%}
      {{ recommendation_video
        | video_tag:
          image_size: '960x',
          autoplay: false,
          loop: true,
          muted: true,
          controls: false,
          preload: 'metadata',
          playsinline: true,
          class: 'grid__card-image grid__card-image--primary milaura-recommendation-card__video'
      }}
    {%- elsif card_product.featured_image != blank -%}
      {%- if recommendation_media -%}
        {{ card_product.featured_image
          | image_url: width: 960
          | image_tag:
            class: 'grid__card-image grid__card-image--primary',
            loading: img_loading,
            widths: '240, 360, 480, 640, 800, 960',
            sizes: recommendation_sizes,
            alt: primary_alt,
            decoding: 'async'
        }}
      {%- else -%}
        <img
          class="grid__card-image grid__card-image--primary"
          src="{{ card_product.featured_image | image_url: width: 480 }}"
          srcset="{{ card_product.featured_image | image_url: width: 160 }} 160w,
                  {{ card_product.featured_image | image_url: width: 320 }} 320w,
                  {{ card_product.featured_image | image_url: width: 480 }} 480w"
          sizes="(max-width: 380px) 45vw, (max-width: 768px) 48vw, 25vw"
          alt="{{ primary_alt | escape }}"
          loading="{{ img_loading | default: 'lazy' }}"
          decoding="async"
          width="480"
          height="480"
        >
      {%- endif -%}
      {%- if secondary_image_enabled and secondary_image != blank -%}
        {%- if recommendation_media -%}
          {{ secondary_image
            | image_url: width: 960
            | image_tag:
              class: 'grid__card-image grid__card-image--secondary',
              loading: 'lazy',
              widths: '240, 360, 480, 640, 800, 960',
              sizes: recommendation_sizes,
              alt: secondary_alt,
              decoding: 'async'
          }}
        {%- else -%}
          <img
            class="grid__card-image grid__card-image--secondary"
            src="{{ secondary_image | image_url: width: 480 }}"
            srcset="{{ secondary_image | image_url: width: 160 }} 160w,
                    {{ secondary_image | image_url: width: 320 }} 320w,
                    {{ secondary_image | image_url: width: 480 }} 480w"
            sizes="(max-width: 380px) 45vw, (max-width: 768px) 48vw, 25vw"
            alt="{{ secondary_alt | escape }}"
            loading="lazy"
            decoding="async"
            width="480"
            height="480"
          >
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="grid__card-info">
    {%- if show_vendor and card_product.vendor != blank -%}
      <span class="grid__card-vendor">{{ card_product.vendor }}</span>
    {%- endif -%}
    <h3 class="grid__card-title">{{ card_product.title }}</h3>
    <div class="grid__card-price">
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="grid__card-price--compare">{{ card_product.compare_at_price | money }}</span>
      {%- endif -%}
      {{ card_product.price | money }}
    </div>
  </div>
</a>
