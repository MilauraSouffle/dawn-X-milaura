{%- comment -%}
  MilAura cart drawer rewards.
  Progression 30 / 50 / 80. Les avantages sont synchronises par
  milaura-cart-rewards-auto.js a partir du sous-total marchand d'origine :
  point relais offert, cadeau du mois, puis remise de 15 %.
{%- endcomment -%}

{%- if settings.milaura_cart_rewards_enabled and cart.item_count > 0 -%}
  {%- liquid
    assign threshold_1_cents = settings.milaura_reward_threshold_1 | default: 30 | times: 100
    assign threshold_2_cents = settings.milaura_reward_threshold_2 | default: 50 | times: 100
    assign threshold_3_cents = settings.milaura_reward_threshold_3 | default: 80 | times: 100
    assign reward_label_1 = settings.milaura_reward_label_1 | default: 'Point relais offert'
    assign reward_label_2 = settings.milaura_reward_label_2 | default: 'Cadeau du mois offert'
    assign reward_label_3 = settings.milaura_reward_label_3 | default: '-15 % sur la commande'
    if reward_label_1 == 'Surprise offerte'
      assign reward_label_1 = 'Point relais offert'
    endif
    if reward_label_2 == 'Livraison offerte'
      assign reward_label_2 = 'Cadeau du mois offert'
    endif
    assign paid_cart_cents = 0

    for item in cart.items
      assign is_milaura_gift = false
      if item.product.tags contains 'milaura-gift' or item.product.title contains 'Cadeau -'
        assign is_milaura_gift = true
      endif
      for property in item.properties
        if property.first == '_milaura_gift' and property.last == 'true'
          assign is_milaura_gift = true
        endif
      endfor
      unless is_milaura_gift
        assign item_paid_line_price = item.original_line_price
        if item_paid_line_price == blank
          assign item_paid_line_price = item.line_price
        endif
        if item_paid_line_price == blank
          assign item_paid_line_price = item.final_line_price
        endif
        assign paid_cart_cents = paid_cart_cents | plus: item_paid_line_price
      endunless
    endfor

    assign unlocked_rewards = 0
    if paid_cart_cents >= threshold_1_cents
      assign unlocked_rewards = 1
    endif
    if paid_cart_cents >= threshold_2_cents
      assign unlocked_rewards = 2
    endif
    if paid_cart_cents >= threshold_3_cents
      assign unlocked_rewards = 3
    endif

    assign next_threshold_cents = threshold_1_cents
    if unlocked_rewards == 1
      assign next_threshold_cents = threshold_2_cents
    elsif unlocked_rewards == 2
      assign next_threshold_cents = threshold_3_cents
    endif

    assign next_remaining_cents = next_threshold_cents | minus: paid_cart_cents | at_least: 0
    assign paid_cart_label = paid_cart_cents | money_without_trailing_zeros | remove: 'EUR' | remove: '€' | strip | append: ' €'
    assign next_remaining_label = next_remaining_cents | money_without_trailing_zeros | remove: 'EUR' | remove: '€' | strip | append: ' €'
    assign threshold_1_label = threshold_1_cents | money_without_trailing_zeros | remove: 'EUR' | remove: '€' | strip | append: ' €'
    assign threshold_2_label = threshold_2_cents | money_without_trailing_zeros | remove: 'EUR' | remove: '€' | strip | append: ' €'
    assign threshold_3_label = threshold_3_cents | money_without_trailing_zeros | remove: 'EUR' | remove: '€' | strip | append: ' €'
    assign progress_percent = paid_cart_cents | times: 100.0 | divided_by: threshold_3_cents | at_most: 100
    assign mark_1_percent = threshold_1_cents | times: 100.0 | divided_by: threshold_3_cents | at_most: 100
    assign mark_2_percent = threshold_2_cents | times: 100.0 | divided_by: threshold_3_cents | at_most: 100
  -%}

  <section class="milaura-drawer-rewards" aria-labelledby="MilauraDrawerRewardsTitle">
    <div class="milaura-drawer-rewards__heading">
      <h3 class="milaura-drawer-rewards__title" id="MilauraDrawerRewardsTitle">Vos avantages</h3>
      <p class="milaura-drawer-rewards__count">
        {{ unlocked_rewards }} avantage{% unless unlocked_rewards == 1 %}s{% endunless %} sur 3 débloqué{% unless unlocked_rewards == 1 %}s{% endunless %}
      </p>
    </div>

    {%- if unlocked_rewards > 0 -%}
      <ul class="milaura-drawer-rewards__earned milaura-drawer-rewards__earned--{{ unlocked_rewards }}" aria-label="Avantages débloqués">
        <li>
          <span class="milaura-drawer-rewards__check" aria-hidden="true">✓</span>
          <span class="milaura-drawer-rewards__earned-copy">
            <strong>Livraison en point relais offerte</strong>
            <span>Choisissez un point relais éligible au paiement.</span>
          </span>
        </li>
        {%- if unlocked_rewards >= 2 -%}
          <li>
            <span class="milaura-drawer-rewards__check" aria-hidden="true">✓</span>
            <span class="milaura-drawer-rewards__earned-copy">
              <strong>Cadeau du mois offert</strong>
              <span>Il est ajouté automatiquement au panier.</span>
            </span>
          </li>
        {%- endif -%}
        {%- if unlocked_rewards >= 3 -%}
          <li>
            <span class="milaura-drawer-rewards__check" aria-hidden="true">✓</span>
            <span class="milaura-drawer-rewards__earned-copy">
              <strong>Remise de 15 % débloquée</strong>
              <span>Elle s'applique automatiquement à la commande.</span>
            </span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    <p class="milaura-drawer-rewards__next{% if unlocked_rewards >= 3 %} is-complete{% endif %}" aria-live="polite">
      {%- if unlocked_rewards >= 3 -%}
        <strong>Tous vos avantages sont débloqués.</strong>
      {%- else -%}
        <span>Prochain avantage</span>
        <strong>
          {%- if unlocked_rewards == 0 -%}
            Plus que {{ next_remaining_label }} pour obtenir la livraison offerte en point relais.
          {%- elsif unlocked_rewards == 1 -%}
            Plus que {{ next_remaining_label }} pour recevoir le cadeau du mois.
          {%- else -%}
            Plus que {{ next_remaining_label }} pour obtenir 15 % de remise sur la commande.
          {%- endif -%}
        </strong>
      {%- endif -%}
    </p>

    <div
      class="milaura-drawer-rewards__track"
      role="progressbar"
      aria-label="Progression vers les avantages de commande"
      aria-valuemin="0"
      aria-valuemax="{{ threshold_3_cents }}"
      aria-valuenow="{{ paid_cart_cents | at_most: threshold_3_cents }}"
      aria-valuetext="{{ paid_cart_label }} sur {{ threshold_3_label }}"
    >
      <span class="milaura-drawer-rewards__fill" style="width: {{ progress_percent }}%;"></span>
      <span
        class="milaura-drawer-rewards__mark{% if unlocked_rewards >= 1 %} is-reached{% elsif unlocked_rewards == 0 %} is-next{% endif %}"
        style="left: {{ mark_1_percent }}%;"
        aria-hidden="true"
      ></span>
      <span
        class="milaura-drawer-rewards__mark{% if unlocked_rewards >= 2 %} is-reached{% elsif unlocked_rewards == 1 %} is-next{% endif %}"
        style="left: {{ mark_2_percent }}%;"
        aria-hidden="true"
      ></span>
      <span
        class="milaura-drawer-rewards__mark milaura-drawer-rewards__mark--last{% if unlocked_rewards >= 3 %} is-reached{% elsif unlocked_rewards == 2 %} is-next{% endif %}"
        aria-hidden="true"
      ></span>
    </div>

    <ol class="milaura-drawer-rewards__steps">
      <li class="{% if unlocked_rewards >= 1 %}is-reached{% else %}is-next{% endif %}">
        <span class="milaura-drawer-rewards__step-head">
          <strong>{{ threshold_1_label }}</strong>
          <small>{% if unlocked_rewards >= 1 %}Acquis{% else %}Prochain{% endif %}</small>
        </span>
        <span>{{ reward_label_1 }}</span>
      </li>
      <li class="{% if unlocked_rewards >= 2 %}is-reached{% elsif unlocked_rewards == 1 %}is-next{% endif %}">
        <span class="milaura-drawer-rewards__step-head">
          <strong>{{ threshold_2_label }}</strong>
          <small>{% if unlocked_rewards >= 2 %}Acquis{% elsif unlocked_rewards == 1 %}Prochain{% else %}À débloquer{% endif %}</small>
        </span>
        <span>{{ reward_label_2 }}</span>
      </li>
      <li class="{% if unlocked_rewards >= 3 %}is-reached{% elsif unlocked_rewards == 2 %}is-next{% endif %}">
        <span class="milaura-drawer-rewards__step-head">
          <strong>{{ threshold_3_label }}</strong>
          <small>{% if unlocked_rewards >= 3 %}Acquis{% elsif unlocked_rewards == 2 %}Prochain{% else %}À débloquer{% endif %}</small>
        </span>
        <span>{{ reward_label_3 }}</span>
      </li>
    </ol>
  </section>
{%- endif -%}

{%- if settings.milaura_cart_rewards_auto_enabled -%}
  <div
    id="MilauraCartRewardsConfig"
    hidden
    data-threshold-gift="{{ settings.milaura_reward_threshold_2 | default: 50 | times: 100 }}"
    data-threshold-shipping="{{ settings.milaura_reward_threshold_1 | default: 30 | times: 100 }}"
    data-threshold-discount="{{ settings.milaura_reward_threshold_3 | default: 80 | times: 100 }}"
    data-gift-variant-id="{{ settings.milaura_reward_gift_variant_id | default: '53142713925979' | escape }}"
    data-shipping-code="{{ settings.milaura_reward_shipping_code | default: 'MILAURA-RELAIS30' | escape }}"
    data-discount-code="{{ settings.milaura_reward_order_code | default: 'MILAURA15-80' | escape }}"
  ></div>
{%- endif -%}
