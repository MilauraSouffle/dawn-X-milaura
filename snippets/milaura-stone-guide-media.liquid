<div class="milaura-product-panel__media milaura-stone-guide__media">
  {%- if image != blank -%}
    {{- image
      | image_url: width: 1200
      | image_tag:
        class: 'milaura-product-panel__image',
        widths: '420, 620, 840, 1000, 1200',
        sizes: '(max-width: 749px) 88vw, 42vw',
        loading: 'lazy',
        alt: image_alt
    -}}
    <span class="milaura-stone-guide__identity" aria-hidden="true">
      <span class="milaura-stone-guide__identity-label">{{ identity_label | escape }}</span>
      <span class="milaura-stone-guide__identity-name">{{ stone_name | escape }}</span>
    </span>
  {%- else -%}
    {{ 'product-2' | placeholder_svg_tag: 'milaura-product-panel__placeholder' }}
  {%- endif -%}
</div>
