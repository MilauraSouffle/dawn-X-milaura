{%- if template.name == 'index' -%}
  {%- liquid
    assign transition_tone = tone | default: 'nacre'
  -%}
  <span
    class="milaura-home-transition milaura-home-transition--{{ transition_tone }}"
    aria-hidden="true"
  >
    <span class="milaura-home-transition__line"></span>
  </span>
{%- endif -%}
