{%- if settings.milaura_c1_release_candidate_enabled -%}
  <div
    data-milaura-c1-release-bridge
    data-enabled="true"
    data-logged-in="{% if customer %}true{% else %}false{% endif %}"
    data-customer-id="{{ customer.id }}"
    data-login-path="{{ routes.root_url }}customer_authentication/login"
    data-endpoint="{{ routes.root_url }}apps/milaura-c1-bridge"
    data-account-url="{{ settings.milaura_c1_mon_ecrin_url | escape }}"
    hidden
  ></div>
  <script src="{{ 'milaura-account-save-intent.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'milaura-c1-release-bridge.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
