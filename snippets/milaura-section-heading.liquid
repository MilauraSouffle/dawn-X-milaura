{%- comment -%}
  En-tete editorial MilAura reutilisable.

  Parametres :
  - eyebrow: surtitre court
  - title: titre principal
  - text: introduction optionnelle
  - heading_tag: h1 ou h2
  - heading_id: identifiant du titre
  - align: left ou center
  - size: section ou hero
  - eyebrow_style: utility ou signature
{%- endcomment -%}

{%- liquid
  assign heading_tag = heading_tag | default: 'h2'
  assign align = align | default: 'left'
  assign size = size | default: 'section'
  assign eyebrow_style = eyebrow_style | default: 'utility'
-%}

<header class="milaura-section-heading milaura-section-heading--{{ align }} milaura-section-heading--{{ size }} milaura-section-heading--eyebrow-{{ eyebrow_style }}">
  {%- if eyebrow != blank -%}
    <p class="milaura-section-heading__eyebrow milaura-section-label">{{ eyebrow | escape }}</p>
  {%- endif -%}

  {%- if title != blank -%}
    {%- if heading_tag == 'h1' -%}
      <h1{% if heading_id != blank %} id="{{ heading_id }}"{% endif %} class="milaura-section-heading__title milaura-section-title">
        {{ title | escape }}
      </h1>
    {%- else -%}
      <h2{% if heading_id != blank %} id="{{ heading_id }}"{% endif %} class="milaura-section-heading__title milaura-section-title">
        {{ title | escape }}
      </h2>
    {%- endif -%}
  {%- endif -%}

  {%- if text != blank -%}
    <p class="milaura-section-heading__text">{{ text | escape }}</p>
  {%- endif -%}
</header>
