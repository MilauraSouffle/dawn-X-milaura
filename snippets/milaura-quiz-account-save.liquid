{% comment %}2026-09-05: explicit account save, before product recommendations.{% endcomment %}
<div class="quiz-reveal-account-invite" id="quiz-reveal-account-invite-{{ section_id }}">
  <p class="quiz-reveal-account-text">Retrouvez votre pierre et vos conseils dans Mon Écrin.</p>
  {%- if settings.milaura_c1_release_candidate_enabled -%}
    <button
      type="button"
      class="quiz-reveal-account-save"
      data-milaura-c1-save-diagnostic
      aria-describedby="quiz-reveal-account-status-{{ section_id }}"
    >
      Conserver mon résultat
    </button>
    <p id="quiz-reveal-account-status-{{ section_id }}" class="quiz-reveal-account-status" aria-live="polite">
      {% if customer %}Votre résultat sera enregistré dans votre compte.{% else %}Connectez-vous ou créez votre compte par e-mail pour le conserver.{% endif %}
    </p>
    <p class="quiz-reveal-account-status">Ce choix personnalise votre pierre, vos suggestions et votre pierre préférée selon vos achats. Il ne vous inscrit pas aux e-mails ou aux SMS.</p>
    <button type="button" class="quiz-reveal-account-skip" data-milaura-c1-skip-save>
      Continuer sans enregistrer
    </button>
  {%- else -%}
    <a href="{{ routes.account_register_url }}" class="quiz-reveal-account-link">Créer mon compte</a>
  {%- endif -%}
</div>
