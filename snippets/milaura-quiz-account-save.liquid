{% comment %}2026-09-14: Mon Écrin requires a customer account; visitors keep their quiz result on this page without a false guest link.{% endcomment %}
<section
  class="quiz-reveal-account-invite"
  id="quiz-reveal-account-invite-{{ section_id }}"
  aria-labelledby="quiz-reveal-account-title-{{ section_id }}"
>
  {%- if settings.milaura_c1_release_candidate_enabled -%}
    <h3 id="quiz-reveal-account-title-{{ section_id }}" class="quiz-reveal-account-title">
      {% if customer %}Retrouver votre résultat{% else %}Conserver votre résultat{% endif %}
    </h3>
    <button
      type="button"
      class="quiz-reveal-account-save"
      data-milaura-c1-save-diagnostic
      aria-describedby="quiz-reveal-account-status-{{ section_id }}"
    >
      {% if customer %}Enregistrer dans Mon Écrin{% else %}Conserver dans Mon Écrin{% endif %}
    </button>
    <p id="quiz-reveal-account-status-{{ section_id }}" class="quiz-reveal-account-status" aria-live="polite">
      {% if customer %}Enregistrez votre pierre et vos conseils dans Mon Écrin.{% else %}Créez ou ouvrez votre compte pour retrouver votre pierre et vos conseils sur tous vos appareils.{% endif %}
    </p>
    <a href="{{ settings.milaura_c1_mon_ecrin_url | escape }}" class="quiz-reveal-account-link" data-milaura-c1-saved-link hidden>Ouvrir Mon Écrin</a>
  {%- else -%}
    <h3 id="quiz-reveal-account-title-{{ section_id }}" class="quiz-reveal-account-title">Conserver votre résultat</h3>
    <p class="quiz-reveal-account-text">Créez votre compte pour retrouver votre pierre et vos conseils dans Mon Écrin.</p>
    <a href="{{ routes.account_register_url }}" class="quiz-reveal-account-link">Créer mon compte</a>
  {%- endif -%}
</section>
