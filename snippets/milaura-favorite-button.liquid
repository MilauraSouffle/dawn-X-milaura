{%- comment -%}
  Coeur favori partage entre cartes catalogue et fiche produit.

  Params :
  - favorite_product : produit Shopify
  - favorite_placement : card ou pdp
  - favorite_detached : masque le bouton PDP jusqu a son placement dans la galerie
{%- endcomment -%}
{%- if settings.milaura_c1_release_candidate_enabled and favorite_product != blank -%}
  {%- assign favorite_position = favorite_placement | default: 'card' -%}
  <button
    type="button"
    class="milaura-favorite-button milaura-favorite-button--{{ favorite_position }} no-js-hidden"
    data-milaura-favorite
    data-product-id="gid://shopify/Product/{{ favorite_product.id }}"
    data-product-title="{{ favorite_product.title | escape }}"
    {%- if favorite_detached %} data-milaura-favorite-detached hidden{% endif -%}
    aria-label="Ajouter aux favoris : {{ favorite_product.title | escape }}"
    aria-pressed="false"
    aria-busy="true"
    title="Ajouter aux favoris"
    disabled
  >
    <svg class="milaura-favorite-button__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path class="milaura-favorite-button__backdrop" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
      <path class="milaura-favorite-button__heart" d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
    </svg>
  </button>
{%- endif -%}
