{%- comment -%}
  Navigation editoriale partagee entre desktop et mobile.

  Parametres :
  - group : bijoux, pierres, rituels-bien-etre, cadeaux ou guides
  - mobile : adapte les classes et la fermeture du panneau mobile
{%- endcomment -%}

{%- liquid
  assign link_class = 'nav-dropdown-link'
  assign featured_class = 'nav-dropdown-featured'
  assign heading_class = 'nav-dropdown-heading'
  if mobile
    assign link_class = 'nav-mobile-sublink'
    assign featured_class = 'nav-mobile-featured'
    assign heading_class = 'nav-mobile-heading'
  endif
-%}

{%- case group -%}
  {%- when 'bijoux' -%}
    <li class="{{ featured_class }}">
      <a class="{{ link_class }}" href="{{ routes.collections_url }}/bijoux-pierres-naturelles"{% if mobile %} data-nav-close-mobile{% endif %}>Tous les bijoux</a>
    </li>
    <li class="{{ heading_class }}">Par type de bijou</li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/bracelets-pierres"{% if mobile %} data-nav-close-mobile{% endif %}>Bracelets</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/colliers-pierres"{% if mobile %} data-nav-close-mobile{% endif %}>Colliers</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/bagues-pierres"{% if mobile %} data-nav-close-mobile{% endif %}>Bagues</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/boucles-oreilles"{% if mobile %} data-nav-close-mobile{% endif %}>Boucles d’oreilles</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/pendentifs"{% if mobile %} data-nav-close-mobile{% endif %}>Pendentifs</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/chaines"{% if mobile %} data-nav-close-mobile{% endif %}>Chaînes</a></li>

  {%- when 'pierres' -%}
    <li class="{{ featured_class }}">
      <a class="{{ link_class }}" href="/pages/bijoux-par-pierre"{% if mobile %} data-nav-close-mobile{% endif %}>Tous les bijoux par pierre</a>
    </li>
    <li><a class="{{ link_class }}" href="/pages/bijoux-par-pierre?view=milaura-guide-pierres"{% if mobile %} data-nav-close-mobile{% endif %}>Pierres de A à Z</a></li>
    <li><a class="{{ link_class }}" href="/pages/bijoux-par-pierre?view=milaura-guide-pierres#histoire-symbolique"{% if mobile %} data-nav-close-mobile{% endif %}>Histoire et symbolique</a></li>
    <li><a class="{{ link_class }}" href="/pages/choisir-sa-pierre"{% if mobile %} data-nav-close-mobile{% endif %}>Choisir selon son émotion du moment</a></li>
    <li class="{{ heading_class }}">Pierres incontournables</li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-amethyste"{% if mobile %} data-nav-close-mobile{% endif %}>Améthyste</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-quartz-rose"{% if mobile %} data-nav-close-mobile{% endif %}>Quartz rose</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-oeil-de-tigre"{% if mobile %} data-nav-close-mobile{% endif %}>Œil de tigre</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-lapis-lazuli"{% if mobile %} data-nav-close-mobile{% endif %}>Lapis-lazuli</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-aigue-marine"{% if mobile %} data-nav-close-mobile{% endif %}>Aigue-marine</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/par-pierre-aventurine"{% if mobile %} data-nav-close-mobile{% endif %}>Aventurine</a></li>

  {%- when 'rituels-bien-etre' -%}
    <li class="{{ featured_class }}">
      <a class="{{ link_class }}" href="{{ routes.collections_url }}/rituels-bien-etre"{% if mobile %} data-nav-close-mobile{% endif %}>Tous les rituels et produits bien-être</a>
    </li>
    <li class="{{ heading_class }}">Par famille</li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/savons-naturels"{% if mobile %} data-nav-close-mobile{% endif %}>Savons naturels</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/bols-chantants"{% if mobile %} data-nav-close-mobile{% endif %}>Bols chantants</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/bougies-emotionnelles"{% if mobile %} data-nav-close-mobile{% endif %}>Bougies émotionnelles</a></li>

  {%- when 'cadeaux' -%}
    <li><a class="{{ link_class }}" href="/pages/pierres-de-naissance"{% if mobile %} data-nav-close-mobile{% endif %}>Pierre de naissance</a></li>
    <li><a class="{{ link_class }}" href="/pages/cadeaux-anniversaire-de-mariage"{% if mobile %} data-nav-close-mobile{% endif %}>Anniversaire de mariage</a></li>
    <li><a class="{{ link_class }}" href="{{ routes.collections_url }}/selection-aout-2026?view=selection-de-karine"{% if mobile %} data-nav-close-mobile{% endif %}>Rentrée en Sodalite</a></li>

  {%- when 'guides' -%}
    <li><a class="{{ link_class }}" href="/pages/choisir-sa-pierre"{% if mobile %} data-nav-close-mobile{% endif %}>Choisir selon son émotion du moment</a></li>
    <li><a class="{{ link_class }}" href="/pages/diagnostic-emotionnel"{% if mobile %} data-nav-close-mobile{% endif %}>Faire le diagnostic</a></li>
    <li><a class="{{ link_class }}" href="/blogs/journal"{% if mobile %} data-nav-close-mobile{% endif %}>Le Journal</a></li>
    <li><a class="{{ link_class }}" href="/pages/notre-histoire"{% if mobile %} data-nav-close-mobile{% endif %}>Notre histoire</a></li>
{%- endcase -%}
