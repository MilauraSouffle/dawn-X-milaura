{{ 'milaura-cookie-consent.css' | asset_url | stylesheet_tag }}

<div
  id="MilauraCookieConsent"
  class="milaura-cookie-consent"
  data-milaura-cookie-consent
  hidden
>
  <section
    class="milaura-cookie-consent__banner"
    aria-labelledby="MilauraCookieConsentTitle"
    aria-describedby="MilauraCookieConsentDescription"
  >
    <div class="milaura-cookie-consent__gem" aria-hidden="true">
      <img
        src="{{ 'milaura-cookie-gem.webp' | asset_url }}"
        alt=""
        width="1000"
        height="1000"
        loading="eager"
        fetchpriority="low"
      >
    </div>

    <div class="milaura-cookie-consent__inner">
      <div class="milaura-cookie-consent__copy">
        <h2 id="MilauraCookieConsentTitle">Vos choix, simplement</h2>
        <p id="MilauraCookieConsentDescription">
          Les essentiels font fonctionner la boutique. Avec votre accord, les autres mesurent les visites et
          personnalisent votre expérience MilAura.
          <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">En savoir plus</a>
        </p>
      </div>

      <div class="milaura-cookie-consent__actions" aria-label="Choix des cookies">
        <button type="button" class="milaura-cookie-consent__action milaura-cookie-consent__action--reject" data-cookie-reject>
          Je refuse
        </button>
        <button
          type="button"
          class="milaura-cookie-consent__action milaura-cookie-consent__action--choose"
          data-cookie-choose
          aria-haspopup="dialog"
        >
          Je choisis mes cookies
        </button>
        <button type="button" class="milaura-cookie-consent__action milaura-cookie-consent__action--accept" data-cookie-accept>
          J’accepte
        </button>
      </div>

      <p class="milaura-cookie-consent__status" data-cookie-status role="status" aria-live="polite" hidden></p>
    </div>
  </section>
</div>

<div class="milaura-cookie-preferences" data-cookie-preferences hidden>
  <div class="milaura-cookie-preferences__backdrop" data-cookie-preferences-close></div>
  <section
    class="milaura-cookie-preferences__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="MilauraCookiePreferencesTitle"
    aria-describedby="MilauraCookiePreferencesDescription"
    tabindex="-1"
  >
    <button
      type="button"
      class="milaura-cookie-preferences__close"
      data-cookie-preferences-close
      aria-label="Fermer le choix des cookies"
    >
      <span aria-hidden="true">×</span>
    </button>

    <p class="milaura-cookie-preferences__eyebrow">Vos préférences</p>
    <h2 id="MilauraCookiePreferencesTitle">Choisissez vos cookies</h2>
    <p id="MilauraCookiePreferencesDescription">
      Les cookies essentiels restent actifs. Vous pouvez choisir séparément les préférences, la mesure d’audience
      et le marketing.
    </p>

    <div class="milaura-cookie-preferences__choices">
      <div class="milaura-cookie-preferences__choice">
        <div>
          <h3>Essentiels</h3>
          <p>Panier, sécurité, paiement et fonctionnement de la boutique.</p>
        </div>
        <span class="milaura-cookie-preferences__required">Toujours actifs</span>
      </div>

      <label class="milaura-cookie-preferences__choice">
        <span>
          <strong>Préférences</strong>
          <small>Mémoriser vos choix et personnaliser votre navigation.</small>
        </span>
        <input type="checkbox" data-cookie-category="preferences">
      </label>

      <label class="milaura-cookie-preferences__choice">
        <span>
          <strong>Mesure d’audience</strong>
          <small>Comprendre l’utilisation de la boutique et améliorer son fonctionnement.</small>
        </span>
        <input type="checkbox" data-cookie-category="analytics">
      </label>

      <label class="milaura-cookie-preferences__choice">
        <span>
          <strong>Marketing</strong>
          <small>Mesurer nos campagnes et adapter les communications publicitaires.</small>
        </span>
        <input type="checkbox" data-cookie-category="marketing">
      </label>

      <label class="milaura-cookie-preferences__choice" data-cookie-sale-row hidden>
        <span>
          <strong>Partage publicitaire</strong>
          <small>Autoriser le partage de données à des fins de publicité ciblée.</small>
        </span>
        <input type="checkbox" data-cookie-category="sale_of_data">
      </label>
    </div>

    <div class="milaura-cookie-preferences__actions">
      <button type="button" class="milaura-cookie-preferences__reject" data-cookie-preferences-reject>
        Tout refuser
      </button>
      <button type="button" class="milaura-cookie-preferences__save" data-cookie-preferences-save>
        Enregistrer mes choix
      </button>
    </div>

    <p class="milaura-cookie-preferences__status" data-cookie-preferences-status role="status" aria-live="polite" hidden></p>
  </section>
</div>

<script src="{{ 'milaura-cookie-consent.js' | asset_url }}" defer="defer"></script>
