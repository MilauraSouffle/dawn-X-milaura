{%- comment -%}
  MILAURA PDP RECOS V2
  Recommandations page produit (pierre-first, max 2)
  Self-contained — logique inlinee, pas de | push
{%- endcomment -%}

{%- liquid
  assign current_stone = product.metafields.milaura.stone_handle
  assign current_type = product.metafields.milaura.product_type_handle
  assign reco_source = collections['recos-pool'].products
  assign max_recos = 2
  assign reco_count = 0
  assign reco_1_id = 0
  assign reco_2_id = 0
-%}

{%- capture reco_cards -%}
  {%- comment -%} Pass 1 : meme pierre, type different {%- endcomment -%}
  {%- for item in reco_source limit: 50 -%}
    {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
    {%- if item.metafields.milaura.stone_handle == current_stone and item.metafields.milaura.product_type_handle != current_type -%}
      {% render 'milaura-product-card',
        product: item,
        img_loading: 'lazy',
        show_vendor: false,
        show_badges: true,
        show_secondary_image: true,
        force_bestseller_badge: false
      %}
      {%- if reco_count == 0 -%}
        {%- assign reco_1_id = item.id -%}
      {%- elsif reco_count == 1 -%}
        {%- assign reco_2_id = item.id -%}
      {%- endif -%}
      {%- assign reco_count = reco_count | plus: 1 -%}
      {%- if reco_count >= max_recos -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Pass 2 : fallback bestsellers {%- endcomment -%}
  {%- if reco_count < max_recos -%}
    {%- for item in reco_source limit: 50 -%}
      {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if item.id == reco_1_id or item.id == reco_2_id -%}{%- continue -%}{%- endif -%}
      {%- if item.metafields.milaura.is_bestseller == true -%}
        {% render 'milaura-product-card',
          product: item,
          img_loading: 'lazy',
          show_vendor: false,
          show_badges: true,
          show_secondary_image: true,
          force_bestseller_badge: false
        %}
        {%- assign reco_count = reco_count | plus: 1 -%}
        {%- if reco_count >= max_recos -%}{%- break -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if reco_count > 0 -%}
  <div class="milaura-pdp-recos">
    <div class="milaura-pdp-recos-container">
      <h3 class="milaura-pdp-recos-title">Complétez votre intention</h3>
      <div class="milaura-pdp-recos-grid milaura-cards" role="list">
        {{ reco_cards }}
      </div>
    </div>
  </div>

  <style>
    .milaura-pdp-recos {
      padding: var(--milaura-esp-xl) 0;
      background: transparent;
    }
    .milaura-pdp-recos-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .milaura-pdp-recos-title {
      font-family: var(--milaura-font-display);
      font-size: 1.75rem;
      text-align: center;
      margin: 0 0 2rem 0;
      color: var(--milaura-text, #000000);
    }
    .milaura-pdp-recos-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--milaura-esp-md);
    }
    @media screen and (min-width: 768px) {
      .milaura-pdp-recos-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
{%- endif -%}
