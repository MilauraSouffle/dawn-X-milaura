{%- comment -%}
  Carte produit MilAura canonique.

  Params :
  - product: produit Shopify
  - img_loading: eager ou lazy
  - show_vendor: boolean
  - show_badges: boolean
  - show_secondary_image: boolean
  - force_bestseller_badge: boolean
  - badge_label: texte du badge force
  - html_attributes: attributs Shopify facultatifs du bloc
  - nested_list_item: false quand le composant vit deja dans un li
{%- endcomment -%}

<div class="milaura-product-card"{% unless nested_list_item == false %} role="listitem"{% endunless %} {{ html_attributes }}>
  {% render 'milaura-card-product',
    card_product: product,
    img_loading: img_loading,
    show_vendor: show_vendor,
    show_badges: show_badges,
    show_secondary_image: show_secondary_image,
    force_bestseller_badge: force_bestseller_badge,
    badge_label: badge_label
  %}
  {% render 'milaura-editorial-purchase', product: product %}
</div>
